---
import fs from 'node:fs';
import Base from '../layouts/Base.astro';
import LangToggle from '../components/LangToggle.astro';
import data from '../data/cv.json';

// Drop a square photo at public/profile.{jpg,jpeg,png,webp} and rebuild — it replaces the monogram.
// Bump profile.photoVersion in cv.json when the photo changes, so browsers drop the cached one.
const photoFile = ['profile.jpg', 'profile.jpeg', 'profile.png', 'profile.webp'].find((f) =>
  fs.existsSync(new URL('../../public/' + f, import.meta.url))
);

// Everything on this page that changes over time lives in src/data/cv.json.
// It is edited from 실적관 (Romaan Village), or by hand; keep its shape in step with these types.
type Bi = { en: string; ko: string };
type CV = {
  profile: {
    name: string;
    nameKo: string;
    email: string;
    role: Bi; // [text](url) makes a link
    interests: Bi;
    links: { label: string; url: string }[];
    photoVersion: number;
    seo: {
      title: string;
      description: string;
      affiliation: { name: string; url: string };
      alumniOf: string;
      knowsAbout: string[];
      sameAs: string[]; // profiles beyond `links`
    };
  };
  news: { when: string; en: string; ko: string; href?: string }[];
  publications: {
    title: string;
    authors: { n: string; me?: boolean }[];
    collab?: string; // external collaboration, shown muted after the author list
    venue: { em: string; rest: string }; // em is bolded; rest is appended as-is
    award?: string; // e.g. 'Oral presentation' — accent text after the venue
    links: { label: string; url: string }[];
  }[];
  education: { org: string; role: string; extra?: string; advisor?: string; meta: string }[];
  experience: { org: string; url?: string; role: string; advisor?: string; meta: string }[];
  awards: { name: string; extra?: string; meta: string }[];
};
const { profile, news, publications: pubs, education, experience, awards } = data as CV;

// Keep each person's name on one line: spaces inside a name become non-breaking.
const nb = (name: string) => name.replaceAll(' ', '\u00a0');
const nbList = (names: string) => names.split(', ').map(nb).join(', ');

// Profile lines may carry [text](url) links. Link text is a name, so it never breaks.
const parts = (s: string) =>
  s
    .split(/(\[[^\]]+\]\([^)\s]+\))/)
    .filter(Boolean)
    .map((part) => {
      const m = part.match(/^\[([^\]]+)\]\(([^)\s]+)\)$/);
      return m ? { text: nb(m[1]), url: m[2] } : { text: part };
    });
const initials = profile.name.split(/\s+/).map((w) => w[0]).join('');
---

<Base
  title={profile.seo.title}
  description={profile.seo.description}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: profile.name,
    alternateName: profile.nameKo,
    url: 'https://romaanj.github.io/',
    email: profile.email,
    affiliation: { '@type': 'Organization', ...profile.seo.affiliation },
    alumniOf: profile.seo.alumniOf,
    award: awards.map((a) => a.name),
    sameAs: [...profile.links.map((l) => l.url), ...profile.seo.sameAs],
    knowsAbout: profile.seo.knowsAbout,
  }}
>
  <section class="section profile">
    <div class="container narrow">
      <div class="profile-top">
        {photoFile ? (
          <img class="portrait" src={'/' + photoFile + '?v=' + profile.photoVersion} alt={profile.name} width="198" height="264" />
        ) : (
          <div class="portrait monogram" aria-hidden="true">{initials}</div>
        )}
        <div class="id-block">
          <h1>{profile.name} <span class="name-ko">{profile.nameKo}</span></h1>
          <p class="role">
            {(['en', 'ko'] as const).map((lang) => (
              <span class={'lang-' + lang}>
                {parts(profile.role[lang]).map((p) => (p.url ? <a href={p.url} target="_blank" rel="noopener">{p.text}</a> : p.text))}
              </span>
            ))}
          </p>
          <p class="interests">
            <span class="lang-en"><strong>Research interest:</strong> {profile.interests.en}</span>
            <span class="lang-ko"><strong>연구 관심사:</strong> {profile.interests.ko}</span>
          </p>
          <p class="id-links">
            <a href={'mailto:' + profile.email}>{profile.email}</a>
            {profile.links.map((l) => (
              <>
                <span class="sep">·</span>
                <a href={l.url} target="_blank" rel="noopener">{l.label}</a>
              </>
            ))}
          </p>
          <div class="id-toggle"><LangToggle /></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight" id="news">
    <div class="container narrow">
      <h2 class="sec-h">News</h2>
      <ul class="news-list">
        {news.map((n) => (
          <li>
            <span class="news-when">{n.when}</span>
            <span class="news-sep">|</span>
            <span class="news-text">
              <span class="lang-en">{n.en}</span>
              <span class="lang-ko">{n.ko}</span>
              {n.href && (
                <a class="news-link" href={n.href} target={n.href.startsWith('http') ? '_blank' : undefined} rel="noopener">Link</a>
              )}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight" id="publications">
    <div class="container narrow">
      <h2 class="sec-h">Publications</h2>
      <ul class="pub-list">
        {pubs.map((pub) => (
          <li>
            <h3 class="pub-title">{pub.title}</h3>
            <p class="pub-authors">
              {pub.authors.map((a, i) => (
                <>
                  {a.me ? <strong>{nb(a.n)}</strong> : nb(a.n)}{i < pub.authors.length - 1 ? ', ' : ''}
                </>
              ))}
              {pub.collab && <span class="pub-collab"> · {pub.collab}</span>}
            </p>
            <p class="pub-venue">
              <strong>{pub.venue.em}</strong><em>{pub.venue.rest}</em>{pub.award && (
                <>, <span class="pub-award">{pub.award}</span></>
              )}
            </p>
            {pub.links.length > 0 && (
              <p class="pub-links">
                {pub.links.map((l, i) => (
                  <>
                    {i > 0 && <span class="pub-link-sep">|</span>}
                    <a href={l.url} target="_blank" rel="noopener">{l.label}</a>
                  </>
                ))}
              </p>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight" id="education">
    <div class="container narrow">
      <h2 class="sec-h">Education</h2>
      <ul class="cv-list">
        {education.map((e) => (
          <li>
            <h3 class="cv-title">{e.org}</h3>
            <p class="cv-role">{e.role}</p>
            {e.extra && <p class="cv-role">{e.extra}</p>}
            {e.advisor && <p class="cv-advisor">Advisor: {nbList(e.advisor)}</p>}
            <p class="cv-meta">{e.meta}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight" id="experience">
    <div class="container narrow">
      <h2 class="sec-h">Experience</h2>
      <ul class="cv-list">
        {experience.map((e) => (
          <li>
            <h3 class="cv-title">
              {e.url ? (
                <a class="cv-org-link" href={e.url} target="_blank" rel="noopener">{e.org}</a>
              ) : (
                e.org
              )}
            </h3>
            <p class="cv-role">{e.role}</p>
            {e.advisor && <p class="cv-advisor">Advisor: {nbList(e.advisor)}</p>}
            <p class="cv-meta">{e.meta}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight page-end" id="awards">
    <div class="container narrow">
      <h2 class="sec-h">Awards &amp; Honors</h2>
      <ul class="cv-list">
        {awards.map((a) => (
          <li>
            <h3 class="cv-title">{a.name}</h3>
            {a.extra && <p class="cv-role">{a.extra}</p>}
            <p class="cv-meta">{a.meta}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .narrow { max-width: 780px; }
  .profile { padding-top: clamp(3rem, 8vw, 5.5rem); padding-bottom: 1.5rem; }
  .profile-top {
    display: flex;
    gap: clamp(1.4rem, 4vw, 2.6rem);
    align-items: flex-start;
  }
  .portrait {
    width: 198px;
    height: 264px; /* full-frame 3:4 portrait */
    border-radius: var(--radius-l);
    object-fit: cover;
    border: 1px solid var(--line);
    flex-shrink: 0;
    box-shadow: var(--shadow-card);
  }
  .portrait.monogram {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-dark);
    color: var(--accent);
    font-family: var(--font-serif);
    font-size: 3.2rem;
    font-weight: 600;
  }
  .id-block h1 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    margin-bottom: 0.35rem;
  }
  .name-ko {
    font-size: 0.62em;
    font-weight: 500;
    color: var(--text-secondary);
    margin-left: 0.25em;
  }
  .role { margin: 0 0 0.55rem; font-size: 1rem; color: var(--text-secondary); }
  .role a { color: var(--accent-strong); }
  .role a:hover { text-decoration: underline; }
  .interests { margin: 0 0 0.8rem; font-size: 0.96rem; color: var(--text-secondary); line-height: 1.6; }
  .interests strong { color: var(--text); font-weight: 600; }
  .id-links { margin: 0 0 0.9rem; font-size: 0.92rem; }
  .id-links a { color: var(--accent-strong); }
  .id-links a:hover { text-decoration: underline; }
  .sep { color: var(--line-strong); margin: 0 0.45em; }

  section[id] { scroll-margin-top: 72px; } /* clear the sticky header on /#anchor jumps */
  .section-tight { padding: clamp(1.3rem, 2.6vw, 1.9rem) 0; } /* one-page CV rhythm (global: 2–3rem) */
  .sec-h {
    font-size: 1.45rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 1rem;
  }
  .news-list { list-style: none; margin: 0; padding: 0; }
  .news-list li {
    display: flex;
    gap: 0.7em;
    padding: 0.42rem 0;
    font-size: 0.97rem;
    line-height: 1.55;
  }
  .news-when {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-tertiary);
    white-space: nowrap;
    padding-top: 0.15em;
    min-width: 4.6em;
  }
  .news-sep { color: var(--line-strong); }
  .news-text { color: var(--text); }
  .news-link {
    margin-left: 0.5em;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--accent-strong);
  }
  .news-link:hover { text-decoration: underline; }

  .pub-list { list-style: none; margin: 0; padding: 0; }
  /* every line in near-black; hierarchy from weight and italics, not gray shades */
  .pub-list li { padding: 0.5rem 0 1rem; }
  .pub-title,
  .cv-title {
    font-family: var(--font-sans);
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.005em;
    margin-bottom: 0.2rem;
  }
  .pub-authors { margin: 0 0 0.1rem; font-size: 0.95rem; color: var(--text); }
  .pub-authors strong { font-weight: 700; }
  .pub-collab { color: var(--text-secondary); }
  .pub-venue { margin: 0; font-size: 0.95rem; color: var(--text); }
  .pub-venue strong { font-weight: 700; }
  .pub-award { font-weight: 700; font-style: italic; color: var(--accent-strong); }
  .pub-links { margin: 0.15rem 0 0; font-size: 0.93rem; }
  .pub-links a { color: var(--accent-strong); font-weight: 500; }
  .pub-links a:hover { text-decoration: underline; }
  .pub-link-sep { color: var(--line-strong); margin: 0 0.4em; }

  /* cv-style lists (Education / Experience / Awards) — same treatment as publications */
  .cv-list { list-style: none; margin: 0; padding: 0; }
  .cv-list li { padding: 0.5rem 0 1rem; }
  .cv-org-link { color: inherit; }
  .cv-org-link:hover { color: var(--accent-strong); }
  .cv-role,
  .cv-advisor { margin: 0 0 0.1rem; font-size: 0.95rem; color: var(--text); line-height: 1.55; }
  .cv-meta { margin: 0; font-size: 0.95rem; color: var(--text); font-style: italic; }

  .page-end { padding-bottom: clamp(3rem, 7vw, 5rem); }

  @media (max-width: 620px) {
    .profile-top { flex-direction: column; align-items: center; text-align: center; }
    .id-block h1 { font-size: 1.8rem; }
    .id-toggle { display: flex; justify-content: center; }
    .news-list li { flex-wrap: wrap; }
  }
</style>
