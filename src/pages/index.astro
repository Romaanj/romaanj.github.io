---
import fs from 'node:fs';
import Base from '../layouts/Base.astro';
import LangToggle from '../components/LangToggle.astro';

// Drop a square photo at public/profile.{jpg,jpeg,png,webp} and rebuild — it replaces the monogram.
const photoFile = ['profile.jpg', 'profile.jpeg', 'profile.png', 'profile.webp'].find((f) =>
  fs.existsSync(new URL('../../public/' + f, import.meta.url))
);

const news: { when: string; en: string; ko: string; href?: string }[] = [
  {
    when: 'Mar 2026',
    en: 'Starting my M.S. @ IRIS Lab, SKKU!',
    ko: '성균관대학교 IRIS Lab에서 석사과정을 시작합니다!',
    href: 'https://iris.skku.edu/',
  },
  {
    when: 'Feb 2026',
    en: 'Graduated from Sungkyunkwan University — B.S. in Electronic and Electrical Engineering, magna cum laude.',
    ko: '성균관대학교 전자전기공학부 졸업 (magna cum laude).',
  },
  {
    when: 'Dec 2025',
    en: 'RUSH accepted to RA-L 2026!',
    ko: 'RUSH가 RA-L 2026에 게재 승인되었습니다!',
    href: 'https://ieeexplore.ieee.org/abstract/document/11347481',
  },
];

type Pub = {
  title: string;
  authors: { n: string; me?: boolean }[];
  venue: string;
  tags: string[];
  links: { label: string; url: string }[];
};
const pubs: Pub[] = [
  {
    title: 'RUSH: Recursive and Scalable 3D Coarse to Fine Path Planning',
    authors: [
      { n: 'Hwajung Lee' }, { n: 'Daegeol Ko' }, { n: 'Jaehyuk Hur' },
      { n: 'Junwon Lee', me: true }, { n: 'Seongbo Ha' }, { n: 'Jong Hwan Ko' },
      { n: 'Hyeonwoo Yu' },
    ],
    venue: 'IEEE Robotics and Automation Letters (RA-L), 2026',
    tags: ['#Diffusion', '#PathPlanning'],
    links: [{ label: 'paper', url: 'https://ieeexplore.ieee.org/abstract/document/11347481' }],
  },
  {
    title: 'Paper on Diffusion LLM KV Caching',
    authors: [
      { n: 'Junwon Lee', me: true }, { n: 'Wonwook Lee' }, { n: 'Dongmin Han' },
      { n: 'Jae-sun Seo' }, { n: 'Jong Hwan Ko' },
    ],
    venue: 'Under review at EMNLP 2026 · in collaboration with Cornell Tech',
    tags: ['#DiffusionLLM', '#KVCaching'],
    links: [],
  },
];

const explore = [
  { href: '/study/', label: 'Study' },
  { href: '/reviews/', label: 'Paper Review' },
  { href: '/talks/', label: 'Talks' },
  { href: '/projects/', label: 'Project' },
];
---

<Base title="Junwon Lee — Efficient AI Research">
  <section class="section profile">
    <div class="container narrow">
      <div class="profile-top">
        {photoFile ? (
          <img class="portrait" src={'/' + photoFile} alt="Junwon Lee" width="168" height="168" />
        ) : (
          <div class="portrait monogram" aria-hidden="true">JL</div>
        )}
        <div class="id-block">
          <h1>Junwon Lee <span class="name-ko">이준원</span></h1>
          <p class="role">
            <span class="lang-en">
              M.S. Student @ <a href="https://iris.skku.edu/" target="_blank" rel="noopener">IRIS Lab</a>,
              Sungkyunkwan University
            </span>
            <span class="lang-ko">
              성균관대학교 <a href="https://iris.skku.edu/" target="_blank" rel="noopener">IRIS Lab</a>
              석사과정
            </span>
          </p>
          <p class="interests">
            <span class="lang-en">
              <strong>Research interest:</strong> efficient AI inference — diffusion LLMs,
              KV-cache compression &amp; quantization, hybrid attention, and hardware-software
              co-optimization.
            </span>
            <span class="lang-ko">
              <strong>연구 관심사:</strong> 효율적인 AI 추론 — diffusion LLM,
              KV-cache 압축·quantization, hybrid attention, 그리고 hardware-software
              co-optimization.
            </span>
          </p>
          <p class="id-links">
            <a href="mailto:jwlee1218@g.skku.edu">jwlee1218@g.skku.edu</a>
            <span class="sep">·</span>
            <a href="https://github.com/Romaanj" target="_blank" rel="noopener">GitHub</a>
            <span class="sep">·</span>
            <a href="https://www.linkedin.com/in/junwon-lee-961383204/" target="_blank" rel="noopener">LinkedIn</a>
            <span class="sep">·</span>
            <a href="/about/">About</a>
          </p>
          <div class="id-toggle"><LangToggle /></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container narrow">
      <h2 class="news-h">News</h2>
      <ul class="news-list">
        {news.map((n) => (
          <li>
            <span class="news-when">{n.when}</span>
            <span class="news-sep">|</span>
            <span class="news-text">
              <span class="lang-en">{n.en}</span>
              <span class="lang-ko">{n.ko}</span>
              {n.href && (
                <a class="news-link" href={n.href} target={n.href.startsWith('http') ? '_blank' : undefined} rel="noopener">Link</a>
              )}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight">
    <div class="container narrow">
      <h2 class="news-h">Publications</h2>
      <ul class="pub-list">
        {pubs.map((pub) => (
          <li>
            <h3 class="pub-title">{pub.title}</h3>
            <p class="pub-authors">
              {pub.authors.map((a, i) => (
                <>
                  {a.me ? <strong>{a.n}</strong> : a.n}{i < pub.authors.length - 1 ? ', ' : ''}
                </>
              ))}
            </p>
            <p class="pub-venue">{pub.venue}</p>
            <p class="pub-tags">{pub.tags.join('  ')}</p>
            {pub.links.length > 0 && (
              <p class="pub-chips">
                {pub.links.map((l) => (
                  <a class="pub-chip" href={l.url} target="_blank" rel="noopener">{l.label}</a>
                ))}
              </p>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight explore-band">
    <div class="container narrow">
      <p class="explore-row">
        <span class="explore-label">
          <span class="lang-en">Explore</span>
          <span class="lang-ko">둘러보기</span>
        </span>
        {explore.map((e) => (
          <a class="arrow-link" href={e.href}>{e.label}</a>
        ))}
      </p>
    </div>
  </section>
</Base>

<style>
  .narrow { max-width: 780px; }
  .profile { padding-top: clamp(3rem, 8vw, 5.5rem); padding-bottom: 1.5rem; }
  .profile-top {
    display: flex;
    gap: clamp(1.4rem, 4vw, 2.6rem);
    align-items: flex-start;
  }
  .portrait {
    width: 168px;
    height: 168px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--line);
    flex-shrink: 0;
    box-shadow: var(--shadow-card);
  }
  .portrait.monogram {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-dark);
    color: var(--accent);
    font-family: var(--font-serif);
    font-size: 3.2rem;
    font-weight: 600;
  }
  .id-block h1 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    margin-bottom: 0.35rem;
  }
  .name-ko {
    font-size: 0.62em;
    font-weight: 500;
    color: var(--text-secondary);
    margin-left: 0.25em;
  }
  .role { margin: 0 0 0.55rem; font-size: 1rem; color: var(--text-secondary); }
  .role a { color: var(--accent-strong); }
  .role a:hover { text-decoration: underline; }
  .interests { margin: 0 0 0.8rem; font-size: 0.96rem; color: var(--text-secondary); line-height: 1.6; }
  .interests strong { color: var(--text); font-weight: 600; }
  .id-links { margin: 0 0 0.9rem; font-size: 0.92rem; }
  .id-links a { color: var(--accent-strong); }
  .id-links a:hover { text-decoration: underline; }
  .sep { color: var(--line-strong); margin: 0 0.45em; }

  .news-h {
    font-size: 1.45rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 1rem;
  }
  .news-list { list-style: none; margin: 0; padding: 0; }
  .news-list li {
    display: flex;
    gap: 0.7em;
    padding: 0.42rem 0;
    font-size: 0.97rem;
    line-height: 1.55;
  }
  .news-when {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-tertiary);
    white-space: nowrap;
    padding-top: 0.15em;
    min-width: 4.6em;
  }
  .news-sep { color: var(--line-strong); }
  .news-text { color: var(--text); }
  .news-link {
    margin-left: 0.5em;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--accent-strong);
  }
  .news-link:hover { text-decoration: underline; }

  .pub-list { list-style: none; margin: 0; padding: 0; }
  .pub-list li { padding: 0.55rem 0 1.3rem; }
  .pub-title { font-size: 1.22rem; margin-bottom: 0.3rem; }
  .pub-authors { margin: 0 0 0.1rem; font-size: 0.94rem; color: var(--text); }
  .pub-authors strong { font-weight: 700; }
  .pub-venue { margin: 0 0 0.15rem; font-size: 0.9rem; color: var(--text-tertiary); }
  .pub-tags { margin: 0 0 0.55rem; font-size: 0.9rem; font-style: italic; color: var(--text-secondary); white-space: pre; }
  .pub-chips { margin: 0; display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .pub-chip {
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.3em 1.1em;
    border-radius: 999px;
    background: var(--surface-dark);
    color: var(--text-on-dark);
    transition: background 0.15s;
  }
  .pub-chip:hover { background: var(--accent-strong); color: #fff; }

  .explore-band { padding-bottom: clamp(3rem, 7vw, 5rem); }
  .explore-row {
    display: flex;
    align-items: center;
    gap: 1.3rem;
    flex-wrap: wrap;
    margin: 0;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }
  .explore-label {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  @media (max-width: 620px) {
    .profile-top { flex-direction: column; align-items: center; text-align: center; }
    .id-block h1 { font-size: 1.8rem; }
    .id-toggle { display: flex; justify-content: center; }
    .news-list li { flex-wrap: wrap; }
  }
</style>
