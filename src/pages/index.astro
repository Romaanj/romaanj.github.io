---
import fs from 'node:fs';
import Base from '../layouts/Base.astro';
import LangToggle from '../components/LangToggle.astro';

// Drop a square photo at public/profile.{jpg,jpeg,png,webp} and rebuild — it replaces the monogram.
const photoFile = ['profile.jpg', 'profile.jpeg', 'profile.png', 'profile.webp'].find((f) =>
  fs.existsSync(new URL('../../public/' + f, import.meta.url))
);

const news: { when: string; en: string; ko: string; href?: string }[] = [
  {
    when: 'Sep 2026',
    en: 'Three papers accepted to the NeurIPS 2026 DiffuLM Workshop (2 orals, 1 poster)!',
    ko: 'NeurIPS 2026 DiffuLM Workshop에 논문 3편(Oral 2편, Poster 1편)이 채택되었습니다!',
    href: 'https://7amin.github.io/diffulm-neurips2026/',
  },
  {
    when: 'Mar 2026',
    en: 'Starting my M.S. @ IRIS Lab, SKKU!',
    ko: '성균관대학교 IRIS Lab에서 석사과정을 시작합니다!',
    href: 'https://iris.skku.edu/',
  },
  {
    when: 'Feb 2026',
    en: 'Graduated from Sungkyunkwan University — B.S. in Electronic and Electrical Engineering, magna cum laude.',
    ko: '성균관대학교 전자전기공학부 졸업 (magna cum laude).',
  },
  {
    when: 'Dec 2025',
    en: 'RUSH accepted to RA-L 2026!',
    ko: 'RUSH가 RA-L 2026에 게재 승인되었습니다!',
    href: 'https://ieeexplore.ieee.org/abstract/document/11347481',
  },
];

type Pub = {
  title: string;
  authors: { n: string; me?: boolean }[];
  collab?: string; // external collaboration, shown muted after the author list
  venue: { em: string; rest: string }; // em is bolded; rest is appended as-is
  award?: string; // e.g. 'Oral' — accent badge after the venue
  tags: string[];
  links: { label: string; url: string }[];
};
const pubs: Pub[] = [
  {
    title: 'QWaF: Ultra-Low-Bit KV-Cache Quantization for Block-Diffusion Language Models',
    authors: [{ n: 'Junwon Lee', me: true }, { n: 'Jae-sun Seo' }, { n: 'Jong Hwan Ko' }],
    collab: 'in collaboration with Cornell Tech',
    venue: { em: 'NeurIPS 2026 Workshop', rest: ' on Diffusion Language Models (DiffuLM)' },
    award: 'Oral',
    tags: ['#DiffusionLLM', '#KVCache', '#Quantization'],
    links: [],
  },
  {
    title: 'SPIRA: Sparse Pre-RoPE Informed Routing Attention for Diffusion Language Models',
    authors: [
      { n: 'Chaehyeon Min' }, { n: 'Seokho Han' }, { n: 'Junwon Lee', me: true }, { n: 'Jong Hwan Ko' },
    ],
    venue: { em: 'NeurIPS 2026 Workshop', rest: ' on Diffusion Language Models (DiffuLM)' },
    award: 'Oral',
    tags: ['#DiffusionLLM', '#SparseAttention'],
    links: [],
  },
  {
    title: 'TwinQuant: Decoding-Aware Dual-Centred Quantization for Diffusion Language Models',
    authors: [
      { n: 'Seokho Han' }, { n: 'Chaehyeon Min' }, { n: 'Junwon Lee', me: true }, { n: 'Jong Hwan Ko' },
    ],
    venue: { em: 'NeurIPS 2026 Workshop', rest: ' on Diffusion Language Models (DiffuLM)' },
    tags: ['#DiffusionLLM', '#Quantization'],
    links: [],
  },
  {
    title: 'RUSH: Recursive and Scalable 3D Coarse to Fine Path Planning',
    authors: [
      { n: 'Hwajung Lee' }, { n: 'Daegeol Ko' }, { n: 'Jaehyuk Hur' },
      { n: 'Junwon Lee', me: true }, { n: 'Seongbo Ha' }, { n: 'Jong Hwan Ko' },
      { n: 'Hyeonwoo Yu' },
    ],
    venue: { em: 'IEEE Robotics and Automation Letters (RA-L)', rest: ', 2026' },
    tags: ['#Diffusion', '#PathPlanning'],
    links: [{ label: 'paper', url: 'https://ieeexplore.ieee.org/abstract/document/11347481' }],
  },

];

const experience = [
  {
    org: 'IRIS Lab, Sungkyunkwan University',
    url: 'https://iris.skku.edu/',
    role: 'Research Intern — Multi-Modal LLM, Video Compression, Diffusion Quantization, Path Planning',
    advisor: 'Jong Hwan Ko',
    meta: 'Suwon, Korea | Jun 2024 – Sep 2025',
  },
  {
    org: 'DAVIAN Lab, KAIST',
    url: 'https://davian.kaist.ac.kr/',
    role: 'Research Intern — 3D AI research',
    advisor: 'Jaegul Choo, Taewoong Kang',
    meta: 'Seongnam, Korea | Dec 2023 – Mar 2024',
  },
  {
    org: 'Whatcon',
    role: 'Blockchain Engineer — smart contract & mainnet development',
    meta: 'Seoul, Korea | Sep 2023 – Jan 2024',
  },
  {
    org: 'Republic of Korea Army',
    role: 'Sergeant, TOD Operator (military service)',
    meta: 'Sep 2021 – Mar 2023',
  },
];

const education = [
  {
    org: 'Sungkyunkwan University',
    role: 'B.S.–M.S. Combined, Graduate School of Electrical and Computer Engineering',
    extra: 'Intelligent & Resource-efficient Image processing & Systems design (IRIS) Lab | Prof. Jong Hwan Ko',
    meta: '2025 – present',
  },
  {
    org: 'Sungkyunkwan University',
    role: 'B.S. in Electronic and Electrical Engineering (Magna Cum Laude)',
    meta: '2020 – 2026',
  },
];

const awards = [
  {
    name: 'First Prize - 2026 SKKU NPU Challenge',
    extra: 'Accelerated long-context decoding of Llama-3.2-3B on Tenstorrent Eagle-N NPU',
    meta: 'Sungkyunkwan University | Aug 2026',
  },
  {
    name: 'BK21 Scholarship',
    extra: 'Outstanding graduate students in ECE ($10k/year)',
    meta: 'BrainKorea21 | 2026-2027',
  },
  {
    name: 'Samsung Outstanding Poster Award',
    extra: 'Top-voted project, Industry–Academia Collaboration Exchange',
    meta: 'Samsung Electronics | Oct 2025',
  },
  {
    name: 'Best Project Award — SKKU Capstone Design Project',
    extra: 'FPGA-accelerated image super-resolution (FSRCNN) for hardware-software co-acceleration',
    meta: 'Sungkyunkwan University | Jun 2025',
  },
  {
    name: "Dean's List — College of Information and Communication Engineering",
    meta: 'Sungkyunkwan University | Fall 2023, Fall 2024',
  },
  {
    name: 'Excellence Prize — 2023 Metaverse Developer Competition',
    extra: "Personalized NFT metaverse gallery 'BID:AM'",
    meta: 'Ministry of Science and ICT, Republic of Korea | Oct 2023',
  },
  {
    name: 'Encouragement Prize — 2023 Blockchain Challenge for Solving Difficult Problems',
    meta: 'Ministry of Science and ICT, Republic of Korea | Aug 2023',
  },
];
---

<Base
  title="Junwon Lee — Efficient AI Research"
  description="Junwon Lee — B.S.–M.S. combined student at IRIS Lab, Sungkyunkwan University. Training-free acceleration of diffusion LLMs, KV-cache compression, quantization, and efficient inference systems."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Junwon Lee',
    alternateName: '이준원',
    url: 'https://romaanj.github.io/',
    email: 'jwlee1218@g.skku.edu',
    affiliation: {
      '@type': 'Organization',
      name: 'IRIS Lab, Sungkyunkwan University',
      url: 'https://iris.skku.edu/',
    },
    alumniOf: 'Sungkyunkwan University',
    award: awards.map((a) => a.name),
    sameAs: [
      'https://github.com/Romaanj',
      'https://www.linkedin.com/in/junwon-lee-961383204/',
      'https://iris.skku.edu/authors/m29_junwon_lee/',
    ],
    knowsAbout: ['diffusion LLMs', 'KV-cache compression', 'quantization', 'efficient inference'],
  }}
>
  <section class="section profile">
    <div class="container narrow">
      <div class="profile-top">
        {photoFile ? (
          <img class="portrait" src={'/' + photoFile + '?v=2'} alt="Junwon Lee" width="198" height="264" />
        ) : (
          <div class="portrait monogram" aria-hidden="true">JL</div>
        )}
        <div class="id-block">
          <h1>Junwon Lee <span class="name-ko">이준원</span></h1>
          <p class="role">
            <span class="lang-en">
              M.S. Student @ <a href="https://iris.skku.edu/" target="_blank" rel="noopener">IRIS Lab</a>,
              Sungkyunkwan University, advised by
              <a href="https://iris.skku.edu/authors/admin/" target="_blank" rel="noopener">Prof. Jong Hwan Ko</a>
            </span>
            <span class="lang-ko">
              성균관대학교 <a href="https://iris.skku.edu/" target="_blank" rel="noopener">IRIS Lab</a>
              석사과정 · 지도교수
              <a href="https://iris.skku.edu/authors/admin/" target="_blank" rel="noopener">고종환</a>
            </span>
          </p>
          <p class="interests">
            <span class="lang-en">
              <strong>Research interest:</strong> efficient AI inference — diffusion LLMs,
              KV-cache compression &amp; quantization, hybrid attention, and hardware-software
              co-optimization.
            </span>
            <span class="lang-ko">
              <strong>연구 관심사:</strong> 효율적인 AI 추론 — diffusion LLM,
              KV-cache 압축·quantization, hybrid attention, 그리고 hardware-software
              co-optimization.
            </span>
          </p>
          <p class="id-links">
            <a href="mailto:jwlee1218@g.skku.edu">jwlee1218@g.skku.edu</a>
            <span class="sep">·</span>
            <a href="https://github.com/Romaanj" target="_blank" rel="noopener">GitHub</a>
            <span class="sep">·</span>
            <a href="https://www.linkedin.com/in/junwon-lee-961383204/" target="_blank" rel="noopener">LinkedIn</a>
          </p>
          <div class="id-toggle"><LangToggle /></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight" id="news">
    <div class="container narrow">
      <h2 class="sec-h">News</h2>
      <ul class="news-list">
        {news.map((n) => (
          <li>
            <span class="news-when">{n.when}</span>
            <span class="news-sep">|</span>
            <span class="news-text">
              <span class="lang-en">{n.en}</span>
              <span class="lang-ko">{n.ko}</span>
              {n.href && (
                <a class="news-link" href={n.href} target={n.href.startsWith('http') ? '_blank' : undefined} rel="noopener">Link</a>
              )}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight" id="publications">
    <div class="container narrow">
      <h2 class="sec-h">Publications</h2>
      <ul class="pub-list">
        {pubs.map((pub) => (
          <li>
            <h3 class="pub-title">{pub.title}</h3>
            <p class="pub-authors">
              {pub.authors.map((a, i) => (
                <>
                  {a.me ? <strong>{a.n}</strong> : a.n}{i < pub.authors.length - 1 ? ', ' : ''}
                </>
              ))}
              {pub.collab && <span class="pub-collab"> · {pub.collab}</span>}
            </p>
            <p class="pub-venue">
              <strong>{pub.venue.em}</strong>{pub.venue.rest}
              {pub.award && <span class="tag accent pub-award">{pub.award}</span>}
            </p>
            <p class="pub-tags">{pub.tags.join('  ')}</p>
            {pub.links.length > 0 && (
              <p class="pub-chips">
                {pub.links.map((l) => (
                  <a class="pub-chip" href={l.url} target="_blank" rel="noopener">{l.label}</a>
                ))}
              </p>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight" id="awards">
    <div class="container narrow">
      <h2 class="sec-h">Awards &amp; Honors</h2>
      <ul class="cv-list">
        {awards.map((a) => (
          <li>
            <h3 class="cv-title">{a.name}</h3>
            {a.extra && <p class="cv-role">{a.extra}</p>}
            <p class="cv-meta">{a.meta}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight" id="education">
    <div class="container narrow">
      <h2 class="sec-h">Education</h2>
      <ul class="cv-list">
        {education.map((e) => (
          <li>
            <h3 class="cv-title">{e.org}</h3>
            <p class="cv-role">{e.role}</p>
            {e.extra && <p class="cv-role">{e.extra}</p>}
            <p class="cv-meta">{e.meta}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight page-end" id="experience">
    <div class="container narrow">
      <h2 class="sec-h">Experience</h2>
      <ul class="cv-list">
        {experience.map((e) => (
          <li>
            <h3 class="cv-title">
              {e.url ? (
                <a class="cv-org-link" href={e.url} target="_blank" rel="noopener">{e.org}</a>
              ) : (
                e.org
              )}
            </h3>
            <p class="cv-role">{e.role}</p>
            {e.advisor && <p class="cv-advisor">Advisor: {e.advisor}</p>}
            <p class="cv-meta">{e.meta}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .narrow { max-width: 780px; }
  .profile { padding-top: clamp(3rem, 8vw, 5.5rem); padding-bottom: 1.5rem; }
  .profile-top {
    display: flex;
    gap: clamp(1.4rem, 4vw, 2.6rem);
    align-items: flex-start;
  }
  .portrait {
    width: 198px;
    height: 264px; /* full-frame 3:4 portrait */
    border-radius: var(--radius-l);
    object-fit: cover;
    border: 1px solid var(--line);
    flex-shrink: 0;
    box-shadow: var(--shadow-card);
  }
  .portrait.monogram {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-dark);
    color: var(--accent);
    font-family: var(--font-serif);
    font-size: 3.2rem;
    font-weight: 600;
  }
  .id-block h1 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    margin-bottom: 0.35rem;
  }
  .name-ko {
    font-size: 0.62em;
    font-weight: 500;
    color: var(--text-secondary);
    margin-left: 0.25em;
  }
  .role { margin: 0 0 0.55rem; font-size: 1rem; color: var(--text-secondary); }
  .role a { color: var(--accent-strong); }
  .role a:hover { text-decoration: underline; }
  .interests { margin: 0 0 0.8rem; font-size: 0.96rem; color: var(--text-secondary); line-height: 1.6; }
  .interests strong { color: var(--text); font-weight: 600; }
  .id-links { margin: 0 0 0.9rem; font-size: 0.92rem; }
  .id-links a { color: var(--accent-strong); }
  .id-links a:hover { text-decoration: underline; }
  .sep { color: var(--line-strong); margin: 0 0.45em; }

  section[id] { scroll-margin-top: 72px; } /* clear the sticky header on /#anchor jumps */
  .section-tight { padding: clamp(1.3rem, 2.6vw, 1.9rem) 0; } /* one-page CV rhythm (global: 2–3rem) */
  .sec-h {
    font-size: 1.45rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 1rem;
  }
  .news-list { list-style: none; margin: 0; padding: 0; }
  .news-list li {
    display: flex;
    gap: 0.7em;
    padding: 0.42rem 0;
    font-size: 0.97rem;
    line-height: 1.55;
  }
  .news-when {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-tertiary);
    white-space: nowrap;
    padding-top: 0.15em;
    min-width: 4.6em;
  }
  .news-sep { color: var(--line-strong); }
  .news-text { color: var(--text); }
  .news-link {
    margin-left: 0.5em;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--accent-strong);
  }
  .news-link:hover { text-decoration: underline; }

  .pub-list { list-style: none; margin: 0; padding: 0; }
  .pub-list li { padding: 0.55rem 0 1.3rem; }
  .pub-title { font-size: 1.22rem; margin-bottom: 0.3rem; }
  .pub-authors { margin: 0 0 0.1rem; font-size: 0.94rem; color: var(--text); }
  .pub-authors strong { font-weight: 700; }
  .pub-collab { font-size: 0.88rem; color: var(--text-tertiary); }
  .pub-venue { margin: 0 0 0.15rem; font-size: 0.9rem; color: var(--text-secondary); }
  .pub-venue strong { font-weight: 600; color: var(--text); }
  .pub-award { margin-left: 0.5em; font-weight: 700; letter-spacing: 0.02em; }
  .pub-tags { margin: 0 0 0.55rem; font-size: 0.9rem; font-style: italic; color: var(--text-secondary); white-space: pre; }
  .pub-chips { margin: 0; display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .pub-chip {
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.3em 1.1em;
    border-radius: 999px;
    background: var(--surface-dark);
    color: var(--text-on-dark);
    transition: background 0.15s;
  }
  .pub-chip:hover { background: var(--accent-strong); color: #fff; }

  /* cv-style lists (Awards / Education / Experience) */
  .cv-list { list-style: none; margin: 0; padding: 0; }
  .cv-list li { padding: 0.45rem 0 0.95rem; }
  .cv-title { font-size: 1.06rem; margin-bottom: 0.2rem; }
  .cv-org-link { color: inherit; }
  .cv-org-link:hover { color: var(--accent-strong); }
  .cv-role { margin: 0 0 0.1rem; font-size: 0.93rem; color: var(--text-secondary); line-height: 1.55; }
  .cv-advisor { margin: 0 0 0.1rem; font-size: 0.88rem; color: var(--text-tertiary); }
  .cv-meta { margin: 0; font-size: 0.86rem; color: var(--text-tertiary); }

  .page-end { padding-bottom: clamp(3rem, 7vw, 5rem); }

  @media (max-width: 620px) {
    .profile-top { flex-direction: column; align-items: center; text-align: center; }
    .id-block h1 { font-size: 1.8rem; }
    .id-toggle { display: flex; justify-content: center; }
    .news-list li { flex-wrap: wrap; }
  }
</style>
