---
import Base from '../layouts/Base.astro';
import LangToggle from '../components/LangToggle.astro';
import { getCollection } from 'astro:content';

const reviews = (await getCollection('reviews'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const study = (await getCollection('study'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const trackLabel: Record<string, string> = {
  models: 'AI Models',
  quantization: 'Quantization',
  gpu: 'GPU',
};
const studyHref = (e: (typeof study)[number]) => e.data.interactive ?? `/study/${e.id}/`;
---

<Base title="Junwon Lee — Efficient AI Research">
  <!-- hero -->
  <section class="section hero">
    <div class="container">
      <p class="eyebrow">Research · Systems · Efficiency</p>
      <h1>
        <span class="lang-en">
          Making large-model inference<br />
          <em>cheap enough to matter.</em>
        </span>
        <span class="lang-ko">
          대형 모델 추론을<br />
          <em>충분히 싸게</em> 만드는 일.
        </span>
      </h1>
      <p class="lede">
        <span class="lang-en">
          I'm Junwon Lee, a graduate researcher at IRIS Lab, Sungkyunkwan University.
          I work on training-free acceleration of diffusion LLMs — KV-cache compression,
          quantization, and the memory wall between HBM and useful tokens.
        </span>
        <span class="lang-ko">
          성균관대학교 IRIS Lab 대학원 연구원 이준원입니다.
          diffusion LLM의 training-free 가속을 연구합니다 — KV-cache 압축과
          quantization, 그리고 HBM과 쓸모 있는 token 사이의 memory wall이 주제입니다.
        </span>
      </p>
      <div class="hero-actions">
        <a class="btn" href="/research/">Explore research</a>
        <a class="btn ghost" href="/about/">About me</a>
        <LangToggle />
      </div>
    </div>
  </section>

  <!-- pillars -->
  <section class="section-tight">
    <div class="container">
      <div class="card-grid pillars">
        <a class="card" href="/research/">
          <span class="card-kicker">Research</span>
          <h3>Inference acceleration</h3>
          <p>
            <span class="lang-en">Diffusion-LM serving, KV-cache compression and quantization — where the FLOPs are cheap and the bytes are not.</span>
            <span class="lang-ko">Diffusion-LM serving, KV-cache 압축과 quantization — FLOPs는 싸고 bytes는 비싼 바로 그 지점.</span>
          </p>
          <span class="card-meta arrow-link">Research areas</span>
        </a>
        <a class="card" href="/study/">
          <span class="card-kicker">Study</span>
          <h3>Tear-downs, visualized</h3>
          <p>
            <span class="lang-en">Interactive anatomy of models, quantization pipelines, and GPU memory — every matrix multiply drawn out.</span>
            <span class="lang-ko">모델, quantization pipeline, GPU memory의 인터랙티브 해부도 — 모든 matrix multiply를 직접 그려낸다.</span>
          </p>
          <span class="card-meta arrow-link">Open the lab bench</span>
        </a>
        <a class="card" href="/reviews/">
          <span class="card-kicker">Paper Review</span>
          <h3>The reading graph</h3>
          <p>
            <span class="lang-en">Daily paper reviews on dLLMs, KV caching, sparse attention and hybrid architectures — linked like an Obsidian vault.</span>
            <span class="lang-ko">dLLM, KV caching, sparse attention, hybrid architecture 논문을 매일 리뷰 — Obsidian vault처럼 서로 연결해 둔다.</span>
          </p>
          <span class="card-meta arrow-link">Browse reviews</span>
        </a>
        <a class="card" href="/talks/">
          <span class="card-kicker">Talks</span>
          <h3>AI talks, in Korean</h3>
          <p>
            <span class="lang-en">English AI keynotes and talks with glossary-accurate Korean subtitles — embedded from the original channels, never re-hosted.</span>
            <span class="lang-ko">해외 AI 키노트와 발표에 용어까지 정확한 한글 자막을 얹어서 — 원본 채널 임베드로, 재업로드 없이.</span>
          </p>
          <span class="card-meta arrow-link">Watch with subtitles</span>
        </a>
        <a class="card" href="/projects/">
          <span class="card-kicker">Project</span>
          <h3>Side quests</h3>
          <p>
            <span class="lang-en">Things built for fun and curiosity — market-flow analysis, tooling, and whatever else escapes the lab.</span>
            <span class="lang-ko">재미와 호기심으로 만든 것들 — market-flow 분석, tooling, 그리고 lab 밖으로 새어 나온 나머지 전부.</span>
          </p>
          <span class="card-meta arrow-link">See projects</span>
        </a>
      </div>
    </div>
  </section>

  {reviews.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="row-head">
          <div>
            <p class="eyebrow">Latest reviews</p>
            <h2>
              <span class="lang-en">Recently on the reading list</span>
              <span class="lang-ko">최근 reading list에 오른 논문들</span>
            </h2>
          </div>
          <a class="arrow-link" href="/reviews/">All reviews</a>
        </div>
        <div class="card-grid">
          {reviews.map((r) => (
            <a class="card" href={`/reviews/${r.id}/`}>
              <span class="card-kicker">{r.data.tags[0] ?? 'Paper'}</span>
              <h3>{r.data.title}</h3>
              <p>
                {r.data.summary_ko ? (
                  <>
                    <span class="lang-en">{r.data.summary}</span>
                    <span class="lang-ko">{r.data.summary_ko}</span>
                  </>
                ) : (
                  r.data.summary
                )}
              </p>
              <span class="card-meta">
                {r.data.lab && <span>{r.data.lab}</span>}
                <span>{r.data.date.toISOString().slice(0, 10)}</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {study.length > 0 && (
    <section class="section band-dark">
      <div class="container">
        <div class="row-head">
          <div>
            <p class="eyebrow">Study</p>
            <h2>
              <span class="lang-en">On the bench right now</span>
              <span class="lang-ko">지금 작업대 위에 있는 것들</span>
            </h2>
          </div>
          <a class="arrow-link" href="/study/">All notes</a>
        </div>
        <div class="card-grid">
          {study.map((s) => (
            <a class="card" href={studyHref(s)}>
              <span class="card-kicker">{trackLabel[s.data.track]}</span>
              <h3>
                {s.data.title_ko ? (
                  <>
                    <span class="lang-en">{s.data.title}</span>
                    <span class="lang-ko">{s.data.title_ko}</span>
                  </>
                ) : (
                  s.data.title
                )}
              </h3>
              <p>
                {s.data.summary_ko ? (
                  <>
                    <span class="lang-en">{s.data.summary}</span>
                    <span class="lang-ko">{s.data.summary_ko}</span>
                  </>
                ) : (
                  s.data.summary
                )}
              </p>
              <span class="card-meta">
                {s.data.interactive && <span class="tag accent">Interactive</span>}
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .hero { padding-top: clamp(3.5rem, 9vw, 7rem); }
  .hero h1 em {
    font-style: italic;
    color: var(--accent-strong);
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 2.2rem;
    flex-wrap: wrap;
  }
  .lede { margin-top: 1.6rem; }
  .row-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }
  .pillars .card h3 { font-size: 1.35rem; }
</style>
