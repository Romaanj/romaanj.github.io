---
import Base from '../../layouts/Base.astro';
import LangToggle from '../../components/LangToggle.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('reviews');
  return entries.map((e) => ({ params: { slug: e.id }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const all = await getCollection('reviews');

/* outgoing links + backlinks, deduped, dangling dropped */
const outgoing = entry.data.links
  .map((slug) => all.find((e) => e.id === slug))
  .filter((e): e is NonNullable<typeof e> => Boolean(e));
const backlinks = all.filter(
  (e) => e.id !== entry.id && e.data.links.includes(entry.id)
);
const linkedMap = new Map(
  [...outgoing, ...backlinks].map((e) => [e.id, e])
);
linkedMap.delete(entry.id);
const linked = [...linkedMap.values()];

const dateStr = entry.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

/* ---------- 13-item bilingual analysis ---------- */

const ANALYSIS_KEYS = [
  'background',
  'problem',
  'prior_limits',
  'goal',
  'method',
  'key_idea',
  'validation',
  'results',
  'comparison',
  'significance',
  'limitations',
  'future_work',
  'resources',
] as const;

const EN_LABELS = [
  'Background',
  'Problem',
  'Prior limitations',
  'Goal',
  'Method',
  'Key idea',
  'Validation',
  'Results',
  'Comparison',
  'Significance',
  'Limitations',
  'Future work',
  'Released resources',
];

const KO_LABELS = [
  '배경',
  '문제',
  '기존 한계',
  '목표',
  '방법',
  '핵심 아이디어',
  '검증',
  '결과',
  '비교',
  '의의',
  '한계',
  '향후 과제',
  '자원 공개',
];

/* restrained rainbow: red → rose across the 13 rows (pre-muted for the ivory ground) */
const HUES = [
  '#c0524a', '#c9703d', '#b98a2e', '#8a9a3a', '#5f9a57', '#3f9b8a', '#3a92a8',
  '#4a7fb5', '#5b6ab8', '#7a63b4', '#94549f', '#b0537e', '#bd5a63',
];

/** HTML-escape first, then convert **...** to <strong>. No other markdown. */
const escapeHtml = (s: string) =>
  s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
const boldify = (s: string) =>
  escapeHtml(s).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');

const analysis = entry.data.analysis;
const analysisRows = analysis
  ? ANALYSIS_KEYS.map((key, i) => ({
      num: String(i + 1).padStart(2, '0'),
      hue: HUES[i],
      labelEn: EN_LABELS[i],
      labelKo: KO_LABELS[i],
      htmlEn: boldify(analysis.en[key] ?? ''),
      htmlKo: boldify(analysis.ko[key] ?? ''),
    }))
  : [];

/* ---------- research thread + sparks ---------- */

/** split a multi-paragraph string on blank lines */
const splitParas = (s: string) =>
  s
    .split(/\n\s*\n/)
    .map((p) => p.trim())
    .filter(Boolean);

const threadEn = entry.data.thread ? splitParas(entry.data.thread.en) : [];
const threadKo = entry.data.thread ? splitParas(entry.data.thread.ko) : [];
const hasThread = threadEn.length > 0 || threadKo.length > 0;
const sparks = entry.data.sparks ?? [];

const hasNotes = (entry.body ?? '').trim().length > 0;
const hasKoLede = Boolean(entry.data.summary_ko);
---

<Base
  title={`${entry.data.title} — Junwon Lee`}
  description={entry.data.summary}
>
  <section class="section">
    <div class="container review-detail">
      <a class="back-link" href="/reviews/">← All reviews</a>

      <p class="eyebrow">Paper Review</p>
      <h1 class="review-title">{entry.data.title}</h1>

      <div class="meta-row">
        <span class="meta-item mono">{dateStr}</span>
        {entry.data.authors && <span class="meta-item">{entry.data.authors}</span>}
        {entry.data.lab && <span class="meta-item lab-badge">{entry.data.lab}</span>}
        {entry.data.venue && <span class="meta-item venue">{entry.data.venue}</span>}
        {entry.data.arxivId && (
          <a
            class="meta-item arxiv-link mono"
            href={`https://arxiv.org/abs/${entry.data.arxivId}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            arXiv:{entry.data.arxivId}
          </a>
        )}
      </div>

      <div class="tag-row">
        {entry.data.tags.map((t) => (
          <span class="tag accent">{t}</span>
        ))}
      </div>

      {hasKoLede ? (
        <>
          <p class="lede review-lede lang-en">{entry.data.summary}</p>
          <p class="lede review-lede lang-ko">{entry.data.summary_ko}</p>
        </>
      ) : (
        <p class="lede review-lede">{entry.data.summary}</p>
      )}

      <div class="toggle-row">
        <LangToggle />
      </div>

      {entry.data.figures.length > 0 && (
        <div class="review-figs">
          {entry.data.figures.map((f) => (
            <figure class="review-fig">
              <a
                class="fig-frame"
                href={f.src}
                target="_blank"
                rel="noopener noreferrer"
              >
                <img
                  src={f.src}
                  alt={f.caption}
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <figcaption>
                {f.caption_ko ? (
                  <>
                    <span class="fig-caption lang-en">{f.caption}</span>
                    <span class="fig-caption lang-ko">{f.caption_ko}</span>
                  </>
                ) : (
                  <span class="fig-caption">{f.caption}</span>
                )}
                <span class="fig-credit">{f.credit}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      )}

      {analysisRows.length > 0 && (
        <div class="analysis-block">
          <div class="summary-list">
            {analysisRows.map((row) => (
              <div class="summary-row" style={`--row-hue: ${row.hue}`}>
                <span class="row-num" aria-hidden="true">{row.num}</span>
                <div class="row-body">
                  <p class="row-text lang-en">
                    <strong class="row-label">{row.labelEn}</strong>
                    <span set:html={row.htmlEn} />
                  </p>
                  <p class="row-text lang-ko">
                    <strong class="row-label">{row.labelKo}</strong>
                    <span set:html={row.htmlKo} />
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {hasThread && (
        <div class="thread-block">
          <p class="eyebrow">The research thread</p>
          <h2 class="thread-heading">
            <span class="lang-en">Where this paper sits</span>
            <span class="lang-ko">연구의 흐름</span>
          </h2>
          <div class="thread-prose">
            <div class="lang-en">
              {threadEn.map((p) => (
                <p class="thread-para" set:html={boldify(p)} />
              ))}
            </div>
            <div class="lang-ko">
              {threadKo.map((p) => (
                <p class="thread-para" set:html={boldify(p)} />
              ))}
            </div>
          </div>
        </div>
      )}

      {sparks.length > 0 && (
        <div class="sparks-panel">
          <h2 class="sparks-title">
            <span class="sparks-mark" aria-hidden="true">✦</span>
            <span class="lang-en">Sparks — where one could take this</span>
            <span class="lang-ko">아이디어의 씨앗</span>
          </h2>
          <ul class="sparks-list">
            {sparks.map((s) => (
              <li class="spark-row">
                <span class="spark-marker" aria-hidden="true">✦</span>
                <p class="spark-text">
                  <span class="lang-en" set:html={boldify(s.en)} />
                  <span class="lang-ko" set:html={boldify(s.ko)} />
                </p>
              </li>
            ))}
          </ul>
          <p class="sparks-footnote">
            <span class="lang-en">
              Seeds grounded in the paper's own stated limitations and open
              questions.
            </span>
            <span class="lang-ko">
              논문이 스스로 밝힌 limitations와 open questions에 뿌리를 둔
              씨앗입니다.
            </span>
          </p>
        </div>
      )}

      {entry.data.resources.length > 0 && (
        <div class="resource-row">
          {entry.data.resources.map((r) => (
            <a
              class="resource-chip"
              href={r.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {r.label}
              <span class="chip-ext" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      )}

      {hasNotes && (
        <div class="notes-block">
          {analysisRows.length > 0 && <p class="eyebrow notes-eyebrow">Notes</p>}
          <div class="prose">
            <Content />
          </div>
        </div>
      )}

      {linked.length > 0 && (
        <div class="linked-block">
          <p class="eyebrow">Linked reviews</p>
          <div class="card-grid">
            {linked.map((e) => (
              <a class="card" href={`/reviews/${e.id}/`}>
                <span class="card-kicker">{e.data.tags[0]}</span>
                <h3>{e.data.title}</h3>
                <p>{e.data.summary}</p>
                <span class="card-meta">
                  {e.data.date.toLocaleDateString('en-US', {
                    month: 'short',
                    day: '2-digit',
                    year: 'numeric',
                  })}
                  {e.data.lab ? ` · ${e.data.lab}` : ''}
                </span>
              </a>
            ))}
          </div>
        </div>
      )}

      <p class="bottom-back">
        <a class="arrow-link" href="/reviews/">Back to the review vault</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .back-link {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-decoration: none;
    margin-bottom: 2rem;
    transition: color 0.15s ease;
  }
  .back-link:hover {
    color: var(--accent-strong);
  }
  .review-title {
    max-width: 860px;
  }
  .meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem 1.1rem;
    margin-top: 1.1rem;
    font-size: 0.86rem;
    color: var(--text-secondary);
  }
  .mono {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.76rem;
  }
  .lab-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    background: var(--surface-warm);
    border: 1px solid var(--line);
  }
  .venue {
    font-weight: 600;
    color: var(--text);
  }
  .arxiv-link {
    color: var(--accent-strong);
    text-decoration: none;
    border-bottom: 1px dotted var(--accent);
  }
  .arxiv-link:hover {
    border-bottom-style: solid;
  }
  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.9rem;
  }
  .review-lede {
    margin-top: 1.6rem;
    max-width: 760px;
  }

  /* language visibility + toggle styling come from the shared LangToggle component
     (html[data-lang='ko'] + .lang-en/.lang-ko global rules). */
  .toggle-row {
    margin-top: 1.6rem;
  }

  /* ---- key figures from the paper (credited) ---- */
  .review-figs {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
    margin-top: 1.75rem;
    max-width: 900px;
  }
  .review-fig {
    flex: 1 1 340px;
    min-width: 0;
    margin: 0;
  }
  .fig-frame {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    transition: border-color 0.15s ease;
  }
  .fig-frame:hover {
    border-color: var(--accent);
  }
  .fig-frame img {
    display: block;
    max-width: 100%;
    max-height: 480px;
    object-fit: contain;
    border-radius: calc(var(--radius-m) - 6px);
  }
  .review-fig figcaption {
    margin-top: 0.6rem;
    font-size: 0.83rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }
  .fig-caption {
    display: block;
  }
  .fig-credit {
    display: block;
    margin-top: 0.3rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.66rem;
    color: var(--text-tertiary);
  }

  /* ---- 13-item analysis: one column, never a grid ---- */
  .analysis-block {
    margin-top: 1.75rem;
    max-width: 900px;
  }
  .summary-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .summary-row {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 0.95rem 1.15rem 0.95rem 1rem;
    border-left: 3px solid var(--row-hue);
    border-radius: var(--radius-m);
    background: color-mix(in srgb, var(--row-hue) 7%, var(--surface));
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .summary-row:hover {
    background: color-mix(in srgb, var(--row-hue) 11%, var(--surface));
    transform: translateY(-1px);
  }
  .row-num {
    flex: none;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--row-hue);
    background: color-mix(in srgb, var(--row-hue) 14%, var(--surface));
    padding: 0.22rem 0.5rem;
    border-radius: 7px;
    margin-top: 0.12rem;
  }
  .row-body {
    min-width: 0;
    flex: 1;
  }
  .row-text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text);
    overflow-wrap: anywhere;
  }
  .row-label {
    display: block;
    color: var(--row-hue);
    font-weight: 700;
    margin-bottom: 0.35rem;
  }

  /* ---- the research thread: serif narrative prose ---- */
  .thread-block {
    margin-top: 3rem;
    max-width: var(--prose-width);
  }
  .thread-heading {
    margin: 0.5rem 0 0;
    font-size: clamp(1.35rem, 2.6vw, 1.7rem);
  }
  .thread-prose {
    margin-top: 1.1rem;
  }
  .thread-para {
    font-family: var(--font-serif);
    font-size: 1.08rem;
    line-height: 1.85;
    color: var(--text);
    margin: 0 0 1.15em;
  }
  .thread-para:last-child {
    margin-bottom: 0;
  }

  /* ---- sparks: quiet warm panel, not the rainbow ---- */
  .sparks-panel {
    margin-top: 2rem;
    max-width: var(--prose-width);
    padding: 1.5rem 1.6rem 1.35rem;
    background: var(--surface-warm);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
  }
  .sparks-title {
    margin: 0;
    font-size: 1.08rem;
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
  }
  .sparks-mark {
    color: var(--accent);
    font-size: 0.9em;
  }
  .sparks-list {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .spark-row {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
  }
  .spark-marker {
    flex: none;
    color: var(--accent);
    font-size: 0.78rem;
    line-height: 1.7;
    margin-top: 0.1em;
  }
  .spark-text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text);
    overflow-wrap: anywhere;
  }
  .sparks-footnote {
    margin: 1.25rem 0 0;
    padding-top: 0.9rem;
    border-top: 1px dashed var(--line);
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--text-tertiary);
  }

  /* ---- resources chips ---- */
  .resource-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  .resource-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    padding: 0.32rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .resource-chip:hover {
    border-color: var(--accent);
    color: var(--accent-strong);
  }
  .chip-ext {
    color: var(--accent);
    font-size: 0.68rem;
  }

  /* ---- notes / prose ---- */
  .notes-block {
    margin-top: 2.5rem;
  }
  .notes-eyebrow {
    margin-bottom: 0.75rem;
  }
  .linked-block {
    margin-top: 3.5rem;
    padding-top: 2.25rem;
    border-top: 1px solid var(--line);
  }
  .linked-block .card-grid {
    margin-top: 1.25rem;
  }
  .bottom-back {
    margin-top: 3rem;
  }

  @media (max-width: 640px) {
    .summary-row {
      gap: 10px;
      padding: 0.8rem 0.9rem 0.8rem 0.75rem;
    }
    .row-num {
      font-size: 0.62rem;
      padding: 0.16rem 0.38rem;
    }
    .row-text {
      font-size: 0.9rem;
    }
  }
</style>
