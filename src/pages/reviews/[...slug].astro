---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('reviews');
  return entries.map((e) => ({ params: { slug: e.id }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const all = await getCollection('reviews');

/* outgoing links + backlinks, deduped, dangling dropped */
const outgoing = entry.data.links
  .map((slug) => all.find((e) => e.id === slug))
  .filter((e): e is NonNullable<typeof e> => Boolean(e));
const backlinks = all.filter(
  (e) => e.id !== entry.id && e.data.links.includes(entry.id)
);
const linkedMap = new Map(
  [...outgoing, ...backlinks].map((e) => [e.id, e])
);
linkedMap.delete(entry.id);
const linked = [...linkedMap.values()];

const dateStr = entry.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

/* ---------- 13-item bilingual analysis ---------- */

const ANALYSIS_KEYS = [
  'background',
  'problem',
  'prior_limits',
  'goal',
  'method',
  'key_idea',
  'validation',
  'results',
  'comparison',
  'significance',
  'limitations',
  'future_work',
  'resources',
] as const;

const EN_LABELS = [
  'Background',
  'Problem',
  'Prior limitations',
  'Goal',
  'Method',
  'Key idea',
  'Validation',
  'Results',
  'Comparison',
  'Significance',
  'Limitations',
  'Future work',
  'Released resources',
];

const KO_LABELS = [
  '배경',
  '문제',
  '기존 한계',
  '목표',
  '방법',
  '핵심 아이디어',
  '검증',
  '결과',
  '비교',
  '의의',
  '한계',
  '향후 과제',
  '자원 공개',
];

/* restrained rainbow: red → rose across the 13 rows (pre-muted for the ivory ground) */
const HUES = [
  '#c0524a', '#c9703d', '#b98a2e', '#8a9a3a', '#5f9a57', '#3f9b8a', '#3a92a8',
  '#4a7fb5', '#5b6ab8', '#7a63b4', '#94549f', '#b0537e', '#bd5a63',
];

/** HTML-escape first, then convert **...** to <strong>. No other markdown. */
const escapeHtml = (s: string) =>
  s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
const boldify = (s: string) =>
  escapeHtml(s).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');

const analysis = entry.data.analysis;
const analysisRows = analysis
  ? ANALYSIS_KEYS.map((key, i) => ({
      num: String(i + 1).padStart(2, '0'),
      hue: HUES[i],
      labelEn: EN_LABELS[i],
      labelKo: KO_LABELS[i],
      htmlEn: boldify(analysis.en[key] ?? ''),
      htmlKo: boldify(analysis.ko[key] ?? ''),
    }))
  : [];

const hasNotes = (entry.body ?? '').trim().length > 0;
const hasKoLede = Boolean(entry.data.summary_ko);
---

<Base
  title={`${entry.data.title} — Junwon Lee`}
  description={entry.data.summary}
>
  <script is:inline>
    try {
      document.documentElement.setAttribute(
        'data-review-lang',
        localStorage.getItem('review-lang') === 'ko' ? 'ko' : 'en'
      );
    } catch (e) {
      /* no-JS / blocked storage: EN default via CSS */
    }
  </script>

  <section class="section">
    <div class="container review-detail">
      <a class="back-link" href="/reviews/">← All reviews</a>

      <p class="eyebrow">Paper Review</p>
      <h1 class="review-title">{entry.data.title}</h1>

      <div class="meta-row">
        <span class="meta-item mono">{dateStr}</span>
        {entry.data.authors && <span class="meta-item">{entry.data.authors}</span>}
        {entry.data.lab && <span class="meta-item lab-badge">{entry.data.lab}</span>}
        {entry.data.venue && <span class="meta-item venue">{entry.data.venue}</span>}
        {entry.data.arxivId && (
          <a
            class="meta-item arxiv-link mono"
            href={`https://arxiv.org/abs/${entry.data.arxivId}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            arXiv:{entry.data.arxivId}
          </a>
        )}
      </div>

      <div class="tag-row">
        {entry.data.tags.map((t) => (
          <span class="tag accent">{t}</span>
        ))}
      </div>

      {hasKoLede ? (
        <>
          <p class="lede review-lede lang-en">{entry.data.summary}</p>
          <p class="lede review-lede lang-ko">{entry.data.summary_ko}</p>
        </>
      ) : (
        <p class="lede review-lede">{entry.data.summary}</p>
      )}

      <div class="lang-toggle" role="group" aria-label="Analysis language">
        <button type="button" class="lang-pill active" data-lang="en">EN</button>
        <button type="button" class="lang-pill" data-lang="ko">한국어</button>
      </div>

      {analysisRows.length > 0 && (
        <div class="analysis-block">
          <div class="summary-list">
            {analysisRows.map((row) => (
              <div class="summary-row" style={`--row-hue: ${row.hue}`}>
                <span class="row-num" aria-hidden="true">{row.num}</span>
                <div class="row-body">
                  <p class="row-text lang-en">
                    <strong class="row-label">{row.labelEn}</strong>
                    <span set:html={row.htmlEn} />
                  </p>
                  <p class="row-text lang-ko">
                    <strong class="row-label">{row.labelKo}</strong>
                    <span set:html={row.htmlKo} />
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {entry.data.resources.length > 0 && (
        <div class="resource-row">
          {entry.data.resources.map((r) => (
            <a
              class="resource-chip"
              href={r.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {r.label}
              <span class="chip-ext" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      )}

      {hasNotes && (
        <div class="notes-block">
          {analysisRows.length > 0 && <p class="eyebrow notes-eyebrow">Notes</p>}
          <div class="prose">
            <Content />
          </div>
        </div>
      )}

      {linked.length > 0 && (
        <div class="linked-block">
          <p class="eyebrow">Linked reviews</p>
          <div class="card-grid">
            {linked.map((e) => (
              <a class="card" href={`/reviews/${e.id}/`}>
                <span class="card-kicker">{e.data.tags[0]}</span>
                <h3>{e.data.title}</h3>
                <p>{e.data.summary}</p>
                <span class="card-meta">
                  {e.data.date.toLocaleDateString('en-US', {
                    month: 'short',
                    day: '2-digit',
                    year: 'numeric',
                  })}
                  {e.data.lab ? ` · ${e.data.lab}` : ''}
                </span>
              </a>
            ))}
          </div>
        </div>
      )}

      <p class="bottom-back">
        <a class="arrow-link" href="/reviews/">Back to the review vault</a>
      </p>
    </div>
  </section>
</Base>

<script>
  const pills = Array.from(
    document.querySelectorAll<HTMLButtonElement>('.lang-pill')
  );
  const applyLang = (lang: string) => {
    document.documentElement.setAttribute('data-review-lang', lang);
    try {
      localStorage.setItem('review-lang', lang);
    } catch {
      /* storage unavailable */
    }
    pills.forEach((p) => p.classList.toggle('active', p.dataset.lang === lang));
  };
  const initial =
    document.documentElement.getAttribute('data-review-lang') === 'ko'
      ? 'ko'
      : 'en';
  pills.forEach((p) => {
    p.classList.toggle('active', p.dataset.lang === initial);
    p.addEventListener('click', () => applyLang(p.dataset.lang === 'ko' ? 'ko' : 'en'));
  });
</script>

<style>
  .back-link {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-decoration: none;
    margin-bottom: 2rem;
    transition: color 0.15s ease;
  }
  .back-link:hover {
    color: var(--accent-strong);
  }
  .review-title {
    max-width: 860px;
  }
  .meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem 1.1rem;
    margin-top: 1.1rem;
    font-size: 0.86rem;
    color: var(--text-secondary);
  }
  .mono {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.76rem;
  }
  .lab-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    background: var(--surface-warm);
    border: 1px solid var(--line);
  }
  .venue {
    font-weight: 600;
    color: var(--text);
  }
  .arxiv-link {
    color: var(--accent-strong);
    text-decoration: none;
    border-bottom: 1px dotted var(--accent);
  }
  .arxiv-link:hover {
    border-bottom-style: solid;
  }
  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.9rem;
  }
  .review-lede {
    margin-top: 1.6rem;
    max-width: 760px;
  }

  /* ---- language visibility (EN default, works without JS) ---- */
  .lang-ko {
    display: none;
  }
  :global(html[data-review-lang='ko']) .lang-ko {
    display: revert;
  }
  :global(html[data-review-lang='ko']) .lang-en {
    display: none;
  }

  /* ---- language toggle ---- */
  .lang-toggle {
    display: inline-flex;
    gap: 0.3rem;
    margin-top: 1.6rem;
    padding: 0.25rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
  }
  .lang-pill {
    font-family: inherit;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 0.32rem 0.85rem;
    border: none;
    border-radius: 999px;
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .lang-pill:hover {
    color: var(--text);
  }
  .lang-pill.active {
    background: var(--text);
    color: var(--bg);
  }

  /* ---- 13-item analysis: one column, never a grid ---- */
  .analysis-block {
    margin-top: 1.75rem;
    max-width: 860px;
  }
  .summary-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .summary-row {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 0.95rem 1.15rem 0.95rem 1rem;
    border-left: 3px solid var(--row-hue);
    border-radius: var(--radius-m);
    background: color-mix(in srgb, var(--row-hue) 7%, var(--surface));
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .summary-row:hover {
    background: color-mix(in srgb, var(--row-hue) 11%, var(--surface));
    transform: translateY(-1px);
  }
  .row-num {
    flex: none;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--row-hue);
    background: color-mix(in srgb, var(--row-hue) 14%, var(--surface));
    padding: 0.22rem 0.5rem;
    border-radius: 7px;
    margin-top: 0.12rem;
  }
  .row-body {
    min-width: 0;
  }
  .row-text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text);
    overflow-wrap: anywhere;
  }
  .row-label {
    color: var(--row-hue);
    font-weight: 700;
    margin-right: 0.4rem;
  }

  /* ---- resources chips ---- */
  .resource-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  .resource-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    padding: 0.32rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .resource-chip:hover {
    border-color: var(--accent);
    color: var(--accent-strong);
  }
  .chip-ext {
    color: var(--accent);
    font-size: 0.68rem;
  }

  /* ---- notes / prose ---- */
  .notes-block {
    margin-top: 2.5rem;
  }
  .notes-eyebrow {
    margin-bottom: 0.75rem;
  }
  .linked-block {
    margin-top: 3.5rem;
    padding-top: 2.25rem;
    border-top: 1px solid var(--line);
  }
  .linked-block .card-grid {
    margin-top: 1.25rem;
  }
  .bottom-back {
    margin-top: 3rem;
  }

  @media (max-width: 640px) {
    .summary-row {
      gap: 10px;
      padding: 0.8rem 0.9rem 0.8rem 0.75rem;
    }
    .row-num {
      font-size: 0.62rem;
      padding: 0.16rem 0.38rem;
    }
    .row-text {
      font-size: 0.9rem;
    }
  }
</style>
