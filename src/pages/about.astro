---
import Base from '../layouts/Base.astro';

const experience = [
  {
    org: 'IRIS Lab, Sungkyunkwan University',
    url: 'https://iris.skku.edu/',
    role: 'Research Intern — Multi-Modal LLM, Video Compression, Diffusion Quantization, Path Planning',
    advisor: 'Jong Hwan Ko',
    meta: 'Suwon, Korea | Jun 2024 – Sep 2025',
  },
  {
    org: 'DAVIAN Lab, KAIST',
    url: 'https://davian.kaist.ac.kr/',
    role: 'Research Intern — 3D AI research',
    advisor: 'Jaegul Choo, Taewoong Kang',
    meta: 'Seongnam, Korea | Dec 2023 – Mar 2024',
  },
  {
    org: 'Whatcon',
    role: 'Blockchain Engineer — smart contract & mainnet development',
    meta: 'Seoul, Korea | Sep 2023 – Jan 2024',
  },
  {
    org: 'Republic of Korea Army',
    role: 'Sergeant, TOD Operator (military service)',
    meta: 'Sep 2021 – Mar 2023',
  },
];

const education = [
  {
    org: 'Sungkyunkwan University',
    role: 'B.S.–M.S. Combined, Graduate School of Electrical and Computer Engineering',
    extra: 'Intelligent & Resource-efficient Image processing & Systems design (IRIS) Lab | Prof. Jong Hwan Ko',
    meta: '2025 – present',
  },
  {
    org: 'Sungkyunkwan University',
    role: 'B.S. in Electronic and Electrical Engineering (Magna Cum Laude)',
    meta: '2020 – 2026',
  },
];

const awards = [
  {
    name: 'Best Project Award — SKKU Capstone Design Project',
    extra: 'FPGA-accelerated image super-resolution (FSRCNN) for hardware-software co-acceleration',
    meta: 'Sungkyunkwan University | Jun 2025',
  },
  {
    name: "Dean's List — College of Information and Communication Engineering",
    meta: 'Sungkyunkwan University | Fall 2023, Fall 2024',
  },
  {
    name: 'Excellence Prize — 2023 Metaverse Developer Competition',
    extra: "Personalized NFT metaverse gallery 'BID:AM'",
    meta: 'Ministry of Science and ICT, Republic of Korea | Oct 2023',
  },
  {
    name: 'Encouragement Prize — 2023 Blockchain Challenge for Solving Difficult Problems',
    meta: 'Ministry of Science and ICT, Republic of Korea | Aug 2023',
  },
];
---

<Base
  title="About — Junwon Lee"
  description="Junwon Lee — B.S.–M.S. combined student at IRIS Lab, Sungkyunkwan University. Training-free acceleration of diffusion LLMs, KV-cache compression, quantization, and efficient inference systems."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Junwon Lee',
    alternateName: '이준원',
    url: 'https://romaanj.github.io/about/',
    email: 'jwlee1218@g.skku.edu',
    affiliation: {
      '@type': 'Organization',
      name: 'IRIS Lab, Sungkyunkwan University',
      url: 'https://iris.skku.edu/',
    },
    alumniOf: 'Sungkyunkwan University',
    award: [
      'Best Project Award, SKKU Capstone Design Project (2025)',
      "Dean's List, College of Information and Communication Engineering, SKKU (Fall 2023, Fall 2024)",
      'Excellence Prize, 2023 Metaverse Developer Competition (Ministry of Science and ICT)',
    ],
    sameAs: [
      'https://github.com/Romaanj',
      'https://www.linkedin.com/in/junwon-lee-961383204/',
      'https://iris.skku.edu/authors/m29_junwon_lee/',
    ],
    knowsAbout: ['diffusion LLMs', 'KV-cache compression', 'quantization', 'efficient inference'],
  }}
>
  <!-- hero -->
  <section class="section hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">About me</p>
        <h1>Hi, I'm Junwon.</h1>
        <p class="lede">
          I work on efficient inference for large models at IRIS Lab,
          Sungkyunkwan University — where AI meets hardware.
        </p>
        <p class="interest-tags">
          <span class="tag">Diffusion LLMs</span>
          <span class="tag">KV-cache compression</span>
          <span class="tag">Quantization</span>
          <span class="tag">HW-SW co-optimization</span>
        </p>
      </div>

      <!-- decorative monogram (replaced by /profile.jpg on the home page when added) -->
      <div class="monogram-wrap" aria-hidden="true">
        <svg class="monogram" viewBox="0 0 240 240" xmlns="http://www.w3.org/2000/svg" role="img">
          <rect x="4" y="4" width="232" height="232" rx="24" class="mg-ground" />
          <path d="M 236 236 L 236 140 A 96 96 0 0 0 140 236 Z" class="mg-coral" />
          <circle cx="52" cy="188" r="14" class="mg-olive" />
          <path d="M 178 44 L 206 92 L 150 92 Z" class="mg-kraft" />
          <text x="46" y="132" class="mg-letters">JL</text>
          <path d="M 46 158 L 118 150 L 194 150" class="mg-roofline" />
        </svg>
      </div>
    </div>
  </section>

  <!-- experience -->
  <section class="section-tight">
    <div class="container">
      <h2 class="cv-h">Experience</h2>
      <ul class="cv-list">
        {experience.map((e) => (
          <li>
            <h3>
              {e.url ? (
                <a class="cv-org-link" href={e.url} target="_blank" rel="noopener">{e.org}</a>
              ) : (
                e.org
              )}
            </h3>
            <p class="cv-role">{e.role}</p>
            {e.advisor && <p class="cv-advisor">Advisor: {e.advisor}</p>}
            <p class="cv-meta">{e.meta}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- education -->
  <section class="section-tight">
    <div class="container">
      <h2 class="cv-h">Education</h2>
      <ul class="cv-list">
        {education.map((e) => (
          <li>
            <h3>{e.org}</h3>
            <p class="cv-role">{e.role}</p>
            {e.extra && <p class="cv-role">{e.extra}</p>}
            <p class="cv-meta">{e.meta}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- awards -->
  <section class="section-tight">
    <div class="container">
      <h2 class="cv-h">Awards</h2>
      <ul class="cv-list">
        {awards.map((a) => (
          <li>
            <h3>{a.name}</h3>
            {a.extra && <p class="cv-role">{a.extra}</p>}
            <p class="cv-meta">{a.meta}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- contact -->
  <section class="section contact">
    <div class="container">
      <div class="contact-row">
        <div>
          <p class="eyebrow">Contact</p>
          <h2>Say hello</h2>
          <p class="contact-note">
            Happy to talk about efficient inference, diffusion LLMs, or GPU
            systems.
          </p>
        </div>
        <div class="contact-actions">
          <a class="btn" href="mailto:jwlee1218@g.skku.edu">Email me</a>
          <a class="btn ghost" href="https://github.com/Romaanj" target="_blank" rel="noopener">GitHub — Romaanj</a>
          <a class="btn ghost" href="https://iris.skku.edu/authors/m29_junwon_lee/" target="_blank" rel="noopener">IRIS Lab profile</a>
          <a class="btn ghost" href="https://www.linkedin.com/in/junwon-lee-961383204/" target="_blank" rel="noopener">LinkedIn</a>
          <a class="arrow-link" href="/study/">See what I'm studying</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: clamp(3.5rem, 9vw, 7rem); }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 250px;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .lede { margin-top: 1.6rem; }
  .interest-tags { display: flex; flex-wrap: wrap; gap: 0.45rem; margin: 1.4rem 0 0; }

  /* monogram */
  .monogram-wrap { justify-self: end; }
  .monogram { display: block; width: 100%; max-width: 250px; }
  .mg-ground { fill: var(--surface-warm); stroke: var(--line); stroke-width: 1.5; }
  .mg-coral { fill: var(--accent); }
  .mg-olive { fill: var(--swatch-olive); }
  .mg-kraft { fill: var(--swatch-kraft); }
  .mg-letters {
    font-family: 'Source Serif 4 Variable', Georgia, serif;
    font-size: 92px;
    font-weight: 600;
    fill: var(--text);
    letter-spacing: 0.02em;
  }
  .mg-roofline {
    fill: none;
    stroke: var(--accent-strong);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* cv-style lists (Experience / Education / Awards) */
  .cv-h {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    margin-bottom: 1.6rem;
  }
  .cv-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 760px;
  }
  .cv-list li { padding: 0 0 1.7rem; }
  .cv-list li:last-child { padding-bottom: 0.4rem; }
  .cv-list h3 { font-size: 1.18rem; margin-bottom: 0.25rem; }
  .cv-role {
    margin: 0 0 0.15rem;
    font-size: 0.96rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }
  .cv-org-link { color: inherit; }
  .cv-org-link:hover { color: var(--accent-strong); }
  .cv-advisor {
    margin: 0 0 0.15rem;
    font-size: 0.9rem;
    color: var(--text-tertiary);
  }
  .cv-meta {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-tertiary);
  }

  /* contact */
  .contact-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .contact-note { color: var(--text-secondary); max-width: 34em; margin-top: 1rem; }
  .contact-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
  }

  @media (max-width: 760px) {
    .hero-grid { grid-template-columns: 1fr; }
    .monogram-wrap { justify-self: start; }
    .monogram { max-width: 180px; }
  }
</style>
