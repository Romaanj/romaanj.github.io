---
import Base from '../../../layouts/Base.astro';

// Build-time geometry for the A100 die map (renders to static HTML, no JS needed).
// 108 SMs drawn as two banks of 54 (9 cols x 6 rows) around the L2 band.
const smCols = 9;
const smRows = 6;
const cellW = 71.1;
const cellH = 26.5;
const banks = [{ y0: 36 }, { y0: 272 }];
const sms: { id: number; x: number; y: number }[] = [];
let n = 0;
for (const bank of banks) {
  for (let r = 0; r < smRows; r++) {
    for (let c = 0; c < smCols; c++) {
      sms.push({ id: n++, x: 106 + c * cellW, y: bank.y0 + r * cellH });
    }
  }
}
---

<Base
  title="GPU Memory Hierarchy — Junwon Lee"
  description="An interactive tour of where bytes live on an NVIDIA A100 — die map, memory-hierarchy ladder, interactive roofline, and one decode step traced — and why LLM decode is memory-bound."
>
  <section class="section hero">
    <div class="container">
      <p class="eyebrow">Study · GPU · Interactive</p>
      <h1>Where the bytes live,<br /><em>and why decode waits for them.</em></h1>
      <p class="lede">
        A datacenter GPU is a small city built around one shortage: bytes per second.
        This is a guided tour of the NVIDIA A100-40GB — the floorplan, the memory ladder,
        the roofline, and a single LLM decode step traced byte by byte — ending at the
        number that rules inference: <span class="mono-inline">14&nbsp;GB ÷ 1.55&nbsp;TB/s ≈ 9&nbsp;ms per token</span>.
      </p>
      <div class="spec-strip" aria-label="A100-40GB key specs">
        <div class="spec"><span class="spec-num">108</span><span class="spec-label">SMs</span></div>
        <div class="spec"><span class="spec-num">312</span><span class="spec-label">TFLOP/s BF16 (dense)</span></div>
        <div class="spec"><span class="spec-num">40 MB</span><span class="spec-label">L2 cache</span></div>
        <div class="spec"><span class="spec-num">40 GB</span><span class="spec-label">HBM2e</span></div>
        <div class="spec"><span class="spec-num">1.555 TB/s</span><span class="spec-label">HBM bandwidth</span></div>
        <div class="spec"><span class="spec-num">≈200</span><span class="spec-label">FLOP/byte ridge point</span></div>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="viz-frame explorer">
        <div class="views" role="tablist" aria-label="Explorer views">
          <button class="btn view-btn is-active" data-view="die">① Die map</button>
          <button class="btn ghost view-btn" data-view="ladder">② Hierarchy ladder</button>
          <button class="btn ghost view-btn" data-view="roofline">③ Roofline</button>
          <button class="btn ghost view-btn" data-view="trace">④ One decode step</button>
        </div>

        <!-- ============ VIEW A · DIE MAP ============ -->
        <div class="panel" id="panel-die" data-panel="die">
          <div class="panel-head">
            <h3>The floorplan: compute is an island, memory is the ocean around it</h3>
            <p class="panel-sub">Simplified A100 die. Hover any region for its numbers; <strong>click an SM</strong> to zoom into its internals on the right.</p>
          </div>
          <div class="die-grid">
            <div class="die-svg-wrap">
              <svg viewBox="0 0 860 460" width="100%" style="min-width: 640px" role="img" aria-label="Simplified A100 floorplan: HBM stacks flanking a die with 108 SMs and a 40MB L2 band">
                <!-- HBM stacks, left -->
                {[30, 175, 320].map((y) => (
                  <g class="region hbm" data-info="hbm">
                    <rect x="14" y={y} width="60" height="115" rx="6" class="hbm-rect" />
                    <text x="44" y={y + 62} class="svg-label vert" transform={`rotate(-90 44 ${y + 62})`}>HBM2e</text>
                  </g>
                ))}
                <!-- HBM stacks, right -->
                {[30, 175, 320].map((y) => (
                  <g class="region hbm" data-info="hbm">
                    <rect x="786" y={y} width="60" height="115" rx="6" class="hbm-rect" />
                    <text x="816" y={y + 62} class="svg-label vert" transform={`rotate(-90 816 ${y + 62})`}>HBM2e</text>
                  </g>
                ))}
                <!-- die outline -->
                <rect x="90" y="10" width="680" height="440" rx="10" class="die-rect" />
                <!-- SM banks -->
                {sms.map((sm) => (
                  <rect
                    x={sm.x} y={sm.y} width="63" height="20" rx="3"
                    class="sm region" data-info="sm" data-sm={sm.id}
                  />
                ))}
                <!-- L2 band -->
                <g class="region l2" data-info="l2">
                  <rect x="106" y="202" width="310" height="48" rx="5" class="l2-rect" />
                  <text x="261" y="231" class="svg-label mid">L2 · 20 MB partition</text>
                </g>
                <g class="region l2" data-info="l2">
                  <rect x="428" y="202" width="310" height="48" rx="5" class="l2-rect" />
                  <text x="583" y="231" class="svg-label mid">L2 · 20 MB partition</text>
                </g>
                <!-- interconnect hint lines -->
                <line x1="74" y1="230" x2="90" y2="230" class="wire" />
                <line x1="770" y1="230" x2="786" y2="230" class="wire" />
              </svg>
            </div>
            <div class="die-side">
              <div class="info-card" id="die-info">
                <span class="card-kicker" id="die-info-kicker">A100-40GB die</span>
                <h4 id="die-info-title">826 mm² of silicon, one bottleneck</h4>
                <p id="die-info-body">
                  108 streaming multiprocessors (SMs) share a 40 MB L2 cache and five active
                  HBM2e stacks delivering 1.555 TB/s. Every weight an LLM touches must cross
                  from the flanking HBM into this island — hover a region to see its numbers.
                </p>
              </div>
              <div class="sm-detail">
                <span class="card-kicker">Inside one SM <span id="sm-detail-which">(click any SM)</span></span>
                <svg viewBox="0 0 400 310" width="100%" role="img" aria-label="Inside one A100 SM: four processing blocks with warp scheduler, register file and tensor core, above a combined 192KB L1/shared memory">
                  <rect x="4" y="4" width="392" height="302" rx="8" class="smd-outline" />
                  {[0, 1, 2, 3].map((i) => (
                    <g transform={`translate(${12 + i * 96}, 14)`}>
                      <rect x="0" y="0" width="88" height="196" rx="5" class="smd-block" />
                      <rect x="6" y="8" width="76" height="26" rx="3" class="smd-sched" />
                      <text x="44" y="25" class="svg-label tiny mid">warp sched</text>
                      <rect x="6" y="40" width="76" height="40" rx="3" class="smd-rf" />
                      <text x="44" y="57" class="svg-label tiny mid">register file</text>
                      <text x="44" y="72" class="svg-label tiny mid strong">64 KB</text>
                      <rect x="6" y="86" width="76" height="52" rx="3" class="smd-cores" />
                      <text x="44" y="106" class="svg-label tiny mid">FP32 / INT32</text>
                      <text x="44" y="121" class="svg-label tiny mid">FP64 lanes</text>
                      <rect x="6" y="144" width="76" height="44" rx="3" class="smd-tc" />
                      <text x="44" y="162" class="svg-label tiny mid on-accent">Tensor Core</text>
                      <text x="44" y="177" class="svg-label tiny mid on-accent">3rd gen</text>
                    </g>
                  ))}
                  <rect x="12" y="220" width="376" height="42" rx="5" class="smd-smem" />
                  <text x="200" y="238" class="svg-label mid">L1 data cache + shared memory · 192 KB combined</text>
                  <text x="200" y="254" class="svg-label mid tiny">(up to 164 KB configurable as shared memory)</text>
                  <rect x="12" y="270" width="180" height="26" rx="5" class="smd-misc" />
                  <text x="102" y="287" class="svg-label tiny mid">LD/ST units</text>
                  <rect x="208" y="270" width="180" height="26" rx="5" class="smd-misc" />
                  <text x="298" y="287" class="svg-label tiny mid">SFU · Tex</text>
                </svg>
                <p class="sm-detail-caption">
                  Per SM: 4 processing blocks, each with a warp scheduler, a 64 KB register-file
                  partition (256 KB total) and one tensor core (4 per SM, 432 on the die).
                  All four share 192 KB of combined L1/shared storage — up to 164 KB usable
                  as software-managed shared memory.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- ============ VIEW B · HIERARCHY LADDER ============ -->
        <div class="panel" id="panel-ladder" data-panel="ladder">
          <div class="panel-head">
            <h3>The ladder: every step up costs ~1000× capacity, buys ~10× speed</h3>
            <p class="panel-sub">Log-scale bars — equal visual steps are multiplicative. Hover a level for what actually fits there during LLM inference.</p>
          </div>
          <div class="ladder">
            <div class="ladder-legend">
              <span><i class="sw sw-cap"></i> capacity</span>
              <span><i class="sw sw-bw"></i> aggregate bandwidth</span>
              <span><i class="sw sw-lat"></i> latency (shorter is better)</span>
            </div>

            <div class="rung" tabindex="0">
              <div class="rung-head">
                <span class="rung-name">Registers</span>
                <span class="rung-where">inside each SM partition</span>
              </div>
              <div class="bars">
                <div class="bar-row"><span class="bar cap" style="width:29%"></span><span class="bar-val">256 KB / SM · ≈27 MB on die</span></div>
                <div class="bar-row"><span class="bar bw" style="width:92%"></span><span class="bar-val">≈100+ TB/s-class operand rate</span></div>
                <div class="bar-row"><span class="bar lat" style="width:13%"></span><span class="bar-val">≈1–2 cycles (≈1 ns)</span></div>
              </div>
              <div class="rung-fits">
                <strong>What fits:</strong> only the accumulator fragments of the tile being
                multiplied <em>right now</em> — each thread holds a few dozen 32-bit values.
                Fun fact: the die-wide register file (≈27 MB) is two-thirds the size of L2,
                and orders of magnitude faster.
              </div>
            </div>

            <div class="rung" tabindex="0">
              <div class="rung-head">
                <span class="rung-name">Shared memory / L1</span>
                <span class="rung-where">per SM, software-managed</span>
              </div>
              <div class="bars">
                <div class="bar-row"><span class="bar cap" style="width:25%"></span><span class="bar-val">192 KB combined / SM (≤164 KB shared) · ≈17.7 MB usable die-wide</span></div>
                <div class="bar-row"><span class="bar bw" style="width:64%"></span><span class="bar-val">≈19.5 TB/s aggregate (128 B/clk × 108 SMs)</span></div>
                <div class="bar-row"><span class="bar lat" style="width:36%"></span><span class="bar-val">≈20–30 cycles (≈20 ns)</span></div>
              </div>
              <div class="rung-fits">
                <strong>What fits:</strong> the working tiles of a GEMM. A 128×128 FP16 tile is
                32 KB, so double-buffered A- and B-tiles plus pipeline stages fill it. That's
                ~0.0005% of a 7B model resident at once — everything else must stream.
              </div>
            </div>

            <div class="rung" tabindex="0">
              <div class="rung-head">
                <span class="rung-name">L2 cache</span>
                <span class="rung-where">shared, two 20 MB partitions</span>
              </div>
              <div class="bars">
                <div class="bar-row"><span class="bar cap" style="width:32%"></span><span class="bar-val">40 MB</span></div>
                <div class="bar-row"><span class="bar bw" style="width:43%"></span><span class="bar-val">several TB/s aggregate (microbenchmarks: ~3–7 TB/s, access-pattern dependent)</span></div>
                <div class="bar-row"><span class="bar lat" style="width:68%"></span><span class="bar-val">≈200+ cycles (≈150–250 ns; far partition costs more)</span></div>
              </div>
              <div class="rung-fits">
                <strong>What fits:</strong> barely one weight matrix — a single 4096×4096 FP16
                projection is 33.5 MB. Or ~76 tokens' worth of a 7B model's KV cache
                (≈524 KB per token). Weights stream <em>through</em> L2; they cannot live in it.
              </div>
            </div>

            <div class="rung" tabindex="0">
              <div class="rung-head">
                <span class="rung-name">HBM2e</span>
                <span class="rung-where">off-die, five active stacks</span>
              </div>
              <div class="bars">
                <div class="bar-row"><span class="bar cap" style="width:92%"></span><span class="bar-val">40 GB</span></div>
                <div class="bar-row"><span class="bar bw" style="width:25%"></span><span class="bar-val">1.555 TB/s</span></div>
                <div class="bar-row"><span class="bar lat" style="width:89%"></span><span class="bar-val">≈400–500 ns</span></div>
              </div>
              <div class="rung-fits">
                <strong>What fits:</strong> the model itself. A 7B model in FP16 is ~14 GB;
                a 4k-token KV cache adds ~2 GB; the rest is activations, workspace, and
                headroom. This is the <em>only</em> level that holds the weights — which is
                why its 1.555 TB/s, not the 312 TFLOP/s, sets the decode speed limit.
              </div>
            </div>

            <div class="ladder-note">
              Bandwidths are aggregates across the die; per-byte latency is hidden by
              parallelism, but <strong>bandwidth cannot be hidden</strong> — every byte of a
              7B model must physically cross the HBM interface for every generated token.
            </div>
          </div>
        </div>

        <!-- ============ VIEW C · ROOFLINE ============ -->
        <div class="panel" id="panel-roofline" data-panel="roofline">
          <div class="panel-head">
            <h3>The roofline: two ceilings, and decode lives under the slanted one</h3>
            <p class="panel-sub">
              Achievable FLOP/s = min(peak compute, bandwidth × arithmetic intensity). Log–log axes.
              Drag the batch slider and switch weight precision to move the ● marker.
            </p>
          </div>
          <div class="roofline-grid">
            <div class="roofline-svg-wrap">
              <svg id="roofline-svg" viewBox="0 0 760 452" width="100%" style="min-width: 640px" role="img" aria-label="Roofline for the A100: memory-bound slope of 1.555 terabytes per second meeting a 312 teraflop compute roof at about 200 flop per byte">
                <!-- memory-bound shading -->
                <polygon points="60,400 60,379.2 574.6,63.4 574.6,400" class="rf-shade" />
                <!-- gridlines x: AI 0.25..1024 (powers of 4) -->
                <g class="rf-grid">
                  <line x1="166.7" y1="40" x2="166.7" y2="400" /><line x1="273.3" y1="40" x2="273.3" y2="400" />
                  <line x1="380" y1="40" x2="380" y2="400" /><line x1="486.7" y1="40" x2="486.7" y2="400" />
                  <line x1="593.3" y1="40" x2="593.3" y2="400" /><line x1="700" y1="40" x2="700" y2="400" />
                  <line x1="60" y1="334.5" x2="700" y2="334.5" /><line x1="60" y1="269.1" x2="700" y2="269.1" />
                  <line x1="60" y1="203.6" x2="700" y2="203.6" /><line x1="60" y1="138.2" x2="700" y2="138.2" />
                  <line x1="60" y1="72.7" x2="700" y2="72.7" />
                </g>
                <!-- axes -->
                <line x1="60" y1="400" x2="700" y2="400" class="rf-axis" />
                <line x1="60" y1="40" x2="60" y2="400" class="rf-axis" />
                <g class="rf-ticks">
                  <text x="60" y="418">0.25</text><text x="166.7" y="418">1</text><text x="273.3" y="418">4</text>
                  <text x="380" y="418">16</text><text x="486.7" y="418">64</text><text x="593.3" y="418">256</text>
                  <text x="700" y="418">1024</text>
                  <text x="52" y="404" class="ty">0.25</text><text x="52" y="338" class="ty">1</text>
                  <text x="52" y="273" class="ty">4</text><text x="52" y="208" class="ty">16</text>
                  <text x="52" y="142" class="ty">64</text><text x="52" y="77" class="ty">256</text>
                </g>
                <text x="380" y="444" class="rf-axis-label">arithmetic intensity — FLOP / byte from HBM (log)</text>
                <text x="18" y="220" class="rf-axis-label" transform="rotate(-90 18 220)">achievable TFLOP/s (log)</text>
                <!-- roofs -->
                <line x1="60" y1="379.2" x2="574.6" y2="63.4" class="rf-mem-roof" />
                <line x1="574.6" y1="63.4" x2="700" y2="63.4" class="rf-comp-roof" />
                <text x="235" y="240" class="rf-roof-label" transform="rotate(-31.5 235 240)">HBM roof · 1.555 TB/s × AI</text>
                <text x="637" y="55" class="rf-roof-label comp">312 TFLOP/s BF16</text>
                <!-- ridge -->
                <line x1="574.6" y1="63.4" x2="574.6" y2="400" class="rf-ridge" />
                <text x="574.6" y="392" class="rf-ridge-label">ridge ≈ 200 FLOP/B</text>
                <!-- fixed workload markers -->
                <g class="rf-marker" data-rf="prefill">
                  <circle cx="658.9" cy="68.4" r="7" class="mk mk-prefill" />
                  <text x="658.9" y="90" class="mk-label">prefill GEMM</text>
                </g>
                <g class="rf-marker" data-rf="decode1">
                  <circle cx="166.7" cy="313.7" r="7" class="mk mk-decode" />
                  <text x="166.7" y="300" class="mk-label">decode GEMV, B=1</text>
                </g>
                <g class="rf-marker" data-rf="attn">
                  <circle cx="149.5" cy="324.2" r="7" class="mk mk-attn" />
                  <text x="149.5" y="346" class="mk-label">attention · long KV</text>
                </g>
                <!-- movable batch marker (JS) -->
                <g id="rf-batch" class="rf-marker live">
                  <circle id="rf-batch-dot" cx="326.7" cy="215.5" r="9" class="mk mk-batch" />
                  <text id="rf-batch-label" x="326.7" y="200" class="mk-label strong">batched decode · B=8</text>
                </g>
              </svg>
            </div>
            <div class="roofline-side">
              <div class="ctrl-block">
                <span class="ctrl-label">Batch size B (weights amortize, AI ≈ B × FLOP-per-weight-byte)</span>
                <input type="range" id="batch-slider" min="0" max="9" step="1" value="3" aria-label="Batch size, powers of two from 1 to 512" />
                <div class="ctrl-scale"><span>1</span><span>8</span><span>64</span><span>512</span></div>
              </div>
              <div class="ctrl-block">
                <span class="ctrl-label">Weight precision (weight-only quantization)</span>
                <div class="quant-btns">
                  <button class="tag quant-btn is-active" data-bpw="2">FP16 · 2 B/w</button>
                  <button class="tag quant-btn" data-bpw="1">INT8 · 1 B/w</button>
                  <button class="tag quant-btn" data-bpw="0.5">INT4 · 0.5 B/w</button>
                </div>
              </div>
              <div class="readout" id="rf-readout">
                <div class="ro-row"><span>Arithmetic intensity</span><strong id="ro-ai">≈ 8 FLOP/B</strong></div>
                <div class="ro-row"><span>Achievable</span><strong id="ro-tflops">≈ 12.4 TFLOP/s (4.0% of peak)</strong></div>
                <div class="ro-row"><span>Aggregate decode ceiling</span><strong id="ro-toks">≈ 889 tok/s (8 seq × 111)</strong></div>
                <div class="ro-row"><span>Regime</span><strong id="ro-regime" class="regime mem">memory-bound</strong></div>
              </div>
              <div class="divider-math" id="rf-division">
                <span class="dm-title">The division that sets the ceiling (per sequence)</span>
                <code id="dm-code">14 GB weights ÷ 1.555 TB/s ≈ 9.0 ms/token → ~111 tok/s</code>
                <p id="dm-note">
                  At B=1 every generated token must read <em>all</em> weights once. Quantize
                  FP16→INT4 and the same division reads 3.5 GB ÷ 1.555 TB/s ≈ 2.3 ms → ~440 tok/s:
                  compression is a bandwidth multiplier, not a compute trick.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- ============ VIEW D · ONE DECODE STEP ============ -->
        <div class="panel" id="panel-trace" data-panel="trace">
          <div class="panel-head">
            <h3>One decode step, traced: 15.4 GB in, one token out</h3>
            <p class="panel-sub">
              Llama-7B-class model (d=4096, 32 layers, FFN 11008, vocab 32k), FP16, 4096 tokens
              of context, batch 1. Step through what actually moves.
            </p>
          </div>
          <div class="trace-grid">
            <div class="trace-svg-wrap">
              <svg viewBox="0 0 760 350" width="100%" style="min-width: 640px" role="img" aria-label="Data flow of one decode step: weights and KV cache stream from HBM through L2 into the SM, activations stay in shared memory and registers">
                <!-- HBM -->
                <g id="tr-hbm" class="tr-box">
                  <rect x="16" y="36" width="158" height="272" rx="10" class="tr-hbm-rect" />
                  <text x="95" y="62" class="svg-label mid strong">HBM · 40 GB</text>
                  <rect x="30" y="76" width="130" height="98" rx="6" class="tr-res weights" />
                  <text x="95" y="116" class="svg-label mid">weights</text>
                  <text x="95" y="134" class="svg-label mid tiny">13.5 GB FP16</text>
                  <rect x="30" y="184" width="130" height="62" rx="6" class="tr-res kv" />
                  <text x="95" y="210" class="svg-label mid">KV cache</text>
                  <text x="95" y="228" class="svg-label mid tiny">2.15 GB @ 4k ctx</text>
                  <rect x="30" y="256" width="130" height="38" rx="6" class="tr-res acts" />
                  <text x="95" y="280" class="svg-label mid tiny">activations (tiny)</text>
                </g>
                <!-- L2 -->
                <g id="tr-l2" class="tr-box">
                  <rect x="234" y="118" width="92" height="110" rx="8" class="tr-l2-rect" />
                  <text x="280" y="166" class="svg-label mid">L2</text>
                  <text x="280" y="184" class="svg-label mid tiny">40 MB</text>
                </g>
                <!-- SM island -->
                <g id="tr-sm" class="tr-box">
                  <rect x="392" y="36" width="352" height="272" rx="10" class="tr-sm-rect" />
                  <text x="568" y="62" class="svg-label mid strong">108 SMs</text>
                  <rect x="410" y="78" width="150" height="90" rx="6" class="tr-smem" />
                  <text x="485" y="112" class="svg-label mid tiny">SMEM / L1</text>
                  <text x="485" y="128" class="svg-label mid tiny">activation x[1×4096]</text>
                  <text x="485" y="144" class="svg-label mid tiny">= 8 KB, stays here</text>
                  <rect x="578" y="78" width="150" height="90" rx="6" class="tr-regs" />
                  <text x="653" y="112" class="svg-label mid tiny">registers</text>
                  <text x="653" y="128" class="svg-label mid tiny">accumulators</text>
                  <rect x="410" y="188" width="318" height="100" rx="6" class="tr-tc" />
                  <text x="569" y="228" class="svg-label mid on-accent">tensor cores</text>
                  <text x="569" y="248" class="svg-label mid tiny on-accent" id="tr-tc-note">≈2 FLOPs per weight byte-pair, then the weight is discarded</text>
                </g>
                <!-- streaming paths -->
                <path id="tr-path-w" class="tr-path" d="M 174 125 C 210 125, 210 148, 234 148 L 326 148 C 360 148, 360 120, 392 120" />
                <path id="tr-path-kv" class="tr-path" d="M 174 214 C 208 214, 210 198, 234 198 L 326 198 C 360 198, 360 236, 392 236" />
