    },
    hbm: {
      k: 'HBM2e stack',
      t: '8 GB per stack · 1.555 TB/s aggregate',
      b: 'Five active stacks (a sixth site exists but is disabled on the 40 GB part) sit on the interposer beside the die, ~400–500 ns away. This is the only level that holds a model: 13.5 GB of FP16 weights, plus KV cache. Split evenly, each SM’s fair share of bandwidth is ~14 GB/s.',
    },
    l2: {
      k: 'L2 cache partition',
      t: '20 MB × 2 · ~200+ cycles',
      b: '40 MB total in two partitions joined by a crossbar, with several TB/s of aggregate throughput. But one 4096×4096 FP16 projection is already 33.5 MB — weights stream through L2; they cannot live in it.',
    },
    sm: {
      k: 'Streaming multiprocessor',
      t: '1 of 108 · 4 tensor cores each',
      b: 'Per SM: 4 warp schedulers, a 256 KB register file, 192 KB combined L1/shared (up to 164 KB shared). All 108 together deliver 312 dense BF16 TFLOP/s — the machine can do ~200 FLOPs in the time it takes HBM to deliver one byte.',
    },
  } as const;
  const infoK = document.getElementById('die-info-kicker');
  const infoT = document.getElementById('die-info-title');
  const infoB = document.getElementById('die-info-body');
  function setInfo(key: keyof typeof dieInfo) {
    const d = dieInfo[key];
    if (infoK) infoK.textContent = d.k;
    if (infoT) infoT.textContent = d.t;
    if (infoB) infoB.textContent = d.b;
  }
  const dieSvg = document.querySelector('#panel-die svg');
  dieSvg?.addEventListener('mouseover', (e) => {
    const region = (e.target as Element).closest<SVGElement>('.region');
    if (region?.dataset.info) setInfo(region.dataset.info as keyof typeof dieInfo);
  });
  dieSvg?.addEventListener('mouseleave', () => setInfo('default'));
  dieSvg?.addEventListener('click', (e) => {
    const sm = (e.target as Element).closest<SVGElement>('.sm');
    if (!sm) return;
    dieSvg.querySelectorAll('.sm.is-selected').forEach((el) => el.classList.remove('is-selected'));
    sm.classList.add('is-selected');
    const which = document.getElementById('sm-detail-which');
    if (which) which.textContent = `— SM #${Number(sm.dataset.sm) + 1} of 108`;
    setInfo('sm');
  });

  // ============ view C · roofline ============
  const BW = 1.555; // TB/s
  const PEAK = 312; // TFLOP/s
  const RIDGE = PEAK / (BW * 1000) * 1000; // ≈ 200.6 FLOP/B
  const X0 = 60, PX_OCT_X = 53.333, Y0 = 400, PX_OCT_Y = 32.727;
  const xpx = (ai: number) => X0 + (Math.log2(ai) + 2) * PX_OCT_X;
  const ypx = (t: number) => Y0 - (Math.log2(t) + 2) * PX_OCT_Y;
  let bpw = 2; // bytes per weight
  const slider = document.getElementById('batch-slider') as HTMLInputElement | null;
  const fmtInt = (x: number) => Math.round(x).toLocaleString('en-US');

  const dmText: Record<string, { code: string }> = {
    '2':   { code: '14 GB weights ÷ 1.555 TB/s ≈ 9.0 ms/token → ~111 tok/s' },
    '1':   { code: '7 GB weights ÷ 1.555 TB/s ≈ 4.5 ms/token → ~222 tok/s' },
    '0.5': { code: '3.5 GB weights ÷ 1.555 TB/s ≈ 2.3 ms/token → ~444 tok/s' },
  };

  function renderRoofline() {
    if (!slider) return;
    const B = 2 ** Number(slider.value);
    const ai = Math.min(B * (2 / bpw), 1024);
    const t = Math.min(BW * ai, PEAK);
    const modelGB = 14 * (bpw / 2);
    const perSeq = 1555 / modelGB;
    const compCap = (PEAK * 1e12) / 14e9; // FLOP roof / ~14 GFLOP per token
    const toks = Math.min(B * perSeq, compCap);
    const dot = document.getElementById('rf-batch-dot');
    const lab = document.getElementById('rf-batch-label');
    const cx = xpx(ai), cy = ypx(t);
    dot?.setAttribute('cx', String(cx));
    dot?.setAttribute('cy', String(cy));
    lab?.setAttribute('x', String(Math.min(cx, 630)));
    lab?.setAttribute('y', String(Math.max(cy - 16, 52)));
    if (lab) lab.textContent = `batched decode · B=${B}`;
    const set = (id: string, txt: string) => { const el = document.getElementById(id); if (el) el.textContent = txt; };
    set('ro-ai', `≈ ${ai < 10 ? ai.toFixed(1) : fmtInt(ai)} FLOP/B`);
    set('ro-tflops', `≈ ${t < 10 ? t.toFixed(2) : t < 100 ? t.toFixed(1) : t.toFixed(0)} TFLOP/s (${((t / PEAK) * 100).toFixed(1)}% of peak)`);
    set('ro-toks', toks >= compCap - 1
      ? `≈ ${fmtInt(compCap)} tok/s (compute roof)`
      : `≈ ${fmtInt(toks)} tok/s (${B} seq × ${fmtInt(perSeq)})`);
    const reg = document.getElementById('ro-regime');
    if (reg) {
      const mem = ai < RIDGE;
      reg.textContent = mem ? 'memory-bound' : 'compute-bound';
      reg.classList.toggle('mem', mem);
      reg.classList.toggle('comp', !mem);
    }
    const dm = document.getElementById('dm-code');
    if (dm) dm.textContent = dmText[String(bpw)].code;
  }
  slider?.addEventListener('input', renderRoofline);
  document.querySelectorAll<HTMLButtonElement>('.quant-btn').forEach((qb) => {
    qb.addEventListener('click', () => {
      document.querySelectorAll('.quant-btn').forEach((x) => x.classList.remove('is-active'));
      qb.classList.add('is-active');
      bpw = Number(qb.dataset.bpw);
      renderRoofline();
    });
  });
  renderRoofline();

  // ============ view D · decode trace ============
  type Step = { bytes: number; flops: number; cap: string; paths: string[]; flow: string };
  const MB = 1e6, GB = 1e9;
  const steps: Step[] = [
    { bytes: 0, flops: 0, paths: [], flow: 'idle — waiting for a token',
      cap: 'A new token needs to be generated. The entire model sits in HBM; the “state” the GPU actually computes on — one 4096-long activation vector — is 8 KB. Press <strong>Next</strong> (or Play) to watch what has to move.' },
    { bytes: 8.2e3, flops: 0, paths: ['w'], flow: 'embedding row → SMEM',
      cap: 'Embedding lookup: one row of <span class="shape">E[32000×4096]</span> — 4096 FP16 values, 8 KB. The activation <span class="shape">x[1×4096]</span> now lives on-die in SMEM/registers for the whole step.' },
    { bytes: 134.2 * MB, flops: 134.2e6, paths: ['w'], flow: 'layer 1: Wq Wk Wv Wo streaming',
      cap: 'Layer 1 attention projections: <span class="shape">x[1×4096] × W{q,k,v,o}[4096×4096]</span>. Four 33.6 MB matrices stream in; each FP16 weight is used for exactly 2 FLOPs, then discarded. This is a GEMV: arithmetic intensity ≈ 1 FLOP/byte.' },
    { bytes: 67.1 * MB, flops: 67.1e6, paths: ['kv'], flow: 'layer 1: KV cache read + append',
      cap: 'Attention over history: <span class="shape">q · Kᵀ[4096 tok × 4096]</span>, then <span class="shape">scores × V</span> — 67 MB of layer-1 KV cache read, +2 KB appended. Also AI ≈ 1, and unlike weights, batching does <em>not</em> amortize it: every sequence reads its own KV.' },
    { bytes: 270.5 * MB, flops: 270.5e6, paths: ['w'], flow: 'layer 1: MLP weights streaming',
      cap: 'Layer 1 MLP: <span class="shape">W_gate, W_up [4096×11008]</span> and <span class="shape">W_down [11008×4096]</span> — 3 × 90.2 MB = 271 MB. The FFN is roughly two-thirds of all weight bytes in the model.' },
    { bytes: 14.626 * GB, flops: 14.626e9, paths: ['w', 'kv'], flow: 'layers 2–32: same pattern ×31',
      cap: 'Layers 2–32 repeat the identical pattern: 31 more × (134 MB attention weights + 67 MB KV + 271 MB MLP) ≈ 14.6 GB. The activation shuttling between layers never leaves the SMs.' },
    { bytes: 262.1 * MB, flops: 262.1e6, paths: ['w'], flow: 'LM head → logits → one token',
      cap: 'LM head: <span class="shape">h[1×4096] × W[4096×32000]</span> = 262 MB read for 32,000 logits → sample → <strong>one token</strong>. Now do it all again for the next one.' },
    { bytes: 0, flops: 0, paths: [], flow: 'done: 1 token out',
      cap: 'Total: ≈<strong>15.4 GB</strong> crossed the HBM interface to produce ≈<strong>15 GFLOP</strong> of useful math — AI ≈ 1, versus a machine balance point of ≈200. The byte-time floor is ~9.9 ms; the FLOP time would be ~0.05 ms.' },
  ];
  const cumBytes: number[] = []; const cumFlops: number[] = [];
  steps.reduce((a, s, i) => (cumBytes[i] = a + s.bytes), 0);
  steps.reduce((a, s, i) => (cumFlops[i] = a + s.flops), 0);
  const TOTAL_B = cumBytes[cumBytes.length - 1];
  const TOTAL_F = cumFlops[cumFlops.length - 1];
  const fmtBytes = (b: number) =>
    b <= 0 ? '0 B' : b < 1e4 ? `${(b / 1e3).toFixed(1)} KB` : b < GB ? `${(b / MB).toFixed(0)} MB` : `${(b / GB).toFixed(2)} GB`;
  const fmtFlops = (f: number) =>
    f <= 0 ? '0' : f < 1e9 ? `${(f / 1e6).toFixed(0)} MFLOP` : `${(f / 1e9).toFixed(2)} GFLOP`;

  let stepIdx = 0;
  let playTimer: ReturnType<typeof setInterval> | null = null;
  const $ = (id: string) => document.getElementById(id);
  function renderTrace() {
    const s = steps[stepIdx];
    const capEl = $('tr-caption'); if (capEl) capEl.innerHTML = s.cap;
    const num = $('tr-stepnum'); if (num) num.textContent = `step ${stepIdx} / ${steps.length - 1}`;
    $('tr-path-w')?.classList.toggle('is-live', s.paths.includes('w'));
    $('tr-path-kv')?.classList.toggle('is-live', s.paths.includes('kv'));
    const flow = $('tr-flow-label'); if (flow) flow.textContent = s.flow;
    const cb = cumBytes[stepIdx], cf = cumFlops[stepIdx];
    const bv = $('tc-bytes'); if (bv) bv.textContent = fmtBytes(cb);
    const fv = $('tc-flops'); if (fv) fv.textContent = fmtFlops(cf);
    const bb = $('tc-bytes-bar'); if (bb) bb.style.width = `${(cb / TOTAL_B) * 100}%`;
    const fb = $('tc-flops-bar'); if (fb) fb.style.width = `${(cf / TOTAL_F) * 100}%`;
    const tm = $('tc-time-mem'); if (tm) tm.textContent = `${((cb / 1.555e12) * 1e3).toFixed(2)} ms  (@ 1.555 TB/s)`;
    const tc = $('tc-time-comp'); if (tc) tc.textContent = `${((cf / 312e12) * 1e3).toFixed(3)} ms  (@ 312 TFLOP/s)`;
    $('tr-punchline')?.classList.toggle('is-dim', stepIdx !== steps.length - 1);
  }
  function stopPlay() {
    if (playTimer) { clearInterval(playTimer); playTimer = null; }
    const pb = $('tr-play'); if (pb) pb.textContent = '▶ Play';
  }
  $('tr-next')?.addEventListener('click', () => { stopPlay(); stepIdx = Math.min(stepIdx + 1, steps.length - 1); renderTrace(); });
  $('tr-prev')?.addEventListener('click', () => { stopPlay(); stepIdx = Math.max(stepIdx - 1, 0); renderTrace(); });
  $('tr-play')?.addEventListener('click', () => {
    if (playTimer) { stopPlay(); return; }
    if (stepIdx >= steps.length - 1) stepIdx = 0;
    const pb = $('tr-play'); if (pb) pb.textContent = '⏸ Pause';
    renderTrace();
    playTimer = setInterval(() => {
      stepIdx += 1;
      if (stepIdx >= steps.length - 1) stopPlay();
      renderTrace();
    }, 2200);
  });
  renderTrace();
</script>
