<script>
  // ============ view switching ============
  const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('.view-btn'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
  function activate(view: string) {
    for (const b of btns) {
      const on = b.dataset.view === view;
      b.classList.toggle('is-active', on);
      b.classList.toggle('ghost', !on);
    }
    for (const p of panels) p.classList.toggle('is-hidden', p.dataset.panel !== view);
