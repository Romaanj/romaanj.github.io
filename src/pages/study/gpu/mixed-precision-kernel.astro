                  <rect x="70" y="60" width={gX(9.8) - 70} height="18" rx="4" fill="#e6e9df"></rect>
                  <rect x={gX(9.8)} y="60" width={gX(12.5) - gX(9.8)} height="18" fill="#f3e0d8"></rect>
                  <rect x={gX(12.5)} y="60" width={910 - gX(12.5)} height="18" rx="4" fill="#eddad3"></rect>
                  <line x1={gX(9.8)} y1="46" x2={gX(9.8)} y2="92" stroke="var(--accent-strong)" stroke-width="2"></line>
