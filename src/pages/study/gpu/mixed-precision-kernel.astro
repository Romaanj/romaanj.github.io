    opacity: 0;
    transition: opacity 0.15s;
  }
  [data-tip] { cursor: help; }
</style>

<script>
  const page = document.querySelector('.mpk-page');
  if (page) page.classList.add('js');

  const curLang = () => (typeof window.siteLang === 'function' ? window.siteLang() : 'en');
  const pick = (c) => (curLang() === 'ko' ? c.ko : c.en);

  // ============ shared tooltip (bilingual: data-tip / data-tip-ko) ============
  const tip = document.getElementById('mpkTip');
  document.querySelectorAll('[data-tip]').forEach((el) => {
    el.addEventListener('mousemove', (e) => {
      if (!tip) return;
      const ko = el.getAttribute('data-tip-ko');
      tip.textContent = (curLang() === 'ko' && ko ? ko : el.getAttribute('data-tip')) || '';
      tip.style.opacity = '1';
      const x = Math.min(e.clientX + 14, window.innerWidth - 336);
      tip.style.left = x + 'px';
      tip.style.top = e.clientY + 18 + 'px';
    });
    el.addEventListener('mouseleave', () => {
      if (tip) tip.style.opacity = '0';
    });
  });

  // ============ (b) step-through explorer ============
  const root = document.getElementById('mpk-explorer');

  const captions = [
    {
      en: 'One warp issues cp.async loads, 16 bytes per thread, straight from global memory into shared memory — on A100 this bypasses the register file (GA100 whitepaper). The warp’s addresses coalesce into up-to-128-byte transactions built from 32-byte sectors, so aligned, contiguous, 16-byte-per-thread access is the peak-bandwidth pattern. Packing already pays here: the same 128 B carries 64 FP16 elements or 256 INT4 elements.',
      ko: 'warp 하나가 cp.async load를 thread당 16 byte씩 발행한다 — A100에서는 global memory에서 shared memory로 register file을 거치지 않고 직행한다 (GA100 whitepaper). warp의 주소들은 32-byte sector로 구성된 최대 128-byte transaction으로 coalesce되므로, aligned·연속·thread당 16 byte 접근이 최대 대역폭 패턴이다. packing은 여기서 이미 이득이다: 같은 128 B가 FP16이면 64개, INT4면 256개의 element를 나른다.',
    },
    {
      en: 'From shared memory each thread pulls 128 bits into four 32-bit registers; a single register now holds 8 INT4 codes (or 16 INT2). Everything after this point runs in the register file — 256 KB per SM — and competes for the SM’s issue budget: 4 warp schedulers, one instruction per clock each. INT32 and FP32 pipes run concurrently at full rate (GA100), but issue slots are shared.',
      ko: 'shared memory에서 thread마다 128 bit를 32-bit register 4개로 끌어온다; 이제 register 하나에 INT4 code 8개(INT2면 16개)가 들어 있다. 이 지점 이후의 모든 것은 SM당 256 KB의 register file에서 돌며 SM의 issue 예산을 두고 경쟁한다: warp scheduler 4개, 각각 클럭당 instruction 1개. INT32와 FP32 pipe는 full rate로 동시 실행되지만 (GA100), issue slot은 공유다.',
    },
    {
      en: 'The packed word must become separate values. Naive: shift → mask → convert per element — QServe counts ~5 ALU ops each, ≈ 32–40 per 8 elements. Engineered: whole registers at once — one lop3 masks a nibble AND injects the FP16 exponent pattern (MARLIN: naive INT4→FP16 type-casts are slow), prmt places bytes, and with the right offline interleave QServe unpacks a register of INT4 in 3 logic ops. Note what didn’t happen: dropping to INT2 does not shrink this work.',
      ko: 'packed word를 개별 값으로 풀어야 한다. naive: element마다 shift → mask → convert — QServe 기준 각 ~5 ALU ops, 8개당 ≈ 32–40. engineered: register 통째로 — lop3 하나가 nibble mask와 FP16 exponent 패턴 주입을 동시에 하고 (MARLIN: naive INT4→FP16 type-cast는 느리다), prmt가 byte를 배치하고, 적절한 offline interleave가 있으면 QServe는 register 하나 분량의 INT4를 3 logic ops에 푼다. 일어나지 않은 일에 주목: INT2로 내려가도 이 작업은 줄지 않는다.',
    },
    {
      en: 'Dequant needs each group’s scale and zero-point — a second memory stream. At g=128 that is 4 B of FP16 metadata per group riding alongside the payload. MARLIN reorganizes scales like the weights and reloads them per sub-tile so the compiler’s pipelined instruction order survives; QServe stores them inline in each KV-cache page, right after the quantized features. Section c prices this stream in effective bits.',
      ko: 'dequant에는 각 그룹의 scale과 zero-point가 필요하다 — 두 번째 memory stream이다. g=128이면 그룹당 FP16 metadata 4 B가 payload 옆을 따라간다. MARLIN은 scale을 weight처럼 재배열해 sub-tile마다 다시 load함으로써 컴파일러의 pipeline된 instruction 순서를 지키고, QServe는 각 KV-cache page 안에 quantized feature 바로 뒤 inline으로 저장한다. c 섹션이 이 stream을 effective bits로 계산한다.',
    },
    {
      en: 'x̂ = (q − z) · s, two elements per HSUB2/HFMA2 on packed 16-bit halves; QServe even moves the zero-point subtraction into the epilogue algebraically. Then the actual math: decode attention is a batched GEMV at ~1 MAC per element regardless of batch (QServe) — one FMA. Everything before it was overhead. (Tensor-core mma needs ldmatrix, which does not work when storage and compute types differ — QServe.)',
      ko: 'x̂ = (q − z) · s — packed 16-bit 반쪽들에 HSUB2/HFMA2로 한 instruction당 element 2개씩; QServe는 zero-point 빼기를 대수적으로 epilogue로 옮기기까지 한다. 그 다음이 진짜 연산이다: decode attention은 batch와 무관하게 element당 ~1 MAC의 batched GEMV (QServe) — FMA 하나. 그 앞의 전부가 overhead였다. (tensor-core mma는 ldmatrix가 필요한데, storage와 compute type이 다르면 동작하지 않는다 — QServe.)',
    },
    {
      en: 'The bill per 8 elements (estimates on QServe/MARLIN anchors): FP16 ≈ 1 overhead instruction; engineered INT4 ≈ 10–12; naive INT4 ≈ 32–40; INT2 halves the bytes but not the instructions. Divide by bytes moved and compare with the CUDA-core budget — 9.8 ops/byte on A100-80GB (QServe), ≈ 12.5 on 40 GB (estimate). Cross it, and the kernel waits on its own unpack code: QServe measured naive 4-bit KV 1.1–1.2× slower than 8-bit.',
      ko: '8 element당 청구서 (QServe/MARLIN anchor 위의 추정): FP16 ≈ overhead instruction 1개; engineered INT4 ≈ 10–12; naive INT4 ≈ 32–40; INT2는 byte만 반으로 줄고 instruction은 그대로다. 이동한 byte로 나눠 CUDA-core 예산과 비교하라 — A100-80GB에서 9.8 ops/byte (QServe), 40 GB에서 ≈ 12.5 (추정). 넘는 순간 kernel은 자기 unpack 코드를 기다린다: QServe는 naive 4-bit KV가 8-bit보다 1.1–1.2× 느린 것을 실측했다.',
    },
  ];

  // meter verdicts (must match meterRows order in the template)
  const meterVerdicts = [
    { en: 'DRAM-bound — the baseline', ko: 'DRAM-bound — 기준선' },
    {
      en: 'DRAM-bound — dequant absorbed (KVQuant: 1.2–1.7× faster than fp16 at batch 1)',
      ko: 'DRAM-bound — dequant가 흡수된다 (KVQuant: batch 1에서 fp16보다 1.2–1.7× 빠름)',
    },
    {
      en: 'at / over the wall — QServe measured 1.1–1.2× slower than KV8 on A100',
      ko: '벽에 걸리거나 넘는다 — QServe가 A100에서 KV8보다 1.1–1.2× 느림을 실측',
    },
    {
      en: 'approaching the wall — bytes halved, instructions didn’t',
      ko: '벽에 접근 — byte는 반으로 줄었지만 instruction은 그대로',
    },
    {
      en: 'firmly ALU-bound — ~20 ops/byte vs a 9.8–12.5 budget',
      ko: '확실한 ALU-bound — 예산 9.8–12.5 대비 ~20 ops/byte',
    },
  ];
  let meterSel = 2;

  const verdictEl = document.getElementById('mpk-verdict');
  const renderMeter = () => {
    if (verdictEl) verdictEl.textContent = pick(meterVerdicts[meterSel]);
    document.querySelectorAll('#mpk-meter-table tbody tr').forEach((tr) => {
      tr.classList.toggle('on', tr.getAttribute('data-row') === String(meterSel));
    });
    for (let i = 0; i < meterVerdicts.length; i++) {
      const dot = document.getElementById('mpk-g-' + i);
      if (dot) dot.classList.toggle('on', i === meterSel);
    }
    document.querySelectorAll('.mpk-modes [data-mode]').forEach((b) => {
      b.classList.toggle('on', b.getAttribute('data-mode') === String(meterSel));
    });
  };
  document.querySelectorAll('.mpk-modes [data-mode]').forEach((b) => {
    b.addEventListener('click', () => {
      meterSel = parseInt(b.getAttribute('data-mode') || '0', 10);
      renderMeter();
    });
  });

  if (root) {
    const panels = Array.from(root.querySelectorAll('.mpk-panel'));
    const pips = Array.from(root.querySelectorAll('.mpk-pip'));
    const prevBtn = document.getElementById('mpk-prev');
    const nextBtn = document.getElementById('mpk-next');
    const capText = document.getElementById('mpk-caption-text');
    const stepNum = document.getElementById('mpk-step-num');
    let current = 0;

    function show(n) {
      current = ((n % panels.length) + panels.length) % panels.length;
      panels.forEach((p, i) => p.classList.toggle('active', i === current));
      pips.forEach((p, i) => {
        p.classList.toggle('active', i === current);
        p.setAttribute('aria-selected', i === current ? 'true' : 'false');
      });
      if (capText) capText.textContent = pick(captions[current]);
      if (stepNum) stepNum.textContent = 'Step ' + (current + 1) + ' / ' + panels.length;
    }

    if (prevBtn) prevBtn.addEventListener('click', () => show(current - 1));
    if (nextBtn) nextBtn.addEventListener('click', () => show(current + 1));
    pips.forEach((p) =>
      p.addEventListener('click', () => show(parseInt(p.getAttribute('data-step') || '0', 10)))
    );

    document.addEventListener('keydown', (e) => {
      const t = e.target;
      const tag = t && t.tagName ? t.tagName.toLowerCase() : '';
      if (tag === 'input' || tag === 'textarea' || tag === 'select') return;
      const r = root.getBoundingClientRect();
      const visible = r.top < window.innerHeight && r.bottom > 0;
      if (!visible) return;
      if (e.key === 'ArrowRight') show(current + 1);
      if (e.key === 'ArrowLeft') show(current - 1);
    });

    window.addEventListener('site-langchange', () => {
      if (capText) capText.textContent = pick(captions[current]);
    });

    show(0);
  }

  // ============ (e) before/after toggles ============
  document.querySelectorAll('.fix-card').forEach((card) => {
    const btns = Array.from(card.querySelectorAll('.ba-btn'));
    const figs = Array.from(card.querySelectorAll('.fix-fig'));
    btns.forEach((b) => {
      b.addEventListener('click', () => {
        const which = b.getAttribute('data-show');
        btns.forEach((x) => x.classList.toggle('on', x === b));
        figs.forEach((f) => f.classList.toggle('on', f.classList.contains('fig-' + which)));
      });
    });
  });

  // ============ (f) crossover: bytes vs instructions ============
  const crossData = {
    '16': {
      bytes: 16, bytesTxt: '16 B', instr: 1, instrTxt: '≈ 1',
      en: 'FP16 baseline: one 128-bit load per 8 elements; the math is the payload. Nothing to unpack.',
      ko: 'FP16 기준선: 8 element당 128-bit load 하나; 연산 자체가 본업이다. unpack할 것이 없다.',
    },
    '4-fused': {
      bytes: 4, bytesTxt: '4 B', instr: 11, instrTxt: '≈ 10–12',
      en: 'INT4, fused: 4× fewer bytes for ~10–12 instructions per 8 elements — stays memory-bound; the savings are real (KVQuant: 1.2–1.7× faster than fp16 at batch 1).',
      ko: 'INT4, fused: byte 4× 감소에 8 element당 instruction ~10–12개 — memory-bound가 유지되고 절약은 진짜다 (KVQuant: batch 1에서 fp16보다 1.2–1.7× 빠름).',
    },
    '4-naive': {
      bytes: 4, bytesTxt: '4 B', instr: 36, instrTxt: '≈ 32–40',
      en: 'INT4, naive: the same 4× fewer bytes now cost ~10 ops per byte moved vs a 9.8 budget — QServe measured this kernel 1.1–1.2× slower than KV8 on A100.',
      ko: 'INT4, naive: 같은 4× byte 감소가 이제 이동 byte당 ~10 ops를 요구한다, 예산은 9.8 — QServe는 이 kernel이 A100에서 KV8보다 1.1–1.2× 느린 것을 실측했다.',
    },
    '2-fused': {
      bytes: 2, bytesTxt: '2 B', instr: 14, instrTxt: '≈ 12–16',
      en: 'INT2, fused: 8× fewer payload bytes, but ≈ 6–8 ops/byte — approaching the CUDA-core roofline. And metadata drags “2-bit” to ~3 effective bits at g=32 (section c).',
      ko: 'INT2, fused: payload byte는 8× 감소지만 ≈ 6–8 ops/byte — CUDA-core roofline에 접근한다. 게다가 metadata가 g=32에서 “2-bit”를 ~3 effective bits로 끌어올린다 (c 섹션).',
    },
    '2-naive': {
      bytes: 2, bytesTxt: '2 B', instr: 36, instrTxt: '≈ 32–40',
      en: 'INT2, naive: ≈ 16–20 ops/byte — firmly ALU-bound. This is why 2-bit is not 2× faster than 4-bit without heroic kernels.',
      ko: 'INT2, naive: ≈ 16–20 ops/byte — 확실한 ALU-bound. heroic kernel 없이는 2-bit가 4-bit보다 2× 빠르지 않은 이유다.',
    },
  };
  const bitStops = [16, 4, 2];
  let crossBits = 4;
  let crossStyle = 'fused';

  const bitSlider = document.getElementById('mpk-bit-slider');
  const bitVal = document.getElementById('mpk-bit-val');
  const bytesBar = document.getElementById('mpk-bytes-bar');
  const bytesVal = document.getElementById('mpk-bytes-val');
  const instrBar = document.getElementById('mpk-instr-bar');
  const instrVal = document.getElementById('mpk-instr-val');
  const crossVerdict = document.getElementById('mpk-cross-verdict');
  const styleFused = document.getElementById('mpk-style-fused');
  const styleNaive = document.getElementById('mpk-style-naive');

  function renderCross() {
    const key = crossBits === 16 ? '16' : crossBits + '-' + crossStyle;
    const d = crossData[key];
    if (!d) return;
    if (bitVal) bitVal.textContent = crossBits === 16 ? 'FP16' : 'INT' + crossBits;
    if (bytesBar) bytesBar.style.width = (d.bytes / 16) * 100 + '%';
    if (bytesVal) bytesVal.textContent = d.bytesTxt;
    if (instrBar) instrBar.style.width = (d.instr / 36) * 100 + '%';
    if (instrVal) instrVal.textContent = d.instrTxt;
    if (crossVerdict) crossVerdict.textContent = pick(d);
    const styleOff = crossBits === 16;
    [styleFused, styleNaive].forEach((b) => {
      if (!b) return;
      b.disabled = styleOff;
      b.style.opacity = styleOff ? '0.4' : '';
      b.classList.toggle('on', !styleOff && b.getAttribute('data-style') === crossStyle);
    });
  }
  if (bitSlider)
    bitSlider.addEventListener('input', () => {
      crossBits = bitStops[parseInt(bitSlider.value, 10)] || 4;
      renderCross();
    });
  [styleFused, styleNaive].forEach((b) => {
    if (!b) return;
    b.addEventListener('click', () => {
      crossStyle = b.getAttribute('data-style') || 'fused';
      renderCross();
    });
  });

  // ============ (f) crossover: batch decay ============
  const pts = [[1, 3.9], [16, 3.9], [32, 3.85], [48, 3.3], [64, 2.7], [96, 2.0], [128, 1.5]];
  const cX = (b) => 60 + b * 5;
  const cY = (s) => 260 - s * 48.89;
  const speedAt = (b) => {
    for (let i = 1; i < pts.length; i++) {
      if (b <= pts[i][0]) {
        const [b0, s0] = pts[i - 1];
        const [b1, s1] = pts[i];
        return s0 + ((b - b0) / (b1 - b0)) * (s1 - s0);
      }
    }
    return pts[pts.length - 1][1];
  };
  const batchRegimes = [
    {
      max: 40,
      en: 'Memory-bound regime: MARLIN holds close to the maximum 4× for batches up to 16–32; FLUTE’s LUT gains likewise concentrate below batch 32.',
      ko: 'Memory-bound regime: MARLIN은 batch 16–32까지 최대 4×에 근접하게 유지한다; FLUTE의 LUT 이득도 batch 32 아래에 몰린다.',
    },
    {
      max: 72,
      en: 'The crossover: an A10’s FLOPs/byte ≈ 200 puts the memory→compute flip near batch 50–64 (MARLIN’s roofline). A100-40GB has nearly the same FP16 tensor-core ratio, so the analysis transfers — as an estimate.',
      ko: 'crossover: A10의 FLOPs/byte ≈ 200은 memory→compute 전환을 batch 50–64 근처에 둔다 (MARLIN의 roofline). A100-40GB도 FP16 tensor-core 비율이 거의 같아 이 분석은 — 추정으로서 — 이식된다.',
    },
    {
      max: 129,
      en: 'Compute-bound: dequant no longer hides under DRAM stalls — ~1.5× at batch 128; end-to-end in vLLM, 2.8× at batch 16 decays to ~1.2× at 128 (MARLIN).',
      ko: 'Compute-bound: dequant가 더는 DRAM stall 밑에 숨지 못한다 — batch 128에서 ~1.5×; vLLM end-to-end로는 batch 16의 2.8×가 128에서 ~1.2×로 감쇠한다 (MARLIN).',
    },
  ];
  let batchB = 32;
  const batchSlider = document.getElementById('mpk-batch-slider');
  const batchVal = document.getElementById('mpk-batch-val');
  const batchDot = document.getElementById('mpk-batch-dot');
  const batchVerdict = document.getElementById('mpk-batch-verdict');

  function renderBatch() {
    const s = speedAt(batchB);
    if (batchDot) {
      batchDot.setAttribute('cx', String(cX(batchB)));
      batchDot.setAttribute('cy', String(cY(s)));
    }
    if (batchVal) batchVal.textContent = 'b = ' + batchB + ' · ≈ ' + s.toFixed(1) + '×';
    const regime = batchRegimes.find((r) => batchB < r.max) || batchRegimes[2];
    if (batchVerdict) batchVerdict.textContent = pick(regime);
  }
  if (batchSlider)
    batchSlider.addEventListener('input', () => {
      batchB = parseInt(batchSlider.value, 10) || 1;
      renderBatch();
    });

  // ============ language re-render ============
  window.addEventListener('site-langchange', () => {
    renderMeter();
    renderCross();
    renderBatch();
  });
</script>
