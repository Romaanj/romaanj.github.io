  .fix-card .card-kicker {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-strong);
  }
  .fix-cite { font-size: 0.86rem; color: var(--text-secondary); line-height: 1.65; margin: 0.8rem 0 0; }

  .ba-btns { display: none; gap: 0.4rem; margin-bottom: 0.8rem; }
  .mpk-page.js .ba-btns { display: flex; }
  .ba-btn {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    cursor: pointer;
    padding: 0.35em 1em;
    border-radius: 999px;
