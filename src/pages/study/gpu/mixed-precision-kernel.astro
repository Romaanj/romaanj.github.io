  .div-pass { animation: mpkPass 4.2s linear infinite; opacity: 0.12; }
  @keyframes mpkPass {
    0%      { opacity: 0.12; }
    12%     { opacity: 1; }
    72%     { opacity: 1; }
    88%, 100% { opacity: 0.12; }
  }

  .coal-flash { animation: mpkFlash 2.4s linear infinite; }
  @keyframes mpkFlash {
    0%, 35% { stroke-opacity: 0; }
    50%     { stroke-opacity: 1; }
    85%     { stroke-opacity: 1; }
    100%    { stroke-opacity: 0; }
  }

  .g-arr { animation: mpkPulse 4s linear infinite; opacity: 0; }

  @media (prefers-reduced-motion: reduce) {
    .m-arr, .div-pass, .coal-flash, .g-arr, .u-arrs { animation: none; opacity: 1; stroke-opacity: 1; }
