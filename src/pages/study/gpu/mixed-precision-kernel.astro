  .u-arrs { animation: mpkFadeIn 0.9s var(--ease-out) both; }
  @keyframes mpkFadeIn { from { opacity: 0; } to { opacity: 1; } }

  .m-arr { animation: mpkPulse 4.4s linear infinite; opacity: 0; }
  @keyframes mpkPulse {
    0%, 6% { opacity: 0; }
    14%    { opacity: 1; }
    80%    { opacity: 1; }
    92%, 100% { opacity: 0; }
