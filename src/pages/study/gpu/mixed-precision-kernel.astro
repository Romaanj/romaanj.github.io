  }
  .ba-btn.on { background: var(--accent); border-color: var(--accent); color: #fff; }

  .fix-fig { margin: 0 0 0.8rem; }
  .mpk-page.js .fix-fig { display: none; }
  .mpk-page.js .fix-fig.on { display: block; animation: mpkFade 0.3s var(--ease-out); }
  .fix-fig .fig-svg { width: 100%; height: auto; display: block; background: var(--surface-warm); border-radius: var(--radius-s); }
  .fix-fig .fig-svg text { font-family: var(--font-sans); fill: var(--text); }
  .fix-fig .fig-svg .t-tiny { font-size: 10px; }
  .fix-fig .fig-svg .t-mono { font-family: var(--font-mono); }
  .fix-fig .fig-svg .t-tert { fill: var(--text-tertiary); }
  .fix-fig .fig-svg .t-accent { fill: var(--accent-strong); }
  .fix-fig figcaption { font-size: 0.76rem; color: var(--text-tertiary); margin-top: 0.4rem; }

  .flow { display: flex; align-items: center; flex-wrap: wrap; gap: 0.45rem; background: var(--surface-warm); border-radius: var(--radius-s); padding: 0.9rem 1rem; }
  .fchip {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.45em 0.8em;
    border-radius: 7px;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    white-space: nowrap;
  }
  .fchip.mem { background: #eaf1f8; border-color: var(--swatch-sky); }
  .fchip.warn { background: var(--accent-soft); border-color: var(--accent-strong); color: var(--accent-strong); font-weight: 700; }
  .fchip.good { background: #e6e9df; border-color: var(--swatch-olive); font-weight: 700; }
  .farr { color: var(--text-tertiary); font-size: 0.85rem; }

  /* ---------- (f) crossover ---------- */
  .cross-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 1.2rem; align-items: start; }
  @media (max-width: 900px) { .cross-grid { grid-template-columns: 1fr; } }
  .cross-h { font-size: 0.95rem; margin: 0 0 0.9rem; }
  .cross-controls { margin-bottom: 1rem; }
  .mpk-modes.small { margin-top: 0.5rem; }

  .slider-row { display: none; align-items: center; gap: 0.8rem; margin: 0.7rem 0; }
  .mpk-page.js .slider-row { display: flex; }
  .slider-lbl { font-size: 0.78rem; color: var(--text-tertiary); font-family: var(--font-mono); }
  .slider-row input[type='range'] { flex: 1; accent-color: var(--accent-strong); min-width: 120px; }
  .slider-val { font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-secondary); white-space: nowrap; min-width: 7.5em; text-align: right; }

  .tw-bars { margin: 0.9rem 0; }
  .tw-row { display: flex; align-items: center; gap: 0.7rem; margin-bottom: 0.5rem; }
  .tw-lbl { font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-tertiary); width: 8.5em; flex: none; }
  .tw-track { flex: 1; height: 18px; background: var(--surface-warm); border-radius: 5px; overflow: hidden; }
  .tw-bar { display: block; height: 100%; border-radius: 5px; transition: width 0.35s var(--ease-out); }
  .tw-bytes { background: var(--swatch-sky); }
  .tw-instr { background: var(--accent); }
  .tw-val { font-family: var(--font-mono); font-size: 0.78rem; white-space: nowrap; min-width: 5.5em; }

  .cross-verdict {
    margin: 0.9rem 0 0;
    padding: 0.75rem 1rem;
    background: var(--surface-warm);
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius-s) var(--radius-s) 0;
    font-size: 0.88rem;
    line-height: 1.6;
    min-height: 4.2em;
  }

  /* ---------- why band ---------- */
  .why-band {
    border-radius: var(--radius-l);
    padding: clamp(1.4rem, 3vw, 2.2rem);
    max-width: 900px;
  }
  .why-band h3 { color: var(--text-on-dark); margin: 0 0 0.7rem; }
  .why-band p { font-size: 0.97rem; line-height: 1.75; margin: 0; }
  .why-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.1rem; }
  .why-chip {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-on-dark);
    border: 1px solid var(--line-on-dark);
    border-radius: 999px;
    padding: 0.35em 0.9em;
    background: #1d1d1b;
  }

  .deeper-list { list-style: none; padding: 0; margin: 0.6rem 0 0; display: flex; flex-direction: column; gap: 0.55rem; }
  .deeper-list .arrow-link { text-decoration: none; }

  /* ---------- tooltip ---------- */
  #mpkTip {
    position: fixed;
    z-index: 60;
    max-width: 320px;
    pointer-events: none;
    background: var(--surface-dark);
