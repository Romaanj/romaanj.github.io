---
import Base from '../../../layouts/Base.astro';
import LangToggle from '../../../components/LangToggle.astro';

// ------------------------------------------------------------------
// All numbers on this page come from published papers / vendor docs
// (MARLIN, FLUTE, QServe, KVQuant, Any-Precision LLM, Atom,
// SqueezeLLM, KIVI, DiffKV; NVIDIA GA100 whitepaper, CUDA docs).
// Derived arithmetic is labeled "estimate" in place.
// ------------------------------------------------------------------

// (a) compute-path stages, HBM -> ... -> MMA/FMA
const pathStages = [
  {
    x: 20, w: 96, kind: 'mem', name: 'HBM', sub: '1,555 GB/s',
    tip: 'A100-40GB: 40 GB HBM2 @ 1,555 GB/s. Global loads coalesce into up-to-128-byte transactions built from 32-byte sectors; vectorized access needs natural alignment (CUDA Best Practices).',
    tipKo: 'A100-40GB: 40 GB HBM2 @ 1,555 GB/s. global load는 32-byte sector로 구성된 최대 128-byte transaction으로 coalesce된다; vectorized access는 natural alignment가 필요하다 (CUDA Best Practices).',
  },
  {
    x: 140, w: 84, kind: 'mem', name: 'L2', sub: '40 MB',
    tip: '40 MB in 2 partitions, 5,120 B/clk read bandwidth — 2.3× V100 (GA100 whitepaper).',
    tipKo: '2개 partition에 40 MB, read 5,120 B/clk — V100의 2.3× (GA100 whitepaper).',
  },
  {
    x: 248, w: 96, kind: 'mem', name: 'SMEM', sub: '≤164 KB/SM',
    tip: 'Up to 164 KB of the 192 KB combined L1/SMEM per SM; 32 banks × 32 bits per clock. cp.async copies global→SMEM directly, bypassing the register file (GA100).',
    tipKo: 'SM당 L1/SMEM 통합 192 KB 중 최대 164 KB; 32 bank × 32 bit/clk. cp.async는 register file을 거치지 않고 global→SMEM으로 직접 복사한다 (GA100).',
  },
  {
    x: 368, w: 100, kind: 'mem', name: 'Registers', sub: '256 KB/SM',
    tip: '64 K × 32-bit registers per SM. Unpack and dequant live here — and every instruction competes for the SM’s 4 issue slots per clock.',
    tipKo: 'SM당 64 K × 32-bit register. unpack과 dequant가 여기서 돌고 — 모든 instruction이 SM의 클럭당 4개 issue slot을 두고 경쟁한다.',
  },
  {
    x: 492, w: 118, kind: 'added', name: 'UNPACK', sub: 'shf · prmt · lop3',
    tip: 'Packed fields become elements: per-element shift/mask (naive) or register-wide bit tricks — prmt picks 4 arbitrary bytes from two registers, lop3 does any 3-input logic op, shf funnel-shifts fields that straddle a 32-bit word (PTX ISA).',
    tipKo: 'packed field를 element로 푼다: element별 shift/mask (naive) 또는 register 단위 bit trick — prmt는 register 두 개에서 임의 byte 4개를 고르고, lop3는 임의의 3-입력 logic op, shf는 32-bit word 경계에 걸친 field를 funnel-shift한다 (PTX ISA).',
  },
  {
    x: 634, w: 118, kind: 'added', name: 'DEQUANT', sub: '(q − z) · s',
    tip: 'Naive per-element dequant ≈ 5 ALU ops (QServe) — on CUDA cores, where one op costs as much as ~50 INT4 tensor-core ops.',
    tipKo: 'naive element별 dequant ≈ 5 ALU ops (QServe) — CUDA core에서 돌고, CUDA core op 하나는 INT4 tensor-core op ~50개 값이다.',
  },
  {
    x: 776, w: 164, kind: 'math', name: 'MMA / FMA', sub: 'the actual math',
    tip: 'Decode attention over the KV cache is a batched GEMV, ~1 MAC per element regardless of batch (QServe). ldmatrix→mma only works when storage and compute types match — sub-byte storage must be unpacked into the exact lane layout by other means (QServe).',
    tipKo: 'KV cache 위의 decode attention은 batch와 무관하게 element당 ~1 MAC의 batched GEMV다 (QServe). ldmatrix→mma는 storage와 compute type이 같을 때만 동작한다 — sub-byte storage는 다른 수단으로 정확한 lane layout까지 풀어야 한다 (QServe).',
  },
];

// (b) verdict-meter rows — per 8 elements, estimates anchored to
// QServe (5 ops/elem naive, ~2 ops/elem optimized) and MARLIN.
// issue bar = ops-per-byte ÷ 9.8 budget (A100-80GB, QServe), row-normalized.
const meterRows = [
  {
    id: 'fp16', label: 'FP16 passthrough', bytes: '16 B', instr: '≈ 1', opsb: '≈ 0.1', ops: 0.1,
    dram: 100, issue: 2, flip: false,
    vEn: 'DRAM-bound — the baseline', vKo: 'DRAM-bound — 기준선',
    tip: 'One 128-bit load covers 8 FP16 elements; the dot-product FMAs are the payload, not overhead. (estimate)',
    tipKo: '128-bit load 하나가 FP16 element 8개를 덮는다; dot-product FMA는 overhead가 아니라 본업이다. (추정)',
  },
  {
    id: 'i4f', label: 'INT4 · fused + bit-tricked', bytes: '4 B', instr: '≈ 10–12', opsb: '≈ 2.5–3', ops: 2.75,
    dram: 100, issue: 28, flip: false,
    vEn: 'DRAM-bound — dequant absorbed (KVQuant: 1.2–1.7× faster than fp16 at batch 1)',
    vKo: 'DRAM-bound — dequant가 흡수된다 (KVQuant: batch 1에서 fp16보다 1.2–1.7× 빠름)',
    tip: '¼ of a 128-bit load + ~4 lop3 + 1–2 prmt/shift + ~4 HFMA2/HSUB2 — consistent with QServe’s optimized ~2 ops/element. (estimate)',
    tipKo: '128-bit load의 ¼ + lop3 ~4개 + prmt/shift 1–2개 + HFMA2/HSUB2 ~4개 — QServe의 최적화된 ~2 ops/element와 일치. (추정)',
  },
  {
    id: 'i4n', label: 'INT4 · naive per-element', bytes: '4 B', instr: '≈ 32–40', opsb: '≈ 8–10', ops: 10,
    dram: 98, issue: 100, flip: true,
    vEn: 'at / over the wall — QServe measured 1.1–1.2× slower than KV8 on A100',
    vKo: '벽에 걸리거나 넘는다 — QServe가 A100에서 KV8보다 1.1–1.2× 느림을 실측',
    tip: 'shift + and + cvt + fma per element ≈ QServe’s 5 ALU ops/element; 5 ÷ 0.5 B = 10 ops per byte moved vs a 9.8 budget. (estimate on verified anchors)',
    tipKo: 'element마다 shift + and + cvt + fma ≈ QServe의 5 ALU ops/element; 5 ÷ 0.5 B = 이동 byte당 10 ops vs 예산 9.8. (검증된 anchor 위의 추정)',
  },
  {
    id: 'i2f', label: 'INT2 · fused + bit-tricked', bytes: '2 B', instr: '≈ 12–16', opsb: '≈ 6–8', ops: 7,
    dram: 100, issue: 71, flip: false,
    vEn: 'approaching the wall — bytes halved, instructions didn’t',
    vKo: '벽에 접근 — byte는 반으로 줄었지만 instruction은 그대로',
    tip: 'Per-element extract/convert/scale work doesn’t shrink with bit-width, so ops-per-byte roughly doubles vs INT4. (estimate)',
    tipKo: 'element별 extract/convert/scale 작업은 bit-width와 함께 줄지 않으므로 byte당 ops는 INT4 대비 대략 2배가 된다. (추정)',
  },
  {
    id: 'i2n', label: 'INT2 · naive per-element', bytes: '2 B', instr: '≈ 32–40', opsb: '≈ 16–20', ops: 18,
    dram: 49, issue: 100, flip: true,
    vEn: 'firmly ALU-bound — ~20 ops/byte vs a 9.8–12.5 budget',
    vKo: '확실한 ALU-bound — 예산 9.8–12.5 대비 ~20 ops/byte',
    tip: 'This is the quantitative reason “2-bit is not 2× faster than 4-bit” without heroic kernels. (estimate)',
    tipKo: '“heroic kernel 없이는 2-bit가 4-bit보다 2× 빠르지 않다”의 정량적 이유. (추정)',
  },
];

// gauge x-position for ops/byte in [0, 22] → px [70, 910]
const gX = (v: number) => 70 + (v / 22) * 840;

// (c) effective-bits bars (d = 128, fp16 scale+zero = 4 B/group)
const effBars = [
  {
    label: 'FP16', total: '16.0', ratio: '1×',
    segs: [{ w: 16, cls: 'sg-pay' }],
    tip: '128 dims × 2 B = 256 B per row.', tipKo: '128 dims × 2 B = row당 256 B.',
  },
  {
    label: 'INT4 · g=128', total: '4.25', ratio: '3.76×',
    segs: [{ w: 4, cls: 'sg-pay' }, { w: 0.25, cls: 'sg-meta' }],
    tip: '64 B codes + 4 B scale/zero = 68 B vs 256 B → 4.25 effective bits, 3.76× (not 4×). (estimate, verified inputs)',
    tipKo: 'code 64 B + scale/zero 4 B = 68 B vs 256 B → 4.25 effective bits, 3.76× (4×가 아님). (추정, 입력은 검증됨)',
  },
  {
    label: 'INT4 · g=64', total: '4.5', ratio: '3.56×',
    segs: [{ w: 4, cls: 'sg-pay' }, { w: 0.5, cls: 'sg-meta' }],
    tip: '64 B + 8 B = 72 B → 4.5 effective bits. (estimate)',
    tipKo: '64 B + 8 B = 72 B → 4.5 effective bits. (추정)',
  },
  {
    label: 'INT2 · g=32 (KIVI’s setting)', total: '3.0', ratio: '5.33×',
    segs: [{ w: 2, cls: 'sg-pay' }, { w: 1, cls: 'sg-meta' }],
    tip: '32 B payload + 4 groups × 4 B = 48 B → 3 effective bits, 5.33× (not 8×) — metadata alone is 50% of payload. (estimate; KIVI G=32 verified)',
    tipKo: 'payload 32 B + 그룹 4개 × 4 B = 48 B → 3 effective bits, 5.33× (8×가 아님) — metadata만으로 payload의 50%. (추정; KIVI G=32는 검증됨)',
  },
  {
    label: 'INT2 · g=32 + FP16 window R=128, 512-token ctx', total: '≥ 6.25', ratio: '≤ 2.56×',
    segs: [{ w: 1.5, cls: 'sg-pay' }, { w: 0.75, cls: 'sg-meta' }, { w: 4, cls: 'sg-res' }],
    tip: 'KIVI keeps the newest R=128 tokens in full precision; at 512 tokens the average is (128×16 + 384×3)/512 = 6.25 bits. (estimate; R=128 verified)',
    tipKo: 'KIVI는 최신 R=128 token을 full precision으로 유지; 512 token에서 평균은 (128×16 + 384×3)/512 = 6.25 bits. (추정; R=128은 검증됨)',
  },
];

// (d-1) mixed-width example records — a GENERIC example alphabet {0,2,4,8,16}
// per-token 128-dim rows; px = bytes / 2
const mixRecs = [
  { bits: 4, px: 32 }, { bits: 2, px: 16 }, { bits: 16, px: 128 }, { bits: 0, px: 7 },
  { bits: 8, px: 64 }, { bits: 4, px: 32 }, { bits: 2, px: 16 }, { bits: 8, px: 64 },
];
let acc = 0;
const mixOff = mixRecs.map((r) => { const o = acc; acc += r.px; return o; });

// (d-2) warp-divergence lanes (8 of a 32-lane warp shown)
const divLanes = [2, 4, 2, 8, 4, 2, 8, 4];
const laneColor = (b: number) => (b === 2 ? 'var(--accent)' : b === 4 ? 'var(--swatch-sky)' : 'var(--swatch-olive)');

// (f) MARLIN A10 speedup-vs-batch anchors (sketch through published points)
const marlinPts = [
  [1, 3.9], [16, 3.9], [32, 3.85], [48, 3.3], [64, 2.7], [96, 2.0], [128, 1.5],
];
const cX = (b: number) => 60 + b * 5;
const cY = (s: number) => 260 - s * 48.89;
const curvePts = marlinPts.map(([b, s]) => `${cX(b).toFixed(1)},${cY(s).toFixed(1)}`).join(' ');

// going deeper — primary sources
const papers = [
  {
    id: '2408.11743', name: 'MARLIN — Frantar et al., 2024',
    en: 'The reference INT4×FP16 GEMM kernel: interleaved packing, lop3 dequant, cp.async pipelines — and the honest speedup-vs-batch decay curve.',
    ko: 'INT4×FP16 GEMM kernel의 표준: interleaved packing, lop3 dequant, cp.async pipeline — 그리고 정직한 speedup-vs-batch 감쇠 곡선.',
    meta: 'the kernel-engineering playbook', metaKo: 'kernel engineering 플레이북',
  },
  {
    id: '2407.10960', name: 'FLUTE — Guo et al., 2024',
    en: 'LUT-quantized GEMM: 128-bit access granularity, bit-slicing odd widths, and vectorized + duplicated lookup tables against bank conflicts.',
    ko: 'LUT-quantized GEMM: 128-bit access granularity, 홀수 width의 bit-slicing, bank conflict에 맞서는 vectorized + duplicated lookup table.',
    meta: 'odd widths & LUTs', metaKo: '홀수 width와 LUT',
  },
  {
    id: '2405.04532', name: 'QServe — Lin et al., 2024',
    en: 'W4A8KV4 serving: the 5-ops-per-element dequant accounting, compute-aware weight reordering, and why naive 4-bit KV lost to 8-bit.',
    ko: 'W4A8KV4 serving: element당 5 ops의 dequant 회계, compute-aware weight reordering, 그리고 naive 4-bit KV가 8-bit에 진 이유.',
    meta: 'the ops-per-byte accounting', metaKo: 'ops-per-byte 회계',
  },
  {
    id: '2401.18079', name: 'KVQuant — Hooper et al., 2024',
    en: 'Fused non-uniform KV dequant that is faster than fp16 at batch 1 — the existence proof that low-bit KV loading can win outright.',
    ko: 'batch 1에서 fp16보다 빠른 fused non-uniform KV dequant — low-bit KV loading이 완승할 수 있다는 존재 증명.',
    meta: 'the batch-1 counterpoint', metaKo: 'batch-1 반례',
  },
  {
    id: '2402.10517', name: 'Any-Precision LLM — Park et al., 2024',
    en: 'Bitplane storage: a lower width means reading fewer planes, not taking a different branch — width variation without divergence.',
    ko: 'bitplane 저장: 낮은 width = 다른 branch가 아니라 더 적은 plane 읽기 — divergence 없는 width 가변.',
    meta: 'bitplanes', metaKo: 'bitplane',
  },
  {
    id: '2310.19102', name: 'Atom — Zhao et al., 2023',
    en: 'Mixed-precision made regular by reordering: scattered outlier channels moved to a contiguous tail so each region is uniform.',
    ko: 'reordering으로 규칙화한 mixed-precision: 흩어진 outlier channel을 연속된 꼬리로 옮겨 각 영역을 uniform하게.',
    meta: 'the pool ancestor', metaKo: 'pool 패턴의 조상',
  },
  {
    id: '2412.03131', name: 'DiffKV — Zhang et al., 2024',
    en: 'Heterogeneous KV precision as a memory-management problem: differentiated pages plus parallel compaction of fragmented free memory.',
    ko: '이종 KV precision을 memory management 문제로: differentiated page와 파편화된 free memory의 parallel compaction.',
    meta: 'mixed-precision KV systems', metaKo: 'mixed-precision KV 시스템',
  },
  {
    id: '2306.07629', name: 'SqueezeLLM — Kim et al., 2023',
    en: 'The price of a sparse side-band, measured: 0.45% of weights in CSR costs ~10% kernel latency and needs balanced hybrid kernels.',
    ko: 'sparse side-band의 가격 실측: weight의 0.45%를 CSR로 빼는 데 kernel latency ~10%, balanced hybrid kernel 필요.',
    meta: 'what gather costs', metaKo: 'gather의 비용',
  },
];
---

<Base
  title="Mixed-precision KV caches inside the kernel — Junwon Lee"
  description="Why 8× smaller can load slower: an interactive walk through what a GPU kernel actually does with packed low-bit and mixed-precision KV caches — unpack instructions, metadata streams, warp divergence, and the published fix patterns."
>
  <div class="mpk-page">
    <!-- ============ hero ============ -->
    <section class="section">
      <div class="container">
        <div class="hero-top">
          <p class="eyebrow">Study · GPU kernels</p>
          <LangToggle />
        </div>
        <h1>
          <span class="lang-en">Why 8× smaller can load slower: mixed-precision KV caches inside the kernel</span><span class="lang-ko">8× 작은데 왜 더 느리게 읽히는가: kernel 안의 mixed-precision KV cache</span>
        </h1>
        <p class="lede">
          <span class="lang-en">
            Quantization shrinks the bytes; the kernel still has to unpack, dequantize, and feed
            them to the math units. This page walks that path at the instruction level — using only
            published kernel-engineering results (MARLIN, FLUTE, QServe, KVQuant, and friends) and
            vendor-documented A100 facts — to show exactly when byte savings turn into time savings,
            and when they quietly don’t.
          </span><span class="lang-ko">
            Quantization은 byte를 줄이지만, kernel은 여전히 그 byte를 unpack하고 dequantize해서
            연산 유닛에 먹여야 한다. 이 페이지는 그 경로를 instruction 수준에서 따라간다 — 공개된
            kernel engineering 결과(MARLIN, FLUTE, QServe, KVQuant 등)와 vendor가 문서화한 A100
            사실만으로, byte 절약이 언제 시간 절약이 되고 언제 조용히 안 되는지를 정확히 보인다.
          </span>
        </p>
        <p class="scope-note">
          <span class="lang-en">
            Scope note: various published schemes assign different bit-widths per token, head, or
            channel (MiKV, QAQ, DiffKV). How widths get <em>assigned</em> is out of scope here —
            everything below takes an assignment as given and asks only how it is stored, loaded,
            and computed fast.
          </span><span class="lang-ko">
            범위 주석: 공개된 여러 기법이 token·head·channel별로 서로 다른 bit-width를 부여한다
            (MiKV, QAQ, DiffKV). width를 <em>어떻게 정하는지</em>는 이 페이지의 범위 밖이다 —
            아래의 모든 내용은 부여가 주어졌다고 놓고, 그것을 어떻게 저장하고 읽고 빠르게
            계산하는지만 다룬다.
          </span>
        </p>
        <div class="jump-row">
          <a class="tag" href="#promise">a · Promise vs path</a>
          <a class="tag" href="#walkthrough">b · Inside one warp</a>
          <a class="tag" href="#metadata">c · The second stream</a>
          <a class="tag" href="#irregularity">d · Mixed-width breakage</a>
          <a class="tag" href="#fixes">e · The fix patterns</a>
          <a class="tag" href="#crossover">f · When it wins</a>
        </div>
      </div>
    </section>

    <!-- ============ (a) the promise vs the path ============ -->
    <section class="section-tight" id="promise">
      <div class="container">
        <h2 class="viz-h">
          <span class="lang-en">a · The promise vs the path</span>
          <span class="lang-ko">a · 약속 vs 경로</span>
        </h2>
        <p class="viz-sub">
          <span class="lang-en">
            The storage story is one bar: fewer bits, fewer HBM bytes. The performance story is a
            pipeline: every byte must traverse the memory hierarchy <em>and then</em> an unpack +
            dequant instruction sequence before any math happens. Hover each stage.
          </span><span class="lang-ko">
            저장의 이야기는 막대 하나다: bit가 줄면 HBM byte가 준다. 성능의 이야기는
            파이프라인이다: 모든 byte는 memory hierarchy를 지나고 <em>그 다음</em> unpack +
            dequant instruction 시퀀스를 지나야 비로소 연산이 시작된다. 각 stage에 hover해 보라.
          </span>
        </p>

        <div class="viz-frame">
          <!-- storage bars -->
          <div class="promise-bars">
            <div class="pb-row">
              <span class="pb-label">FP16</span>
              <div class="pb-track">
                <div class="pb-bar pb-fp16" style="width: 100%"
                  data-tip="One 128-dim K row: 128 × 16 bits = 256 B"
                  data-tip-ko="128-dim K row 하나: 128 × 16 bits = 256 B"></div>
              </div>
              <span class="pb-val">256 B / row</span>
            </div>
            <div class="pb-row">
              <span class="pb-label">INT2</span>
              <div class="pb-track">
                <div class="pb-bar pb-int2" style="width: 12.5%"
                  data-tip="128 × 2 bits = 32 B of payload — the promise: 8× fewer HBM bytes (before metadata; see section c)"
                  data-tip-ko="128 × 2 bits = payload 32 B — 약속: HBM byte 8× 감소 (metadata 반영 전; c 섹션 참고)"></div>
              </div>
              <span class="pb-val">32 B / row · <strong>8×</strong></span>
            </div>
            <p class="pb-note">
              <span class="lang-en">The promise — payload bytes only. The rest of the page is about what those bytes cost to use.</span>
              <span class="lang-ko">약속 — payload byte만 센 것이다. 페이지의 나머지는 그 byte를 쓰는 데 드는 비용 이야기다.</span>
            </p>
          </div>

          <!-- compute path strip -->
          <div class="mpk-scroll">
            <svg class="mpk-svg" viewBox="0 0 960 210" style="min-width: 780px" role="img"
                 aria-label="Compute path from HBM through L2, shared memory, registers, unpack and dequant stages to the math units">
              <defs>
                <marker id="mpk-arr-a" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
                  <path d="M0,0 L8,4 L0,8 z" fill="var(--text-tertiary)"></path>
                </marker>
              </defs>
              {pathStages.map((s, i) => (
                <g>
                  <rect
                    class={`ps-box ps-${s.kind}`}
                    x={s.x} y="52" width={s.w} height="72" rx="10"
                    data-tip={s.tip} data-tip-ko={s.tipKo}
                  ></rect>
                  <text x={s.x + s.w / 2} y="84" text-anchor="middle" class={`t-mid ${s.kind === 'math' ? 't-ondark' : ''}`}>{s.name}</text>
                  <text x={s.x + s.w / 2} y="104" text-anchor="middle" class={`t-small ${s.kind === 'math' ? 't-ondark-sec' : 't-tert'}`}>{s.sub}</text>
                  {i < pathStages.length - 1 && (
                    <line x1={s.x + s.w + 2} y1="88" x2={pathStages[i + 1].x - 3} y2="88"
                          stroke="var(--text-tertiary)" stroke-width="1.5" marker-end="url(#mpk-arr-a)"></line>
                  )}
                </g>
              ))}
              <text x="20" y="30" class="t-label">the path every KV byte takes at decode time</text>
              <path d="M 492 140 L 492 152 L 750 152 L 750 140" fill="none" stroke="var(--accent)" stroke-width="1.5"></path>
              <text x="621" y="172" text-anchor="middle" class="t-small t-accent">the stages quantization adds — CUDA-core instructions, not tensor-core math</text>
              <text x="621" y="190" text-anchor="middle" class="t-small t-tert">QServe: on A100, one CUDA-core op ≈ 50 INT4 tensor-core ops</text>
            </svg>
          </div>

          <p class="mpk-note">
            <span class="lang-en">
              Why this can break: decode attention reads the KV cache at an arithmetic intensity of
              ~1 MAC per element <em>regardless of batch size</em> (QServe) — it is
              DRAM-bandwidth-bound, which is exactly why KVQuant argues compression is worth “a more
              complex dequantization process.” But dequant runs on CUDA cores, and the A100
              CUDA-core roofline is only ≈ 9.8 ops per byte moved (QServe, A100-80GB; ≈ 12.5 on the
              40 GB part — estimate). Cross that line and the kernel stops waiting on DRAM and
              starts waiting on its own unpack instructions.
            </span><span class="lang-ko">
              이것이 깨질 수 있는 이유: decode attention은 <em>batch 크기와 무관하게</em> element당
              ~1 MAC의 arithmetic intensity로 KV cache를 읽는다 (QServe) — DRAM
              bandwidth-bound이고, 바로 그래서 KVQuant는 “더 복잡한 dequantization을 감수하고라도”
              압축할 가치가 있다고 논증한다. 그런데 dequant는 CUDA core에서 돌고, A100의 CUDA-core
              roofline은 이동 byte당 겨우 ≈ 9.8 ops다 (QServe, A100-80GB; 40 GB 모델은 ≈ 12.5 —
              추정). 이 선을 넘는 순간 kernel은 DRAM이 아니라 자기 unpack instruction을 기다리기
              시작한다.
            </span>
          </p>
        </div>
      </div>
    </section>

