  .kvq-val .b { font-size: 0.66rem; color: var(--text-tertiary); letter-spacing: 0.08em; }
  .kvq-val.is-max { border-color: var(--accent-strong); background: var(--accent-soft); }
  .kvq-val.is-min { border-color: var(--swatch-sky); background: #eaf1f8; }
  .kvq-val .mm {
    position: absolute;
    bottom: -1.35em;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .kvq-val.is-max .mm { color: var(--accent-strong); }
  .kvq-val.is-min .mm { color: var(--swatch-sky); }

  /* ---------- math cards (panel 3) ---------- */
  .kvq-math-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }
  .kvq-math {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    padding: 1rem 1.2rem;
    box-shadow: var(--shadow-card);
  }
  .kvq-math .k {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-strong);
    margin-bottom: 0.5rem;
  }
  .kvq-math code {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    line-height: 1.75;
  }
  .kvq-math code em { color: var(--text-tertiary); font-style: normal; font-size: 0.8em; }
  .kvq-math code strong { color: var(--accent-strong); }
  .kvq-math p { margin: 0.55rem 0 0; font-size: 0.82rem; color: var(--text-secondary); }

  .kvq-formula {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
    margin-top: 1.1rem;
    background: var(--surface-dark);
    color: var(--text-on-dark);
    border-radius: var(--radius-m);
    padding: 0.9rem 1.3rem;
  }
  .kvq-formula span {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-on-dark-secondary);
  }
  .kvq-formula code {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    color: #f5c8b4;
  }

  /* ---------- table ---------- */
  .kvq-table {
    border-collapse: collapse;
    width: 100%;
    min-width: 560px;
    font-size: 0.86rem;
    margin: 0.8rem 0;
  }
  .kvq-table th, .kvq-table td {
    border: 1px solid var(--line);
    padding: 0.42em 0.75em;
    text-align: left;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    white-space: nowrap;
  }
  .kvq-table th {
    background: var(--surface-warm);
    font-family: var(--font-sans);
    font-weight: 600;
  }
  .kvq-table td.q { color: var(--accent-strong); font-weight: 700; }
  .kvq-table td.bits { letter-spacing: 0.15em; }
  .kvq-table td em { color: var(--text-tertiary); font-style: normal; font-size: 0.85em; }

  .kvq-badges { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.4rem; }

  /* ---------- packing (panel 5) ---------- */
  .kvq-pack { min-width: 640px; padding: 0.4rem 0; }
  .kvq-nibrow, .kvq-byterow { display: flex; gap: 0.45rem; }
  .kvq-nib {
    flex: 1;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.18em;
    background: var(--accent-soft);
    border: 1px solid var(--accent);
    color: var(--accent-strong);
    border-radius: 7px;
    padding: 0.45em 0;
    cursor: help;
  }
  .kvq-nib.hi { background: var(--surface-warm); border-color: var(--line-strong); color: var(--text); }
  .kvq-bracerow {
    display: flex;
    margin: 0.1rem 0;
    color: var(--text-tertiary);
  }
  .kvq-bracerow span { flex: 1; text-align: center; font-size: 1.1rem; line-height: 1; }
  .kvq-byte {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    background: var(--surface-dark);
    color: var(--text-on-dark);
    border-radius: 8px;
    padding: 0.5em 0;
    cursor: help;
  }
  .kvq-byte strong { font-family: var(--font-mono); font-size: 1rem; color: #f5c8b4; }
  .kvq-byte em { font-family: var(--font-mono); font-style: normal; font-size: 0.72rem; color: var(--text-on-dark-secondary); letter-spacing: 0.14em; }

  .kvq-record {
    display: flex;
    gap: 3px;
    margin: 0.6rem 0 0.4rem;
    border-radius: var(--radius-s);
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    text-align: center;
    min-height: 2.6em;
  }
  .kvq-record span { display: flex; align-items: center; justify-content: center; padding: 0.5em 0.4em; }
  .kvq-record .rec-codes { flex: 8; background: var(--accent-soft); color: var(--accent-strong); border: 1px solid var(--accent); border-radius: 7px 0 0 7px; }
  .kvq-record .rec-scale { flex: 1.2; background: #e6e9df; border: 1px solid var(--swatch-olive); cursor: help; }
  .kvq-record .rec-zero { flex: 1.2; background: #eaf1f8; border: 1px solid var(--swatch-sky); border-radius: 0 7px 7px 0; cursor: help; }

  /* ---------- read-path animation (panel 6) ---------- */
  .kvq-pkt { animation: kvqFlow 3s linear infinite; }
  @keyframes kvqFlow {
    0%   { transform: translateX(0); opacity: 1; }
    88%  { opacity: 1; }
    100% { transform: translateX(450px); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .kvq-pkt { animation: none; transform: translateX(180px); }
    .kvq.js .kvq-panel.active, .kvq.js .kvq-panel.active .kvq-dotg { animation: none; }
  }

  /* ---------- failure cards (panel 7) ---------- */
  .kvq-failgrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
  }
  .kvq-fail {
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    align-self: start;
  }
  .kvq-fail summary {
    cursor: pointer;
    padding: 0.9rem 1.1rem;
    font-weight: 600;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    list-style: none;
  }
  .kvq-fail summary::-webkit-details-marker { display: none; }
  .kvq-fail summary:hover { color: var(--accent-strong); }
  .kvq-fail .fail-body { padding: 0 1.1rem 1rem; }
  .kvq-fail .fail-body p { font-size: 0.9rem; color: var(--text-secondary); margin: 0 0 0.8em; }

  /* ---------- tooltip ---------- */
  .kvq-tip {
    position: absolute;
    z-index: 30;
    max-width: 300px;
    background: var(--surface-dark);
    color: var(--text-on-dark);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    line-height: 1.5;
    padding: 0.5em 0.8em;
    border-radius: 8px;
    pointer-events: none;
    box-shadow: var(--shadow-card-hover);
  }
</style>

<script>
  const root = document.getElementById('kvq-explorer');

  const captions = [
    {
      en: 'A new token has just been decoded. Its key and value tensors — [32 heads × 128 dim] in FP16, per layer — are appended to the cache: 16 KiB per layer, 512 KiB per token across all 32 layers. Hover any head cell for its exact size.',
      ko: '새 토큰 하나가 방금 decode되었다. 그 key와 value tensor — layer당 FP16 [32 heads × 128 dim] — 가 캐시에 append된다: layer당 16 KiB, 32개 layer 전체로 토큰당 512 KiB. head 셀에 마우스를 올리면 정확한 크기가 보인다.',
    },
    {
      en: 'Quantization never sees the whole tensor. It works group-by-group. Here are 8 real FP16 channel values from one key row — the group we are about to compress from 16 bytes to 4.',
      ko: 'Quantization은 tensor 전체를 보지 않는다. 그룹 단위로 동작한다. 여기 한 key row에서 가져온 실제 FP16 channel 값 8개가 있다 — 지금부터 16 byte를 4 byte로 압축할 그룹이다.',
    },
    {
      en: 'One pass finds min = −0.28 and max = 0.87. Two numbers fall out: the scale s = 0.07667 (width of one grid step) and the zero-point z = 4 (the integer code that decodes to 0.0).',
      ko: '한 번의 스캔으로 min = −0.28, max = 0.87을 찾는다. 숫자 두 개가 따라 나온다: scale s = 0.07667 (grid 한 스텝의 폭)과 zero-point z = 4 (0.0으로 decode되는 정수 code).',
    },
    {
      en: 'Every value snaps to the nearest of 16 grid levels: q = round(x/s) + z. Hover the dots — each rounding error is bounded by half a step, s/2 = 0.0383. The table shows the full arithmetic per element.',
      ko: '모든 값이 16개 grid level 중 가장 가까운 곳으로 스냅된다: q = round(x/s) + z. 점 위에 마우스를 올려 보라 — 각 rounding error는 반 스텝 s/2 = 0.0383으로 유계다. 표에 element별 전체 산술이 있다.',
    },
    {
      en: 'Two 4-bit codes share each byte, low nibble first. 16 bytes of FP16 became 4 bytes of codes plus a shared scale and zero-point — 3.76× smaller at group size 128, i.e. 4.25 effective bits per value.',
      ko: '4-bit code 두 개가 byte 하나를 나눠 쓴다, low nibble 먼저. FP16 16 byte가 code 4 byte + 공유 scale/zero-point가 되었다 — group size 128에서 3.76× 축소, 즉 값당 4.25 effective bits.',
    },
    {
      en: 'Decode-time attention must re-read every cached token. Packed codes and scales stream HBM → L2 → SM; dequant is one FMA per element in registers; dot products stay FP16. Attention is memory-bound, so 3.76× fewer bytes ≈ 3.8× faster cache reads.',
      ko: 'Decode-time attention은 캐시된 모든 토큰을 다시 읽어야 한다. 패킹된 code와 scale이 HBM → L2 → SM으로 스트리밍되고, dequant는 register에서 element당 FMA 하나, dot product는 FP16 그대로다. Attention은 memory-bound이므로 바이트 3.76× 감소 ≈ cache read 3.8× 가속.',
    },
    {
      en: 'Where the clean picture breaks: outlier channels in K wreck shared scales, the grouping axis must differ for K and V, the first tokens are load-bearing, and uniform grids fall off a cliff at 2 bits. Click each card.',
      ko: '깔끔한 그림이 깨지는 곳: K의 outlier channel이 공유 scale을 망가뜨리고, grouping 축은 K와 V가 달라야 하며, 첫 토큰들은 하중을 받치고 있고, uniform grid는 2 bit에서 절벽으로 떨어진다. 각 카드를 클릭해 보라.',
    },
  ];

  const captionFor = (i) => {
    const c = captions[i];
    if (!c) return '';
    const lang = typeof window.siteLang === 'function' ? window.siteLang() : 'en';
    return lang === 'ko' ? c.ko : c.en;
  };

  if (root) {
    root.classList.add('js');

    const panels = Array.from(root.querySelectorAll('.kvq-panel'));
    const pips = Array.from(root.querySelectorAll('.kvq-pip'));
    const prevBtn = document.getElementById('kvq-prev');
    const nextBtn = document.getElementById('kvq-next');
    const playBtn = document.getElementById('kvq-play');
    const capText = document.getElementById('kvq-caption-text');
    const stepNum = document.getElementById('kvq-step-num');

    let current = 0;
    let timer = null;

    function show(n) {
      current = ((n % panels.length) + panels.length) % panels.length;
      panels.forEach((p, i) => p.classList.toggle('active', i === current));
      pips.forEach((p, i) => {
        p.classList.toggle('active', i === current);
        p.setAttribute('aria-selected', i === current ? 'true' : 'false');
      });
      if (capText) capText.textContent = captionFor(current);
      if (stepNum) stepNum.textContent = 'Step ' + (current + 1) + ' / ' + panels.length;
    }

    window.addEventListener('site-langchange', () => {
      if (capText) capText.textContent = captionFor(current);
    });

    function stopPlay() {
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
        if (playBtn) playBtn.textContent = 'Play';
      }
    }

    if (prevBtn) prevBtn.addEventListener('click', () => { stopPlay(); show(current - 1); });
    if (nextBtn) nextBtn.addEventListener('click', () => { stopPlay(); show(current + 1); });
    pips.forEach((p) =>
      p.addEventListener('click', () => {
        stopPlay();
        show(parseInt(p.getAttribute('data-step') || '0', 10));
      })
    );

    if (playBtn)
      playBtn.addEventListener('click', () => {
        if (timer !== null) {
          stopPlay();
        } else {
          playBtn.textContent = 'Pause';
          show(current + 1 === panels.length ? 0 : current); // restart from 0 if at end
          timer = setInterval(() => {
            if (current === panels.length - 1) stopPlay();
            else show(current + 1);
          }, 7000);
        }
      });

    document.addEventListener('keydown', (e) => {
      const t = e.target;
      const tag = t && t.tagName ? t.tagName.toLowerCase() : '';
      if (tag === 'input' || tag === 'textarea' || tag === 'select') return;
      const r = root.getBoundingClientRect();
      const visible = r.top < window.innerHeight && r.bottom > 0;
      if (!visible) return;
      if (e.key === 'ArrowRight') { stopPlay(); show(current + 1); }
      if (e.key === 'ArrowLeft') { stopPlay(); show(current - 1); }
    });

    // ---------- shared tooltip ----------
    const tip = document.getElementById('kvq-tip');
    if (tip) {
      const place = (e) => {
        const r = root.getBoundingClientRect();
        let x = e.clientX - r.left + 14;
        let y = e.clientY - r.top + 16;
        const maxX = r.width - tip.offsetWidth - 10;
        if (x > maxX) x = Math.max(6, maxX);
        tip.style.left = x + 'px';
        tip.style.top = y + 'px';
      };
      const curLang = () => (window.siteLang ? window.siteLang() : 'en');
      root.querySelectorAll('[data-tip]').forEach((el) => {
        el.addEventListener('mouseenter', (e) => {
          const ko = el.getAttribute('data-tip-ko');
          tip.textContent = (curLang() === 'ko' && ko ? ko : el.getAttribute('data-tip')) || '';
          tip.hidden = false;
          place(e);
        });
        el.addEventListener('mousemove', place);
        el.addEventListener('mouseleave', () => { tip.hidden = true; });
      });
    }

    show(0);
  }
</script>
