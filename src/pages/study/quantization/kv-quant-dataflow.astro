---
import Base from '../../../layouts/Base.astro';
import LangToggle from '../../../components/LangToggle.astro';

// ------------------------------------------------------------------
// Running example (all public/textbook arithmetic):
// Llama-2-7B-shaped decoder — 32 layers, MHA, 32 KV heads x 128 dim, FP16.
// Quantization: asymmetric INT4, group-wise (toy 8-value group for the
// worked math; g = 128 for the storage arithmetic).
// ------------------------------------------------------------------

const heads = Array.from({ length: 32 }, (_, h) => h);

// asymmetric INT4 over the toy group: min = -0.28, max = 0.87
// s = 1.15 / 15 = 0.0766667, z = round(0.28 / s) = 4
const s = 1.15 / 15;
const z = 4;

// x-position on the number line: domain [-0.36, 0.90] -> px [60, 900]
const X = (v: number) => 60 + (v + 0.36) * (840 / 1.26);

const levels = Array.from({ length: 16 }, (_, q) => ({ q, v: (q - z) * s }));

const group = [
  { c: 'c0', x: 0.42,  xd: '0.42',  scaled: '5.478',  rnd: '5',  q: 9,  bits: '1001', deq: '0.3833',  err: '−0.0367' },
  { c: 'c1', x: -0.13, xd: '−0.13', scaled: '−1.696', rnd: '−2', q: 2,  bits: '0010', deq: '−0.1533', err: '−0.0233' },
  { c: 'c2', x: 0.87,  xd: '0.87',  scaled: '11.348', rnd: '11', q: 15, bits: '1111', deq: '0.8433',  err: '−0.0267' },
  { c: 'c3', x: 0.05,  xd: '0.05',  scaled: '0.652',  rnd: '1',  q: 5,  bits: '0101', deq: '0.0767',  err: '+0.0267' },
  { c: 'c4', x: -0.28, xd: '−0.28', scaled: '−3.652', rnd: '−4', q: 0,  bits: '0000', deq: '−0.3067', err: '−0.0267' },
  { c: 'c5', x: 0.61,  xd: '0.61',  scaled: '7.957',  rnd: '8',  q: 12, bits: '1100', deq: '0.6133',  err: '+0.0033' },
  { c: 'c6', x: 0.17,  xd: '0.17',  scaled: '2.217',  rnd: '2',  q: 6,  bits: '0110', deq: '0.1533',  err: '−0.0167' },
  { c: 'c7', x: -0.02, xd: '−0.02', scaled: '−0.261', rnd: '0',  q: 4,  bits: '0100', deq: '0.0000',  err: '+0.0200' },
];

const packedBytes = [
  { hex: '0x29', bits: '0010 1001', hi: 'c1 · q=2',  lo: 'c0 · q=9'  },
  { hex: '0x5F', bits: '0101 1111', hi: 'c3 · q=5',  lo: 'c2 · q=15' },
  { hex: '0xC0', bits: '1100 0000', hi: 'c5 · q=12', lo: 'c4 · q=0'  },
  { hex: '0x46', bits: '0100 0110', hi: 'c7 · q=4',  lo: 'c6 · q=6'  },
];
---

<Base
  title="KV-Cache Quantization, Byte by Byte — Junwon Lee"
  description="An interactive tear-down of KV-cache quantization: real FP16 tensors, real INT4 scale/zero arithmetic, nibble packing, and the HBM read path that makes it fast."
>
  <!-- ============ hero ============ -->
  <section class="section">
    <div class="container">
      <div class="hero-top">
        <p class="eyebrow">Study · Quantization</p>
        <LangToggle />
      </div>
      <h1>
        <span class="lang-en">What actually happens when you quantize a KV cache</span><span class="lang-ko">KV cache를 quantize하면 실제로 무슨 일이 일어나는가</span>
      </h1>
      <p class="lede">
        <span class="lang-en">
          Not the cartoon version. A step-through of the real dataflow — actual tensor shapes,
          actual scale/zero arithmetic on an 8-value group, actual bytes packed into HBM, and the
          roofline arithmetic that explains why 4× fewer bytes is (almost) 4× faster decode
          attention. Every number on this page can be recomputed by hand.
        </span><span class="lang-ko">
          만화 버전이 아니다. 실제 dataflow를 한 단계씩 따라간다 — 실제 tensor shape, 8개 값
          그룹에 대한 실제 scale/zero 산술, HBM에 실제로 패킹되는 바이트, 그리고 바이트가 4×
          줄면 decode attention이 (거의) 4× 빨라지는 이유를 설명하는 roofline 산술까지. 이
          페이지의 모든 숫자는 손으로 다시 계산할 수 있다.
        </span>
      </p>
      <div class="hero-tags">
        <span class="tag accent">asymmetric INT4</span>
        <span class="tag">group-wise</span>
        <span class="tag">Llama-2-7B-shaped config</span>
        <span class="tag">memory-bound decode</span>
      </div>
    </div>
  </section>

  <!-- ============ explorer ============ -->
  <section class="section-tight">
    <div class="container">
      <div class="viz-frame kvq" id="kvq-explorer">

        <!-- controls (shown only with JS) -->
        <div class="kvq-controls">
          <button class="btn ghost" id="kvq-prev" type="button" aria-label="Previous step">← Prev</button>
          <div class="kvq-pips" role="tablist" aria-label="Steps">
            <button class="kvq-pip" type="button" role="tab" data-step="0">1 · <span class="lang-en">Arrive</span><span class="lang-ko">도착</span></button>
            <button class="kvq-pip" type="button" role="tab" data-step="1">2 · <span class="lang-en">Group</span><span class="lang-ko">그룹</span></button>
            <button class="kvq-pip" type="button" role="tab" data-step="2">3 · <span class="lang-en">Scale</span><span class="lang-ko">스케일</span></button>
            <button class="kvq-pip" type="button" role="tab" data-step="3">4 · <span class="lang-en">Snap</span><span class="lang-ko">스냅</span></button>
            <button class="kvq-pip" type="button" role="tab" data-step="4">5 · <span class="lang-en">Pack</span><span class="lang-ko">패킹</span></button>
            <button class="kvq-pip" type="button" role="tab" data-step="5">6 · <span class="lang-en">Read</span><span class="lang-ko">읽기</span></button>
            <button class="kvq-pip" type="button" role="tab" data-step="6">7 · <span class="lang-en">Break</span><span class="lang-ko">한계</span></button>
          </div>
          <button class="btn" id="kvq-next" type="button" aria-label="Next step">Next →</button>
          <button class="btn ghost" id="kvq-play" type="button">Play</button>
        </div>

        <!-- narration bar (shown only with JS) -->
        <div class="kvq-caption" aria-live="polite">
          <span class="kvq-step-num" id="kvq-step-num">Step 1 / 7</span>
          <span id="kvq-caption-text"></span>
        </div>

        <div class="kvq-stage">

          <!-- ======== PANEL 0 · arrival ======== -->
          <section class="kvq-panel" data-panel="0">
            <h3 class="kvq-panel-title"><span class="kvq-stepchip">1</span><span class="lang-en">One decode step, two tensors</span><span class="lang-ko">디코드 한 스텝, 두 개의 텐서</span></h3>
            <div class="kvq-cols">
              <div class="kvq-scroll">
                <svg class="kvq-svg" viewBox="0 0 960 332" style="min-width: 720px" role="img"
                     aria-label="A decoded token producing K and V tensors of shape 32 heads by 128 dims per layer">
                  <defs>
                    <marker id="kvq-arr0" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
                      <path d="M0,0 L8,4 L0,8 z" fill="var(--text-tertiary)"></path>
                    </marker>
                  </defs>

                  <!-- token chip -->
                  <rect x="20" y="125" width="150" height="82" rx="10" fill="var(--surface-warm)" stroke="var(--line-strong)"></rect>
                  <text x="95" y="152" text-anchor="middle" class="t-small t-tert">decoded token</text>
                  <text x="95" y="176" text-anchor="middle" class="t-mono t-big">t = 4097</text>
                  <text x="95" y="196" text-anchor="middle" class="t-small t-tert">one decode step</text>

                  <line x1="172" y1="150" x2="238" y2="98"  stroke="var(--text-tertiary)" stroke-dasharray="4 4" marker-end="url(#kvq-arr0)"></line>
                  <line x1="172" y1="182" x2="238" y2="238" stroke="var(--text-tertiary)" stroke-dasharray="4 4" marker-end="url(#kvq-arr0)"></line>

                  <!-- K grid -->
                  <g transform="translate(250, 26)">
                    <text x="0" y="12" class="t-label">K · shape [32 heads × 128 dim] · FP16 · 8,192 B</text>
                    {heads.map((h) => (
                      <rect
                        x={(h % 8) * 44}
                        y={24 + Math.floor(h / 8) * 24}
                        width="40" height="20" rx="3"
                        fill={h === 3 ? 'var(--accent)' : 'var(--accent-soft)'}
                        stroke="var(--line-strong)"
                        class="kvq-headcell"
                        data-tip={`K · head ${h} · [128] × FP16 (2 B) = 256 B`}
                        data-tip-ko={`K · ${h}번 head · [128] × FP16 (2 B) = 256 B`}
                      ></rect>
                    ))}
                    <text x="356" y="76" class="t-small t-tert">32 KV heads</text>
                  </g>

                  <!-- V grid -->
                  <g transform="translate(250, 200)">
                    <text x="0" y="12" class="t-label">V · shape [32 heads × 128 dim] · FP16 · 8,192 B</text>
                    {heads.map((h) => (
                      <rect
                        x={(h % 8) * 44}
                        y={24 + Math.floor(h / 8) * 24}
                        width="40" height="20" rx="3"
                        fill="#e6e9df"
                        stroke="var(--line-strong)"
                        class="kvq-headcell"
                        data-tip={`V · head ${h} · [128] × FP16 (2 B) = 256 B`}
                        data-tip-ko={`V · ${h}번 head · [128] × FP16 (2 B) = 256 B`}
                      ></rect>
                    ))}
                    <text x="356" y="76" class="t-small t-tert">32 KV heads</text>
                  </g>

                  <!-- zoom callout on K head 3 -->
                  <line x1="424" y1="52" x2="618" y2="56"  stroke="var(--accent)" stroke-dasharray="3 4"></line>
                  <line x1="424" y1="72" x2="618" y2="116" stroke="var(--accent)" stroke-dasharray="3 4"></line>
                  <rect x="620" y="48" width="316" height="72" rx="9" fill="var(--surface)" stroke="var(--accent)"></rect>
                  <text x="778" y="72" text-anchor="middle" class="t-mono t-mid">K[3, :] — one head&apos;s key row</text>
                  <text x="778" y="92" text-anchor="middle" class="t-small">128 dims × 2 B = 256 B</text>
                  <text x="778" y="110" text-anchor="middle" class="t-small t-accent">next step zooms into channels 0–7</text>

                  <text x="620" y="180" class="t-small t-tert">Every decode step appends one K row and one V row</text>
                  <text x="620" y="198" class="t-small t-tert">per head, per layer — the cache only ever grows.</text>
                </svg>
              </div>

              <aside class="kvq-aside">
                <h4><span class="lang-en">The bill, per token</span><span class="lang-ko">토큰당 청구서</span></h4>
                <ul class="kvq-ledger">
                  <li><span><span class="lang-en">K, one layer</span><span class="lang-ko">K, 레이어 1개</span></span><code>32 × 128 × 2 B = 8,192 B</code></li>
                  <li><span><span class="lang-en">K + V, one layer</span><span class="lang-ko">K + V, 레이어 1개</span></span><code>16,384 B = 16 KiB</code></li>
                  <li><span><span class="lang-en">× 32 layers</span><span class="lang-ko">× 32 레이어</span></span><code>512 KiB per token</code></li>
                  <li><span><span class="lang-en">× 4,096 tokens</span><span class="lang-ko">× 4,096 토큰</span></span><code>2.0 GiB per sequence</code></li>
                  <li><span>× batch 8</span><code>16 GiB — before weights</code></li>
                </ul>
                <details class="kvq-more">
                  <summary><span class="lang-en">Why a cache at all? And what about GQA?</span><span class="lang-ko">애초에 왜 캐시인가? 그리고 GQA는?</span></summary>
                  <p>
                    <span class="lang-en">
                      Attention at step t needs K and V of every earlier token. Recomputing them
                      would cost a full forward pass per step, so we cache — trading FLOPs for
                      memory, which then becomes the thing to compress. Grouped-query models shrink
                      the head count (Llama-3-8B keeps 8 KV heads, not 32), dividing every number in
                      this ledger by 4 — but the pipeline on this page is identical.
                    </span><span class="lang-ko">
                      스텝 t의 attention은 앞선 모든 토큰의 K와 V를 필요로 한다. 매번 다시
                      계산하면 스텝마다 full forward pass 비용이 들기 때문에 캐시한다 — FLOPs를
                      memory와 맞바꾸는 것이고, 그 memory가 이번엔 압축 대상이 된다.
                      Grouped-query 모델은 head 수를 줄여 (Llama-3-8B는 32개가 아닌 8개의 KV
                      head) 이 장부의 모든 숫자를 4로 나눈다 — 하지만 이 페이지의 파이프라인은
                      동일하다.
                    </span>
                  </p>
                </details>
              </aside>
            </div>
          </section>

          <!-- ======== PANEL 1 · the group ======== -->
          <section class="kvq-panel" data-panel="1">
            <h3 class="kvq-panel-title"><span class="kvq-stepchip">2</span><span class="lang-en">Zoom in: one quantization group</span><span class="lang-ko">확대: quantization group 하나</span></h3>
            <p class="kvq-note">
              <span class="lang-en">
                Quantizers never see the whole tensor — they work on small <strong>groups</strong> that share
                one scale and one zero-point. Below: the first 8 channels of <code>K[3, :]</code>, real FP16
                values. (8 is a toy size so the math fits on screen; production kernels use g = 32–128.
                Step 5 does the storage arithmetic at g = 128.)
              </span><span class="lang-ko">
                Quantizer는 tensor 전체를 보지 않는다 — scale 하나와 zero-point 하나를 공유하는
                작은 <strong>그룹</strong> 단위로 동작한다. 아래는 <code>K[3, :]</code>의 처음 8개
                channel, 실제 FP16 값이다. (8은 수식이 화면에 들어오도록 고른 toy 크기이고,
                production kernel은 g = 32–128을 쓴다. Step 5에서 g = 128로 저장 산술을 한다.)
              </span>
            </p>
            <div class="kvq-scroll">
              <div class="kvq-vals">
                {group.map((g) => (
                  <div
                    class:list={['kvq-val', { 'is-max': g.c === 'c2', 'is-min': g.c === 'c4' }]}
                    data-tip={`${g.c} · FP16 · 2 bytes`}
                    data-tip-ko={`${g.c} · FP16 · 2 bytes`}
                  >
                    <span class="idx">{g.c}</span>
                    <span class="num">{g.xd}</span>
                    <span class="b">2 B</span>
                    {g.c === 'c2' && <span class="mm">max</span>}
                    {g.c === 'c4' && <span class="mm">min</span>}
                  </div>
                ))}
              </div>
            </div>
            <p class="kvq-note">
              <span class="lang-en">
                Group total in FP16: <code>8 × 2 B = 16 B</code>. The goal of the next three steps is to
                rewrite these 16 bytes as <strong>4 bytes of codes</strong> plus a small shared header —
                while keeping every value within half a grid step of where it started.
              </span><span class="lang-ko">
                FP16 기준 그룹 합계: <code>8 × 2 B = 16 B</code>. 다음 세 단계의 목표는 이
                16바이트를 <strong>code 4바이트</strong>와 작은 공유 header로 다시 쓰는 것이다 —
                모든 값이 원래 자리에서 grid 반 스텝 이내에 머물게 하면서.
              </span>
            </p>
          </section>

          <!-- ======== PANEL 2 · scale & zero ======== -->
          <section class="kvq-panel" data-panel="2">
            <h3 class="kvq-panel-title"><span class="kvq-stepchip">3</span><span class="lang-en">Two numbers summarize the group</span><span class="lang-ko">숫자 두 개가 그룹을 요약한다</span></h3>
            <div class="kvq-math-grid">
              <div class="kvq-math">
                <span class="k">1 · scan</span>
                <code>min = −0.28 <em>(c4)</em></code>
                <code>max = &nbsp;0.87 <em>(c2)</em></code>
                <code>range = 1.15</code>
                <p><span class="lang-en">One pass over the 8 values.</span><span class="lang-ko">8개 값을 한 번에 스캔.</span></p>
              </div>
              <div class="kvq-math">
                <span class="k">2 · scale</span>
                <code>s = range / (2⁴ − 1)</code>
                <code>&nbsp;&nbsp;= 1.15 / 15</code>
                <code>&nbsp;&nbsp;= <strong>0.07667</strong></code>
                <p><span class="lang-en">The width of one grid step: 16 codes ⇒ 15 steps between them.</span><span class="lang-ko">grid 한 스텝의 폭: code 16개 ⇒ 그 사이 스텝은 15개.</span></p>
              </div>
              <div class="kvq-math">
                <span class="k">3 · zero-point</span>
                <code>z = round(−min / s)</code>
                <code>&nbsp;&nbsp;= round(3.652)</code>
                <code>&nbsp;&nbsp;= <strong>4</strong></code>
                <p><span class="lang-en">The integer code that decodes to ≈ 0.0 — this is what makes it <em>asymmetric</em>.</span><span class="lang-ko">≈ 0.0으로 decode되는 정수 code — 이것이 <em>asymmetric</em>의 핵심이다.</span></p>
              </div>
            </div>
            <div class="kvq-formula">
              <span>quantize</span><code>q = clamp( round(x / s) + z, 0, 15 )</code>
              <span>dequantize</span><code>x̂ = (q − z) × s</code>
            </div>
            <details class="kvq-more">
              <summary><span class="lang-en">Why asymmetric? A concrete comparison</span><span class="lang-ko">왜 asymmetric인가? 구체적 비교</span></summary>
              <p>
                <span class="lang-en">
                  A symmetric INT4 quantizer centers its grid at zero and must cover
                  <code>max(|min|, |max|) = 0.87</code> on <em>both</em> sides:
                  <code>s = 0.87 / 7 = 0.124</code>. This group is skewed positive
                  (max = 0.87 vs |min| = 0.28), so the asymmetric grid&apos;s step of 0.0767 is
                  <strong>38% finer</strong> for the same 4 bits — the zero-point simply slides the grid
                  to hug [min, max]. KV activations are routinely skewed, which is why asymmetric is
                  the default for cache quantization.
                </span><span class="lang-ko">
                  Symmetric INT4 quantizer는 grid를 0에 중심 맞추고
                  <code>max(|min|, |max|) = 0.87</code>을 <em>양쪽</em> 모두 커버해야 한다:
                  <code>s = 0.87 / 7 = 0.124</code>. 이 그룹은 양수 쪽으로 치우쳐 있어
                  (max = 0.87 vs |min| = 0.28), 같은 4 bit로도 asymmetric grid의 스텝 0.0767이
                  <strong>38% 더 촘촘하다</strong> — zero-point는 grid를 [min, max]에 밀착하도록
                  밀어줄 뿐이다. KV activation은 으레 치우쳐 있으므로, cache quantization에서는
                  asymmetric이 기본값이다.
                </span>
              </p>
            </details>
          </section>

          <!-- ======== PANEL 3 · snap to grid ======== -->
          <section class="kvq-panel" data-panel="3">
            <h3 class="kvq-panel-title"><span class="kvq-stepchip">4</span><span class="lang-en">Snap every value to the 16-level grid</span><span class="lang-ko">모든 값을 16-level grid에 스냅</span></h3>
            <div class="kvq-scroll">
              <svg class="kvq-svg" viewBox="0 0 940 220" style="min-width: 720px" role="img"
                   aria-label="Number line with 16 quantization levels; 8 FP16 values snap to their nearest level">
                <defs>
                  <marker id="kvq-arr3" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto">
                    <path d="M0,0 L7,3.5 L0,7 z" fill="var(--accent)"></path>
                  </marker>
                </defs>

                <text x="60" y="24" class="t-small t-tert">FP16 values (hover for exact rounding error)</text>
                <text x="900" y="24" text-anchor="end" class="t-small t-tert">grid: x̂(q) = (q − 4) × 0.07667</text>

                <!-- original values + snap arrows -->
                {group.map((g, i) => (
                  <g class="kvq-dotg" style={`animation-delay:${i * 90}ms`}>
                    <line
                      x1={X(g.x).toFixed(1)} y1="98"
                      x2={X((g.q - z) * s).toFixed(1)} y2="138"
                      stroke="var(--accent)" stroke-dasharray="3 3" opacity="0.55"
                      marker-end="url(#kvq-arr3)"
                    ></line>
                    <circle
                      cx={X(g.x).toFixed(1)} cy="90" r="7"
                      fill="var(--accent)" stroke="var(--surface)" stroke-width="1.5"
                      data-tip={`${g.c}: ${g.xd} → q=${g.q} → ${g.deq}  (err ${g.err})`}
                      data-tip-ko={`${g.c}: ${g.xd} → q=${g.q} → ${g.deq}  (오차 ${g.err})`}
                    ></circle>
                    <text x={X(g.x).toFixed(1)} y="74" text-anchor="middle" class="t-small t-tert">{g.c}</text>
                  </g>
                ))}

                <!-- baseline + 16 levels -->
                <line x1="60" y1="150" x2="900" y2="150" stroke="var(--line-strong)" stroke-width="2"></line>
                {levels.map((l) => (
                  <g>
                    <line
                      x1={X(l.v).toFixed(1)} y1="142" x2={X(l.v).toFixed(1)} y2="158"
                      stroke={l.q === 4 ? 'var(--swatch-sky)' : 'var(--line-strong)'}
                      stroke-width={l.q === 4 ? 3 : 2}
                    ></line>
                    <text x={X(l.v).toFixed(1)} y="175" text-anchor="middle" class="t-tick">{l.q}</text>
                  </g>
                ))}
                <text x={X(-0.3067).toFixed(1)} y="196" text-anchor="middle" class="t-small t-tert">−0.307</text>
                <text x={X(0).toFixed(1)} y="196" text-anchor="middle" class="t-small" fill="var(--swatch-sky)">z = 4 → 0.0</text>
                <text x={X(0.8433).toFixed(1)} y="196" text-anchor="middle" class="t-small t-tert">0.843</text>
                <text x="900" y="215" text-anchor="end" class="t-small t-tert">codes q = 0 … 15</text>
              </svg>
            </div>

            <div class="kvq-scroll">
              <table class="kvq-table">
                <thead>
