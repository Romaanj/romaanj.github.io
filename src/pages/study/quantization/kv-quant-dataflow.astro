                    <span class:list={['kvq-nib', { hi: i % 2 === 1 }]} data-tip={`${g.c} → q=${g.q} → ${g.bits}`} data-tip-ko={`${g.c} → q=${g.q} → ${g.bits}`}>
                      {g.bits}
