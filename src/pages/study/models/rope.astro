    if (!el) return;
    const e = el.querySelector('.lang-en');
    const k = el.querySelector('.lang-ko');
    if (e) e.textContent = en;
    if (k) k.textContent = ko;
  }
  const curLang = () => ((window as any).siteLang ? (window as any).siteLang() : 'en');

  // ---------- shared tooltip (bilingual, DELEGATED so re-rendered SVG keeps working) ----------
  const tip = $('ropeTip');
  document.addEventListener('mousemove', (e) => {
    if (!tip) return;
    const t = e.target as Element;
    const el = t && t.closest ? t.closest('[data-tip]') : null;
    if (!el || !el.closest('.rope-page')) { tip.style.opacity = '0'; return; }
    const ko = el.getAttribute('data-tip-ko');
    tip.textContent = (curLang() === 'ko' && ko ? ko : el.getAttribute('data-tip')) || '';
    tip.style.opacity = '1';
    tip.style.left = Math.min(e.clientX + 14, window.innerWidth - 336) + 'px';
    tip.style.top = e.clientY + 18 + 'px';
  });

  // ================= b · ONE PAIR = ONE DIAL =================
  // pairs of the d=8 worked example (section g)
  const QP = [[1, 0], [0.5, -0.5], [0.2, 0.3], [-0.4, 0.1]];
  const KP = [[0, 1], [0.3, 0.7], [-0.1, 0.2], [0.6, -0.2]];
  const OMB = [1, 0.1, 0.01, 0.001];
  const PCX = 190, PCY = 160, PR = 110; // keep in sync with the static SVG
  const pb = { m: 3, n: 7, band: 0 };

  const slM = $('slM') as HTMLInputElement | null;
  const slN = $('slN') as HTMLInputElement | null;

  function rot2(v: number[], a: number): number[] {
    return [v[0] * Math.cos(a) - v[1] * Math.sin(a), v[0] * Math.sin(a) + v[1] * Math.cos(a)];
  }
  function setVec(id: string, v: number[]) {
    const el = $(id);
    if (!el) return;
    el.setAttribute('x2', String(PCX + v[0] * PR));
    el.setAttribute('y2', String(PCY - v[1] * PR));
  }
  const BAND_CAPS: { en: string; ko: string }[] = [
    {
      en: 'Pair 0 is the fastest dial: ω = 1 rad/token — it advances ≈57° (about a sixth of a turn) between neighboring tokens, so this band distinguishes m = 3 from m = 4 sharply. Shift both positions together and the score stands still: only Δω survives the dot product.',
      ko: 'pair 0은 가장 빠른 다이얼이다: ω = 1 rad/token — 이웃 token 사이에 약 57°(약 1/6 바퀴) 돌아, 이 band는 m = 3과 m = 4를 날카롭게 구분한다. 두 position을 같이 밀면 score는 멈춰 있다: dot product에서 살아남는 것은 Δω뿐이다.',
    },
    {
      en: 'Pair 1 turns 10× slower (ω = 0.1, λ = 62.8 tokens): within a sentence the arrows drift rather than spin. Same identity, gentler phase.',
      ko: 'pair 1은 10배 느리게 돈다 (ω = 0.1, λ = 62.8 tokens): 문장 하나 안에서는 화살표가 도는 게 아니라 슬며시 밀린다. 같은 항등식, 더 완만한 위상.',
    },
    {
      en: 'Pair 2 (ω = 0.01, λ = 628 tokens): across this whole slider range the rotation is a few degrees — the band is nearly position-blind at sentence scale.',
      ko: 'pair 2 (ω = 0.01, λ = 628 tokens): 이 slider 범위 전체에서 회전은 몇 도에 불과하다 — 문장 규모에서는 사실상 position을 보지 못하는 band다.',
    },
    {
      en: 'Pair 3 (ω = 0.001, λ = 6,283 tokens): the slow dial. At any position on this slider the pair is essentially unrotated — a distance-agnostic channel, which is exactly what the lowest bands become in real heads (section d).',
      ko: 'pair 3 (ω = 0.001, λ = 6,283 tokens): 느린 다이얼. 이 slider의 어느 position에서도 pair는 사실상 회전하지 않는다 — 거리-불변 channel이고, 실제 head의 최저 band가 정확히 이렇게 쓰인다 (section d).',
    },
  ];

  function pairRender() {
    const om = OMB[pb.band];
    const q0 = QP[pb.band], k0 = KP[pb.band];
    const qr = rot2(q0, pb.m * om);
    const kr = rot2(k0, pb.n * om);
    setVec('qGhost', q0); setVec('kGhost', k0);
    setVec('qArr', qr); setVec('kArr', kr);
    const ql = $('qLab'), kl = $('kLab');
    if (ql) { ql.setAttribute('x', String(PCX + qr[0] * PR * 1.22 - 24)); ql.setAttribute('y', String(PCY - qr[1] * PR * 1.22)); }
    if (kl) { kl.setAttribute('x', String(PCX + kr[0] * PR * 1.22 - 24)); kl.setAttribute('y', String(PCY - kr[1] * PR * 1.22)); }
    const c = Math.cos(pb.m * om), s = Math.sin(pb.m * om);
    const put = (id: string, v: number) => { const el = $(id); if (el) el.textContent = v.toFixed(3).replace('-', '−'); };
    put('m00', c); put('m01', -s); put('m10', s); put('m11', c);
    const mb = $('matBox');
    if (mb && mb.firstChild) mb.firstChild.textContent = `R(mω) — live 2×2 block, m = ${pb.m}, ω = ${om}\n\n  ⎡ cos mω  −sin mω ⎤   ⎡ `;
    const dot = q0[0] * k0[0] + q0[1] * k0[1];
    const crs = q0[0] * k0[1] - q0[1] * k0[0];
    const del = (pb.n - pb.m) * om;
    const score = dot * Math.cos(del) - crs * Math.sin(del);
    const fx = (v: number, d: number) => v.toFixed(d).replace('-', '−');
    const set = (id: string, txt: string) => { const el = $(id); if (el) el.textContent = txt; };
    set('cMth', fx(pb.m * om, 3)); set('cNth', fx(pb.n * om, 3));
    set('cDel', String(pb.n - pb.m)); set('cScore', fx(score, 4));
    set('vM', String(pb.m)); set('vN', String(pb.n));
    setCap($('pairCap'), BAND_CAPS[pb.band].en, BAND_CAPS[pb.band].ko);
  }
  if (slM) slM.addEventListener('input', () => { pb.m = Number(slM.value); pairRender(); });
  if (slN) slN.addEventListener('input', () => { pb.n = Number(slN.value); pairRender(); });
  const shiftBtn = $('shiftBtn');
  if (shiftBtn) shiftBtn.addEventListener('click', () => {
    if (pb.m + 10 > 50 || pb.n + 10 > 50) { pb.m = Math.max(0, pb.m - 40); pb.n = Math.max(0, pb.n - 40); }
    else { pb.m += 10; pb.n += 10; }
    if (slM) slM.value = String(pb.m);
    if (slN) slN.value = String(pb.n);
    pairRender();
  });
  document.querySelectorAll('.band-chip').forEach((b) => {
    b.addEventListener('click', () => {
      pb.band = Number((b as HTMLElement).dataset.band);
      document.querySelectorAll('.band-chip').forEach((x) => x.classList.toggle('on', x === b));
      pairRender();
    });
  });
  document.querySelectorAll('.conv-chip').forEach((b) => {
    b.addEventListener('click', () => {
      const v = (b as HTMLElement).dataset.conv;
      document.querySelectorAll('.conv-chip').forEach((x) => x.classList.toggle('on', x === b));
      const pi = $('convInter'), ph = $('convHalf');
      if (pi) pi.classList.toggle('hidden', v !== 'inter');
      if (ph) ph.classList.toggle('hidden', v !== 'half');
    });
  });
  // JS present: show one convention panel at a time (both visible without JS)
  const ph0 = $('convHalf');
  if (ph0) ph0.classList.add('hidden');
  pairRender();

  // ================= c · THE DIAL WALL =================
  // geometry mirrored from the static SSR markup — keep in sync
  const wall = { m: 64, base: 10000 };
  let wallTimer: ReturnType<typeof setInterval> | null = null;
  const fmtLamJs = (v: number): string =>
    v < 100 ? v.toFixed(1)
    : v < 1000 ? String(Math.round(v))
    : v < 100000 ? (v / 1000).toFixed(1).replace(/\.0$/, '') + 'K'
    : (v / 1e6).toFixed(2) + 'M';
  const quartJs = (i: number) => (i < 16 ? 'cq0' : i < 32 ? 'cq1' : i < 48 ? 'cq2' : 'cq3');
  const CTX_OF: Record<number, { L: number; lab: string }> = {
    10000: { L: 2048, lab: 'trained ctx 2,048 (LLaMA-era)' },
    500000: { L: 8192, lab: 'max_position 8,192 (Llama-3-8B)' },
    1000000: { L: 40960, lab: 'max_position 40,960 (Qwen3-8B)' },
  };
  const specXJs = (lam: number) =>
    40 + ((Math.log10(lam) - Math.log10(5)) / (Math.log10(6e6) - Math.log10(5))) * 880;

  function wallRender() {
    const wd = $('wallDyn');
    if (wd) {
      let s = `<text class="rowlab" x="20" y="14">dials 0–63 · ωᵢ = base^(−2i/128) rad/token · hand = current angle m·ωᵢ (mod 2π) · label = λᵢ in tokens</text>`;
      for (let i = 0; i < 64; i++) {
        const om = Math.pow(wall.base, (-2 * i) / 128);
        const lam = (2 * Math.PI) / om;
        const a = (wall.m * om) % (2 * Math.PI);
        const cx = 38 + (i % 16) * 57.5;
        const cy = 46 + Math.floor(i / 16) * 74;
        const turns = (wall.m * om) / (2 * Math.PI);
        const tipEn = `dial ${i} — ω = ${om < 0.001 ? om.toExponential(2) : om.toFixed(om < 0.01 ? 5 : 3)} rad/token · λ = ${lam < 1000 ? lam.toFixed(1) : Math.round(lam).toLocaleString('en-US')} tokens · at m = ${wall.m.toLocaleString('en-US')}: ${turns >= 1 ? turns.toFixed(1) + ' full turns' : a.toFixed(3) + ' rad'}`;
        const tipKo = `dial ${i} — ω = ${om < 0.001 ? om.toExponential(2) : om.toFixed(om < 0.01 ? 5 : 3)} rad/token · λ = ${lam < 1000 ? lam.toFixed(1) : Math.round(lam).toLocaleString('en-US')} tokens · m = ${wall.m.toLocaleString('en-US')}에서 ${turns >= 1 ? turns.toFixed(1) + '바퀴' : a.toFixed(3) + ' rad'}`;
        s += `<g data-tip="${tipEn}" data-tip-ko="${tipKo}">` +
          `<circle class="clk ${quartJs(i)}" cx="${cx}" cy="${cy}" r="17"></circle>` +
          `<line class="clk-tick" x1="${cx + 14}" y1="${cy}" x2="${cx + 17}" y2="${cy}"></line>` +
          `<line class="clk-hand" x1="${cx}" y1="${cy}" x2="${(cx + 13 * Math.cos(a)).toFixed(2)}" y2="${(cy - 13 * Math.sin(a)).toFixed(2)}"></line>` +
          `<text class="clk-lam" x="${cx}" y="${cy + 29}" text-anchor="middle">${fmtLamJs(lam)}</text></g>`;
      }
      wd.innerHTML = s;
    }
    const sd = $('specDyn');
    if (sd) {
      let s = `<line x1="40" y1="48" x2="920" y2="48" stroke="var(--line-strong)" stroke-width="1.2"></line>`;
      [10, 100, 1000, 1e4, 1e5, 1e6].forEach((v) => {
        const x = specXJs(v).toFixed(1);
        s += `<line x1="${x}" y1="44" x2="${x}" y2="52" stroke="var(--text-tertiary)" stroke-width="1"></line>` +
          `<text class="ssub" x="${x}" y="68" text-anchor="middle">${v >= 1e6 ? '1M' : v >= 1000 ? v / 1000 + 'K' : v}</text>`;
      });
      for (let i = 0; i < 64; i++) {
        const lam = 2 * Math.PI * Math.pow(wall.base, (2 * i) / 128);
        s += `<line class="spec-mark ${quartJs(i)}" x1="${specXJs(lam).toFixed(1)}" y1="30" x2="${specXJs(lam).toFixed(1)}" y2="46"></line>`;
      }
      const cm = CTX_OF[wall.base];
      const cX = specXJs(cm.L).toFixed(1);
      s += `<line x1="${cX}" y1="14" x2="${cX}" y2="52" stroke="var(--accent-strong)" stroke-width="1.4" stroke-dasharray="4 3"></line>` +
        `<text class="smono" x="${Number(cX) + 6}" y="20" fill="var(--accent-strong)">${cm.lab}</text>` +
        `<text class="rowlab" x="20" y="88">wavelength λ (tokens, log scale) — dials to the right of the context marker never complete one turn in training</text>`;
      sd.innerHTML = s;
    }
    const om63 = Math.pow(wall.base, -126 / 128);
    const a63 = wall.m * om63;
    const put = (id: string, txt: string) => { const el = $(id); if (el) el.textContent = txt; };
    put('wcM', wall.m.toLocaleString('en-US'));
    put('wcFast', (wall.m / (2 * Math.PI)).toFixed(1));
    put('wcSlow', a63 >= 2 * Math.PI
      ? (a63 / (2 * Math.PI)).toFixed(2) + ' turns'
      : a63.toFixed(4) + ' rad — ' + ((a63 / (2 * Math.PI)) * 100).toFixed(2) + '% of a turn');
    put('wcLmax', Math.round((2 * Math.PI) / om63).toLocaleString('en-US'));
    const vw = $('vWall'); if (vw) vw.textContent = wall.m.toLocaleString('en-US');
    const sl = $('slWall') as HTMLInputElement | null;
    if (sl) sl.value = String(Math.min(wall.m, 1000));
    document.querySelectorAll('.wjump').forEach((x) =>
      x.classList.toggle('on', Number((x as HTMLElement).dataset.m) === wall.m));
  }
  const WALL_CAPS: Record<number, { en: string; ko: string }> = {
    10000: {
      en: 'Base 10,000 (RoFormer): the ladder runs from λ₀ = 2π ≈ 6.28 tokens to λ₆₃ = 2π·10000^(126/128) ≈ 54,410 tokens [computed; slightly below the 2π·base ≈ 62,832 approximation]. Dial 0 disambiguates neighbors; the last dials barely move inside any real context — near position-free channels.',
      ko: 'base 10,000 (RoFormer): 사다리는 λ₀ = 2π ≈ 6.28 token에서 λ₆₃ = 2π·10000^(126/128) ≈ 54,410 token까지 뻗는다 [계산값; 2π·base ≈ 62,832 근사보다 약간 작다]. 다이얼 0은 이웃 token을 구분하고, 마지막 다이얼들은 어떤 실제 context 안에서도 거의 움직이지 않는다 — 사실상 position-free channel이다.',
    },
    500000: {
      en: 'Base 500,000 — Llama-3’s train-time route (rope_theta in config.json). The whole wall stretches: the slowest dial’s wavelength becomes ≈ 2.56M tokens [computed], so at max_position 8,192 it turns only ≈1.15° [computed]. Barbero et al.: a larger θ prevents tokens “being erroneously misaligned simply due to the large context.”',
      ko: 'base 500,000 — Llama-3의 train-time 경로 (config.json의 rope_theta). 벽 전체가 늘어난다: 가장 느린 다이얼의 wavelength가 ≈ 2.56M token이 되어 [계산값], max_position 8,192에서도 약 1.15°만 돈다 [계산값]. Barbero et al.: 큰 θ는 token들이 “단지 context가 크다는 이유로 잘못 어긋나는” 것을 막는다.',
    },
    1000000: {
      en: 'Base 1,000,000 — Qwen3-8B ships this (rope_theta 10⁶, max_position 40,960, rope_scaling null). The slowest dial’s wavelength is ≈ 5.06M tokens [computed]: over the full 40K context it moves about 0.05 rad. The top of the ladder is position-free by construction.',
      ko: 'base 1,000,000 — Qwen3-8B의 출고 사양이다 (rope_theta 10⁶, max_position 40,960, rope_scaling null). 가장 느린 다이얼의 wavelength는 ≈ 5.06M token [계산값]: 40K context 전체에서 약 0.05 rad 움직인다. 사다리 꼭대기는 구조적으로 position-free다.',
    },
  };
  function wallStop() {
    if (wallTimer !== null) { clearInterval(wallTimer); wallTimer = null; }
    const wp = $('wallPlay'); if (wp) wp.textContent = '▶ Play';
  }
  const slWall = $('slWall') as HTMLInputElement | null;
  if (slWall) slWall.addEventListener('input', () => { wallStop(); wall.m = Number(slWall.value); wallRender(); });
  document.querySelectorAll('.wjump').forEach((b) => {
    b.addEventListener('click', () => { wallStop(); wall.m = Number((b as HTMLElement).dataset.m); wallRender(); });
  });
  document.querySelectorAll('.wbase').forEach((b) => {
    b.addEventListener('click', () => {
      wall.base = Number((b as HTMLElement).dataset.b);
      document.querySelectorAll('.wbase').forEach((x) => x.classList.toggle('on', x === b));
      const c = WALL_CAPS[wall.base];
      setCap($('wallCap'), c.en, c.ko);
      wallRender();
    });
  });
  const wallPlay = $('wallPlay');
  if (wallPlay) wallPlay.addEventListener('click', () => {
    if (wallTimer !== null) { wallStop(); return; }
    wallPlay.textContent = '❚❚ Pause';
    wallTimer = setInterval(() => {
      wall.m = wall.m >= 1000 ? 0 : wall.m + 2;
      wallRender();
    }, 50);
  });
  wallRender();

  // ================= d · HOW BANDS COMBINE =================
  const CTH = [1, 0.1, 0.01, 0.001];
  const amps = [0.25, 0.45, 0.7, 1.0];
  const COMB_PRE: Record<string, number[]> = {
    sem: [0.25, 0.45, 0.7, 1.0],
    pos: [1.0, 0.35, 0.1, 0.05],
    flat: [0.6, 0.6, 0.6, 0.6],
  };
  const COMB_CAPS: Record<string, { en: string; ko: string }> = {
    sem: {
      en: 'Low-frequency-heavy — the shape Barbero et al. actually measure in trained Gemma 7B: the largest norms sit on the lowest frequencies, producing a slowly-varying, nearly distance-agnostic envelope; the fast dials only add local texture.',
      ko: 'low-frequency 우세 — Barbero et al.이 학습된 Gemma 7B에서 실측한 형태다: 가장 큰 norm이 가장 낮은 frequency에 실려 거의 거리-불변인 느린 envelope을 만들고, 빠른 다이얼은 국소적인 결만 더한다.',
    },
    pos: {
      en: 'High-frequency-heavy — a positional head: the fast band carves a sharp peak at Δ = 0 that collapses within a couple of tokens and re-rings at multiples of λ₀ = 6.3. Gemma’s last-layer diagonal head (L27 H8) and first-layer previous-token head live here (Barbero et al., Fig. 5–6).',
      ko: 'high-frequency 우세 — positional head다: 빠른 band가 Δ = 0에 날카로운 peak을 깎아 내고, 그 peak은 몇 token 만에 무너졌다가 λ₀ = 6.3의 배수마다 다시 울린다. Gemma의 마지막 layer diagonal head(L27 H8)와 첫 layer previous-token head가 여기 산다 (Barbero et al., Fig. 5–6).',
    },
    flat: {
      en: 'Equal weights — pure interference: all bands align at Δ = 0, then dephase at different rates. The sum looks like decay although no band decays — RoFormer’s long-term-decay curve is this dephasing bounded from above, and Barbero et al. argue decay is “unlikely to be the core reason” RoPE helps.',
      ko: '균등 가중 — 순수한 간섭: 모든 band가 Δ = 0에서 정렬했다가 서로 다른 속도로 어긋난다. 어느 band도 감쇠하지 않는데 합은 감쇠처럼 보인다 — RoFormer의 long-term decay 곡선은 이 어긋남의 상한이고, Barbero et al.은 decay가 RoPE 효용의 “핵심 이유일 가능성은 낮다”고 논증한다.',
    },
    custom: {
      en: 'Custom mix — logit(Δ) = Σ aᵢ·cos(Δωᵢ) with φᵢ = 0 here. In a real head aᵢ = ‖q₍ᵢ₎‖·‖k₍ᵢ₎‖ and each band also picks a phase φᵢ (the 2D angle from k₍ᵢ₎ to q₍ᵢ₎), shifting its cosine left or right.',
      ko: '직접 조합 — 여기서는 φᵢ = 0으로 logit(Δ) = Σ aᵢ·cos(Δωᵢ). 실제 head에서는 aᵢ = ‖q₍ᵢ₎‖·‖k₍ᵢ₎‖이고 band마다 위상 φᵢ(k₍ᵢ₎에서 q₍ᵢ₎로의 2D 각도)도 골라 cosine을 좌우로 민다.',
    },
  };
  function combRender() {
    const S = Math.max(1, amps.reduce((s, a) => s + a, 0));
    const line = (fn: (d: number) => number) => {
      const pts: string[] = [];
      for (let d = 0; d <= 80.001; d += 0.25) {
        pts.push((60 + d * 10.625).toFixed(1) + ',' + (160 - (fn(d) / S) * 125).toFixed(1));
      }
      return pts.join(' ');
    };
    for (let i = 0; i < 4; i++) {
      const el = $('cb' + i);
      if (el) el.setAttribute('points', line((d) => amps[i] * Math.cos(d * CTH[i])));
      const v = $('vA' + i);
      if (v) v.textContent = amps[i].toFixed(2);
    }
    const sm = $('cbSum');
    if (sm) sm.setAttribute('points', line((d) => amps.reduce((s, a, i) => s + a * Math.cos(d * CTH[i]), 0)));
    const pk = $('combPeak');
    if (pk) pk.textContent = amps.reduce((s, a) => s + a, 0).toFixed(2);
  }
  document.querySelectorAll('.amp-sl').forEach((s) => {
    s.addEventListener('input', () => {
      amps[Number((s as HTMLElement).dataset.i)] = Number((s as HTMLInputElement).value) / 100;
      document.querySelectorAll('.comb-pre').forEach((x) => x.classList.remove('on'));
      setCap($('combCap'), COMB_CAPS.custom.en, COMB_CAPS.custom.ko);
      combRender();
    });
  });
  document.querySelectorAll('.comb-pre').forEach((b) => {
    b.addEventListener('click', () => {
      const p = COMB_PRE[(b as HTMLElement).dataset.pre || 'sem'];
      for (let i = 0; i < 4; i++) amps[i] = p[i];
      document.querySelectorAll('.amp-sl').forEach((s) => {
        (s as HTMLInputElement).value = String(p[Number((s as HTMLElement).dataset.i)] * 100);
      });
      document.querySelectorAll('.comb-pre').forEach((x) => x.classList.toggle('on', x === b));
      const c = COMB_CAPS[(b as HTMLElement).dataset.pre || 'sem'];
      setCap($('combCap'), c.en, c.ko);
      combRender();
    });
  });
  combRender();

  // ================= e · EDITING THE BANDS =================
  const ed = { m: 'yarn', s: 4 };
  const edX = (i: number) => 70 + i * (850 / 63);
  const edY = (f: number) => 300 - Math.max(0, Math.min(1.02, f)) * 230;
  function edFrac(i: number): number {
    if (ed.m === 'pi') return 1 / ed.s;
    if (ed.m === 'ntk') return Math.pow(ed.s, (-2 * i) / 126);
    if (ed.m === 'base') return Math.pow(50, (-2 * i) / 128); // theta(500k)/theta(10k)
    const lam = 2 * Math.PI * Math.pow(10000, (2 * i) / 128);
    const r = 2048 / lam;
    const g = r <= 1 ? 0 : r >= 32 ? 1 : (r - 1) / 31;
    return (1 - g) / ed.s + g;
  }
  const EDIT_CAPS: Record<string, { en: string; ko: string }> = {
    pi: {
      en: 'Position Interpolation: f′(x, m) = f(x, m·L/L′) — one flat line at 1/s; every dial including the fastest slows equally. Safe (interpolation bound ≈600× tighter than extrapolation, Thm 2.1) and cheap (~1,000 fine-tune steps), but YaRN’s criticism bites: the rescale “removes the high frequency components”, and PI fine-tunes degraded beyond s ≈ 8.',
      ko: 'Position Interpolation: f′(x, m) = f(x, m·L/L′) — 1/s 높이의 수평선 하나다. 가장 빠른 다이얼까지 전부 똑같이 느려진다. 안전하고(interpolation bound가 extrapolation보다 약 600× 좁음, Thm 2.1) 싸지만(fine-tune 약 1,000 step), YaRN의 비판이 정확히 여기를 찌른다: 이 rescale은 “high frequency 성분을 제거”하며, PI fine-tune은 s ≈ 8을 넘으면 열화됐다.',
    },
    ntk: {
      en: 'NTK-aware: change the base, b′ = b·s^(d/(d−2)) — a geometric tilt of the whole ladder. Dial 0 is unchanged exactly; the last dial gets exactly θ/s; everything between is graded [per-band ratio s^(−2i/(d−2)), derived from YaRN Eq. 19–20].',
      ko: 'NTK-aware: base를 바꾼다, b′ = b·s^(d/(d−2)) — 사다리 전체의 기하급수 기울이기다. 다이얼 0은 정확히 그대로, 마지막 다이얼은 정확히 θ/s, 그 사이는 등비로 눕는다 [band별 비율 s^(−2i/(d−2)), YaRN Eq. 19–20에서 유도].',
    },
    yarn: {
      en: 'YaRN = NTK-by-parts + temperature. Per dial, r = L/λ counts full rotations inside the original context L. Fast dials (r above β = 32) stay untouched; dials whose wavelength exceeds the trained context (r below α = 1) get full interpolation θ/s; the middle blends linearly (Eq. 8, 10, 11, 13). Logits are additionally scaled by 0.1·ln(s) + 1 — HF bakes this into the cos/sin cache as attention_scaling.',
      ko: 'YaRN = NTK-by-parts + temperature. 다이얼마다 r = L/λ가 원래 context L 안에서의 회전 수를 센다. 빠른 다이얼(r이 β = 32 초과)은 그대로, wavelength가 학습 context보다 긴 다이얼(r이 α = 1 미만)은 완전 interpolation θ/s, 중간은 선형 blend다 (Eq. 8, 10, 11, 13). 추가로 logit에 0.1·ln(s) + 1을 곱한다 — HF는 이를 attention_scaling으로 cos/sin cache에 굽는다.',
    },
    base: {
      en: 'The train-time route: Llama-3 ships rope_theta = 500,000; the curve shows θ(500k) ÷ θ(10k) per dial — no ramp, no fine-tune patch, the ladder simply grew before training. The slowest dial’s wavelength becomes ≈ 2.56M tokens [computed]. Qwen3-8B goes further with θ = 10⁶.',
      ko: 'train-time 경로: Llama-3는 rope_theta = 500,000으로 출고된다. 곡선은 다이얼별 θ(500k) ÷ θ(10k)다 — ramp도 fine-tune 패치도 없이, 학습 전에 사다리가 이미 자란 것이다. 가장 느린 다이얼의 wavelength는 ≈ 2.56M token이 된다 [계산값]. Qwen3-8B는 θ = 10⁶으로 더 나아간다.',
    },
  };
  function editRender() {
    const line = Array.from({ length: 64 }, (_, i) => edX(i).toFixed(1) + ',' + edY(edFrac(i)).toFixed(1)).join(' ');
    const el = $('editLine');
    if (el) el.setAttribute('points', line);
    const zg = $('zoneG');
    if (zg) (zg as unknown as SVGGElement).style.opacity = ed.m === 'yarn' ? '1' : '0';
    const sLine = $('sLine'), sLab = $('sLab');
    const showS = ed.m !== 'base';
    if (sLine) {
      sLine.style.opacity = showS ? '1' : '0';
      sLine.setAttribute('y1', String(edY(1 / ed.s)));
      sLine.setAttribute('y2', String(edY(1 / ed.s)));
    }
    if (sLab) {
      sLab.style.opacity = showS ? '1' : '0';
      sLab.setAttribute('y', String(edY(1 / ed.s) + 4));
      sLab.textContent = '×1/' + ed.s;
    }
    const put = (id: string, txt: string) => { const el2 = $(id); if (el2) el2.textContent = txt; };
    const temp = (0.1 * Math.log(ed.s) + 1).toFixed(3);
    const bp = Math.round(10000 * Math.pow(ed.s, 128 / 126)).toLocaleString('en-US');
    if (ed.m === 'pi') {
      put('ec1', 'all 64 dials ÷ ' + ed.s + ' — fastest λ 6.3 → ' + (6.28 * ed.s).toFixed(1) + ' tokens');
      put('ec2', 'bound: interpolation ≈600× tighter than extrapolation (Thm 2.1)');
      put('ec3', 'YaRN: PI fine-tunes degraded beyond s ≈ 8');
    } else if (ed.m === 'ntk') {
      put('ec1', 'b′ = 10,000 · ' + ed.s + '^(128/126) ≈ ' + bp);
      put('ec2', 'dial 0: ×1 exactly · dial 63: ×1/' + ed.s + ' exactly');
      put('ec3', 'geometric grading between the endpoints');
    } else if (ed.m === 'yarn') {
      put('ec1', '17 dials untouched · 24 blended · 23 fully interpolated (L=2,048)');
      put('ec2', 'temperature: logits × 0.1·ln s + 1 = ' + temp + ' (s=' + ed.s + ')');
      put('ec3', 'α = 1 · β = 32 (Llama family, YaRN)');
    } else {
      put('ec1', 'θ 10,000 → 500,000 at train time (Llama-3 config.json)');
      put('ec2', 'λ₆₃: 54,410 → ≈ 2.56M tokens [computed]');
      put('ec3', 'Qwen3-8B: θ = 1,000,000 · max_position 40,960');
    }
    document.querySelectorAll('.es-chip').forEach((x) => x.classList.toggle('off', ed.m === 'base'));
    const c = EDIT_CAPS[ed.m];
    setCap($('editCap'), c.en, c.ko);
  }
  document.querySelectorAll('.em-chip').forEach((b) => {
    b.addEventListener('click', () => {
      ed.m = (b as HTMLElement).dataset.m || 'yarn';
      document.querySelectorAll('.em-chip').forEach((x) => x.classList.toggle('on', x === b));
      editRender();
    });
  });
  document.querySelectorAll('.es-chip').forEach((b) => {
    b.addEventListener('click', () => {
      ed.s = Number((b as HTMLElement).dataset.s);
      document.querySelectorAll('.es-chip').forEach((x) => x.classList.toggle('on', x === b));
      editRender();
    });
  });
  editRender();

  // ================= g · WORKED EXAMPLE =================
  const WX_CAPS: { name: string; cap: { en: string; ko: string } }[] = [
    { name: 'Setup', cap: {
      en: 'A checkable micro-example: d = 8 gives four pairs; the 0-indexed convention ωᵢ = 10000^(−2i/8) fixes every speed. Each following step adds one operation — ending at the relative-position identity verified three ways to machine precision.',
      ko: '검산 가능한 초소형 예제: d = 8이면 pair가 4개이고, 0-index 관례 ωᵢ = 10000^(−2i/8)이 모든 속도를 결정한다. step마다 연산이 하나씩 더해지며, 마지막에는 상대-position 항등식을 세 가지 방식으로 machine precision까지 확인한다.' } },
    { name: 'Speeds', cap: {
      en: 'Four dial speeds spanning three orders of magnitude: the fast dial turns 1 rad per token (λ = 6.28 — ≈57°, about a sixth of a turn, between neighbors); the slow dial 0.001 rad (λ = 6,283 — effectively static in an 8-token sentence).',
      ko: '세 자릿수에 걸친 네 개의 다이얼 속도: 빠른 다이얼은 token당 1 rad (λ = 6.28 — 이웃 token 사이 약 57°, 약 1/6 바퀴), 느린 다이얼은 0.001 rad (λ = 6,283 — 8-token 문장에서는 사실상 정지).' } },
    { name: 'Angles', cap: {
      en: 'Angle = position × speed, per dial: at m = 3 the fast dial sits at 3 rad while the slow one has moved 0.003 rad. Same ladder evaluated at n = 7 for the key.',
      ko: '각도 = position × 속도, 다이얼마다: m = 3에서 빠른 다이얼은 3 rad에 있고 느린 다이얼은 0.003 rad만 움직였다. key에는 같은 사다리를 n = 7에서 평가한다.' } },
    { name: 'One pair', cap: {
      en: 'One pair rotated: q’s pair 0 = (1, 0) at m = 3 lands at (cos 3, sin 3) = (−0.98999, 0.14112). That single 2×2 product is the entire per-pair operation — section b shows it live.',
      ko: 'pair 하나의 회전: q의 pair 0 = (1, 0)이 m = 3에서 (cos 3, sin 3) = (−0.98999, 0.14112)에 도착한다. 이 2×2 곱 하나가 pair당 연산의 전부다 — section b에서 실시간으로 볼 수 있다.' } },
    { name: 'Full vectors', cap: {
      en: 'All four pairs rotated at once: R(3)q and R(7)k written out in full. Note how little the last pair moved — the slow dials barely participate at these positions.',
      ko: '네 pair를 한꺼번에 회전: R(3)q와 R(7)k 전체를 적었다. 마지막 pair가 얼마나 조금 움직였는지 보라 — 이 position대에서 느린 다이얼은 거의 참여하지 않는다.' } },
    { name: 'The identity', cap: {
      en: 'The punchline: ⟨R(3)q, R(7)k⟩ = 0.154972 equals ⟨q, R(4)k⟩ — rotating only the key by Δ = 4 — and equals ⟨R(13)q, R(17)k⟩ after shifting both positions by +10. Only n − m survives (RoFormer Eq. 16), to machine precision.',
      ko: '결론: ⟨R(3)q, R(7)k⟩ = 0.154972는 key만 Δ = 4만큼 돌린 ⟨q, R(4)k⟩와 같고, 두 position을 +10 민 ⟨R(13)q, R(17)k⟩와도 같다. 살아남는 것은 n − m뿐이다 (RoFormer Eq. 16) — machine precision까지.' } },
  ];
  const wxRows = Array.from(document.querySelectorAll('.wx-row'));
  const wxStepEl = $('wxStep');
  const wxPrev = $('wxPrev'), wxNext = $('wxNext'), wxPlay = $('wxPlay'), wxReset = $('wxReset');
  let wxCur = 0;
  let wxTimer: ReturnType<typeof setInterval> | null = null;
  function wxGo(i: number) {
    wxCur = Math.max(0, Math.min(WX_CAPS.length - 1, i));
    wxRows.forEach((r) => {
      const k = Number((r as HTMLElement).dataset.wx);
      r.classList.toggle('dimmed', k > wxCur);
      r.classList.toggle('now', k === wxCur);
    });
    const st = WX_CAPS[wxCur];
    setCap($('wxCap'), st.cap.en, st.cap.ko);
    if (wxStepEl) wxStepEl.textContent = 'Step ' + wxCur + ' / ' + (WX_CAPS.length - 1) + ' — ' + st.name;
    if (wxPrev) wxPrev.toggleAttribute('disabled', wxCur === 0);
    if (wxNext) wxNext.toggleAttribute('disabled', wxCur === WX_CAPS.length - 1);
  }
  function wxStop() {
    if (wxTimer !== null) { clearInterval(wxTimer); wxTimer = null; }
    if (wxPlay) wxPlay.textContent = '▶ Play';
  }
  if (wxPrev) wxPrev.addEventListener('click', () => { wxStop(); wxGo(wxCur - 1); });
  if (wxNext) wxNext.addEventListener('click', () => { wxStop(); wxGo(wxCur + 1); });
  if (wxReset) wxReset.addEventListener('click', () => { wxStop(); wxGo(0); });
  if (wxPlay) wxPlay.addEventListener('click', () => {
    if (wxTimer !== null) { wxStop(); return; }
    if (wxCur === WX_CAPS.length - 1) wxGo(0);
    wxPlay.textContent = '❚❚ Pause';
    wxTimer = setInterval(() => {
      if (wxCur >= WX_CAPS.length - 1) { wxStop(); return; }
      wxGo(wxCur + 1);
    }, 3200);
  });
  wxGo(0);
</script>
