---
import Base from '../../../layouts/Base.astro';
import LangToggle from '../../../components/LangToggle.astro';

// ------------------------------------------------------------------
// Every quantity on this page is either quoted from a cited paper /
// official config.json (RoFormer, PI, YaRN, Barbero et al. 2410.06205,
// GPT-NeoX, DeepSeek-V2, KVQuant, Qwen3-8B, Qwen3.5-27B, Llama-3-8B,
// HF transformers, vLLM) or derived arithmetic labeled in place.
// Convention used throughout: 0-indexed omega_i = base^(-2i/d),
// i = 0..d/2-1 — the HF inv_freq form; RoFormer's 1-indexed
// theta_i = base^(-2(i-1)/d) is the same ladder.
// ------------------------------------------------------------------

// ---- (c) dial wall: static default m = 64, base = 10,000, d = 128 ----
const WALL_M0 = 64;
const fmtLam = (v: number): string =>
  v < 100 ? v.toFixed(1)
  : v < 1000 ? String(Math.round(v))
  : v < 100000 ? (v / 1000).toFixed(1).replace(/\.0$/, '') + 'K'
  : (v / 1e6).toFixed(2) + 'M';
const quart = (i: number) => (i < 16 ? 'cq0' : i < 32 ? 'cq1' : i < 48 ? 'cq2' : 'cq3');
const clocks = Array.from({ length: 64 }, (_, i) => {
  const om = Math.pow(10000, (-2 * i) / 128);
  const lam = (2 * Math.PI) / om;
  const a = (WALL_M0 * om) % (2 * Math.PI);
  const col = i % 16;
  const row = Math.floor(i / 16);
  const cx = 38 + col * 57.5;
  const cy = 46 + row * 74;
  return {
    i, q: quart(i), cx, cy,
    hx: +(cx + 13 * Math.cos(a)).toFixed(2),
    hy: +(cy - 13 * Math.sin(a)).toFixed(2),
    lam: fmtLam(lam),
  };
});

// spectrum strip: log-lambda axis from 5 to 6e6 tokens
const specX = (lam: number) =>
  +(40 + ((Math.log10(lam) - Math.log10(5)) / (Math.log10(6e6) - Math.log10(5))) * 880).toFixed(1);
const specMarks = Array.from({ length: 64 }, (_, i) => ({
  x: specX(2 * Math.PI * Math.pow(10000, (2 * i) / 128)),
  q: quart(i),
}));
const specDecades = [10, 100, 1000, 1e4, 1e5, 1e6].map((v) => ({
  x: specX(v),
  label: v >= 1e6 ? '1M' : v >= 1000 ? v / 1000 + 'K' : String(v),
}));
const specCtx = specX(2048);

// ---- (d) band-combination plot: static default, low-frequency-heavy ----
const combTheta = [1, 0.1, 0.01, 0.001];
const combA0 = [0.25, 0.45, 0.7, 1.0];
const combS0 = combA0.reduce((s, a) => s + a, 0); // 2.4
const combLine = (fn: (d: number) => number) => {
  const pts: string[] = [];
  for (let d = 0; d <= 80.001; d += 0.25) {
    pts.push((60 + d * 10.625).toFixed(1) + ',' + (160 - (fn(d) / combS0) * 125).toFixed(1));
  }
  return pts.join(' ');
};
const combBands = combTheta.map((th, i) => combLine((d) => combA0[i] * Math.cos(d * th)));
const combSum = combLine((d) =>
  combA0.reduce((s, a, i) => s + a * Math.cos(d * combTheta[i]), 0)
);

// ---- (e) band-edit plot: static default YaRN, s = 4, L = 2,048 ----
const eX = (i: number) => +(70 + i * (850 / 63)).toFixed(1);
const eY = (f: number) => +(300 - Math.max(0, Math.min(1.02, f)) * 230).toFixed(1);
const yarnFrac = (i: number, s: number) => {
  const lam = 2 * Math.PI * Math.pow(10000, (2 * i) / 128);
  const r = 2048 / lam; // rotations inside the ORIGINAL context (YaRN Eq. 8)
  const g = r <= 1 ? 0 : r >= 32 ? 1 : (r - 1) / 31; // gamma ramp, alpha=1 beta=32
  return (1 - g) / s + g; // h(theta)/theta (YaRN Eq. 13)
};
const yarnLine = Array.from({ length: 64 }, (_, i) => eX(i) + ',' + eY(yarnFrac(i, 4))).join(' ');
// zone edges for L = 2,048: untouched i 0..16, blend 17..40, full 41..63
const zU1 = eX(16.5);
const zB1 = eX(40.5);
---

<Base
  title="RoPE anatomy: the dial wall inside every attention head — Junwon Lee"
  description="An interactive anatomy of rotary position embeddings: where the rotation lands in the attention path, what each of the 64 frequency dials does, how per-band cosines compose into attention logits, and how PI, NTK-aware scaling, YaRN and base-scaling edit the dial ladder for long context."
>
  <div class="rope-page">
    <!-- ============ HERO ============ -->
    <section class="section">
      <div class="container">
        <div class="hero-top">
          <p class="eyebrow">Study · Model anatomy</p>
          <LangToggle />
        </div>
        <h1>
          <span class="lang-en">RoPE: sixty-four dials on every attention head</span>
          <span class="lang-ko">RoPE: 모든 attention head에 달린 64개의 다이얼</span>
        </h1>
        <p class="lede">
          <span class="lang-en">
            Rotary position embeddings never touch the values and never add anything to the
            residual stream — they spin each query/key channel pair by an angle proportional
            to the token's position, at d/2 geometrically spaced speeds. This page locates
            the exact insertion point in the attention path, hangs all 64 dials on one wall,
            composes per-band cosines into attention logits, and shows how PI, NTK-aware
            scaling, YaRN and base-scaling each edit the same dial ladder for long context —
            every number from the cited papers, official configs, or a worked example
            labeled as derived.
          </span>
          <span class="lang-ko">
            Rotary position embedding은 value를 건드리지 않고 residual stream에 아무것도
            더하지 않는다 — 각 query/key channel pair를 token position에 비례한 각도로,
            d/2개의 기하급수 간격 속도로 회전시킬 뿐이다. 이 페이지는 attention 경로에서
            RoPE가 꽂히는 정확한 지점을 찾고, 64개의 다이얼을 한 벽에 걸고, band별
            cosine이 attention logit으로 합성되는 과정을 본 뒤, PI·NTK-aware·YaRN·
            base-scaling이 같은 다이얼 사다리를 long context를 위해 어떻게 다르게
            수정하는지 살핀다 — 모든 수치는 인용 논문·공식 config, 혹은 유도임을 표기한
            계산에서 나온다.
          </span>
        </p>

        <div class="jump-row">
          <a class="tag" href="#where">a · Where it lands</a>
          <a class="tag" href="#pair">b · One pair, one dial</a>
          <a class="tag" href="#wall">c · The dial wall</a>
          <a class="tag" href="#combine">d · Bands combine</a>
          <a class="tag" href="#edits">e · Editing the bands</a>
          <a class="tag" href="#systems">f · Systems corner</a>
          <a class="tag" href="#worked">g · Worked example</a>
        </div>

        <div class="config-note">
          <span class="config-lead">
            <span class="lang-en">Verified references used on this page (papers / official
              config.json / library source):</span>
            <span class="lang-ko">이 페이지에서 사용하는 검증된 근거 (논문 / 공식
              config.json / 라이브러리 소스):</span>
          </span>
          <span class="tag">RoFormer — Eq. 14–16, 34</span>
          <span class="tag">Qwen3-8B — θ 1,000,000 · head_dim 128 · full rotary</span>
          <span class="tag">Llama-3-8B — θ 500,000</span>
          <span class="tag accent">YaRN — α = 1 · β = 32</span>
          <span class="tag">Barbero et al. 2410.06205 — Gemma bands</span>
        </div>
      </div>
    </section>

    <!-- ============ a · WHERE THE ROTATION LANDS ============ -->
    <section class="section-tight" id="where">
      <div class="container">
        <h2 class="viz-h">
          <span class="lang-en">a · Where the rotation lands — q and k only, after the projections</span>
          <span class="lang-ko">a · 회전이 꽂히는 곳 — projection 뒤의 q와 k에만</span>
        </h2>
        <p class="viz-sub">
          <span class="lang-en">One attention layer, Qwen3-accurate. Hover every box — the V
            path has the "why not v?" answer. RoFormer Eq. 14 defines RoPE as
            R(mθ)·W q — the rotation lands after the linear projections, and after QK-norm
            where the model has one.</span>
          <span class="lang-ko">attention layer 하나를 Qwen3 기준으로 정확히 그렸다. 모든
            box에 hover해 보라 — V 경로에 "왜 v는 아닌가?"의 답이 있다. RoFormer Eq. 14는
            RoPE를 R(mθ)·W q로 정의한다: 회전은 linear projection 뒤, 그리고 QK-norm이
            있는 모델에서는 그 뒤에 꽂힌다.</span>
        </p>

        <div class="viz-frame">
          <div class="rope-scroll">
            <svg viewBox="0 0 1000 352" role="img" style="width:100%; height:auto; min-width:940px;"
              aria-label="Dataflow of one attention layer: hidden state through W_q, W_k, W_v; QK-norm; RoPE applied to q and k only; K cached post-RoPE; V untouched">
              <defs>
                <marker id="rp-arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                  <path d="M0,0 L10,5 L0,10 z" fill="#87857c"></path>
                </marker>
              </defs>

              <g data-tip="The layer input off the residual stream. In RoPE models nothing position-shaped has been added before this point — there is no learned absolute position embedding at the bottom of the stack; position will enter only as a rotation angle downstream."
                 data-tip-ko="residual stream에서 들어오는 layer 입력. RoPE 모델에서는 이 지점까지 position 성격의 어떤 것도 더해진 적이 없다 — stack 바닥에 학습된 absolute position embedding이 없고, position은 오직 아래쪽에서 회전 각도로만 들어온다.">
                <rect class="sbox" x="16" y="150" width="104" height="48" rx="9"></rect>
                <text class="stitle sm" x="68" y="170" text-anchor="middle">h_t — hidden</text>
                <text class="smono" x="68" y="188" text-anchor="middle">per token</text>
              </g>

              <line class="flowline" x1="120" y1="164" x2="164" y2="76" marker-end="url(#rp-arr)"></line>
              <line class="flowline" x1="120" y1="174" x2="164" y2="174" marker-end="url(#rp-arr)"></line>
              <line class="flowline" x1="120" y1="184" x2="164" y2="272" marker-end="url(#rp-arr)"></line>

              <g data-tip="Query projection: 32 heads × head_dim 128 (Qwen3-8B config). No position yet — RoFormer Eq. 14 puts the rotation AFTER this matrix: f(x, m) = R(mθ) · W_q x."
                 data-tip-ko="Query projection: 32 heads × head_dim 128 (Qwen3-8B config). 아직 position은 없다 — RoFormer Eq. 14는 회전을 이 행렬 뒤에 둔다: f(x, m) = R(mθ) · W_q x.">
                <rect class="sbox" x="168" y="44" width="104" height="48" rx="9"></rect>
                <text class="stitle sm" x="220" y="64" text-anchor="middle">W_q</text>
                <text class="smono" x="220" y="82" text-anchor="middle">32 h × 128</text>
              </g>
              <g data-tip="Key projection: 8 KV heads × 128 (Qwen3-8B is GQA — 4 query heads share each key). Position lands after this matrix, exactly as on the q path."
                 data-tip-ko="Key projection: 8 KV heads × 128 (Qwen3-8B는 GQA — query head 4개가 key 하나를 공유). q 경로와 똑같이, position은 이 행렬 뒤에 들어온다.">
                <rect class="sbox" x="168" y="150" width="104" height="48" rx="9"></rect>
                <text class="stitle sm" x="220" y="170" text-anchor="middle">W_k</text>
                <text class="smono" x="220" y="188" text-anchor="middle">8 h × 128</text>
              </g>
              <g data-tip="Why not v? Position must enter through the q·k score: R(m)ᵀR(n) = R(n−m) makes the logit depend only on relative distance — and that identity lives inside a dot product between two rotated vectors. v never meets k in a dot product, so rotating it would spin the content the head emits without creating any relative-position term. RoFormer accordingly defines the rotary map only for q and k (Eq. 14)."
                 data-tip-ko="왜 v는 아닌가? position은 q·k score를 통해 들어와야 한다: R(m)ᵀR(n) = R(n−m) 덕분에 logit이 상대 거리에만 의존하는데, 이 항등식은 회전된 두 vector의 dot product 안에서만 성립한다. v는 어떤 dot product에서도 k를 만나지 않으므로, v를 회전시키면 상대-position 항은 하나도 생기지 않고 head가 내보내는 내용만 돌아간다. 그래서 RoFormer는 rotary map을 q와 k에만 정의한다 (Eq. 14).">
                <rect class="sbox" x="168" y="256" width="104" height="48" rx="9"></rect>
                <text class="stitle sm" x="220" y="276" text-anchor="middle">W_v</text>
                <text class="smono" x="220" y="294" text-anchor="middle">8 h × 128</text>
              </g>

              <line class="flowline" x1="272" y1="68" x2="308" y2="68" marker-end="url(#rp-arr)"></line>
              <line class="flowline" x1="272" y1="174" x2="308" y2="174" marker-end="url(#rp-arr)"></line>

              <g data-tip="QK-norm: RMSNorm over head_dim, Qwen3-class models only. Verified order in HF modeling_qwen3.py: q_proj → q_norm → apply_rotary_pos_emb → cache update. The norm sits BEFORE the rotation. (Llama has no QK-norm; RoPE placement is otherwise identical.)"
                 data-tip-ko="QK-norm: head_dim에 대한 RMSNorm, Qwen3 계열에만 있다. HF modeling_qwen3.py에서 검증한 순서: q_proj → q_norm → apply_rotary_pos_emb → cache update. norm이 회전보다 먼저다. (Llama에는 QK-norm이 없고, RoPE 위치는 그 외에 동일하다.)">
                <rect class="sbox sbox-dash" x="312" y="44" width="112" height="48" rx="9"></rect>
                <text class="stitle sm" x="368" y="64" text-anchor="middle">q_norm (RMS)</text>
                <text class="smono" x="368" y="82" text-anchor="middle">Qwen3 · before RoPE</text>
              </g>
              <g data-tip="Same RMSNorm on the key path — also before the rotation (verified code order, HF modeling_qwen3.py)."
                 data-tip-ko="key 경로의 동일한 RMSNorm — 역시 회전보다 먼저다 (HF modeling_qwen3.py에서 검증한 코드 순서).">
                <rect class="sbox sbox-dash" x="312" y="150" width="112" height="48" rx="9"></rect>
                <text class="stitle sm" x="368" y="170" text-anchor="middle">k_norm (RMS)</text>
                <text class="smono" x="368" y="188" text-anchor="middle">Qwen3 · before RoPE</text>
              </g>

              <line class="flowline" x1="424" y1="68" x2="462" y2="68" marker-end="url(#rp-arr)"></line>
              <line class="flowline" x1="424" y1="174" x2="462" y2="174" marker-end="url(#rp-arr)"></line>

              <g data-tip="The rotation: block-diagonal, d/2 = 64 independent 2×2 blocks, block i turning by m·ωᵢ. Implemented element-wise (RoFormer Eq. 34): x ⊗ cos(mθ) + rotate(x) ⊗ sin(mθ) — no matrix multiply. One cos/sin table is computed per forward (inv_freq ⊗ position_ids) and broadcast to every head and every layer."
                 data-tip-ko="회전 그 자체: block-diagonal, 독립적인 2×2 block이 d/2 = 64개이고 block i는 m·ωᵢ만큼 돈다. 구현은 element-wise다 (RoFormer Eq. 34): x ⊗ cos(mθ) + rotate(x) ⊗ sin(mθ) — 행렬곱이 없다. cos/sin 테이블은 forward당 한 번 계산되어(inv_freq ⊗ position_ids) 모든 head·모든 layer에 broadcast된다.">
                <circle class="ropec" cx="490" cy="68" r="24"></circle>
                <text class="stitle sm" x="490" y="72" text-anchor="middle">R(m)</text>
              </g>
              <g data-tip="Identical rotation on the key path, at the key's own position n. Same cos/sin table, same 64 blocks."
                 data-tip-ko="key 경로에도 동일한 회전이, key 자신의 position n에서 적용된다. 같은 cos/sin 테이블, 같은 64개 block.">
                <circle class="ropec" cx="490" cy="174" r="24"></circle>
                <text class="stitle sm" x="490" y="178" text-anchor="middle">R(n)</text>
              </g>
              <text class="ssub" x="490" y="122" text-anchor="middle">64 blocks of 2×2</text>

              <line class="flowline" x1="514" y1="68" x2="552" y2="68" marker-end="url(#rp-arr)"></line>
              <line class="flowline" x1="514" y1="174" x2="552" y2="174" marker-end="url(#rp-arr)"></line>

              <g data-tip="The rotated query — used immediately for this step's scores, never cached."
                 data-tip-ko="회전된 query — 이번 step의 score 계산에 바로 쓰이고, cache되지 않는다.">
                <rect class="sbox" x="556" y="44" width="96" height="48" rx="9"></rect>
                <text class="stitle sm" x="604" y="64" text-anchor="middle">q — rotated</text>
                <text class="smono" x="604" y="82" text-anchor="middle">used this step</text>
              </g>
              <g data-tip="The rotated key, headed for the cache."
                 data-tip-ko="회전된 key — cache로 향한다.">
                <rect class="sbox" x="556" y="150" width="96" height="48" rx="9"></rect>
                <text class="stitle sm" x="604" y="170" text-anchor="middle">k — rotated</text>
                <text class="smono" x="604" y="188" text-anchor="middle">→ cache</text>
              </g>

              <line class="flowline" x1="652" y1="174" x2="696" y2="174" marker-end="url(#rp-arr)"></line>

              <g data-tip="Rotate-at-write: in the HF path apply_rotary_pos_emb runs BEFORE past_key_values.update(...), so every cached K is stamped with the position it was written at. Reusing a cached K at a different position means un-rotating and re-rotating it. See the systems corner."
                 data-tip-ko="Rotate-at-write: HF 경로에서 apply_rotary_pos_emb가 past_key_values.update(...)보다 먼저 실행되므로, cache된 모든 K에는 쓰일 당시의 position이 새겨져 있다. cache된 K를 다른 position에서 재사용하려면 회전을 풀고 다시 돌려야 한다. systems corner 참고.">
                <rect class="sbox sbox-accent" x="700" y="150" width="130" height="48" rx="9"></rect>
                <text class="stitle sm taccent" x="765" y="170" text-anchor="middle">K cache</text>
                <text class="smono" x="765" y="188" text-anchor="middle">stored post-RoPE</text>
              </g>
              <g data-tip="V is cached exactly as projected — position-free. Nothing on this path ever sees a rotation."
                 data-tip-ko="V는 projection된 그대로 cache된다 — position이 없다. 이 경로는 회전을 한 번도 만나지 않는다.">
                <rect class="sbox" x="640" y="256" width="130" height="48" rx="9"></rect>
                <text class="stitle sm" x="705" y="276" text-anchor="middle">V cache</text>
                <text class="smono" x="705" y="294" text-anchor="middle">no RoPE — untouched</text>
              </g>
              <line class="flowline" x1="272" y1="280" x2="636" y2="280" marker-end="url(#rp-arr)"></line>
              <text class="ssub" x="430" y="270" text-anchor="middle">v is never rotated — hover W_v for why</text>

              <g data-tip="RoFormer Eq. 16: (R(m) W_q x_m)ᵀ (R(n) W_k x_n) = x_mᵀ W_qᵀ R(n−m) W_k x_n. The absolute positions cancel inside the dot product — only n−m survives. Section g checks this to machine precision."
                 data-tip-ko="RoFormer Eq. 16: (R(m) W_q x_m)ᵀ (R(n) W_k x_n) = x_mᵀ W_qᵀ R(n−m) W_k x_n. 절대 position은 dot product 안에서 상쇄되고 n−m만 남는다. section g에서 machine precision까지 확인한다.">
                <rect class="sbox sbox-score" x="868" y="150" width="116" height="48" rx="9"></rect>
                <text class="stitle sm" x="926" y="170" text-anchor="middle">q·kᵀ → softmax</text>
                <text class="smono" x="926" y="188" text-anchor="middle">depends on n−m</text>
              </g>
              <path class="flowline" d="M 652 68 H 926 V 146" fill="none" marker-end="url(#rp-arr)"></path>
              <line class="flowline" x1="830" y1="174" x2="864" y2="174" marker-end="url(#rp-arr)"></line>
              <path class="flowline" d="M 770 280 H 926 V 202" fill="none" marker-end="url(#rp-arr)"></path>
              <text class="ssub" x="856" y="270" text-anchor="middle">softmax · V → output</text>

              <text class="smono" x="16" y="340">cos/sin: computed once per forward (inv_freq ⊗ position_ids), broadcast to all heads and all layers — standard dense decoders (HF Qwen3; hybrid stacks and MLA differ, see fine print)</text>
            </svg>
          </div>

          <p class="cap">
            <span class="lang-en">RoPE is a rewrite of q and k only — post-projection,
              post-QK-norm where one exists, applied with the same cos/sin table in every
              layer and every head of a standard dense decoder. V passes through untouched,
              and K enters the cache already rotated. Those two facts carry the whole
              systems story in section f.</span>
            <span class="lang-ko">RoPE는 오직 q와 k만 다시 쓴다 — projection 뒤, QK-norm이
              있으면 그 뒤에서, 표준 dense decoder의 모든 layer·모든 head에 같은 cos/sin
              테이블로 적용된다. V는 그대로 통과하고, K는 이미 회전된 채 cache에 들어간다.
              이 두 사실이 section f의 systems 이야기 전부를 떠받친다.</span>
          </p>
        </div>
      </div>
    </section>

    <!-- ============ b · ONE PAIR = ONE DIAL ============ -->
    <section class="section-tight" id="pair">
      <div class="container">
        <h2 class="viz-h">
          <span class="lang-en">b · One pair = one dial — the 2×2 block, live</span>
          <span class="lang-ko">b · pair 하나 = 다이얼 하나 — 2×2 block을 실시간으로</span>
        </h2>
        <p class="viz-sub">
          <span class="lang-en">One (2i, 2i+1) channel pair from the d = 8 worked example
            (section g). Drag the position sliders: q spins with m, k with n — and the pair
            score only ever cares about n − m. Click "both +10" to watch both arrows move
            while the score stands still.</span>
          <span class="lang-ko">d = 8 예제(section g)에서 (2i, 2i+1) channel pair 하나를
            떼어 왔다. position slider를 움직여 보라: q는 m을 따라, k는 n을 따라 돌지만
            pair score는 오직 n − m에만 반응한다. "both +10"을 누르면 두 화살표는 도는데
            score는 멈춰 있는 것을 볼 수 있다.</span>
        </p>

        <div class="viz-frame">
          <div class="pair-controls">
            <div class="ctl-row">
              <span class="ctl-label">m (query pos)</span>
              <input type="range" id="slM" min="0" max="50" step="1" value="3" />
              <span class="ctl-val" id="vM">3</span>
            </div>
            <div class="ctl-row">
              <span class="ctl-label">n (key pos)</span>
              <input type="range" id="slN" min="0" max="50" step="1" value="7" />
              <span class="ctl-val" id="vN">7</span>
            </div>
            <div class="pair-btns">
              <button class="btn btn-sm" id="shiftBtn" type="button">both +10</button>
              <span class="rp-chips" role="group" aria-label="Frequency band">
                <button class="rp-chip band-chip on" data-band="0" type="button">pair 0 · ω=1</button>
                <button class="rp-chip band-chip" data-band="1" type="button">pair 1 · ω=0.1</button>
                <button class="rp-chip band-chip" data-band="2" type="button">pair 2 · ω=0.01</button>
                <button class="rp-chip band-chip" data-band="3" type="button">pair 3 · ω=0.001</button>
              </span>
            </div>
          </div>

          <div class="pair-grid">
            <div class="rope-scroll">
              <svg viewBox="0 0 400 320" role="img" style="width:100%; height:auto; min-width:320px; max-width:430px;"
                aria-label="Two 2D vectors q and k rotating on a circle as positions m and n change">
                <defs>
                  <marker id="rp-arr-q" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
                    <path d="M0,0 L10,5 L0,10 z" fill="#c15f3c"></path>
                  </marker>
                  <marker id="rp-arr-k" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
                    <path d="M0,0 L10,5 L0,10 z" fill="#576270"></path>
                  </marker>
                </defs>
                <circle cx="190" cy="160" r="110" fill="none" stroke="var(--line-strong)" stroke-width="1.2" stroke-dasharray="3 4"></circle>
                <line x1="70" y1="160" x2="310" y2="160" stroke="var(--line)" stroke-width="1"></line>
                <line x1="190" y1="40" x2="190" y2="280" stroke="var(--line)" stroke-width="1"></line>
                <line id="qGhost" class="ghostline gq" x1="190" y1="160" x2="300" y2="160"></line>
                <line id="kGhost" class="ghostline gk" x1="190" y1="160" x2="190" y2="50"></line>
                <line id="qArr" class="veca vq" x1="190" y1="160" x2="81.1" y2="144.5" marker-end="url(#rp-arr-q)"></line>
                <line id="kArr" class="veca vk" x1="190" y1="160" x2="117.7" y2="77.1" marker-end="url(#rp-arr-k)"></line>
                <text class="smono" x="30" y="136" fill="#c15f3c" id="qLab">R(m)q₍ᵢ₎</text>
                <text class="smono" x="96" y="66" fill="#576270" id="kLab">R(n)k₍ᵢ₎</text>
                <text class="ssub" x="304" y="176">angle 0</text>
                <text class="ssub" x="20" y="306">dashed = the pair before rotation (m = n = 0)</text>
              </svg>
            </div>

            <div class="pair-side">
              <div class="formula" id="matBox">R(mω) — live 2×2 block, m = 3, ω = 1

  ⎡ cos mω  −sin mω ⎤   ⎡ <b id="m00">−0.990</b>  <b id="m01">−0.141</b> ⎤
  ⎣ sin mω   cos mω ⎦ = ⎣ <b id="m10">0.141</b>   <b id="m11">−0.990</b> ⎦</div>
              <div class="wire-stats">
                <span class="stat-chip">mω = <b id="cMth">3.000</b> rad</span>
                <span class="stat-chip">nω = <b id="cNth">7.000</b> rad</span>
                <span class="stat-chip">Δ = n−m = <b id="cDel">4</b></span>
                <span class="stat-chip">pair score = <b id="cScore">0.7568</b></span>
              </div>
              <p class="fine-inline">
                <span class="lang-en">pair score = ⟨R(mω)q₍ᵢ₎, R(nω)k₍ᵢ₎⟩ =
                  c·cos(Δω) − s·sin(Δω), where c is the 2D dot and s the 2D cross of the
                  unrotated pair — a function of Δ = n−m only (RoFormer Eq. 16; derivation
                  in section d).</span>
                <span class="lang-ko">pair score = ⟨R(mω)q₍ᵢ₎, R(nω)k₍ᵢ₎⟩ =
                  c·cos(Δω) − s·sin(Δω). c는 회전 전 pair의 2D dot, s는 2D cross —
                  오직 Δ = n−m만의 함수다 (RoFormer Eq. 16; 유도는 section d).</span>
              </p>
            </div>
          </div>

          <p class="cap" id="pairCap">
            <span class="lang-en">Pair 0 is the fastest dial: ω = 1 rad/token, so q at m = 3
              sits at 3 rad and k at n = 7 at 7 rad. Slide either position and the score
              moves; shift both together and it does not — the absolute angles cancel inside
              the dot product, leaving only Δω.</span>
            <span class="lang-ko">pair 0은 가장 빠른 다이얼이다: ω = 1 rad/token이므로
              m = 3의 q는 3 rad, n = 7의 k는 7 rad에 있다. 한쪽 position만 움직이면
              score가 변하지만, 둘을 같이 밀면 변하지 않는다 — 절대 각도는 dot product
              안에서 상쇄되고 Δω만 남는다.</span>
          </p>

          <!-- pairing conventions -->
          <h3 class="sub-h">
            <span class="lang-en">Which channels form a pair? Two conventions, one warning</span>
            <span class="lang-ko">어떤 channel끼리 pair인가? 두 가지 관례, 한 가지 경고</span>
          </h3>
          <div class="rp-chips conv-row" role="group" aria-label="Pairing convention">
            <button class="rp-chip conv-chip on" data-conv="inter" type="button">interleaved · GPT-J / rotate_gptj</button>
            <button class="rp-chip conv-chip" data-conv="half" type="button">half-split · GPT-NeoX / rotate_half</button>
          </div>

          <div class="conv-panel" id="convInter"
            data-tip="vLLM rotate_gptj: x1 = x[..., ::2]; x2 = x[..., 1::2]; stack((−x2, x1)).flatten — RoFormer's own math uses this adjacent-pair layout (Eq. 15, 34)."
            data-tip-ko="vLLM rotate_gptj: x1 = x[..., ::2]; x2 = x[..., 1::2]; stack((−x2, x1)).flatten — RoFormer 본문의 수식이 바로 이 인접-pair 배치다 (Eq. 15, 34).">
            <div class="conv-cells">
              <span class="cc p0">x₀</span><span class="cc p0">x₁</span><span class="cc p1">x₂</span><span class="cc p1">x₃</span><span class="cc p2">x₄</span><span class="cc p2">x₅</span><span class="cc p3">x₆</span><span class="cc p3">x₇</span>
            </div>
            <p class="conv-note">
              <span class="lang-en">Adjacent channels pair: (x₀,x₁)(x₂,x₃)(x₄,x₅)(x₆,x₇).
                Rotate-vector: (−x₁, x₀, −x₃, x₂, −x₅, x₄, −x₇, x₆) — RoFormer Eq. 34's
                element-wise form.</span>
              <span class="lang-ko">인접 channel끼리 pair: (x₀,x₁)(x₂,x₃)(x₄,x₅)(x₆,x₇).
                rotate-vector는 (−x₁, x₀, −x₃, x₂, −x₅, x₄, −x₇, x₆) — RoFormer Eq. 34의
                element-wise 형태다.</span>
            </p>
          </div>

          <div class="conv-panel" id="convHalf"
            data-tip="HF / vLLM rotate_half (rotate_neox): x1 = x[..., :d//2]; x2 = x[..., d//2:]; cat((−x2, x1)). The cos/sin cache layout emb = cat((freqs, freqs)) exists to serve exactly this pairing."
            data-tip-ko="HF / vLLM rotate_half (rotate_neox): x1 = x[..., :d//2]; x2 = x[..., d//2:]; cat((−x2, x1)). cos/sin cache 배치 emb = cat((freqs, freqs))가 정확히 이 pairing을 위한 것이다.">
            <div class="conv-cells">
              <span class="cc p0">x₀</span><span class="cc p1">x₁</span><span class="cc p2">x₂</span><span class="cc p3">x₃</span><span class="cc p0">x₄</span><span class="cc p1">x₅</span><span class="cc p2">x₆</span><span class="cc p3">x₇</span>
            </div>
            <p class="conv-note">
              <span class="lang-en">Channel j pairs with j + d/2: (x₀,x₄)(x₁,x₅)(x₂,x₆)(x₃,x₇).
                Rotate-vector: (−x₄, −x₅, −x₆, −x₇, x₀, x₁, x₂, x₃) — HF's rotate_half.</span>
              <span class="lang-ko">channel j는 j + d/2와 pair: (x₀,x₄)(x₁,x₅)(x₂,x₆)(x₃,x₇).
                rotate-vector는 (−x₄, −x₅, −x₆, −x₇, x₀, x₁, x₂, x₃) — HF의 rotate_half다.</span>
            </p>
          </div>

          <p class="warn-note">
            <span class="lang-en">⚠ Checkpoints don't mix. Both layouts are valid RoPE up to
              a permutation of which W_q/W_k output channel meets which frequency — but a
              trained checkpoint has its rows ordered for exactly one of them. Apply the
              wrong one and every channel pair rotates at the wrong speed. Ground truth: HF's
              convert_llama_weights_to_hf.py permutes the q/k weights ("permute for sliced
              rotary") when converting Meta's interleaved checkpoint to the half-split
              layout, and vLLM exposes is_neox_style per model. (The permutation-equivalence
              reading is this page's derivation; the two code paths and the converter are
              verified sources.)</span>
            <span class="lang-ko">⚠ checkpoint는 섞이지 않는다. 두 배치 모두 "어느 W_q/W_k
              출력 channel이 어느 frequency를 만나는가"의 순열 차이일 뿐 유효한 RoPE지만,
              학습된 checkpoint의 행 순서는 정확히 한쪽에 맞춰져 있다. 반대쪽을 적용하면
              모든 channel pair가 틀린 속도로 회전한다. 근거: HF의
              convert_llama_weights_to_hf.py는 Meta의 interleaved checkpoint를 half-split
              배치로 바꿀 때 q/k weight를 순열한다("permute for sliced rotary"). vLLM은
              모델별로 is_neox_style을 노출한다. (순열-동치 해석은 이 페이지의 유도이고,
              두 코드 경로와 변환기는 검증된 출처다.)</span>
          </p>

          <noscript>
            <p class="viz-sub">
              <span class="lang-en">With JavaScript the vectors, matrix and score are live;
                the static view shows m = 3, n = 7 on pair 0 — and both convention panels at
                once.</span>
              <span class="lang-ko">JavaScript가 있으면 vector·행렬·score가 실시간으로
                움직인다. 정적 화면은 pair 0의 m = 3, n = 7 상태와 두 관례 패널을 모두
                보여준다.</span>
            </p>
          </noscript>
        </div>
      </div>
    </section>

    <!-- ============ c · THE DIAL WALL ============ -->
    <section class="section-tight" id="wall">
      <div class="container">
        <h2 class="viz-h">
          <span class="lang-en">c · The dial wall — all 64 speeds at once</span>
          <span class="lang-ko">c · 다이얼 벽 — 64개의 속도를 한눈에</span>
        </h2>
        <p class="viz-sub">
          <span class="lang-en">Every (2i, 2i+1) pair of a head_dim-128 head is a dial
            advancing ωᵢ = base^(−2i/128) rad per token — an odometer with geometrically
            geared hands. Drag the position: the fast dials whirl, the slow ones barely
            creep. The number under each dial is its wavelength in tokens, λᵢ = 2π/ωᵢ
            (YaRN Eq. 8).</span>
          <span class="lang-ko">head_dim 128인 head의 (2i, 2i+1) pair 하나하나가 token당
            ωᵢ = base^(−2i/128) rad씩 도는 다이얼이다 — 기하급수 기어비의 odometer.
            position을 끌어 보라: 빠른 다이얼은 팽팽 돌고 느린 다이얼은 거의 기지 않는다.
            각 다이얼 아래 숫자는 token 단위 wavelength, λᵢ = 2π/ωᵢ다 (YaRN Eq. 8).</span>
        </p>

        <div class="viz-frame">
          <div class="wall-controls">
            <div class="ctl-row ctl-wide">
              <span class="ctl-label">position m</span>
              <input type="range" id="slWall" min="0" max="1000" step="1" value="64" />
              <span class="ctl-val" id="vWall">64</span>
            </div>
            <div class="rp-chips" role="group" aria-label="Jump to position">
              <button class="rp-chip wjump" data-m="0" type="button">m=0</button>
              <button class="rp-chip wjump on" data-m="64" type="button">64</button>
              <button class="rp-chip wjump" data-m="512" type="button">512</button>
              <button class="rp-chip wjump" data-m="4096" type="button">4,096</button>
              <button class="rp-chip wjump" data-m="40960" type="button">40,960</button>
              <button class="btn ghost btn-sm" id="wallPlay" type="button">▶ Play</button>
            </div>
            <div class="rp-chips" role="group" aria-label="RoPE base">
              <span class="ctl-label">base</span>
              <button class="rp-chip wbase on" data-b="10000" type="button">10,000 · RoFormer</button>
              <button class="rp-chip wbase" data-b="500000" type="button">500,000 · Llama-3</button>
              <button class="rp-chip wbase" data-b="1000000" type="button">1,000,000 · Qwen3</button>
            </div>
          </div>

          <div class="rope-scroll">
            <svg id="wallSvg" viewBox="0 0 960 322" role="img" style="width:100%; height:auto; min-width:920px;"
              aria-label="64 dials, one per channel pair, each advancing at its own geometric speed; wavelength in tokens under each dial">
              <g id="wallDyn">
                <text class="rowlab" x="20" y="14">dials 0–63 · ωᵢ = base^(−2i/128) rad/token · hand = current angle m·ωᵢ (mod 2π) · label = λᵢ in tokens</text>
                {clocks.map((c) => (
                  <g>
                    <circle class={`clk ${c.q}`} cx={c.cx} cy={c.cy} r="17"></circle>
                    <line class="clk-tick" x1={c.cx + 14} y1={c.cy} x2={c.cx + 17} y2={c.cy}></line>
                    <line class="clk-hand" x1={c.cx} y1={c.cy} x2={c.hx} y2={c.hy}></line>
                    <text class="clk-lam" x={c.cx} y={c.cy + 29} text-anchor="middle">{c.lam}</text>
                  </g>
                ))}
              </g>
            </svg>
          </div>

          <div class="wire-stats" id="wallStats">
            <span class="stat-chip">m = <b id="wcM">64</b></span>
            <span class="stat-chip">dial 0: <b id="wcFast">10.2</b> full turns</span>
            <span class="stat-chip">dial 63: <b id="wcSlow">0.0074 rad — 0.12% of a turn</b></span>
            <span class="stat-chip">λ₆₃ = <b id="wcLmax">54,410</b> tokens</span>
          </div>

          <div class="rope-scroll">
            <svg id="specSvg" viewBox="0 0 960 92" role="img" style="width:100%; height:auto; min-width:920px;"
              aria-label="Log-scale spectrum of the 64 wavelengths, from about 6 tokens to millions of tokens, with the trained context marked">
              <g id="specDyn">
                <line x1="40" y1="48" x2="920" y2="48" stroke="var(--line-strong)" stroke-width="1.2"></line>
                {specDecades.map((d) => (
                  <g>
                    <line x1={d.x} y1="44" x2={d.x} y2="52" stroke="var(--text-tertiary)" stroke-width="1"></line>
                    <text class="ssub" x={d.x} y="68" text-anchor="middle">{d.label}</text>
                  </g>
                ))}
                {specMarks.map((mk) => (
                  <line class={`spec-mark ${mk.q}`} x1={mk.x} y1="30" x2={mk.x} y2="46"></line>
                ))}
                <line x1={specCtx} y1="14" x2={specCtx} y2="52" stroke="var(--accent-strong)" stroke-width="1.4" stroke-dasharray="4 3"></line>
                <text class="smono" x={specCtx + 6} y="20" fill="var(--accent-strong)">trained ctx 2,048 (LLaMA-era)</text>
                <text class="rowlab" x="20" y="88">wavelength λ (tokens, log scale) — dials to the right of the context marker never complete one turn in training</text>
              </g>
            </svg>
          </div>

          <p class="cap" id="wallCap">
            <span class="lang-en">Base 10,000 (RoFormer): the ladder runs from λ₀ = 2π ≈ 6.28
              tokens to λ₆₃ = 2π·10000^(126/128) ≈ 54,410 tokens [computed; slightly below
              the 2π·base ≈ 62,832 approximation]. Dial 0 disambiguates neighbors; the last
              dials barely move inside any real context — near position-free channels.
              Switching the base stretches the whole wall at once: that is Llama-3's and
              Qwen3's train-time long-context route (section e).</span>
            <span class="lang-ko">base 10,000 (RoFormer): 사다리는 λ₀ = 2π ≈ 6.28 token에서
              λ₆₃ = 2π·10000^(126/128) ≈ 54,410 token까지 뻗는다 [계산값; 2π·base ≈ 62,832
              근사보다 약간 작다]. 다이얼 0은 이웃 token을 구분하고, 마지막 다이얼들은
              어떤 실제 context 안에서도 거의 움직이지 않는다 — 사실상 position-free
              channel이다. base를 바꾸면 벽 전체가 한 번에 늘어난다: 그것이 Llama-3와
              Qwen3의 train-time long-context 경로다 (section e).</span>
          </p>

          <noscript>
            <p class="viz-sub">
              <span class="lang-en">With JavaScript the wall animates with position and the
                base is switchable; the static view shows m = 64 at base 10,000.</span>
              <span class="lang-ko">JavaScript가 있으면 벽이 position을 따라 움직이고 base를
                바꿀 수 있다. 정적 화면은 base 10,000, m = 64 상태다.</span>
            </p>
          </noscript>
        </div>
      </div>
    </section>

    <!-- ============ d · HOW BANDS COMBINE ============ -->
    <section class="section-tight" id="combine">
      <div class="container">
        <h2 class="viz-h">
          <span class="lang-en">d · How the bands combine — the logit is a cosine series</span>
          <span class="lang-ko">d · band는 어떻게 합쳐지는가 — logit은 cosine 급수다</span>
        </h2>
        <p class="viz-sub">
          <span class="lang-en">Writing q and k as d/2 two-dim sub-vectors, the attention
            logit at relative distance Δ is Σᵢ aᵢ·cos(Δωᵢ − φᵢ), where the per-band
            amplitude aᵢ = ‖q₍ᵢ₎‖·‖k₍ᵢ₎‖ is the product of sub-vector norms [derived on
            this page, numerically checked; consistent with RoFormer's complex form].
            Set the four amplitudes of the d = 8 example (φᵢ = 0 here) and watch the
            score-vs-distance curve compose.</span>
          <span class="lang-ko">q와 k를 d/2개의 2차원 sub-vector로 쪼개 쓰면, 상대 거리
            Δ에서의 attention logit은 Σᵢ aᵢ·cos(Δωᵢ − φᵢ)가 된다. band별 amplitude
            aᵢ = ‖q₍ᵢ₎‖·‖k₍ᵢ₎‖는 sub-vector norm의 곱이다 [이 페이지의 유도, 수치 검증;
            RoFormer의 복소수 형태와 일치]. d = 8 예제의 amplitude 네 개를 조절하며
            (여기서는 φᵢ = 0) score-vs-distance 곡선이 합성되는 것을 보라.</span>
        </p>

        <div class="viz-frame">
          <div class="comb-controls">
            <div class="rp-chips" role="group" aria-label="Amplitude presets">
              <button class="rp-chip comb-pre on" data-pre="sem" type="button">low-freq heavy · trained-like</button>
              <button class="rp-chip comb-pre" data-pre="pos" type="button">high-freq heavy · positional head</button>
              <button class="rp-chip comb-pre" data-pre="flat" type="button">equal · interference</button>
            </div>
            <div class="amp-rows">
              <div class="ctl-row">
                <span class="ctl-label">a₀ · ω=1 · λ 6.3</span>
                <input type="range" class="amp-sl" data-i="0" min="0" max="100" step="1" value="25" />
                <span class="ctl-val" id="vA0">0.25</span>
              </div>
              <div class="ctl-row">
                <span class="ctl-label">a₁ · ω=0.1 · λ 63</span>
                <input type="range" class="amp-sl" data-i="1" min="0" max="100" step="1" value="45" />
                <span class="ctl-val" id="vA1">0.45</span>
              </div>
              <div class="ctl-row">
                <span class="ctl-label">a₂ · ω=0.01 · λ 628</span>
                <input type="range" class="amp-sl" data-i="2" min="0" max="100" step="1" value="70" />
                <span class="ctl-val" id="vA2">0.70</span>
              </div>
              <div class="ctl-row">
                <span class="ctl-label">a₃ · ω=0.001 · λ 6.3K</span>
                <input type="range" class="amp-sl" data-i="3" min="0" max="100" step="1" value="100" />
                <span class="ctl-val" id="vA3">1.00</span>
              </div>
            </div>
          </div>

          <div class="rope-scroll">
            <svg id="combSvg" viewBox="0 0 960 330" role="img" style="width:100%; height:auto; min-width:920px;"
