<script>
  // ============ shared tooltip (bilingual: data-tip / data-tip-ko) ============
  const tip = document.getElementById('hybTip');
  const curLang = () => (window.siteLang ? window.siteLang() : 'en');
  document.querySelectorAll('[data-tip]').forEach((el) => {
    el.addEventListener('mousemove', (e) => {
      if (!tip) return;
      const ko = el.getAttribute('data-tip-ko');
      tip.textContent = (curLang() === 'ko' && ko ? ko : el.getAttribute('data-tip')) || '';
      tip.style.opacity = '1';
      const x = Math.min(e.clientX + 14, window.innerWidth - 316);
      tip.style.left = x + 'px';
      tip.style.top = e.clientY + 18 + 'px';
    });
    el.addEventListener('mouseleave', () => {
      if (tip) tip.style.opacity = '0';
    });
  });

  // ============ memory race ============
  // Constants derived from the verified Qwen3.5-27B config (see fine print):
  const KV_HYB = 65536;        // 16 full layers × 4,096 B per token
  const KV_AF = 262144;        // 64 full layers × 4,096 B per token
  const STATE_CONST = 154927104; // 48 × (3,145,728 B fp32 state + 81,920 B conv buffer)
  const CROSS_T = 788;         // 3,227,648 / 4,096 — per-layer AND whole-model break-even

  const MODES = {
    zoom: { tMax: 4096, bMax: 1.25 * 1024 * 1024 * 1024, xt: ['0', '1K', '2K', '3K', '4K'], yt: ['0', '320 MB', '640 MB', '960 MB', '1.25 GB'] },
    full: { tMax: 262144, bMax: 64 * 1024 * 1024 * 1024, xt: ['0', '64K', '128K', '192K', '262K'], yt: ['0', '16 GB', '32 GB', '48 GB', '64 GB'] },
  };

  const X0 = 70, X1 = 700, Y0 = 310, Y1 = 40;

  const hybBytes = (t) => KV_HYB * t + STATE_CONST;
  const afBytes = (t) => KV_AF * t;

  function fmtB(b) {
    const G = 1073741824, M = 1048576, K = 1024;
    if (b >= G) return (b / G).toFixed(b < 10 * G ? 2 : 1) + ' GB';
    if (b >= M) return Math.round(b / M) + ' MB';
    return Math.round(b / K) + ' KB';
  }
  function fmtT(t) {
    return t.toLocaleString('en-US') + ' tok';
  }

  const MILESTONES = [
    {
      t: 512, mode: 'zoom',
      en: 'Below the crossover the hybrid actually holds <b>more</b> memory: 48 linear layers carry a fixed 148 MB of fp32 state while 16 full layers have written only 512 × 64 KB = 32 MB of KV. The all-full model sits at 128 MB. Recurrent state is a fixed cost, paid up front.',
      ko: 'crossover 아래에서는 hybrid가 오히려 메모리를 <b>더</b> 쓴다: linear layer 48개가 고정 148 MB의 fp32 state를 들고 있는 동안, full layer 16개가 쓴 KV는 512 × 64 KB = 32 MB뿐이다. all-full 모델은 128 MB. recurrent state는 선불로 내는 고정비다.',
    },
    {
      t: 788, mode: 'zoom',
      en: '<b>Crossover: 3,227,648 B of per-layer state ÷ 4,096 B/token of per-layer KV = 788 tokens.</b> The same T = 788 is where the whole-model totals tie (≈ 197 MB each), because both sides scale by the same 48 layers. Every token after this one is where the hybrid earns its keep.',
      ko: '<b>Crossover: layer당 state 3,227,648 B ÷ layer당 KV 4,096 B/token = 788 tokens.</b> 모델 전체 총량도 같은 T = 788에서 동점이 된다 (각각 ≈ 197 MB) — 양쪽 다 같은 48개 layer로 스케일하기 때문. 이 지점 이후의 모든 token이 hybrid가 밥값을 하는 구간이다.',
    },
    {
      t: 4096, mode: 'zoom',
      en: '4K context: hybrid = 256 MB KV + 148 MB state = <b>404 MB</b> vs <b>1 GB</b> all-full — already 2.5×. From here the gap grows by 192 KB per token, forever: that is the 48 layers that stopped paying rent.',
      ko: '4K context: hybrid = KV 256 MB + state 148 MB = <b>404 MB</b> vs all-full <b>1 GB</b> — 벌써 2.5×다. 여기서부터 격차는 token마다 192 KB씩 영원히 벌어진다: 임대료를 그만 낸 48개 layer의 몫이다.',
    },
    {
      t: 32768, mode: 'full',
      en: '32K: 2 GB + 148 MB ≈ <b>2.15 GB</b> vs <b>8 GB</b> — 3.7×. The constant state is already rounding noise; from here on the budget is entirely the 16 full-attention layers.',
      ko: '32K: 2 GB + 148 MB ≈ <b>2.15 GB</b> vs <b>8 GB</b> — 3.7×. 고정 state는 이미 반올림 오차 수준이고, 이제 예산은 전부 full-attention layer 16개의 것이다.',
    },
    {
      t: 131072, mode: 'full',
      en: '128K: 8 GB + 0.14 GB vs 32 GB. Note the slopes ARE the layer ratio — <b>64 KB/token vs 256 KB/token = 16 / 64 full layers</b>. Hybridization divides the KV problem by 4; it does not delete it.',
      ko: '128K: 8 GB + 0.14 GB vs 32 GB. 기울기가 곧 layer 비율이다 — <b>64 KB/token vs 256 KB/token = full layer 16 / 64</b>. 하이브리드화는 KV 문제를 4로 나눌 뿐, 지우지 않는다.',
    },
    {
      t: 262144, mode: 'full',
      en: 'Native max, 262,144 tokens: <b>16.1 GB vs 64 GB — 3.96×</b>, asymptotically 4×. The 48 linear layers still hold the same 148 MB they held at T = 0. This flat blue line is the entire architectural argument.',
      ko: '네이티브 최대 262,144 tokens: <b>16.1 GB vs 64 GB — 3.96×</b>, 점근적으로 4×. linear layer 48개는 T = 0일 때 들고 있던 148 MB를 여전히 그대로 들고 있다. 이 평평한 파란 선이 아키텍처 논증의 전부다.',
    },
  ];

  let mode = 'zoom';
  let T = 512;
  let step = 0;       // -1 = free slider
  let timer = null;

  const $ = (id) => document.getElementById(id);
  const xFor = (t) => X0 + (t / MODES[mode].tMax) * (X1 - X0);
  const yFor = (b) => Y0 - Math.min(1, b / MODES[mode].bMax) * (Y0 - Y1);

  function setLine(id, t0, b0, t1, b1) {
    const ln = $(id);
    if (!ln) return;
    ln.setAttribute('x1', xFor(t0)); ln.setAttribute('y1', yFor(b0));
    ln.setAttribute('x2', xFor(t1)); ln.setAttribute('y2', yFor(b1));
  }

  function drawStatic() {
    const m = MODES[mode];
    setLine('lnAF', 0, 0, m.tMax, afBytes(m.tMax));
    setLine('lnHyb', 0, STATE_CONST, m.tMax, hybBytes(m.tMax));
    setLine('lnSt', 0, STATE_CONST, m.tMax, STATE_CONST);
    document.querySelectorAll('#xTicks .xt').forEach((el, i) => { el.textContent = m.xt[i]; });
    document.querySelectorAll('#yTicks .yt').forEach((el, i) => { el.textContent = m.yt[i]; });
    const cg = $('crossG');
    if (cg) {
      cg.style.display = mode === 'zoom' ? '' : 'none';
      const cd = $('crossDot'), cl = $('crossLbl');
      if (cd) { cd.setAttribute('cx', xFor(CROSS_T)); cd.setAttribute('cy', yFor(afBytes(CROSS_T))); }
      if (cl) { cl.setAttribute('x', xFor(CROSS_T) + 8); cl.setAttribute('y', yFor(afBytes(CROSS_T)) - 10); }
    }
  }

  function drawCursor() {
    const x = xFor(T);
    const bh = hybBytes(T), ba = afBytes(T);
    const cur = $('cursor');
    if (cur) { cur.setAttribute('x1', x); cur.setAttribute('x2', x); }
    const dA = $('dotAF'), dH = $('dotHyb');
    if (dA) { dA.setAttribute('cx', x); dA.setAttribute('cy', yFor(ba)); }
    if (dH) { dH.setAttribute('cx', x); dH.setAttribute('cy', yFor(bh)); }
    const anchorEnd = x > 540;
    const lx = anchorEnd ? x - 10 : x + 10;
    const lA = $('lblAF'), lH = $('lblHyb');
    if (lA) {
      lA.setAttribute('x', lx); lA.setAttribute('text-anchor', anchorEnd ? 'end' : 'start');
      lA.setAttribute('y', Math.max(58, yFor(ba) - 9));
      lA.textContent = 'all-full ' + fmtB(ba);
    }
    if (lH) {
      lH.setAttribute('x', lx); lH.setAttribute('text-anchor', anchorEnd ? 'end' : 'start');
      lH.setAttribute('y', Math.min(Y0 - 4, yFor(bh) + 16));
      lH.textContent = 'hybrid ' + fmtB(bh);
    }
    const sv = $('sliderVal');
    if (sv) sv.textContent = fmtT(T);
  }

  function renderMeters() {
    const el = $('raceMeters');
    if (!el) return;
    const bh = hybBytes(T), ba = afBytes(T);
    const ratio = ba > 0 ? (ba / bh).toFixed(2) : '—';
    el.innerHTML =
      'T = <b>' + T.toLocaleString('en-US') + '</b> · full-attn KV ' + fmtB(KV_HYB * T) +
      ' + linear state ' + fmtB(STATE_CONST) + ' (const) = hybrid <b>' + fmtB(bh) + '</b>' +
      ' · all-full ' + fmtB(ba) + ' · ratio <b>' + ratio + '×</b>';
  }

  function renderCaption() {
    const cap = $('raceCaption');
    if (!cap) return;
    const lang = curLang();
    if (step >= 0) {
      cap.innerHTML = MILESTONES[step][lang === 'ko' ? 'ko' : 'en'];
    } else {
      const bh = hybBytes(T), ba = afBytes(T);
      const r = (ba / bh).toFixed(2);
      cap.innerHTML = lang === 'ko'
        ? 'T = <b>' + T.toLocaleString('en-US') + '</b> tokens: hybrid <b>' + fmtB(bh) + '</b> vs all-full <b>' + fmtB(ba) + '</b> — ' + r + '×. (milestone 해설은 Prev/Next로)'
        : 'At T = <b>' + T.toLocaleString('en-US') + '</b> tokens: hybrid <b>' + fmtB(bh) + '</b> vs all-full <b>' + fmtB(ba) + '</b> — ' + r + '×. (Use Prev/Next for the milestone commentary.)';
    }
    const st = $('raceStep');
    if (st) {
      st.textContent = step >= 0
        ? 'Step ' + step + ' / ' + (MILESTONES.length - 1) + ' — ' + MILESTONES[step].t.toLocaleString('en-US') + ' tokens'
        : 'free — ' + T.toLocaleString('en-US') + ' tokens';
    }
  }

  function setMode(m) {
    if (mode === m) return;
    mode = m;
    const mz = $('modeZoom'), mf = $('modeFull');
    if (mz) mz.classList.toggle('on', m === 'zoom');
    if (mf) mf.classList.toggle('on', m === 'full');
    T = Math.min(T, MODES[mode].tMax);
    drawStatic();
    syncSlider();
    drawCursor();
    renderMeters();
    renderCaption();
  }

  function syncSlider() {
    const s = $('ctxSlider');
    if (s) s.value = String(Math.round((T / MODES[mode].tMax) * 1000));
  }

  function goStep(i) {
    step = Math.max(0, Math.min(MILESTONES.length - 1, i));
    const ms = MILESTONES[step];
    if (ms.mode !== mode) {
      mode = ms.mode;
      const mz = $('modeZoom'), mf = $('modeFull');
      if (mz) mz.classList.toggle('on', mode === 'zoom');
      if (mf) mf.classList.toggle('on', mode === 'full');
      drawStatic();
    }
    T = ms.t;
    syncSlider();
    drawCursor();
    renderMeters();
    renderCaption();
    const bp = $('btnPrev'), bn = $('btnNext');
    if (bp) bp.toggleAttribute('disabled', step === 0);
    if (bn) bn.toggleAttribute('disabled', step === MILESTONES.length - 1);
  }

  function stopPlay() {
    if (timer !== null) { clearInterval(timer); timer = null; }
    const p = $('btnPlay');
    if (p) p.textContent = '▶ Play';
  }

  const slider = $('ctxSlider');
  if (slider) {
    slider.addEventListener('input', () => {
      stopPlay();
      step = -1;
      T = Math.max(16, Math.round((Number(slider.value) / 1000) * MODES[mode].tMax));
      drawCursor();
      renderMeters();
      renderCaption();
      const bp = $('btnPrev'), bn = $('btnNext');
      if (bp) bp.removeAttribute('disabled');
      if (bn) bn.removeAttribute('disabled');
    });
  }

  const mzBtn = $('modeZoom'), mfBtn = $('modeFull');
  if (mzBtn) mzBtn.addEventListener('click', () => { stopPlay(); step = -1; setMode('zoom'); });
  if (mfBtn) mfBtn.addEventListener('click', () => { stopPlay(); step = -1; setMode('full'); });

  const bPrev = $('btnPrev'), bNext = $('btnNext'), bReset = $('btnReset'), bPlay = $('btnPlay');
  if (bPrev) bPrev.addEventListener('click', () => { stopPlay(); goStep(step < 0 ? 0 : step - 1); });
  if (bNext) bNext.addEventListener('click', () => { stopPlay(); goStep(step < 0 ? 0 : step + 1); });
  if (bReset) bReset.addEventListener('click', () => { stopPlay(); goStep(0); });
  if (bPlay) {
    bPlay.addEventListener('click', () => {
      if (timer !== null) { stopPlay(); return; }
      if (step < 0 || step >= MILESTONES.length - 1) goStep(0);
      bPlay.textContent = '❚❚ Pause';
      timer = setInterval(() => {
        if (step >= MILESTONES.length - 1) { stopPlay(); return; }
        goStep(step + 1);
      }, 2600);
    });
  }

  window.addEventListener('site-langchange', () => {
    renderCaption();
  });

  goStep(0);
</script>
