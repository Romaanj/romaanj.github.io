<script>
  // ============ shared tooltip (bilingual: data-tip / data-tip-ko) ============
  const tip = document.getElementById('hybTip');
  const curLang = () => (window.siteLang ? window.siteLang() : 'en');
  document.querySelectorAll('[data-tip]').forEach((el) => {
