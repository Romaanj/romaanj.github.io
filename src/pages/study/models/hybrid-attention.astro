    });
    el.addEventListener('mouseleave', () => {
      if (tip) tip.style.opacity = '0';
    });
  });

  // ============ memory race ============
  // Constants derived from the verified Qwen3.5-27B config (see fine print):
  const KV_HYB = 65536;        // 16 full layers × 4,096 B per token
  const KV_AF = 262144;        // 64 full layers × 4,096 B per token
  const STATE_CONST = 154927104; // 48 × (3,145,728 B fp32 state + 81,920 B conv buffer)
  const CROSS_T = 788;         // 3,227,648 / 4,096 — per-layer AND whole-model break-even

  const MODES = {
    zoom: { tMax: 4096, bMax: 1.25 * 1024 * 1024 * 1024, xt: ['0', '1K', '2K', '3K', '4K'], yt: ['0', '320 MB', '640 MB', '960 MB', '1.25 GB'] },
    full: { tMax: 262144, bMax: 64 * 1024 * 1024 * 1024, xt: ['0', '64K', '128K', '192K', '262K'], yt: ['0', '16 GB', '32 GB', '48 GB', '64 GB'] },
  };

  const X0 = 70, X1 = 700, Y0 = 310, Y1 = 40;

  const hybBytes = (t) => KV_HYB * t + STATE_CONST;
  const afBytes = (t) => KV_AF * t;

  function fmtB(b) {
    const G = 1073741824, M = 1048576, K = 1024;
    if (b >= G) return (b / G).toFixed(b < 10 * G ? 2 : 1) + ' GB';
    if (b >= M) return Math.round(b / M) + ' MB';
    return Math.round(b / K) + ' KB';
  }
  function fmtT(t) {
    return t.toLocaleString('en-US') + ' tok';
  }

  const MILESTONES = [
    {
