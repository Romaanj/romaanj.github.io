  .sdar-page .smono { font-family: var(--font-mono); font-size: 10.5px; fill: var(--text-secondary); }
  .sdar-page .anno { font-size: 12px; fill: var(--text-secondary); }
  .sdar-page .taccent { fill: var(--accent-strong); }
  .sdar-page .mlabel { font-family: var(--font-mono); font-size: 9.5px; fill: var(--text-tertiary); }

  .sdar-page .sbox { fill: #ffffff; stroke: var(--line-strong); stroke-width: 1.3; }
  .sdar-page .sbox-warm { fill: var(--surface-warm); stroke: var(--line); }
  .sdar-page .sbox-accent { fill: #fdf6f2; stroke: var(--accent); stroke-dasharray: 5 4; stroke-width: 1.4; }
  .sdar-page .sbox-blk { fill: #ffffff; }
  .sdar-page .clickable { cursor: pointer; }
  .sdar-page .clickable:hover .sbox-blk { stroke: var(--accent); stroke-width: 2; }
  .sdar-page .clickable:hover .stitle { fill: var(--accent-strong); }
  .sdar-page .blk-link { text-decoration: none; }

  .sdar-page .flowline { stroke: var(--text-tertiary); stroke-width: 1.6; fill: none; }
  .sdar-page .flowline-thin { stroke: var(--line-strong); stroke-width: 1.4; fill: none; }
  .sdar-page .flowline-dash { stroke: var(--line-strong); stroke-width: 1.4; stroke-dasharray: 3 4; }
  .sdar-page .skipline { stroke: var(--line-strong); stroke-width: 1.4; stroke-dasharray: 4 4; }
  .sdar-page .loopline { stroke: var(--accent); stroke-width: 1.6; fill: none; stroke-dasharray: 6 5; }
  .sdar-page .rescirc { fill: var(--surface-warm); stroke: var(--line-strong); stroke-width: 1.3; }

  /* ---- layer view grid ---- */
  .sdar-page .layer-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; }
  @media (min-width: 980px) {
    .sdar-page .layer-grid { grid-template-columns: 5fr 4fr; align-items: start; }
  }
  .sdar-page .mask-modes { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.9rem; }
  .sdar-page .mode-btn {
    font-family: var(--font-sans); font-size: 0.78rem; font-weight: 600; cursor: pointer;
    padding: 0.4em 1em; border-radius: 999px; border: 1px solid var(--line-strong);
    background: var(--surface); color: var(--text-secondary); transition: all 0.2s;
  }
  .sdar-page .mode-btn.on { background: var(--text); border-color: var(--text); color: var(--bg); }
  .sdar-page .mode-btn:not(.on):hover { border-color: var(--accent); color: var(--accent-strong); }

  .sdar-page .mcell.m-past { fill: var(--swatch-kraft); opacity: 0.75; }
  .sdar-page .mcell.m-intra { fill: var(--accent); }
  .sdar-page .mcell.m-off { fill: #ffffff; stroke: var(--line); }
  .sdar-page .mhit { fill: transparent; cursor: pointer; }
  .sdar-page .mrow.active .mcell { stroke: var(--text); stroke-width: 1.4; }
  .sdar-page .mrow.active .mlabel { fill: var(--text); font-weight: 700; }
  .sdar-page .mrow { transition: opacity 0.25s; }
  .sdar-page .mask-wrap.decode .row-prev { opacity: 0.22; }
  .sdar-page .mdiag { stroke: var(--text); stroke-width: 1.2; stroke-dasharray: 5 4; opacity: 0.45; pointer-events: none; }

  .sdar-page .mask-legend {
    display: flex; flex-direction: column; gap: 0.3rem; margin: 0.9rem 0 0;
    font-size: 0.8rem; color: var(--text-secondary);
  }
  .sdar-page .mask-legend .sw {
    display: inline-block; width: 13px; height: 13px; border-radius: 3px;
    margin-right: 0.45em; vertical-align: -2px;
  }
  .sdar-page .sw-past { background: var(--swatch-kraft); opacity: 0.75; }
  .sdar-page .sw-intra { background: var(--accent); }
  .sdar-page .sw-off { background: #fff; border: 1px solid var(--line-strong); }
  .sdar-page .sw-diag { background: repeating-linear-gradient(45deg, var(--text) 0 3px, transparent 3px 6px); opacity: 0.5; border-radius: 0; height: 3px; margin-bottom: 4px; }
  .sdar-page .mask-caption {
    margin: 0.9rem 0 0; padding: 0.8rem 1rem; min-height: 4.6em;
    background: var(--surface-warm); border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius-s) var(--radius-s) 0;
    font-size: 0.88rem; color: var(--text-secondary);
  }

  /* ---- decoding timeline ---- */
  .sdar-page .dt-controls { display: flex; align-items: center; gap: 0.55rem; flex-wrap: wrap; margin-bottom: 1.3rem; }
  .sdar-page .btn-sm { padding: 0.45em 1.1em; font-size: 0.85rem; }
  .sdar-page .btn[disabled] { opacity: 0.4; pointer-events: none; }
  .sdar-page .dt-step {
    font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-secondary);
    margin-left: auto; white-space: nowrap;
  }

  .sdar-page .dt-strip { display: flex; flex-wrap: wrap; gap: 0.8rem; align-items: flex-start; margin-bottom: 1.1rem; }
  .sdar-page .blk {
    display: inline-flex; flex-direction: column; gap: 0.4rem;
    padding: 0.6rem 0.7rem 0.5rem; border-radius: var(--radius-s);
    border: 1px solid var(--line); background: var(--surface);
  }
  .sdar-page .blk.active { border: 1.5px dashed var(--accent); background: #fdf6f2; }
  .sdar-page .blk.cached { border-color: var(--swatch-olive); background: #f6f7f2; }
  .sdar-page .blk-label {
    font-size: 0.66rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--text-tertiary);
  }
  .sdar-page .blk.active .blk-label { color: var(--accent-strong); }
  .sdar-page .blk.cached .blk-label { color: var(--swatch-olive); }
  .sdar-page .blk-toks { display: flex; gap: 0.4rem; align-items: flex-start; }
  .sdar-page .tokwrap { display: inline-flex; flex-direction: column; align-items: center; gap: 3px; min-height: 56px; min-width: 3em; }
  .sdar-page .chip {
    display: inline-block; font-family: var(--font-mono); font-size: 0.85rem;
    padding: 0.28em 0.6em; border-radius: 7px; border: 1px solid transparent; white-space: nowrap;
  }
  .sdar-page .chip.p { background: var(--text); color: var(--bg); }
  .sdar-page .chip.masked { border: 1.5px dashed var(--line-strong); color: var(--text-tertiary); background: transparent; }
  .sdar-page .chip.just { background: var(--accent); color: #fff; animation: sdar-pop 0.45s var(--ease-out); }
  .sdar-page .chip.done { background: var(--accent-soft); color: var(--accent-strong); }
  .sdar-page .chip.kv { background: var(--surface-warm); color: var(--text); border-color: var(--line); }
  @keyframes sdar-pop {
    0% { transform: scale(0.6); opacity: 0; }
    60% { transform: scale(1.12); }
    100% { transform: scale(1); opacity: 1; }
  }
  .sdar-page .confbar { width: 90%; height: 5px; border-radius: 3px; background: var(--line); overflow: hidden; }
  .sdar-page .confbar i { display: block; height: 100%; background: var(--accent); border-radius: 3px; transition: width 0.4s var(--ease-out); }
  .sdar-page .guess { font-family: var(--font-mono); font-size: 0.66rem; color: var(--text-tertiary); white-space: nowrap; }
  .sdar-page .guess.dim { opacity: 0.55; }

  .sdar-page .dt-caption {
    margin: 0 0 0.8rem; padding: 0.9rem 1.1rem; min-height: 4.4em;
    background: var(--surface-warm); border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius-s) var(--radius-s) 0; font-size: 0.95rem;
  }
  .sdar-page .dt-meters { font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-secondary); margin-bottom: 1.3rem; }
  .sdar-page .dt-meters b { color: var(--accent-strong); }

  .sdar-page .cache-panel { border-top: 1px solid var(--line); padding-top: 1rem; }
  .sdar-page .cache-title { font-size: 0.82rem; color: var(--text-secondary); margin-bottom: 0.55rem; }
  .sdar-page .cache-title b { color: var(--text); }
  .sdar-page .cache-row { display: flex; flex-wrap: wrap; gap: 3px; align-items: flex-end; min-height: 20px; }
  .sdar-page .cc { width: 13px; height: 19px; border-radius: 3px; animation: sdar-rise 0.35s var(--ease-out); }
  .sdar-page .cc.g-p { background: var(--swatch-slate); }
  .sdar-page .cc.g-1 { background: var(--accent); }
  .sdar-page .cc.g-2 { background: var(--swatch-kraft); }
  .sdar-page .cc.g-sep { margin-left: 9px; }
  @keyframes sdar-rise {
    from { transform: translateY(6px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
  .sdar-page .cache-label { font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-tertiary); margin-top: 0.5rem; }

  /* ---- efficiency note ---- */
  .sdar-page .eff-note {
    border-radius: var(--radius-l); padding: clamp(1.4rem, 3vw, 2.2rem);
    margin: 3rem 0; max-width: 860px;
  }
  .sdar-page .eff-note h3 { color: var(--text-on-dark); margin-bottom: 0.7rem; }
  .sdar-page .eff-note p { font-size: 0.97rem; line-height: 1.7; }
  .sdar-page .eff-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.1rem; }
  .sdar-page .eff-chip {
    font-family: var(--font-mono); font-size: 0.74rem; color: var(--text-on-dark);
    border: 1px solid var(--line-on-dark); border-radius: 999px; padding: 0.35em 0.9em;
    background: #1d1d1b;
  }

  .sdar-page .deeper-list { list-style: none; padding: 0; margin: 0.6rem 0 1.6rem; display: flex; flex-direction: column; gap: 0.55rem; }
  .sdar-page .deeper-list .arrow-link { text-decoration: none; }
  .sdar-page .fine-print { font-size: 0.85rem; color: var(--text-tertiary); }

  /* ---- tooltip ---- */
  #sdarTip {
    position: fixed; z-index: 60; max-width: 280px; pointer-events: none;
    background: var(--surface-dark); color: var(--text-on-dark);
    font-family: var(--font-sans); font-size: 0.78rem; line-height: 1.5;
    padding: 0.5rem 0.75rem; border-radius: 8px; opacity: 0;
    transition: opacity 0.15s; box-shadow: 0 8px 24px rgba(20, 20, 19, 0.25);
  }
</style>

<script>
  // ============ shared tooltip (bilingual: data-tip / data-tip-ko) ============
  const tip = document.getElementById('sdarTip');
  const curLang = () =>
    typeof window.siteLang === 'function' ? window.siteLang() : 'en';
  document.querySelectorAll('[data-tip]').forEach((el) => {
    el.addEventListener('mousemove', (e) => {
      if (!tip) return;
      const ko = el.getAttribute('data-tip-ko');
      tip.textContent = (curLang() === 'ko' && ko ? ko : el.getAttribute('data-tip')) || '';
      tip.style.opacity = '1';
      const x = Math.min(e.clientX + 14, window.innerWidth - 296);
      tip.style.left = x + 'px';
      tip.style.top = e.clientY + 18 + 'px';
    });
    el.addEventListener('mouseleave', () => {
      if (tip) tip.style.opacity = '0';
    });
  });

  // ============ mask matrix ============
  const maskWrap = document.getElementById('maskWrap');
  const maskCap = document.getElementById('maskCaption');
  const modeTrainBtn = document.getElementById('modeTrain');
  const modeDecBtn = document.getElementById('modeDec');
  let maskMode = 'train';

  const CAP_DEFAULT = {
    train: {
      en: 'Hover a row: each row is one query position; filled cells are the K/V positions it may attend to. Coral cells right of the dashed diagonal are exactly what block diffusion adds over an AR mask.',
      ko: '행에 마우스를 올려 보자: 각 행은 query 위치 하나이고, 채워진 셀은 그 query가 attend할 수 있는 K/V 위치다. 점선 대각선 오른쪽의 coral 셀이 바로 block diffusion이 AR mask 위에 더하는 가시성이다.',
    },
    dec: {
      en: 'Decoding view: while block B2 is being denoised, only its four queries (t8–t11) run through the layers. t0–t7 are finalized — they never run as queries again; their K/V are read from the cache.',
      ko: '디코딩 뷰: block B2를 denoise하는 동안 그 네 개의 query(t8–t11)만 layer를 통과한다. t0–t7은 확정(finalized)되어 다시는 query로 실행되지 않는다; 이들의 K/V는 cache에서 읽는다.',
    },
  };

  let maskCapRow = null; // active row q, or null → default caption

  function maskCaptionText() {
    const lang = curLang();
    if (maskCapRow !== null) return rowText(maskCapRow, lang);
    const d = CAP_DEFAULT[maskMode];
    return lang === 'ko' ? d.ko : d.en;
  }

  function setMaskMode(m) {
    maskMode = m;
    if (maskWrap) maskWrap.classList.toggle('decode', m === 'dec');
    if (modeTrainBtn) modeTrainBtn.classList.toggle('on', m === 'train');
    if (modeDecBtn) modeDecBtn.classList.toggle('on', m === 'dec');
    maskCapRow = null;
    if (maskCap) maskCap.textContent = maskCaptionText();
    clearRows();
  }
  if (modeTrainBtn) modeTrainBtn.addEventListener('click', () => setMaskMode('train'));
  if (modeDecBtn) modeDecBtn.addEventListener('click', () => setMaskMode('dec'));

  function clearRows() {
    document.querySelectorAll('.mrow.active').forEach((x) => x.classList.remove('active'));
  }

  function rowText(q, lang) {
    const b = Math.floor(q / 4);
    const s = b * 4;
    const e = s + 3;
    if (lang === 'ko') {
      if (maskMode === 'dec' && b < 2) {
        return (
          't' + q + '는 확정(finalized)된 block에 있다: 디코딩 동안 다시는 query로 실행되지 않고, ' +
          'K/V(layer당 4 KB)는 이후 block들이 cache에서 바로 읽어 간다.'
        );
      }
      let k = 'Query t' + q + ' (block B' + b + '): ';
      k += b > 0
        ? 't0–t' + (s - 1) + '(block B0–B' + (b - 1) + ', KV cache에서 제공)에는 causal하게, '
        : '';
      k += '자기 block B' + b + ' 전체(t' + s + '–t' + e + ')에는 bidirectional하게 attend한다';
      if (q < e) k += ' — 미래 위치 t' + (q + 1) + '–t' + e + ' 포함';
      k += '. t' + e + ' 이후 위치는 mask로 가려진다.';
      return k;
    }
    if (maskMode === 'dec' && b < 2) {
      return (
        't' + q + ' sits in a finalized block: during decoding it never runs as a query again — ' +
        'its K/V (4 KB per layer) are read straight from the cache by later blocks.'
      );
    }
    let t = 'Query t' + q + ' (block B' + b + '): ';
    t += b > 0
      ? 'attends causally to t0–t' + (s - 1) + ' (blocks B0–B' + (b - 1) + ', served from the KV cache) and '
      : 'attends ';
    t += 'bidirectionally to all of B' + b + ' (t' + s + '–t' + e + ')';
    if (q < e) t += ' — including future positions t' + (q + 1) + '–t' + e;
    t += '. Positions after t' + e + ' are masked out.';
    return t;
  }

  document.querySelectorAll('.mrow').forEach((g) => {
    const q = Number(g.getAttribute('data-q'));
    const activate = () => {
      clearRows();
      g.classList.add('active');
      maskCapRow = q;
      if (maskCap) maskCap.textContent = maskCaptionText();
    };
    g.addEventListener('mouseenter', activate);
    g.addEventListener('click', activate);
  });
  const maskSvg = document.getElementById('maskSvg');
  if (maskSvg) {
    maskSvg.addEventListener('mouseleave', () => {
      clearRows();
      maskCapRow = null;
      if (maskCap) maskCap.textContent = maskCaptionText();
    });
  }

  // ============ decoding timeline ============
  const PROMPT = ['The', 'capital', 'of', 'France', 'is'];
  const B1 = ['Paris', ',', 'home', 'to'];
  const B2 = ['the', 'Louvre', 'museum', '.'];

  // per-position states: 'h' hidden, 'm' masked (no scores yet), {c,g} masked with
  // confidence + current guess, 'j' just committed, 'd' committed, 'k' cached
  const H4 = ['h', 'h', 'h', 'h'];
  const STEPS = [
    {
      name: 'Prefill', b1: H4, b2: H4, cache: 5, fw: 1, dec: 0, em: 0,
      cap: {
        en: 'Prefill — the 5-token prompt runs through all 28 layers once. Every layer writes K and V for the 5 positions: 5 × 112 KB = 560 KB of cache. Identical to an AR model so far.',
        ko: 'Prefill — 5-token prompt가 28개 layer를 한 번 통과한다. 모든 layer가 5개 위치의 K와 V를 기록한다: 5 × 112 KB = 560 KB의 cache. 여기까지는 AR 모델과 동일하다.',
      },
    },
    {
      name: 'Open block 1', b1: ['m', 'm', 'm', 'm'], b2: H4, cache: 5, fw: 1, dec: 0, em: 0,
      cap: {
        en: 'A block of 4 [MASK] tokens is appended. Within this block attention will be bidirectional; toward the prompt it is causal, so the cached K/V are simply read — nothing is recomputed.',
        ko: '[MASK] token 4개짜리 block이 덧붙는다. 이 block 안에서 attention은 bidirectional이 되고, prompt 쪽으로는 causal이므로 cache된 K/V를 그대로 읽기만 한다 — 아무것도 재계산되지 않는다.',
      },
    },
    {
      name: 'Denoise 1/3', b1: ['j', { c: 0.55, g: ',' }, { c: 0.34, g: 'home' }, { c: 0.47, g: 'to' }], b2: H4, cache: 5, fw: 2, dec: 1, em: 1,
      cap: {
        en: "Denoise pass 1 — one forward pass scores all 4 masked positions in parallel. 'Paris' (0.98) clears the confidence threshold (τ ≈ 0.9) and is committed. The rest stay masked — but note the model already has guesses.",
        ko: "Denoise pass 1 — forward pass 한 번이 mask된 4개 위치를 병렬로 채점한다. 'Paris'(0.98)가 confidence threshold(τ ≈ 0.9)를 넘어 commit된다. 나머지는 mask로 남는다 — 하지만 모델이 이미 추측을 갖고 있다는 점에 주목.",
      },
    },
    {
      name: 'Denoise 2/3', b1: ['d', 'j', { c: 0.61, g: 'home' }, 'j'], b2: H4, cache: 5, fw: 3, dec: 2, em: 3,
      cap: {
        en: "Denoise pass 2 — with 'Paris' fixed as context, confidence rises elsewhere: ',' (0.96) and 'to' (0.93) commit. Out of order — inside a block, commit order follows confidence, not position.",
        ko: "Denoise pass 2 — 'Paris'가 context로 고정되자 다른 위치의 confidence가 올라간다: ','(0.96)와 'to'(0.93)가 commit된다. 순서를 건너뛴다 — block 안에서 commit 순서는 위치가 아니라 confidence를 따른다.",
      },
    },
    {
      name: 'Denoise 3/3', b1: ['d', 'd', 'j', 'd'], b2: H4, cache: 5, fw: 4, dec: 3, em: 4,
      cap: {
        en: "Denoise pass 3 — 'home' (0.97) resolves last. Block 1 took 3 forward passes for 4 tokens: 1.33 tokens per pass, vs exactly 1.0 for AR decoding.",
        ko: "Denoise pass 3 — 'home'(0.97)이 마지막으로 풀린다. Block 1은 token 4개에 forward pass 3번: pass당 1.33 token, AR 디코딩은 정확히 1.0이다.",
      },
    },
    {
      name: 'Cache append', b1: ['k', 'k', 'k', 'k'], b2: H4, cache: 9, fw: 4, dec: 3, em: 4,
      cap: {
        en: 'Block 1 is finalized. Because cross-block attention is causal, its K/V values are exact and are appended to the cache (+4 × 112 KB = 448 KB). They will never be recomputed — the same guarantee an AR cache gives.',
        ko: 'Block 1이 확정된다. block 사이 attention은 causal이므로 K/V 값이 정확(exact)하며 cache에 추가된다(+4 × 112 KB = 448 KB). 다시는 재계산되지 않는다 — AR cache가 주는 것과 같은 보장이다.',
      },
    },
    {
      name: 'Open block 2', b1: ['k', 'k', 'k', 'k'], b2: ['m', 'm', 'm', 'm'], cache: 9, fw: 4, dec: 3, em: 4,
      cap: {
        en: 'Block 2 opens with 4 fresh masks. Its queries attend to 9 cached positions (prompt + block 1) plus the 4 in-block positions — 13 keys total per query.',
        ko: 'Block 2가 새 mask 4개로 열린다. 이 block의 query는 cache된 9개 위치(prompt + block 1)와 block 내 4개 위치에 attend한다 — query당 총 13개의 key.',
      },
    },
    {
      name: 'Denoise 1/2', b1: ['k', 'k', 'k', 'k'], b2: ['j', 'j', { c: 0.58, g: 'museum' }, { c: 0.71, g: '.' }], cache: 9, fw: 5, dec: 4, em: 6,
      cap: {
        en: "Denoise pass 1 — two tokens clear τ in a single pass: 'the' (0.95) and 'Louvre' (0.92). Two commits for one read of the 3.4 GB of weights.",
        ko: "Denoise pass 1 — 한 pass에서 token 두 개가 τ를 넘는다: 'the'(0.95)와 'Louvre'(0.92). 3.4 GB weight를 한 번 읽는 동안 commit 두 개.",
      },
    },
    {
      name: 'Denoise 2/2', b1: ['k', 'k', 'k', 'k'], b2: ['d', 'd', 'j', 'j'], cache: 9, fw: 6, dec: 5, em: 8,
      cap: {
        en: "Denoise pass 2 — 'museum' (0.94) and '.' (0.99) commit together. Block 2: 4 tokens in 2 passes.",
        ko: "Denoise pass 2 — 'museum'(0.94)과 '.'(0.99)가 함께 commit된다. Block 2: 2 pass에 token 4개.",
      },
    },
    {
      name: 'Cache append', b1: ['k', 'k', 'k', 'k'], b2: ['k', 'k', 'k', 'k'], cache: 13, fw: 6, dec: 5, em: 8,
      cap: {
        en: "Block 2's K/V join the cache: 13 tokens × 112 KB ≈ 1.42 MB. The cache grows in block-sized strides but is bit-for-bit what an AR pass would have produced.",
        ko: 'Block 2의 K/V가 cache에 합류한다: 13 token × 112 KB ≈ 1.42 MB. cache는 block 크기 보폭으로 자라지만, AR pass가 만들었을 값과 bit 단위로 동일하다.',
      },
    },
    {
      name: 'Tally', b1: ['k', 'k', 'k', 'k'], b2: ['k', 'k', 'k', 'k'], cache: 13, fw: 6, dec: 5, em: 8,
      cap: {
        en: 'Tally — 8 new tokens in 5 denoising passes (AR would use 8). At batch 1 each pass reads all ≈3.4 GB of weights, so tokens-per-pass is nearly free throughput. The knob is τ: lower it for more parallelism, raise it for more caution.',
        ko: '결산 — denoising pass 5번으로 새 token 8개(AR이라면 8번). batch 1에서는 pass마다 ≈3.4 GB weight 전체를 읽으므로, tokens-per-pass는 거의 공짜 throughput이다. 손잡이는 τ: 낮추면 병렬성이, 높이면 신중함이 커진다.',
      },
    },
  ];

  const stripEl = document.getElementById('dtStrip');
  const capEl = document.getElementById('dtCaption');
  const metersEl = document.getElementById('dtMeters');
  const stepEl = document.getElementById('dtStep');
  const cacheEl = document.getElementById('dtCache');
  const cacheLblEl = document.getElementById('dtCacheLbl');
  const btnPrev = document.getElementById('btnPrev');
  const btnNext = document.getElementById('btnNext');
  const btnPlay = document.getElementById('btnPlay');
  const btnReset = document.getElementById('btnReset');

  let cur = 0;
  let timer = null;

  function esc(s) {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;');
  }

  function renderBlock(label, toks, states) {
    if (states.every((s) => s === 'h')) return '';
    const cached = states.every((s) => s === 'k');
    const active = states.some((s) => s === 'm' || s === 'j' || typeof s === 'object');
    const cls = cached ? 'cached' : active ? 'active' : 'done';
    let inner = '';
    states.forEach((s, i) => {
      const t = esc(toks[i]);
      if (s === 'm') {
        inner += '<span class="tokwrap"><span class="chip masked">▢</span><span class="guess dim">?</span></span>';
      } else if (typeof s === 'object') {
        const pct = Math.round(s.c * 100);
        inner +=
          '<span class="tokwrap"><span class="chip masked">▢</span>' +
          '<span class="confbar"><i style="width:' + pct + '%"></i></span>' +
          '<span class="guess">' + esc(s.g) + ' · ' + s.c.toFixed(2) + '</span></span>';
      } else if (s === 'j') {
        inner += '<span class="tokwrap"><span class="chip just">' + t + '</span></span>';
      } else if (s === 'd') {
        inner += '<span class="tokwrap"><span class="chip done">' + t + '</span></span>';
      } else {
        inner += '<span class="tokwrap"><span class="chip kv">' + t + '</span></span>';
      }
    });
    const lab = label + (cached ? ' · in KV cache' : active ? ' · denoising' : '');
    return (
      '<span class="blk ' + cls + '"><span class="blk-label">' + lab +
      '</span><span class="blk-toks">' + inner + '</span></span>'
    );
  }

  function promptHtml() {
    const chips = PROMPT.map((t) => '<span class="chip p">' + esc(t) + '</span>').join('');
    return (
      '<span class="blk prompt-blk"><span class="blk-label">prompt · in KV cache</span>' +
      '<span class="blk-toks">' + chips + '</span></span>'
    );
  }

  function renderCache(n) {
    let h = '';
    for (let i = 0; i < n; i++) {
      const g = i < 5 ? 'g-p' : i < 9 ? 'g-1' : 'g-2';
      const sep = i === 5 || i === 9 ? ' g-sep' : '';
      h += '<span class="cc ' + g + sep + '"></span>';
    }
    if (cacheEl) cacheEl.innerHTML = h;
    const kb = n * 112;
    let lbl = n + ' tokens × 112 KB = ' + kb.toLocaleString() + ' KB';
    if (kb >= 1000) lbl += ' ≈ ' + (kb / 1024).toFixed(2) + ' MB';
    if (cacheLblEl) cacheLblEl.textContent = lbl;
  }

  function render() {
    const s = STEPS[cur];
    if (stripEl) {
      stripEl.innerHTML =
        promptHtml() + renderBlock('block 1', B1, s.b1) + renderBlock('block 2', B2, s.b2);
    }
    if (capEl) capEl.textContent = curLang() === 'ko' ? s.cap.ko : s.cap.en;
    if (metersEl) {
      metersEl.innerHTML =
        'forward passes <b>' + s.fw + '</b> (1 prefill + ' + s.dec + ' denoise) · ' +
        'tokens committed <b>' + s.em + '</b> · AR passes for the same tokens: <b>' + s.em + '</b>';
    }
    if (stepEl) stepEl.textContent = 'Step ' + cur + ' / ' + (STEPS.length - 1) + ' — ' + s.name;
    renderCache(s.cache);
    if (btnPrev) btnPrev.toggleAttribute('disabled', cur === 0);
    if (btnNext) btnNext.toggleAttribute('disabled', cur === STEPS.length - 1);
  }

  function stopPlay() {
    if (timer !== null) {
      clearInterval(timer);
      timer = null;
    }
    if (btnPlay) btnPlay.textContent = '▶ Play';
  }

  function go(i) {
    cur = Math.max(0, Math.min(STEPS.length - 1, i));
    render();
  }

  if (btnPrev) btnPrev.addEventListener('click', () => { stopPlay(); go(cur - 1); });
  if (btnNext) btnNext.addEventListener('click', () => { stopPlay(); go(cur + 1); });
  if (btnReset) btnReset.addEventListener('click', () => { stopPlay(); go(0); });
  if (btnPlay) {
    btnPlay.addEventListener('click', () => {
      if (timer !== null) {
        stopPlay();
        return;
      }
      if (cur === STEPS.length - 1) go(0);
      btnPlay.textContent = '❚❚ Pause';
      timer = setInterval(() => {
        if (cur >= STEPS.length - 1) {
          stopPlay();
          return;
        }
        go(cur + 1);
      }, 1800);
    });
  }

  render();

  // ============ language toggle re-render ============
  window.addEventListener('site-langchange', () => {
    if (maskCap) maskCap.textContent = maskCaptionText();
    render();
  });
</script>
