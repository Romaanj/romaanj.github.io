  .att-page .pre-row { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.3rem; }
  .att-page .pre-chip {
    font-family: var(--font-mono); font-size: 0.74rem; cursor: pointer;
    padding: 0.4em 0.9em; border-radius: 999px; border: 1px solid var(--line-strong);
    background: var(--surface); color: var(--text-secondary); transition: all 0.2s;
  }
  .att-page .pre-chip.on { background: var(--text); border-color: var(--text); color: var(--bg); }
  .att-page .pre-chip:not(.on):hover { border-color: var(--accent); color: var(--accent-strong); }
  .att-page .calc-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.6rem; }
  @media (min-width: 900px) { .att-page .calc-grid { grid-template-columns: 320px minmax(0, 1fr); align-items: start; } }
  .att-page .ctl-row { display: grid; grid-template-columns: 78px 1fr 52px; gap: 0.7rem; align-items: center; margin-bottom: 0.75rem; }
  .att-page .ctl-label { font-size: 0.78rem; font-weight: 600; color: var(--text-secondary); }
  .att-page .ctl-row input[type='range'] { width: 100%; accent-color: var(--accent); }
  .att-page .ctl-val { font-family: var(--font-mono); font-size: 0.78rem; color: var(--text); text-align: right; }
  .att-page .dt-chips { display: flex; gap: 0.4rem; grid-column: 2 / 4; }
  .att-page .dt-chip {
    font-family: var(--font-mono); font-size: 0.72rem; cursor: pointer;
    padding: 0.32em 0.8em; border-radius: 999px; border: 1px solid var(--line-strong);
    background: var(--surface); color: var(--text-secondary); transition: all 0.2s;
  }
  .att-page .dt-chip.on { background: var(--accent); border-color: var(--accent); color: #fff; }
  .att-page .formula {
    font-family: var(--font-mono); font-size: 0.76rem; line-height: 1.7; white-space: pre-wrap;
    color: var(--text-secondary); background: var(--surface-warm);
    border: 1px solid var(--line); border-radius: var(--radius-s, 8px);
    padding: 0.7rem 0.9rem; margin-bottom: 1.1rem; overflow-x: auto;
  }
  .att-page .bar-row { display: grid; grid-template-columns: 64px minmax(0, 1fr) 210px; gap: 0.7rem; align-items: center; margin-bottom: 0.55rem; }
  .att-page .bar-name { font-size: 0.82rem; font-weight: 700; }
  .att-page .bar-sub { display: block; font-family: var(--font-mono); font-size: 0.62rem; font-style: normal; color: var(--text-tertiary); }
  .att-page .bar-track { display: block; height: 18px; background: var(--surface); border: 1px solid var(--line); border-radius: 5px; overflow: hidden; }
  .att-page .bar-fill { display: block; height: 100%; min-width: 2px; border-radius: 4px; transition: width 0.35s var(--ease-out, ease-out); }
  .att-page .f-mha { background: var(--swatch-slate); }
  .att-page .f-gqa { background: var(--swatch-kraft); }
  .att-page .f-mqa { background: var(--swatch-olive); }
  .att-page .f-mla { background: var(--accent); }
  .att-page .bar-val { font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-secondary); white-space: nowrap; }
  .att-page .bar-val b { color: var(--text); font-size: 0.8rem; }
  .att-page .fine-inline { font-size: 0.76rem; color: var(--text-tertiary); margin: 0.7rem 0 0; }
  @media (max-width: 640px) {
    .att-page .bar-row { grid-template-columns: 48px minmax(0, 1fr); }
    .att-page .bar-val { grid-column: 2; }
  }

  /* ---- MLA deep-dive ---- */
  .att-page .dt-controls { display: flex; align-items: center; gap: 0.55rem; flex-wrap: wrap; margin-bottom: 1.2rem; }
  .att-page .btn-sm { padding: 0.45em 1.1em; font-size: 0.85rem; }
  .att-page .btn[disabled] { opacity: 0.4; pointer-events: none; }
  .att-page .dt-step { font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-secondary); margin-left: auto; white-space: nowrap; }
  .att-page .mg { transition: opacity 0.35s; }
  .att-page .mg.dimmed { opacity: 0.14; }

  /* ---- trade-off cards ---- */
  .att-page .to-grid { margin-top: 1.4rem; }
  .att-page .to-grid .card h3 { display: flex; align-items: baseline; gap: 0.6rem; }
  .att-page .to-year { font-family: var(--font-mono); font-size: 0.68rem; font-weight: 400; color: var(--text-tertiary); }
  .att-page .to-grid .card p { font-size: 0.9rem; line-height: 1.65; color: var(--text-secondary); margin: 0.6rem 0 0.8rem; }
  .att-page .ev-chip {
    display: inline-block; font-family: var(--font-mono); font-size: 0.68rem;
    color: var(--accent-strong); border: 1px solid var(--line); border-radius: 999px;
    padding: 0.3em 0.8em; background: var(--surface-warm);
  }

  /* ---- dark band + misc ---- */
  .att-page .eff-note { border-radius: var(--radius-l, 16px); padding: clamp(1.4rem, 3vw, 2.2rem); margin: 3rem 0; max-width: 880px; }
  .att-page .eff-note h3 { color: var(--text-on-dark); margin-bottom: 0.7rem; }
  .att-page .eff-note p { font-size: 0.97rem; line-height: 1.7; }
  .att-page .eff-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.1rem; }
  .att-page .eff-chip {
    font-family: var(--font-mono); font-size: 0.74rem; color: var(--text-on-dark);
    border: 1px solid var(--line-on-dark); border-radius: 999px; padding: 0.35em 0.9em;
    background: #1d1d1b;
  }
  .att-page .deeper-list { list-style: none; padding: 0; margin: 0.6rem 0 1.6rem; display: flex; flex-direction: column; gap: 0.55rem; }
  .att-page .deeper-list .arrow-link { text-decoration: none; }
  .att-page .fine-print { font-size: 0.85rem; color: var(--text-tertiary); }
</style>

<script>
  // ---------- bilingual caption helper: set BOTH spans, CSS shows the active one ----------
  function setCap(el: HTMLElement | null, en: string, ko: string) {
    if (!el) return;
    const e = el.querySelector('.lang-en');
    const k = el.querySelector('.lang-ko');
    if (e) e.textContent = en;
    if (k) k.textContent = ko;
  }

  // ================= 1 · HEAD WIRING =================
  const NQ = 32;
  const KVV = [32, 16, 8, 4, 2, 1];
  const wireDyn = document.getElementById('wireDyn');
  const wireStats = document.getElementById('wireStats');
  const wireCap = document.getElementById('wireCap');
  const dial = document.getElementById('kvDial') as HTMLInputElement | null;
  const dialWrap = document.getElementById('dialWrap');
  let wMode: 'std' | 'mla' = 'std';
  let wKv = 32;

  const qcx = (i: number) => 39 + 22 * i;
  const qx = (i: number) => 30 + 22 * i;

  function wireSvgStd(nkv: number): string {
    const G = NQ / nkv;
    let s = '<text class="rowlab" x="30" y="40">Q heads — 32 × d_h 128</text>';
    s += '<text class="rowlab" x="30" y="256">K/V heads — what the cache stores</text>';
    for (let i = 0; i < NQ; i++) {
      const g = Math.floor(i / G);
      const kcx = 39 + 22 * (g * G + (G - 1) / 2);
      s += `<line class="wline" data-line="${i}" x1="${qcx(i)}" y1="96" x2="${kcx}" y2="196"></line>`;
    }
    for (let i = 0; i < NQ; i++) {
      s += `<rect class="qh" data-q="${i}" x="${qx(i)}" y="64" width="18" height="30" rx="4"></rect>`;
    }
    for (let g = 0; g < nkv; g++) {
      const c = 39 + 22 * (g * G + (G - 1) / 2);
      const w = Math.min(48, 22 * G - 4);
      s += `<rect class="kvh ${nkv === 1 ? 'solo' : ''}" data-kv="${g}" x="${c - w / 2}" y="198" width="${w}" height="30" rx="4"></rect>`;
    }
    return s;
  }

  function wireSvgMla(): string {
    let s = '<text class="rowlab" x="30" y="40">Q heads — 32 shown for legibility (DeepSeek-V2 has 128)</text>';
    s += '<text class="rowlab" x="30" y="256">shared latent — what the cache stores instead of K/V heads</text>';
    for (let i = 0; i < NQ; i++) {
      const lx = 180 + (i / (NQ - 1)) * 280;
      s += `<line class="wline" data-line="${i}" x1="${qcx(i)}" y1="96" x2="${lx}" y2="196"></line>`;
    }
    for (let i = 0; i < NQ; i++) {
      s += `<rect class="qh" data-q="${i}" x="${qx(i)}" y="64" width="18" height="30" rx="4"></rect>`;
    }
    s += '<rect class="latbar" data-kv="lat" x="170" y="198" width="300" height="30" rx="6"></rect>';
    s += '<text class="smono" x="320" y="217" text-anchor="middle">c^KV — [512] latent, shared by ALL heads</text>';
    s += '<text class="stitle sm" x="487" y="217">+</text>';
    s += '<rect class="ropebar" data-kv="rope" x="500" y="198" width="130" height="30" rx="6"></rect>';
    s += '<text class="smono" x="565" y="217" text-anchor="middle">k^R — [64] RoPE</text>';
    s += '<text class="ssub" x="648" y="210">per-head K,V = W^UK/W^UV · c^KV,</text>';
    s += '<text class="ssub" x="648" y="224">folded into Q-path / W^O at inference</text>';
    return s;
  }

  const WIRE_CAPS: Record<string, { en: string; ko: string }> = {
    mha: {
      en: 'MHA — every query head owns a private K/V pair. Nothing is shared: 32 K and 32 V vectors are cached per token per layer, 8,192 elements (16 KB in FP16). This is the quality reference all sharing schemes are measured against.',
      ko: 'MHA — 모든 query head가 전용 K/V pair를 가진다. 아무것도 공유되지 않으므로 token·layer당 K 32개와 V 32개, 8,192개 원소(FP16 기준 16 KB)가 cache된다. 모든 sharing 방식의 품질 기준점이다.',
    },
    mqa: {
      en: 'MQA (Shazeer 2019) — one K/V head serves all 32 query heads: 256 elements (512 B FP16) per token per layer, a 32× cut. The paper reports much faster decoding with "only minor quality degradation".',
      ko: 'MQA (Shazeer 2019) — K/V head 하나가 32개 query head 전부를 담당한다: token·layer당 256개 원소(FP16 512 B), 32× 절감. 논문은 "only minor quality degradation"과 함께 훨씬 빠른 decoding을 보고한다.',
    },
    mla: {
      en: 'MLA (DeepSeek-V2) — the K/V row is gone. All heads share one 512-dim latent plus a 64-dim decoupled RoPE key: 576 cached elements (1,152 B FP16) per token per layer, independent of head count. Open the deep-dive below for the mechanism.',
      ko: 'MLA (DeepSeek-V2) — K/V 행 자체가 사라졌다. 모든 head가 512-dim latent와 64-dim decoupled RoPE key를 공유한다: head 수와 무관하게 token·layer당 576개 원소(FP16 1,152 B)만 cache된다. 메커니즘은 아래 딥다이브에서.',
    },
  };
  function gqaCap(nkv: number) {
    const G = NQ / nkv;
    return {
      en: `GQA-${nkv} — ${nkv} K/V heads, each serving a group of ${G} query heads: ${(2 * nkv * 128).toLocaleString()} elements (${(2 * nkv * 128 * 2) / 1024} KB FP16) per token per layer. Llama-3-8B and Mistral-7B ship exactly this shape at kv = 8.`,
      ko: `GQA-${nkv} — K/V head ${nkv}개가 각각 ${G}개 query head 그룹을 담당한다: token·layer당 ${(2 * nkv * 128).toLocaleString()}개 원소(FP16 ${(2 * nkv * 128 * 2) / 1024} KB). Llama-3-8B와 Mistral-7B가 정확히 kv = 8의 이 형상으로 출시됐다.`,
    };
  }

  function wireStatsHtml(): string {
    if (wMode === 'mla') {
      return '<span class="stat-chip">latent 512 + rope 64</span>' +
        '<span class="stat-chip"><b>576</b> elts / token / layer</span>' +
        '<span class="stat-chip"><b>1,152 B</b> FP16 / token / layer</span>' +
        '<span class="stat-chip">= GQA with <b>2.25</b> groups (paper)</span>';
    }
    const elts = 2 * wKv * 128;
    const kb = (elts * 2) / 1024;
    return `<span class="stat-chip">${wKv} KV head${wKv > 1 ? 's' : ''}</span>` +
      `<span class="stat-chip">2 × ${wKv} × 128 = <b>${elts.toLocaleString()}</b> elts / token / layer</span>` +
      `<span class="stat-chip"><b>${kb < 1 ? kb * 1024 + ' B' : kb + ' KB'}</b> FP16 / token / layer</span>`;
  }

  function renderWire() {
    if (wireDyn) wireDyn.innerHTML = wMode === 'mla' ? wireSvgMla() : wireSvgStd(wKv);
    if (wireStats) wireStats.innerHTML = wireStatsHtml();
    document.querySelectorAll('.mode-btn').forEach((b) => {
      const v = (b as HTMLElement).dataset.var;
      const active =
        wMode === 'mla' ? v === 'mla' : v === (wKv === 32 ? 'mha' : wKv === 1 ? 'mqa' : 'gqa');
      b.classList.toggle('on', active);
    });
    if (dialWrap) dialWrap.classList.toggle('off', wMode === 'mla');
    const c = wMode === 'mla' ? WIRE_CAPS.mla : wKv === 32 ? WIRE_CAPS.mha : wKv === 1 ? WIRE_CAPS.mqa : gqaCap(wKv);
    setCap(wireCap, c.en, c.ko);
  }

  document.querySelectorAll('.mode-btn').forEach((b) => {
    b.addEventListener('click', () => {
      const v = (b as HTMLElement).dataset.var;
      if (v === 'mla') wMode = 'mla';
      else {
        wMode = 'std';
        wKv = v === 'mha' ? 32 : v === 'mqa' ? 1 : 8;
        if (dial) dial.value = String(KVV.indexOf(wKv));
      }
      renderWire();
    });
  });
  if (dial) {
    dial.addEventListener('input', () => {
      wMode = 'std';
      wKv = KVV[Number(dial.value)];
      renderWire();
    });
  }

  // hover: delegate on the svg so re-renders keep working
  const wireSvgEl = document.getElementById('wireSvgEl');
  if (wireSvgEl) {
    wireSvgEl.addEventListener('mouseover', (e) => {
      const t = (e.target as Element).closest('[data-q]');
      if (!t) return;
      const q = Number(t.getAttribute('data-q'));
      document.querySelectorAll('.att-page .hot').forEach((x) => x.classList.remove('hot'));
      t.classList.add('hot');
      const line = document.querySelector(`.att-page [data-line="${q}"]`);
      if (line) line.classList.add('hot');
      if (wMode === 'mla') {
        document.querySelectorAll('.att-page [data-kv]').forEach((x) => x.classList.add('hot'));
        setCap(
          wireCap,
          `Q head ${q} — like every other head — reads the same cached pair: the 512-dim latent c^KV (its per-head key/value are rebuilt from it through W^UK/W^UV, pre-folded into the query and output paths) plus the shared 64-dim RoPE key k^R.`,
          `Q head ${q}도 다른 모든 head와 똑같이 cache된 한 쌍을 읽는다: 512-dim latent c^KV(head별 key/value는 W^UK/W^UV로 복원되며, query·output 경로에 미리 흡수됨)와 공유 64-dim RoPE key k^R.`
        );
      } else {
        const G = NQ / wKv;
        const g = Math.floor(q / G);
        const kv = document.querySelector(`.att-page [data-kv="${g}"]`);
        if (kv) kv.classList.add('hot');
        setCap(
          wireCap,
          G === 1
            ? `Q head ${q} reads its own private K/V head ${g} — no sharing (MHA). Its 2 × 128 cached elements serve exactly one query head.`
            : `Q head ${q} reads K/V head ${g}, shared with ${G - 1} other query head${G > 2 ? 's' : ''} (heads ${g * G}–${(g + 1) * G - 1}). One cached 2 × 128 pair serves ${G} queries — the cache shrinks ${G}×, the attention math is unchanged.`,
          G === 1
            ? `Q head ${q}는 전용 K/V head ${g}를 읽는다 — 공유 없음(MHA). cache된 2 × 128 원소가 query head 하나만 담당한다.`
            : `Q head ${q}는 K/V head ${g}를 읽고, 이를 ${G - 1}개의 다른 query head(heads ${g * G}–${(g + 1) * G - 1})와 공유한다. cache된 2 × 128 pair 하나가 ${G}개 query를 담당한다 — cache는 ${G}× 줄지만 attention 수식은 그대로다.`
        );
      }
    });
    wireSvgEl.addEventListener('mouseleave', () => {
      document.querySelectorAll('.att-page .hot').forEach((x) => x.classList.remove('hot'));
      renderWire();
    });
  }

  // ================= 2 · KV-BYTES CALCULATOR =================
  const CTX = [1024, 2048, 4096, 8192, 16384, 32768, 65536, 131072];
  const CTXL = ['1K', '2K', '4K', '8K', '16K', '32K', '64K', '128K'];
  const HD = [64, 96, 128, 192, 256];
  const DTB: Record<string, number> = { fp16: 2, int8: 1, int4: 0.5 };
  const cal = { L: 32, Q: 32, K: 8, Di: 2, Ci: 3, dt: 'fp16' };

  const PRESETS = [
    { L: 32, Q: 32, K: 32, Di: 2, note: {
      en: 'Llama-2-7B (official config: 32 layers, 32 Q = 32 KV heads, hidden 4,096): full MHA. 512 KB per token in FP16 — the baseline every sharing scheme is cut from.',
      ko: 'Llama-2-7B (공식 config: 32 layers, 32 Q = 32 KV heads, hidden 4,096): 완전한 MHA. FP16에서 token당 512 KB — 모든 sharing 방식이 여기서 출발해 줄여 나가는 기준선이다.' } },
    { L: 32, Q: 32, K: 8, Di: 2, note: {
      en: 'Llama-3-8B: GQA with 32 Q / 8 KV heads — a 4× cache cut vs the same backbone with MHA, straight from the official config.',
      ko: 'Llama-3-8B: 32 Q / 8 KV head의 GQA — 공식 config 그대로, 같은 backbone을 MHA로 둘 때보다 cache가 4× 작다.' } },
    { L: 32, Q: 32, K: 8, Di: 2, note: {
      en: 'Mistral-7B-v0.1: the same 32Q/8KV GQA shape as Llama-3-8B (its sliding-window attention additionally bounds live cache length — not modeled here).',
      ko: 'Mistral-7B-v0.1: Llama-3-8B와 같은 32Q/8KV GQA 형상 (sliding-window attention이 live cache 길이를 추가로 제한하지만 여기서는 반영하지 않는다).' } },
    { L: 60, Q: 128, K: 128, Di: 2, note: {
      en: 'DeepSeek-V2 (236B MoE, 60 layers, 128 heads): MLA caches 67.5 KB/token. The MHA bar shows what 128 full heads would have cost — 3.75 MB/token, 57× more.',
      ko: 'DeepSeek-V2 (236B MoE, 60 layers, 128 heads): MLA는 token당 67.5 KB만 cache한다. MHA 막대는 128개 full head였다면 들었을 비용 — token당 3.75 MB, 57× — 를 보여준다.' } },
    { L: 61, Q: 128, K: 128, Di: 2, note: {
      en: 'DeepSeek-V3 (671B MoE): identical MLA dims (512 + 64) over 61 layers — 68.6 KB/token. The cache design carried over unchanged from V2.',
      ko: 'DeepSeek-V3 (671B MoE): 동일한 MLA 차원(512 + 64)을 61개 layer에 — token당 68.6 KB. cache 설계가 V2에서 그대로 이어졌다.' } },
  ];

  const $ = (id: string) => document.getElementById(id);
  const slLayers = $('slLayers') as HTMLInputElement | null;
  const slQ = $('slQ') as HTMLInputElement | null;
  const slK = $('slK') as HTMLInputElement | null;
  const slD = $('slD') as HTMLInputElement | null;
  const slC = $('slC') as HTMLInputElement | null;

  function fmtB(b: number): string {
    if (b >= 1073741824) { const v = b / 1073741824; return (v >= 10 ? v.toFixed(0) : v.toFixed(2)) + ' GB'; }
    if (b >= 1048576) { const v = b / 1048576; return (v >= 10 ? v.toFixed(0) : v.toFixed(1)) + ' MB'; }
    if (b >= 1024) { const v = b / 1024; return (v >= 10 ? v.toFixed(0) : v.toFixed(1)) + ' KB'; }
    return Math.round(b) + ' B';
  }

  function calcRender() {
    const d = HD[cal.Di];
    const ctx = CTX[cal.Ci];
    const by = DTB[cal.dt];
    const mha = 2 * cal.L * cal.Q * d * by;
    const gqa = 2 * cal.L * cal.K * d * by;
    const mqa = 2 * cal.L * 1 * d * by;
    const mla = cal.L * 576 * by;
    const mx = Math.max(mha, gqa, mqa, mla);

    const set = (bar: string, val: string, pt: number) => {
      const bEl = $(bar); const vEl = $(val);
      if (bEl) bEl.style.width = Math.max(0.4, (pt / mx) * 100) + '%';
      if (vEl) vEl.innerHTML = '<b>' + fmtB(pt) + '</b>/tok · <b>' + fmtB(pt * ctx) + '</b> @ L';
    };
    set('barMha', 'valMha', mha);
    set('barGqa', 'valGqa', gqa);
    set('barMqa', 'valMqa', mqa);
    set('barMla', 'valMla', mla);

    const gs = $('gqaSub'); if (gs) gs.textContent = 'kv = ' + cal.K;
    const f = $('fEq');
    if (f) f.textContent =
      `KV bytes/token = 2 × ${cal.L} layers × ${cal.K} kv_heads × ${d} head_dim × ${by} B = ${gqa.toLocaleString()} B\n` +
      `MLA row: ${cal.L} layers × (d_c 512 + d_R 64) × ${by} B = ${mla.toLocaleString()} B`;

    const vL = $('vLayers'); if (vL) vL.textContent = String(cal.L);
    const vQ = $('vQ'); if (vQ) vQ.textContent = String(cal.Q);
    const vK = $('vK'); if (vK) vK.textContent = String(cal.K);
    const vD = $('vD'); if (vD) vD.textContent = String(d);
    const vC = $('vC'); if (vC) vC.textContent = CTXL[cal.Ci];
    if (slK) { slK.max = String(cal.Q); slK.value = String(cal.K); }
  }

  if (slLayers) slLayers.addEventListener('input', () => { cal.L = Number(slLayers.value); calcRender(); });
  if (slQ) slQ.addEventListener('input', () => { cal.Q = Number(slQ.value); cal.K = Math.min(cal.K, cal.Q); calcRender(); });
  if (slK) slK.addEventListener('input', () => { cal.K = Math.min(Number(slK.value), cal.Q); calcRender(); });
  if (slD) slD.addEventListener('input', () => { cal.Di = Number(slD.value); calcRender(); });
  if (slC) slC.addEventListener('input', () => { cal.Ci = Number(slC.value); calcRender(); });
  document.querySelectorAll('.dt-chip').forEach((b) => {
    b.addEventListener('click', () => {
      cal.dt = (b as HTMLElement).dataset.dt || 'fp16';
      document.querySelectorAll('.dt-chip').forEach((x) => x.classList.toggle('on', x === b));
      calcRender();
    });
  });
  document.querySelectorAll('.pre-chip').forEach((b) => {
    b.addEventListener('click', () => {
      const p = PRESETS[Number((b as HTMLElement).dataset.pre)];
      cal.L = p.L; cal.Q = p.Q; cal.K = p.K; cal.Di = p.Di;
      if (slLayers) slLayers.value = String(p.L);
      if (slQ) slQ.value = String(p.Q);
      if (slD) slD.value = String(p.Di);
      document.querySelectorAll('.pre-chip').forEach((x) => x.classList.toggle('on', x === b));
      setCap($('calCap'), p.note.en, p.note.ko);
      calcRender();
    });
  });
  calcRender();

  // ================= 3 · MLA DEEP-DIVE =================
  const MG = ['g-h', 'g-down', 'g-c', 'g-bad', 'g-up', 'g-absorb', 'g-fix', 'g-cache'];
  const MSTEPS: { name: string; lit: string[] | null; cap: { en: string; ko: string } }[] = [
    { name: 'Overview', lit: null, cap: {
      en: 'Multi-head Latent Attention in one picture: instead of caching per-head K and V, DeepSeek-V2 caches one 512-dim latent c^KV plus one 64-dim RoPE key per token — everything else is rebuilt, or folded into other weight matrices, at compute time. Step through to see how.',
      ko: 'Multi-head Latent Attention 한눈에 보기: head별 K·V를 cache하는 대신 DeepSeek-V2는 token마다 512-dim latent c^KV와 64-dim RoPE key 하나만 cache한다 — 나머지는 계산 시점에 복원되거나 다른 weight matrix에 흡수된다. Step을 넘기며 확인해 보자.' } },
    { name: 'Down-project', lit: ['g-h', 'g-down', 'g-c'], cap: {
      en: 'W^DKV compresses the 5,120-dim hidden state 9× into a 512-dim latent c^KV — one vector per token, shared by all 128 heads. This low-rank bottleneck IS the compression; everything after it is bookkeeping to make attention still work.',
      ko: 'W^DKV가 5,120-dim hidden state를 9× 압축해 512-dim latent c^KV로 만든다 — token당 vector 하나, 128개 head 전부가 공유한다. 이 low-rank bottleneck이 압축의 전부이고, 이후는 attention이 여전히 성립하게 만드는 장부 정리다.' } },
    { name: 'Up-project', lit: ['g-c', 'g-up'], cap: {
      en: 'At compute time W^UK and W^UV expand the latent back into 128 per-head keys and values of dim 128 each — 32,768 reconstructed elements flowing out of 576 cached ones. Nothing per-head is ever stored.',
      ko: '계산 시점에 W^UK와 W^UV가 latent를 다시 head별 key·value 128개(각 dim 128)로 펼친다 — cache된 576개 원소에서 32,768개가 복원되어 나온다. head별 값은 어디에도 저장되지 않는다.' } },
    { name: 'Weight absorption', lit: ['g-up', 'g-absorb'], cap: {
      en: 'Because k_i = W^UK_i · c^KV is linear, the score q_i·k_i equals (q_i · W^UK_i) · c^KV — so W^UK folds into the query projection and W^UV into W^O, once, offline. At decode time queries multiply directly against the cached latent; the up-projections cost nothing per step.',
      ko: 'k_i = W^UK_i · c^KV가 선형이므로 score q_i·k_i는 (q_i · W^UK_i) · c^KV와 같다 — 따라서 W^UK는 query projection에, W^UV는 W^O에 offline으로 한 번만 흡수된다. decode 시점에는 query가 cache된 latent와 곧바로 곱해지며, up-projection은 step당 비용이 없다.' } },
    { name: 'Naive RoPE breaks it', lit: ['g-c', 'g-bad', 'g-up'], cap: {
      en: 'RoPE is the obstacle: applying the position rotation R_t to the reconstructed key would put a position-DEPENDENT matrix between W^UK and c^KV. The folded product W^UQ·R_t·W^UK would change at every position — absorption dies, and with it the whole point of caching only the latent.',
      ko: 'RoPE가 걸림돌이다: 복원된 key에 position 회전 R_t를 적용하면 W^UK와 c^KV 사이에 position 의존 matrix가 끼게 된다. 흡수된 곱 W^UQ·R_t·W^UK가 position마다 달라져 absorption이 무너지고, latent만 cache한다는 발상 자체가 무의미해진다.' } },
    { name: 'Decoupled RoPE', lit: ['g-h', 'g-fix'], cap: {
      en: "DeepSeek's fix: keep the reconstructed 128-dim key position-free ('nope'), and carry position in a separate 64-dim key k^R = RoPE(W^KR · h_t), shared across all 128 heads. The attention score is simply the sum of the two dot products — nope path (absorbable) + rope path (position-aware).",
      ko: 'DeepSeek의 해법: 복원되는 128-dim key는 position 없이("nope") 두고, position 정보는 별도의 64-dim key k^R = RoPE(W^KR · h_t)에 실어 128개 head가 공유한다. attention score는 두 dot product의 합일 뿐이다 — nope 경로(흡수 가능) + rope 경로(position 반영).' } },
    { name: 'What gets cached', lit: ['g-c', 'g-fix', 'g-cache'], cap: {
      en: 'The cache stores only c^KV (512) + k^R (64) = 576 elements = 1,152 B FP16 per layer — 67.5 KB/token over 60 layers. The paper: a KV cache "equal to GQA with only 2.25 groups", 93.3% smaller than DeepSeek 67B — while its own ablations report quality above MHA.',
      ko: 'cache에는 c^KV(512) + k^R(64) = 576개 원소, layer당 FP16 1,152 B만 저장된다 — 60개 layer 기준 token당 67.5 KB. 논문 표현으로는 "GQA 2.25 group과 동일한" KV cache이고 DeepSeek 67B보다 93.3% 작다 — 자체 ablation에서는 MHA보다 높은 품질을 보고한다.' } },
  ];

  const mlaCap = $('mlaCap');
  const mStepEl = $('mStep');
  const mPrev = $('mPrev'); const mNext = $('mNext');
  const mPlay = $('mPlay'); const mReset = $('mReset');
  let mCur = 0;
  let mTimer: ReturnType<typeof setInterval> | null = null;

  function mGo(i: number) {
    mCur = Math.max(0, Math.min(MSTEPS.length - 1, i));
    const st = MSTEPS[mCur];
    MG.forEach((id) => {
      const el = $(id);
      if (el) el.classList.toggle('dimmed', st.lit !== null && !st.lit.includes(id));
    });
    setCap(mlaCap, st.cap.en, st.cap.ko);
    if (mStepEl) mStepEl.textContent = 'Step ' + mCur + ' / ' + (MSTEPS.length - 1) + ' — ' + st.name;
    if (mPrev) mPrev.toggleAttribute('disabled', mCur === 0);
    if (mNext) mNext.toggleAttribute('disabled', mCur === MSTEPS.length - 1);
  }
  function mStop() {
    if (mTimer !== null) { clearInterval(mTimer); mTimer = null; }
    if (mPlay) mPlay.textContent = '▶ Play';
  }
  if (mPrev) mPrev.addEventListener('click', () => { mStop(); mGo(mCur - 1); });
  if (mNext) mNext.addEventListener('click', () => { mStop(); mGo(mCur + 1); });
  if (mReset) mReset.addEventListener('click', () => { mStop(); mGo(0); });
  if (mPlay) {
    mPlay.addEventListener('click', () => {
      if (mTimer !== null) { mStop(); return; }
      if (mCur === MSTEPS.length - 1) mGo(0);
      mPlay.textContent = '❚❚ Pause';
      mTimer = setInterval(() => {
        if (mCur >= MSTEPS.length - 1) { mStop(); return; }
        mGo(mCur + 1);
      }, 3200);
    });
  }
  mGo(0);
</script>
