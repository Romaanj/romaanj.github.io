                <span class="bar-track"><i class="bar-fill f-mqa" id="barMqa" style="width:3.2%"></i></span>
                <span class="bar-val" id="valMqa"><b>16 KB</b>/tok · <b>128 MB</b> @ L</span>
              </div>
