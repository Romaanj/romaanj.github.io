              </div>
              <div class="bar-row">
                <span class="bar-name">GQA<i class="bar-sub" id="gqaSub">kv = 8</i></span>
                <span class="bar-track"><i class="bar-fill f-gqa" id="barGqa" style="width:25%"></i></span>
                <span class="bar-val" id="valGqa"><b>128 KB</b>/tok · <b>1.0 GB</b> @ L</span>
              </div>
              <div class="bar-row">
