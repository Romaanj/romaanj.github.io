---
import Base from '../../../layouts/Base.astro';
import LangToggle from '../../../components/LangToggle.astro';

// ------------------------------------------------------------------
// All numbers on this page come from published papers / public repos
// (fetched 2026-07-07): Huginn arXiv 2502.05171; Parcae arXiv 2604.12946
// + github.com/SandyResearch/parcae; LOTUS arXiv 2606.31779; Universal
// Transformer arXiv 1807.03819; ALBERT arXiv 1909.11942; looped-TF
// arXiv 2311.12424; Mixture-of-Recursions arXiv 2507.10524; Ouro arXiv
// 2510.25741. Derived arithmetic is labeled "estimate" / [RE] in place.
// ------------------------------------------------------------------

// (a) standard 32-layer strip — worked example: equal width d, per-layer params p
const stdLayers = Array.from({ length: 32 }, (_, i) => {
  const n = i + 1;
  return {
    i,
    n,
    tipEn: `Layer ${n} of 32 — its own weight matrices (p params). Stored once, read from HBM once per token at batch-1 decode. No other layer can reuse these bytes.`,
    tipKo: `Layer ${n} / 32 — 자기만의 weight 행렬 (p params). 저장도 한 번, batch-1 decode에서 token마다 HBM 읽기도 한 번. 다른 layer는 이 byte를 재사용할 수 없다.`,
  };
});

// (c) stability trajectories — schematic scalar model x_{t+1} = ρ·x_t + 1
// (stand-in for h_{t+1} = Ā h_t + B̄ e; fixed point 1/(1−ρ) when ρ < 1)
const T_STAB = 24;
const stabTraj = (rho, x0) => {
  const pts = [];
  let x = x0;
  for (let t = 0; t <= T_STAB; t++) {
    pts.push(x);
    x = rho * x + 1;
  }
  return pts;
};
const stabX = (t) => 70 + (t / T_STAB) * 630;
const stabY = (v) => 300 - (Math.min(v, 12) / 12) * 250;
const stabPts = (rho, x0) =>
  stabTraj(rho, x0)
    .map((v, t) => `${stabX(t).toFixed(1)},${stabY(v).toFixed(1)}`)
    .join(' ');
const PTS_CONV_A = stabPts(0.8, 9);   // ρ<1, init far above the fixed point
const PTS_CONV_B = stabPts(0.8, 0.5); // ρ<1, init near zero — same fixed point
const PTS_DIV = stabPts(1.05, 0.5);   // ρ>1 — residual state explosion
const PTS_USER = stabPts(0.95, 0.5);  // default slider curve (JS redraws)
const FP_Y = stabY(1 / (1 - 0.8));    // fixed point of the ρ=0.8 pair

// (d1) Huginn depth-sampling pmf: τ ~ N(log r̄ − σ²/2, σ), r ~ Poisson(e^τ) + 1
// with σ = 1/2, r̄ = 32 (arXiv 2502.05171 §3.3) — numerically integrated here.
const SIG = 0.5;
const RBAR = 32;
const MU = Math.log(RBAR) - (SIG * SIG) / 2;
const R_MAX = 80;
const pmf = new Array(R_MAX + 1).fill(0);
let wsum = 0;
for (let g = 0; g <= 120; g++) {
  const z = -4 + (8 * g) / 120;
  const w = Math.exp((-z * z) / 2);
  wsum += w;
  const lam = Math.exp(MU + SIG * z);
  let p = Math.exp(-lam);
  for (let k = 0; k < R_MAX; k++) {
    pmf[k + 1] += w * p;
    p *= lam / (k + 1);
  }
}
for (let r = 1; r <= R_MAX; r++) pmf[r] /= wsum;
const pmfMax = Math.max(...pmf);
const depthBars = Array.from({ length: R_MAX }, (_, i) => ({
  r: i + 1,
  x: 60 + i * 8,
  h: (pmf[i + 1] / pmfMax) * 170,
}));

// (e1) test-time scaling — schematic curves with the saturating-exponential
// SHAPE Parcae fits (L(T) = L∞ + Z·e^{−zT}) and the task split Huginn reports
// (HellaSwag near-saturates by r≈8; GSM8K still improves at r≈32–64).
const rX = (r) => 70 + (Math.log2(r) / 6) * 630;
const qA = (r) => 78 - 33 * Math.exp(-0.8 * (r - 1)); // recall-style task
const qB = (r) => 70 - 40 * Math.exp(-0.05 * r);      // reasoning-style task
const qY = (q) => 300 - (q / 100) * 250;
const curvePts = (f) => {
  const seg = [];
  for (let i = 0; i <= 60; i++) {
    const r = Math.pow(2, i / 10);
    seg.push(`${rX(r).toFixed(1)},${qY(f(r)).toFixed(1)}`);
  }
  return seg.join(' ');
};
const PTS_QA = curvePts(qA);
const PTS_QB = curvePts(qB);

// (f) accounting bars — [RE] worked example: 4-layer core × 8 loops vs 32
// unique layers, equal width. Units = "per-layer" (p params / 1 application /
// 1 layer-read / 1 layer-cache). Scale: 32 units → 560 px.
const U = 560 / 32;
const accGroups = [
  {
    label: 'unique weight bytes (storage)',
    y: 64,
    bars: [
      { name: '32L standard', w: 32 * U, cls: 'ab-std', txt: '32 p' },
      { name: '4L core × 8', w: 4 * U, cls: 'ab-loop', txt: '4 p (+prelude/coda)', extra: 2 * U },
    ],
    verdict: '≈ 8× fewer unique bytes to store — the core IS the win',
    tipEn: 'Storage and capacity: the looped model keeps 4 unique layers (plus a thin prelude/coda) where the standard net keeps 32. [RE] worked example at equal width.',
    tipKo: '저장 용량: looped 모델은 unique layer 4개(+얇은 prelude/coda)만 저장하고, standard는 32개를 저장한다. [RE] 동일 폭 가정의 계산 예시.',
  },
  {
    label: 'FLOPs / token',
    y: 148,
    bars: [
      { name: '32L standard', w: 32 * U, cls: 'ab-std', txt: '32 layer-applications' },
      { name: '4L core × 8', w: 32 * U, cls: 'ab-loop', txt: '4 × 8 = 32 — equal' },
    ],
    verdict: 'equal — FLOPs scale with r, not with unique layers',
    tipEn: 'Compute does not shrink: 32 layer-applications either way. Looping trades storage for repeated compute. [RE]',
    tipKo: '연산량은 줄지 않는다: 어느 쪽이든 32번의 layer-application. looping은 저장 공간을 반복 연산과 맞바꾼다. [RE]',
  },
  {
    label: 'HBM weight-reads / token (batch-1 decode)',
    y: 232,
    bars: [
      { name: '32L standard', w: 32 * U, cls: 'ab-std', txt: '32 layer-reads' },
      { name: '4L core × 8', w: 32 * U, cls: 'ab-loop', txt: '32 layer-reads — equal' },
    ],
    verdict: 'equal — the core does not fit in SRAM, so it is re-read every loop',
    tipEn: 'A 4-layer core at d=2048 is ≈400 MB in BF16 — far beyond on-chip SRAM, so each loop re-reads it from HBM. At matched effective depth, looping does NOT cut decode weight bandwidth. [RE]',
    tipKo: 'd=2048에서 4-layer core는 BF16으로 ≈400 MB — on-chip SRAM을 한참 넘어서므로 loop마다 HBM에서 다시 읽는다. 동일 유효 깊이에서 looping은 decode weight bandwidth를 줄이지 못한다. [RE]',
  },
  {
    label: 'KV-cache bytes / token',
    y: 316,
    bars: [
      { name: '32L standard', w: 32 * U, cls: 'ab-std', txt: '32 layer-caches' },
      { name: '4L × 8, naive', w: 32 * U, cls: 'ab-loop', txt: '8 iters × 4 layers = 32' },
      { name: '4L × 8, i mod 4', w: 16 * U, cls: 'ab-kv', txt: '4 slots × 4 layers = 16 — 2×↓' },
    ],
    verdict: 'naive KV grows with loops; budgeted sharing claws it back',
    tipEn: 'Each loop iteration runs attention again, so naive KV is per (iteration × core layer) — same as 32 unique layers. Huginn’s i-mod-k sharing with budget 4 halves it at zero reported MTBench cost (5.86). [RE on verified mechanism]',
    tipKo: 'loop iteration마다 attention이 다시 돌므로 naive KV는 (iteration × core layer) 단위 — unique 32 layers와 같다. Huginn의 i mod k 공유(budget 4)는 보고된 MTBench 손실 0으로 (5.86) 이를 절반으로 줄인다. [검증된 메커니즘 위의 RE]',
  },
];
---

<Base
  title="Looped transformers: depth as a runtime knob — Junwon Lee"
  description="Interactive explorer of looped / recurrent-depth transformers: the prelude–core–coda sandwich, input re-injection (Huginn, Parcae, LOTUS), loop-axis stability, random-depth training, test-time depth scaling, and the params-vs-FLOPs-vs-bytes accounting."
>
  <div class="loop-page">
    <section class="section">
      <div class="container">
        <div class="hero-top">
          <p class="eyebrow">Study · Model anatomy</p>
          <LangToggle />
        </div>
        <h1>
          <span class="lang-en">Looped transformers: depth as a runtime knob</span>
          <span class="lang-ko">Looped Transformer: 런타임 노브가 된 깊이</span>
        </h1>
        <p class="lede">
          <span class="lang-en">
            A looped transformer stores a few layers once and applies them many times: a prelude
            embeds the input, a weight-tied core iterates, a coda decodes. Parameters stop tracking
            depth — and depth becomes something you choose at inference time. This page walks the
            verified mechanics of Huginn, Parcae, and LOTUS: how the loop is fed, why naive loops
            explode, how random-depth training works, and what the efficiency ledger actually says.
          </span>
          <span class="lang-ko">
            Looped transformer는 layer 몇 개를 한 번만 저장하고 여러 번 적용한다: prelude가 입력을
            embed하고, weight-tied core가 반복되고, coda가 decode한다. 파라미터 수는 더 이상 깊이를
            따라가지 않는다 — 깊이는 inference 시점에 고르는 값이 된다. 이 페이지는 Huginn, Parcae,
            LOTUS의 검증된 메커니즘을 따라간다: loop에 입력을 어떻게 먹이는지, naive loop는 왜
            폭발하는지, random-depth 학습은 어떻게 하는지, 그리고 효율 장부에 실제로 뭐가 적히는지.
          </span>
        </p>

        <nav class="arc-roadmap" aria-label="Section roadmap">
          <a href="#arc-s1"><span class="arc-n">§1</span><span class="lang-en">The itch</span><span class="lang-ko">문제의식</span></a>
          <a href="#arc-s2"><span class="arc-n">§2</span><span class="lang-en">Foundations</span><span class="lang-ko">기초</span></a>
          <a href="#arc-s3"><span class="arc-n">§3</span><span class="lang-en">The shape</span><span class="lang-ko">형태</span></a>
          <a href="#arc-s4"><span class="arc-n">§4</span><span class="lang-en">Feeding the loop</span><span class="lang-ko">입력 주입</span></a>
          <a href="#arc-s5"><span class="arc-n">§5</span><span class="lang-en">Stability</span><span class="lang-ko">안정성</span></a>
          <a href="#arc-s6"><span class="arc-n">§6</span><span class="lang-en">Training</span><span class="lang-ko">학습</span></a>
          <a href="#arc-s7"><span class="arc-n">§7</span><span class="lang-en">Test-time depth</span><span class="lang-ko">Test-time 깊이</span></a>
          <a href="#arc-s8"><span class="arc-n">§8</span><span class="lang-en">The accounting</span><span class="lang-ko">장부 정리</span></a>
          <a href="#arc-s9"><span class="arc-n">§9</span><span class="lang-en">Where this goes</span><span class="lang-ko">앞으로의 방향</span></a>
        </nav>

        <div class="arc-prereq">
          <span class="lang-en"><strong>Before you start.</strong> This page assumes you know what
            a transformer layer is — attention plus an MLP, each with its own weights — and why a
            decoder keeps a KV cache; <a href="/study/models/attention-anatomy/">attention
            anatomy</a> covers both. §8 also leans on the fact that batch-1 decode is
            memory-bandwidth-bound (weights re-read from HBM for every token) — see
            <a href="/study/gpu/memory-hierarchy/">the GPU memory hierarchy</a>.</span>
          <span class="lang-ko"><strong>시작하기 전에.</strong> 이 페이지는 transformer layer가
            무엇인지 — attention + MLP, 각자 자기 weight를 가진 — 그리고 decoder가 왜 KV cache를
            유지하는지 알고 있다고 가정한다. 둘 다
            <a href="/study/models/attention-anatomy/">attention anatomy</a>에서 다룬다. §8은
            batch-1 decode가 memory-bandwidth-bound라는 사실(모든 token마다 weight를 HBM에서 다시
            읽는다)에도 기대는데, 이는
            <a href="/study/gpu/memory-hierarchy/">GPU memory hierarchy</a>를 보라.</span>
        </div>

        <div class="config-note">
          <span class="config-lead">
            <span class="lang-en">Models on this page — from the published papers and the public
              <code>SandyResearch/parcae</code> repo:</span>
            <span class="lang-ko">이 페이지의 모델들 — 공개 논문과 public
              <code>SandyResearch/parcae</code> repo에서 확인:</span>
          </span>
          <span class="tag accent">Huginn 3.5B — prelude 2 / core 4 / coda 2, trained r̄ = 32</span>
          <span class="tag">Parcae-1.3B — 8 / 8 / 8, r = 8</span>
          <span class="tag">LOTUS 3B — K = 6 × c = 25 latents, R = 6</span>
          <span class="tag">arXiv 2502.05171 · 2604.12946 · 2606.31779</span>
        </div>
      </div>
    </section>

    <!-- ============ §1 · THE ITCH ============ -->
    <section class="section-tight" id="arc-s1">
      <div class="container">
        <h2 class="arc-heading"><span class="arc-num">§1</span>
          <span class="lang-en">The itch: depth is welded to parameters</span>
          <span class="lang-ko">문제의식: 깊이가 파라미터에 용접되어 있다</span>
        </h2>
        <div class="prose">
          <p>
            <span class="lang-en">In a standard transformer, the only way to be deeper is to buy
              more layers. Every layer carries its own weight matrices, so a 32-layer model stores —
              and, at batch-1 decode, re-reads from HBM for every generated token — 32 layers’ worth
              of bytes. Depth is decided once, at training time, and then billed forever: bytes
              stored, bytes shipped to every serving replica, bytes read per token.</span>
            <span class="lang-ko">Standard transformer에서 더 깊어지는 유일한 방법은 layer를 더
              사는 것이다. 모든 layer가 자기만의 weight 행렬을 가지므로, 32-layer 모델은 32개
              layer 분량의 byte를 저장하고 — batch-1 decode에선 생성되는 token마다 HBM에서 다시
              읽는다. 깊이는 학습 시점에 한 번 결정되고, 그 값은 영원히 청구된다: 저장하는 byte,
              모든 serving replica로 전송하는 byte, token마다 읽는 byte.</span>
          </p>
          <p>
            <span class="lang-en">There is a second, quieter problem: that frozen depth is spent
              identically on every token. Completing “2 + 2 =” and carrying out a hard reasoning
              step receive exactly the same 32 layers of computation. What we would actually like
              is a model whose depth is a <em>runtime knob</em> — a few passes for easy tokens,
              many for hard ones — without the parameter bill growing with the knob. That is the
              promise of looped transformers; the rest of this page is what it takes to make the
              promise real, and what it honestly costs.</span>
            <span class="lang-ko">더 조용한 두 번째 문제도 있다: 그 얼어붙은 깊이가 모든 token에
              똑같이 지출된다. “2 + 2 =”를 완성하는 것과 어려운 reasoning 스텝을 수행하는 것이
              정확히 같은 32 layer의 연산을 받는다. 우리가 실제로 원하는 것은 깊이가 <em>런타임
              노브</em>인 모델이다 — 쉬운 token엔 몇 pass, 어려운 token엔 많이 — 노브를 돌려도
              파라미터 청구서는 늘지 않으면서. 그것이 looped transformer의 약속이고, 이 페이지의
              나머지는 그 약속을 실현하는 데 무엇이 필요한지, 그리고 정직하게 무엇을 지불하는지다.</span>
          </p>
        </div>
        <div class="viz-frame">
          <div class="loop-scroll">
          <svg viewBox="0 0 760 300" role="img" aria-label="Left: three standard transformer stacks whose parameter counts grow in lockstep with depth; right: a single small weight-tied core whose depth is chosen at runtime while stored parameters stay fixed" style="width:100%; height:auto; min-width:700px;">
            <defs>
              <marker id="arrItch" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
                <path d="M0,0 L10,5 L0,10 z" fill="#c15f3c"></path>
              </marker>
            </defs>
            <text class="stitle" x="195" y="26" text-anchor="middle">standard: deeper ⇒ more parameters</text>
            <g data-tip="8 unique layers → 8 p parameters. Depth and parameter count move in lockstep — this is the weld." data-tip-ko="Unique layer 8개 → 8 p 파라미터. 깊이와 파라미터 수가 같이 움직인다 — 이것이 용접이다.">
              <rect class="std-cell" x="60" y="202" width="70" height="48" rx="4"></rect>
              <text class="smono" x="95" y="268" text-anchor="middle">8 L → 8 p</text>
            </g>
            <g data-tip="16 unique layers → 16 p parameters. Twice the depth, twice the bytes." data-tip-ko="Unique layer 16개 → 16 p 파라미터. 깊이 2배, byte도 2배.">
              <rect class="std-cell" x="160" y="154" width="70" height="96" rx="4"></rect>
              <text class="smono" x="195" y="268" text-anchor="middle">16 L → 16 p</text>
            </g>
            <g data-tip="32 unique layers → 32 p parameters — stored, shipped, and re-read from HBM for every decoded token." data-tip-ko="Unique layer 32개 → 32 p 파라미터 — 저장하고, 전송하고, decode되는 token마다 HBM에서 다시 읽는다.">
              <rect class="std-cell" x="260" y="58" width="70" height="192" rx="4"></rect>
              <text class="smono" x="295" y="268" text-anchor="middle">32 L → 32 p</text>
            </g>
            <text class="mlabel" x="195" y="288" text-anchor="middle">depth chosen at training time — paid in bytes forever</text>

            <line x1="395" y1="40" x2="395" y2="270" stroke="#d1cfc5" stroke-width="1.5" stroke-dasharray="2 6"></line>

            <text class="stitle taccent" x="577" y="26" text-anchor="middle">wanted: depth as a runtime knob</text>
            <g data-tip="One small set of layers, stored once. Apply it r times: effective depth grows with r, the parameter count does not." data-tip-ko="작은 layer 묶음 하나를 한 번만 저장한다. r번 적용하면 유효 깊이는 r을 따라 커지지만 파라미터 수는 그대로다.">
              <rect class="core-frame" x="470" y="120" width="180" height="76" rx="10"></rect>
              <text class="stitle sm taccent" x="560" y="148" text-anchor="middle">small core — p′ params</text>
              <text class="smono" x="560" y="170" text-anchor="middle">stored once</text>
            </g>
            <path class="loopline" d="M650,180 H700 V136 H654" fill="none" marker-end="url(#arrItch)"></path>
            <text class="smono taccent" x="702" y="210" text-anchor="middle">× r — choose</text>
            <text class="smono taccent" x="702" y="226" text-anchor="middle">at inference</text>
            <text class="mlabel" x="560" y="252" text-anchor="middle">r = 4, 8, 32, 64… — same stored bytes every time</text>
            <text class="mlabel" x="560" y="270" text-anchor="middle">hard token → more passes · easy token → fewer</text>
          </svg>
          </div>
        </div>
        <p class="arc-question">
          <span class="lang-en">Can effective depth be decoupled from stored parameters at all?</span>
          <span class="lang-ko">유효 깊이를 저장 파라미터에서 떼어내는 것이 애초에 가능한가?</span>
        </p>
      </div>
    </section>

    <!-- ============ §2 · FOUNDATIONS ============ -->
    <section class="section-tight" id="arc-s2">
      <div class="container">
        <h2 class="arc-heading"><span class="arc-num">§2</span>
          <span class="lang-en">Foundations: weight tying and fixed-point iteration</span>
          <span class="lang-ko">기초: weight tying과 fixed-point iteration</span>
        </h2>
        <div class="prose">
          <p>
            <span class="lang-en">The escape hatch is old: <b>weight tying</b>. If two layers share
              one set of weights, the parameter count halves while the computation does not. Push
              it to the limit — one block applied r times — and depth becomes function composition,
              f(f(…f(x))): a recurrence, not through time like an RNN, but <em>through depth</em>.
              ALBERT (arXiv 1909.11942) used cross-layer sharing to shrink pretraining; the
              Universal Transformer (arXiv 1807.03819) made the loop explicit, applying one shared
              block under a dynamic halting rule, and is Turing-complete under certain
              assumptions.</span>
            <span class="lang-ko">탈출구는 오래된 것이다: <b>weight tying</b>. 두 layer가 weight
              한 벌을 공유하면 파라미터 수는 절반이 되지만 연산은 그대로다. 극한까지 밀면 — block
              하나를 r번 적용 — 깊이는 함수 합성 f(f(…f(x)))가 된다: RNN처럼 시간 방향이 아니라
              <em>깊이 방향</em>의 recurrence다. ALBERT(arXiv 1909.11942)는 cross-layer 공유로
              pretraining을 줄였고, Universal Transformer(arXiv 1807.03819)는 loop를 명시적으로
              만들어 공유 block 하나를 dynamic halting 규칙 아래 반복 적용했다 — 특정 가정 하에
              Turing-complete.</span>
          </p>
          <p>
            <span class="lang-en">Iterating one map is a well-studied object: <b>fixed-point
              iteration</b>. Apply f again and again and one of two things happens. If f contracts
              (spectral radius of its transition below 1), the iterates converge to a fixed point
              x* with f(x*) = x*; if it expands, they blow up. This one dichotomy organizes most of
              the page: it is what gives “more loops” a meaning — each pass refines the state
              toward an input-conditioned answer — and it names the failure mode training must
              avoid. Both halves return, quantitatively, in §5.</span>
            <span class="lang-ko">한 map을 반복 적용하는 것은 잘 연구된 대상이다: <b>fixed-point
              iteration</b>. f를 계속 적용하면 둘 중 하나가 일어난다. f가 수축하면(transition의
              spectral radius가 1 미만) iterate들은 f(x*) = x*인 fixed point x*로 수렴하고,
              팽창하면 폭발한다. 이 이분법 하나가 페이지 대부분을 조직한다: “loop를 더 돈다”에
              의미를 주는 것 — 매 pass가 state를 입력-조건부 답으로 다듬는다 — 이자, 학습이 피해야
              할 실패 모드의 이름이기도 하다. 두 측면 모두 §5에서 정량적으로 돌아온다.</span>
          </p>
          <p>
            <span class="lang-en">So why did looped models take until recently to become
              competitive language models? Because naive looping — feed the block its own output
              and nothing else — turns out to be the wrong recurrence. Making the loop stable,
              trainable, and worth its FLOPs took a handful of specific engineering decisions, and
              those are the next sections.</span>
            <span class="lang-ko">그렇다면 looped 모델이 경쟁력 있는 언어 모델이 되기까지 왜
              최근까지 걸렸는가? block에 자기 출력만 되먹이는 naive looping이 잘못된 recurrence로
              판명났기 때문이다. loop를 안정적이고, 학습 가능하고, FLOPs 값을 하게 만드는 데는
              구체적인 엔지니어링 결정 몇 가지가 필요했고, 그것이 다음 섹션들이다.</span>
          </p>
        </div>
        <div class="arc-takeaway">
          <span class="arc-takeaway-label"><span class="lang-en">Takeaway</span><span class="lang-ko">핵심 한 줄</span></span>
          <span class="lang-en">Weight tying turns depth into iteration of one map, and fixed-point
            theory says iteration converges exactly when the map contracts — everything that
            follows is engineering that keeps a transformer core in the contracting regime while it
            does useful work.</span>
          <span class="lang-ko">weight tying은 깊이를 한 map의 반복으로 바꾸고, fixed-point 이론은
            그 반복이 map이 수축할 때 정확히 수렴한다고 말한다 — 이후의 모든 것은 transformer
            core가 유용한 일을 하면서도 수축 영역에 머물게 하는 엔지니어링이다.</span>
        </div>
        <p class="arc-question">
          <span class="lang-en">What does a competitive looped LM actually look like, next to the standard stack it replaces?</span>
          <span class="lang-ko">경쟁력 있는 looped LM은 그것이 대체하는 standard stack 옆에서 실제로 어떤 모습인가?</span>
        </p>
      </div>
    </section>

    <!-- ============ §3 · THE SHAPE ============ -->
    <section class="section-tight" id="arc-s3">
      <div class="container">
        <h2 class="arc-heading"><span class="arc-num">§3</span>
          <span class="lang-en">The shape: two ways to be 32 layers deep</span>
          <span class="lang-ko">형태: 32 layer 깊이가 되는 두 가지 방법</span>
        </h2>
        <p class="arc-bridge">
          <span class="lang-en">We want depth without buying parameters, and §2 handed us the tool
            — one block, applied r times. Here is the finished object: the prelude–core–coda
            sandwich, standing next to the standard stack it competes with.</span>
          <span class="lang-ko">파라미터를 사지 않고 깊이를 얻고 싶고, 도구는 §2가 건네주었다 —
            block 하나를 r번 적용하는 것. 여기 완성된 물건이 있다: prelude–core–coda 샌드위치가,
            경쟁 상대인 standard stack 옆에 서 있다.</span>
