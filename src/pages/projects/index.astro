---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const statusLabel: Record<string, string> = {
  idea: 'Idea',
  active: 'Active',
  paused: 'Paused',
  done: 'Done',
};
// date desc; on ties, active projects float above the rest
const statusRank: Record<string, number> = { active: 0, paused: 1, done: 2, idea: 3 };

const projects = (await getCollection('projects')).sort(
  (a, b) =>
    b.data.date.valueOf() - a.data.date.valueOf() ||
    statusRank[a.data.status] - statusRank[b.data.status]
);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<Base
  title="Projects — Junwon Lee"
  description="Side projects by Junwon Lee — things built out of curiosity, away from paper deadlines."
>
  <section class="section hero">
    <div class="container">
      <p class="eyebrow">Project</p>
      <h1>Side quests</h1>
      <p class="lede">
        A free space for things built out of curiosity — away from paper deadlines,
        ablation tables, and anything that needs a review cycle. Some ship, some
        stay ideas; all of them are for fun (재미로).
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      {projects.length === 0 ? (
        <p class="empty-note">Nothing here yet — the quest log is empty.</p>
      ) : (
        <div class="card-grid">
          {projects.map((p) => (
            <article class="card project-card">
              <div class="status-row">
                <span class:list={['tag', { accent: p.data.status === 'active' }]}>
                  {statusLabel[p.data.status]}
                </span>
                <span class="date">{fmtDate(p.data.date)}</span>
              </div>
              <h3>
                {p.data.link ? <a href={p.data.link}>{p.data.title}</a> : p.data.title}
              </h3>
              <p>{p.data.summary}</p>
              <span class="card-meta project-foot">
                <span class="pill-row">
                  {p.data.tags.map((t) => (
                    <span class="tag">{t}</span>
                  ))}
                </span>
                {p.data.link && (
                  <a class="arrow-link" href={p.data.link}>
                    Read
                  </a>
                )}
                {p.data.repo && (
                  <a
                    class="arrow-link"
                    href={p.data.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Repo
                  </a>
                )}
              </span>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .hero .lede {
    margin-top: 1.4rem;
  }
  .status-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    margin-bottom: 0.2rem;
  }
  .status-row .date {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-tertiary);
    letter-spacing: 0.02em;
  }
  .project-foot {
    justify-content: space-between;
    align-items: center;
  }
  .pill-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .empty-note {
    color: var(--text-tertiary);
    font-size: 0.95rem;
  }
</style>
