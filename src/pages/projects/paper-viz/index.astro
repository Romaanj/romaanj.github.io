---
import Base from '../../../layouts/Base.astro';
import LangToggle from '../../../components/LangToggle.astro';

/**
 * Paper Visualizations — index, organised in tracks.
 *
 * Each track starts with foundation pages (kind: 'foundation') that build the
 * vocabulary from the hardware up, then the papers that fall out of them. The
 * explainers themselves are self-contained static pages published from
 * projects/replica (`python publish_to_site.py`) into
 * public/projects/paper-viz/<slug>/index.html, so they keep their own styling
 * and interactivity untouched by the site's global CSS.
 */
const tracks = [
  {
    id: 'compression',
    name: 'Compression',
    name_ko: 'Compression — 압축',
    line: 'Make the same model smaller and faster without changing what it answers.',
    line_ko: '같은 모델을 답을 바꾸지 않은 채로 작고 빠르게 만드는 계열.',
    entries: [
      {
        kind: 'foundation',
        slug: 'quantization-basics',
        title: 'Quantization, from the bits up',
        title_ko: 'Quantization, 비트부터',
        subtitle: 'What a weight is in memory, and what quantizing actually does to it',
        venue: 'Foundation',
        date: '2026-08',
        blurb:
          'The 16 bits of one bf16 weight, the grid its value gets snapped onto, what one ' +
          'outlier costs every neighbour, how 4-bit weights are packed into int32, a measured ' +
          'activation tensor raised into three axes — and the chain of physical facts that ' +
          'forces GPTQ and AWQ into existence.',
        blurb_ko:
          'bf16 weight 하나의 16비트, 그 값이 붙잡히는 격자, outlier 하나가 이웃 전부에게 물리는 ' +
          '세금, 4-bit weight가 int32에 packing되는 방식, 세 개의 축으로 세운 실측 activation ' +
          'tensor — 그리고 GPTQ와 AWQ를 강제로 만들어내는 물리적 사실의 사슬.',
        figures: ['flip a bit, watch the value', 'the outlier tax', 'the model, matrix by matrix', 'a real activation tensor in 3-D', 'the chain to GPTQ'],
        figures_ko: ['비트를 뒤집으면 값이 어떻게 되는지', 'outlier 세금', '행렬 단위로 본 모델', '3차원으로 본 실제 activation tensor', 'GPTQ까지 가는 사슬'],
      },
      {
        kind: 'paper',
        slug: 'gptq',
        title: 'GPTQ',
        title_ko: 'GPTQ',
        subtitle: 'Accurate Post-Training Quantization for Generative Pre-trained Transformers',
        venue: 'ICLR 2023',
        arxiv: 'https://arxiv.org/abs/2210.17323',
        date: '2026-08',
        blurb:
          'Error compensation taught on two weights before anything else, the Hessian followed ' +
          'from its derivation into the per-column arithmetic, and quantization drawn as a lattice.',
        blurb_ko:
          '오차 보상을 다른 무엇보다 먼저 weight 두 개로 가르치고, Hessian을 유도에서 열 단위 산술까지 ' +
          '따라가며, 양자화를 격자 그림으로.',
        figures: ['compensation on two weights', 'one cycle of real arithmetic', 'the OBQ column stepper'],
        figures_ko: ['weight 두 개로 배우는 보상', '실제 산술로 보는 한 사이클', 'OBQ 열 스테퍼'],
      },
      {
        kind: 'paper',
        slug: 'smoothquant',
        title: 'SmoothQuant',
        title_ko: 'SmoothQuant',
        subtitle: 'Accurate and Efficient Post-Training Quantization for Large Language Models',
        venue: 'ICML 2023',
        arxiv: 'https://arxiv.org/abs/2211.10438',
        date: '2026-08',
        blurb:
          'How many of INT8\'s 256 levels a typical channel actually gets, why the obvious fix ' +
          'is unexpressible rather than slow, and one knob that moves the difficulty from the ' +
          'activations into the weights — drawn on both surfaces at once.',
        blurb_ko:
          'INT8의 256레벨 중 보통 채널이 실제로 받는 몫, 뻔한 해법이 왜 느린 게 아니라 표현이 ' +
          '안 되는지, 그리고 difficulty를 activation에서 weight로 옮기는 손잡이 하나 — 두 표면 ' +
          '위에서 동시에.',
        figures: ['where the 256 levels go', 'the identity, on real channels', 'watch the difficulty move'],
        figures_ko: ['256레벨이 어디로 가는가', '실제 채널 위의 항등식', 'difficulty가 옮겨가는 것'],
      },
      {
        kind: 'paper',
        slug: 'awq',
        title: 'AWQ',
        title_ko: 'AWQ',
        subtitle: 'Activation-aware Weight Quantization for On-Device LLM Compression',
        venue: 'MLSys 2024',
        arxiv: 'https://arxiv.org/abs/2306.00978',
        date: '2026-08',
        blurb:
          'The paper\'s own selection ablation, re-run on a real layer: protect 1% of channels ' +
          'by activation magnitude and the error drops, protect them by weight norm and nothing ' +
          'happens. Plus the group step Δ moving as you scale one channel.',
        blurb_ko:
          '논문의 선택 ablation을 실제 레이어에서 다시 돌렸다. activation 크기로 고른 1%를 ' +
          '보호하면 오차가 떨어지고, weight norm으로 고르면 아무 일도 없다. 채널 하나를 ' +
          '키울 때 그룹 간격 Δ가 움직이는 것까지.',
        figures: ['which channels you protect', 'the two rankings', 'one group, one scaled channel'],
        figures_ko: ['어느 채널을 보호하는가', '두 개의 순위', '그룹 하나, 스케일된 채널 하나'],
      },
      {
        kind: 'paper',
        slug: 'quarot',
        title: 'QuaRot',
        title_ko: 'QuaRot',
        subtitle: 'Outlier-Free 4-Bit Inference in Rotated LLMs',
        venue: 'NeurIPS 2024',
        arxiv: 'https://arxiv.org/abs/2404.00456',
        date: '2026-08',
        blurb:
          'Where the per-channel scale runs out of travel, and what happens when the transform ' +
          'is allowed to be any orthogonal matrix instead. The same hidden state before and ' +
          'after one Hadamard, with the norm unchanged to the last digit.',
        blurb_ko:
          'per-channel scale이 어디서 끝까지 돌아가는지, 그리고 변환을 임의의 orthogonal ' +
          '행렬로 열어주면 무슨 일이 벌어지는지. 같은 hidden state를 Hadamard 전후로 그렸고 ' +
          'norm은 마지막 자리까지 그대로다.',
        figures: ['the knob at 8 bits and at 4', 'one Hadamard on a real tensor', 'checking the invariance'],
        figures_ko: ['8비트와 4비트에서의 같은 손잡이', '실제 tensor에 Hadamard 한 번', 'invariance 확인'],
      },
      {
        kind: 'paper',
        slug: 'spinquant',
        title: 'SpinQuant',
        title_ko: 'SpinQuant',
        subtitle: 'LLM Quantization with Learned Rotations',
        venue: 'ICLR 2025',
        arxiv: 'https://arxiv.org/abs/2405.16406',
        date: '2026-08',
        blurb:
          'An invariance is a parameter you have not chosen yet. Sixty-four rotations of one ' +
          'real layer drawn as a distribution, and a Cayley-optimised rotation that finishes ' +
          'below all of them without ever leaving the manifold.',
        blurb_ko:
          'invariance는 아직 고르지 않은 파라미터다. 실제 레이어 하나를 예순네 번 회전시켜 ' +
          '분포로 그렸고, manifold를 벗어나지 않은 채 그 전부보다 아래에서 끝나는 ' +
          'Cayley 최적화 회전까지.',
        figures: ['sixty-four rotations', 'tailedness before and after', 'learning one rotation'],
        figures_ko: ['예순네 번의 회전', '전과 후의 꼬리 두께', '회전 하나를 학습한다'],
      },
    ],
    next: 'Sub-4-bit and the KV cache — once the outliers are gone, what is left is ordinary rounding error.',
    next_ko: '4비트 미만과 KV cache — outlier가 사라지고 나면 남는 것은 평범한 반올림 오차다.',
  },
  {
    id: 'architecture',
    name: 'Architecture & systems',
    name_ko: 'Architecture & systems — 구조와 시스템',
    line: 'Same arithmetic, rearranged around what the hardware is actually good at.',
    line_ko: '산술은 그대로 두고, 하드웨어가 실제로 잘하는 것에 맞춰 배치를 바꾸는 계열.',
    entries: [
      {
        kind: 'paper',
        slug: 'flashattention',
        title: 'FlashAttention',
        title_ko: 'FlashAttention',
        subtitle: 'Fast and Memory-Efficient Exact Attention with IO-Awareness',
        venue: 'NeurIPS 2022',
        arxiv: 'https://arxiv.org/abs/2205.14135',
        date: '2026-08',
        blurb:
          'Why the GPU is a memory machine, why softmax looked untileable, and the online ' +
          'rescaling that rebuilds the exact answer one block at a time — watched to 1e-16.',
        blurb_ko:
          'GPU가 왜 메모리 기계인지, softmax가 왜 tiling 불가능해 보였는지, 그리고 정확한 답을 ' +
          '블록 하나씩 다시 세우는 online rescaling — 오차 1e-16까지 직접 확인.',
        figures: ['online softmax, step by step', 'every trip to HBM', 'what is in SRAM right now'],
        figures_ko: ['한 스텝씩 보는 online softmax', 'HBM으로 가는 모든 왕복', '지금 SRAM에 있는 것'],
      },
    ],
    next: 'PagedAttention, then GQA / MLA — the KV cache as the thing being managed.',
    next_ko: 'PagedAttention, 이어서 GQA / MLA — 관리 대상으로서의 KV cache.',
  },
  {
    id: 'decoding',
    name: 'Decoding',
    name_ko: 'Decoding — 디코딩',
    line: 'Same model, fewer sequential forward passes to get the same tokens out.',
    line_ko: '같은 모델에서 같은 토큰을 꺼내되, 순차 forward pass 수를 줄이는 계열.',
    entries: [
      {
        kind: 'paper',
        slug: 'dflash',
        title: 'DFlash',
        title_ko: 'DFlash',
        subtitle: 'Block Diffusion for Flash Speculative Decoding',
        venue: 'ICML 2026',
        arxiv: 'https://arxiv.org/abs/2602.06036',
        date: '2026-08',
        blurb:
          'Why one forward pass yields one token, what τ actually buys inside a fixed 300 ms, ' +
          'and the accept/reject rule played out on a real recorded cycle.',
        blurb_ko:
          'forward pass 한 번이 왜 토큰 하나인지, 고정된 300 ms 안에서 τ가 실제로 무엇을 사오는지, ' +
          '그리고 수락·거부 규칙을 실제로 기록된 사이클 위에서.',
        figures: ['τ as tokens per 300 ms', 'accept/reject on real tokens', 'the cycle that feeds itself'],
        figures_ko: ['300 ms당 토큰으로 본 τ', '실제 토큰 위의 수락·거부', '자기 자신을 먹이는 사이클'],
      },
    ],
    next: 'A foundation page on the decode loop itself — where the milliseconds go, one token at a time.',
    next_ko: 'decode loop 자체를 다루는 기초 페이지 — 토큰 하나를 뽑는 동안 밀리초가 어디로 가는지.',
  },
];
---

<Base
  title="Paper Visualizations — Junwon Lee"
  description="Papers I wanted to understand completely — built up from foundations, read through 13 questions, with every concept drawn."
>
  <section class="section pv-hero">
    <div class="container">
      <p class="eyebrow">Project · Paper Visualization</p>
      <h1>
        <span class="lang-en">Papers, drawn until they are obvious</span>
        <span class="lang-ko">당연해질 때까지 그려본 논문들</span>
      </h1>
      <p class="lede">
        <span class="lang-en">
          Reading a paper twice is not the same as understanding it. These pages are built in
          tracks, and each track starts at the bottom: what the object physically is, what the
          hardware does with it, and only then the papers — read through the same 13 questions,
          answered in one sentence each, with a picture wherever a sentence was not enough. The
          aim is that by the last page of a track, the method reads as the only move that was
          left.
        </span>
        <span class="lang-ko">
          논문을 두 번 읽는 것과 이해하는 것은 다르다. 이 페이지들은 트랙으로 묶여 있고 각 트랙은
          맨 밑에서 시작한다. 대상이 물리적으로 무엇인지, 하드웨어가 그것을 어떻게 다루는지를 먼저
          보고 나서야 논문으로 간다. 논문은 전부 같은 13개 질문으로 읽고 각 질문에 한 문장으로 답한
          뒤, 문장으로 부족한 자리마다 그림을 넣었다. 트랙의 마지막 페이지에 도착했을 때 그 method가
          남아 있던 유일한 수로 읽히는 것이 목표다.
        </span>
      </p>
      <LangToggle />
    </div>
  </section>

  {tracks.map((t) => (
    <section class="section-tight pv-track">
      <div class="container">
        <div class="pv-trackhead">
          <h2 id={t.id}>
            <span class="lang-en">{t.name}</span>
            <span class="lang-ko">{t.name_ko}</span>
          </h2>
          <p class="pv-trackline">
            <span class="lang-en">{t.line}</span>
            <span class="lang-ko">{t.line_ko}</span>
          </p>
        </div>

        <div class="pv-grid">
          {t.entries.map((p) => (
            <article class={`card pv-card ${p.kind === 'foundation' ? 'is-foundation' : ''}`}>
              <div class="status-row">
                <span class={`tag ${p.kind === 'foundation' ? 'found' : 'accent'}`}>{p.venue}</span>
                <span class="date">{p.date}</span>
              </div>
              <h3>
                <a href={`/projects/paper-viz/${p.slug}/`}>
                  <span class="lang-en">{p.title}</span>
                  <span class="lang-ko">{p.title_ko}</span>
                </a>
              </h3>
              <p class="pv-subtitle">{p.subtitle}</p>
              <p>
                <span class="lang-en">{p.blurb}</span>
                <span class="lang-ko">{p.blurb_ko}</span>
              </p>
              <ul class="pv-figs">
                {p.figures.map((f, i) => (
                  <li>
                    <span class="lang-en">{f}</span>
                    <span class="lang-ko">{p.figures_ko[i]}</span>
                  </li>
                ))}
              </ul>
              <span class="card-meta pv-foot">
                <a class="arrow-link" href={`/projects/paper-viz/${p.slug}/`}>
                  <span class="lang-en">Open</span><span class="lang-ko">열기</span>
                </a>
                {p.arxiv && (
                  <a class="arrow-link muted" href={p.arxiv} rel="noopener" target="_blank">arXiv</a>
                )}
              </span>
            </article>
          ))}
        </div>

        <p class="pv-next">
          <span class="lang-en"><b>Next in this track —</b> {t.next}</span>
          <span class="lang-ko"><b>이 트랙의 다음 —</b> {t.next_ko}</span>
        </p>
      </div>
    </section>
  ))}

  <section class="section-tight">
    <div class="container">
      <p class="pv-note">
        <span class="lang-en">
          Each page is self-contained and runs entirely in your browser — the interactive
          figures need no server. Numbers in the figures are either read from the paper's own
          tables (marked <em>paper</em>) or measured here on a single NVIDIA A100 and read out
          of a stored artifact (marked <em>probe</em>); foundation pages read real tensor
          shapes straight from model files.
        </span>
        <span class="lang-ko">
          각 페이지는 자기완결형이고 전부 브라우저 안에서 돌아간다. 인터랙티브 그림에 서버는
          필요 없다. 그림 속 숫자는 논문의 표에서 가져왔거나(<em>paper</em> 표시) A100 한 장에서
          실측해 저장한 artifact에서 읽어온 것이다(<em>probe</em> 표시). 기초 페이지의 숫자는
          모델 파일에서 직접 읽은 실제 tensor shape다.
        </span>
      </p>
    </div>
  </section>
</Base>

<style>
  .pv-hero h1 { max-width: 20ch; }
  .pv-track { padding-top: 0.6rem; }
  .pv-trackhead { margin-bottom: 1rem; }
  .pv-trackhead h2 {
    font-size: 1.25rem;
    margin: 0 0 0.2rem;
    scroll-margin-top: 90px;
  }
  .pv-trackline {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted, #6b7280);
    max-width: 62ch;
  }
  .pv-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  }
  /* a lone card in a track should keep a card's width, not stretch across */
  .pv-card { max-width: 560px; }
  .pv-card h3 { margin-bottom: 0.15rem; }
  .pv-card.is-foundation { border-color: var(--accent, #d97757); }
  .tag.found {
    background: var(--accent, #d97757);
    color: #fff;
    border-color: var(--accent, #d97757);
  }
  .pv-subtitle {
    font-size: 0.9rem;
    color: var(--muted, #6b7280);
    font-style: italic;
    margin: 0 0 0.6rem;
  }
  .pv-figs {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .pv-figs li {
    font-size: 0.74rem;
    letter-spacing: 0.02em;
    padding: 3px 9px;
    border: 1px solid var(--border, #e5e7eb);
    border-radius: 999px;
    color: var(--muted, #6b7280);
  }
  .pv-foot { display: flex; gap: 1rem; align-items: center; }
  .arrow-link.muted { opacity: 0.7; font-weight: 500; }
  .pv-next {
    margin: 1.1rem 0 0;
    font-size: 0.85rem;
    color: var(--muted, #6b7280);
    max-width: 70ch;
  }
  .pv-note {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--muted, #6b7280);
    max-width: 70ch;
  }
</style>
