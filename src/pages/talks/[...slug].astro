---
import Base from '../../layouts/Base.astro';
import LangToggle from '../../components/LangToggle.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const talks = await getCollection('talks');
  return talks.map((t) => ({ params: { slug: t.id }, props: { talk: t } }));
}

const { talk } = Astro.props;
const d = talk.data;
const { Content } = await render(talk);

const cueModules = import.meta.glob('../../data/talks/*.cues.json', { eager: true });
const mod = cueModules[`../../data/talks/${talk.id}.cues.json`] as
  | { default: { start: number; end: number; ko: string; en: string }[] }
  | undefined;
if (!mod) throw new Error(`Missing cues file: src/data/talks/${talk.id}.cues.json`);
const cues = mod.default;

const fmtDate = (dt: Date) =>
  dt.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Base title={`${d.title} — Talks — Junwon Lee`} description={d.summary}>
  <section class="section-tight talk-page">
    <div class="container">
      <p class="eyebrow">{d.event ?? 'Talk'}</p>
      <h1 class="talk-title">
        <span class="lang-en">{d.title}</span>
        <span class="lang-ko">{d.title_ko ?? d.title}</span>
      </h1>
      <p class="byline">
        {d.speaker}{d.affiliation ? ` · ${d.affiliation}` : ''} —
        <span class="date-mono">{fmtDate(d.date)}{d.duration ? ` · ${d.duration}` : ''}</span>
      </p>

      <div class="stage">
        <div id="yt"></div>
        <div class="subs">
          <div class="sub-ko" id="sub-ko"></div>
          <div class="sub-en" id="sub-en"></div>
        </div>
      </div>

      <div class="bar">
        <button id="toggle-en" type="button">EN 원문</button>
        <button id="font-up" type="button">가+</button>
        <button id="font-down" type="button">가−</button>
        <span class="downloads">
          <a href={`/subs/${talk.id}/ko.srt`} download>ko.srt</a>
          <a href={`/subs/${talk.id}/bilingual.srt`} download>bilingual.srt</a>
        </span>
        <LangToggle />
      </div>

      <p class="summary">
        <span class="lang-en">{d.summary}</span>
        <span class="lang-ko">{d.summary_ko ?? d.summary}</span>
      </p>

      <div class="notes">
        <Content />
      </div>

      <p class="credit">
        <span class="lang-en">
          Video © {d.channel} — plays via YouTube embed, never re-hosted.
          Subtitles: machine-assisted (ASR captions → glossary-driven LLM translation);
          errors possible, corrections welcome.
          <a href={`https://www.youtube.com/watch?v=${d.videoId}`} target="_blank" rel="noopener noreferrer">Watch on YouTube</a>
        </span>
        <span class="lang-ko">
          영상 © {d.channel} — YouTube 임베드로 재생되며 재업로드하지 않습니다.
          자막은 자동 캡션을 용어집 기반 LLM 파이프라인으로 번역해 오류가 있을 수 있습니다 — 제보 환영합니다.
          <a href={`https://www.youtube.com/watch?v=${d.videoId}`} target="_blank" rel="noopener noreferrer">YouTube에서 보기</a>
        </span>
      </p>
    </div>

    <script is:inline define:vars={{ cues, videoId: d.videoId }}>
      let player = null;
      let idx = 0;
      let shownIdx = -2; // last cue index written to the DOM (-1 = hidden)
      let koSize = 1.3;
      const koEl = document.getElementById('sub-ko');
      const enEl = document.getElementById('sub-en');

      const tag = document.createElement('script');
      tag.src = 'https://www.youtube.com/iframe_api';
      document.head.appendChild(tag);
      window.onYouTubeIframeAPIReady = () => {
        player = new YT.Player('yt', { videoId, playerVars: { rel: 0, playsinline: 1 } });
        setInterval(tick, 150);
      };

      function findCue(t) {
        if (idx < cues.length && cues[idx].start <= t && t < cues[idx].end) return idx;
        let lo = 0, hi = cues.length - 1, ans = -1;
        while (lo <= hi) {
          const m = (lo + hi) >> 1;
          if (cues[m].start <= t) { ans = m; lo = m + 1; } else hi = m - 1;
        }
        return ans >= 0 && t < cues[ans].end ? ans : -1;
      }

      function tick() {
        if (!player || !player.getCurrentTime) return;
        const i = findCue(player.getCurrentTime());
        if (i === shownIdx) return; // no DOM churn while the same cue is up
        shownIdx = i;
        if (i >= 0) {
          idx = i;
          koEl.textContent = cues[i].ko;
          enEl.textContent = cues[i].en;
          koEl.style.visibility = 'visible';
          enEl.style.visibility = 'visible';
        } else {
          koEl.style.visibility = 'hidden';
          enEl.style.visibility = 'hidden';
        }
      }

      document.getElementById('toggle-en').addEventListener('click', (e) => {
        const on = document.querySelector('.talk-page').classList.toggle('show-en');
        e.currentTarget.classList.toggle('on', on);
      });
      document.getElementById('font-up').addEventListener('click', () => {
        koSize = Math.min(koSize + 0.15, 2.2);
        document.documentElement.style.setProperty('--sub-ko-size', koSize + 'rem');
      });
      document.getElementById('font-down').addEventListener('click', () => {
        koSize = Math.max(koSize - 0.15, 0.8);
        document.documentElement.style.setProperty('--sub-ko-size', koSize + 'rem');
      });
    </script>
  </section>
</Base>

<style>
  .talk-title {
    margin-top: 0.4rem;
  }
  .byline {
    margin: 0.5rem 0 1.4rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }
  .date-mono {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-tertiary);
    letter-spacing: 0.02em;
  }
  .stage {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: var(--radius-m);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }
  .stage :global(#yt),
  .stage :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .subs {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 6%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    pointer-events: none;
  }
  .sub-ko,
  .sub-en {
    max-width: 88%;
    text-align: center;
    padding: 4px 14px;
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.72);
    color: #fff;
    white-space: pre-line;
    visibility: hidden;
  }
  .sub-ko {
    font-size: var(--sub-ko-size, 1.3rem);
    font-weight: 600;
    line-height: 1.45;
  }
  .sub-en {
    font-size: 0.85rem;
    color: #c7cdd4;
    display: none;
  }
  .talk-page.show-en .sub-en {
    display: block;
  }
  .bar {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-top: 0.9rem;
    flex-wrap: wrap;
  }
  .bar button {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: var(--text-secondary);
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 0.35em 0.9em;
    cursor: pointer;
    transition: color 0.15s, background 0.15s;
  }
  .bar button:hover,
  .bar button.on {
    color: var(--text);
    background: var(--surface-warm);
  }
  .downloads {
    margin-left: auto;
    display: flex;
    gap: 0.8rem;
  }
  .downloads a {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-tertiary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .downloads a:hover {
    color: var(--accent-strong);
  }
  .summary {
    margin-top: 1.6rem;
    max-width: var(--prose-width);
    color: var(--text-secondary);
    line-height: 1.65;
  }
  .notes {
    max-width: var(--prose-width);
  }
  .credit {
    margin-top: 1rem;
    max-width: var(--prose-width);
    font-size: 0.82rem;
    color: var(--text-tertiary);
    line-height: 1.6;
  }
  .credit a {
    color: var(--text-tertiary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .credit a:hover {
    color: var(--accent-strong);
  }
</style>
