---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="serif">Junwon Lee</span>
      <p>Efficient AI — diffusion LLMs, KV caches, quantization, GPU systems.</p>
    </div>
    <div class="footer-links">
      <a href="https://github.com/Romaanj" target="_blank" rel="noopener">GitHub</a>
      <a href="https://www.linkedin.com/in/junwon-lee-961383204/" target="_blank" rel="noopener">LinkedIn</a>
      <a href="mailto:jwlee1218@g.skku.edu">Email</a>
    </div>
  </div>
  <div class="container footer-meta">
    <span>© {year} Junwon Lee · IRIS Lab, SKKU</span>
    <span>Built with Astro</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    border-top: 1px solid var(--line);
    background: var(--surface-warm);
    padding: 2.6rem 0 2rem;
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .footer-brand span { font-size: 1.15rem; font-weight: 600; }
  .footer-brand p {
    margin: 0.4rem 0 0;
    font-size: 0.88rem;
    color: var(--text-tertiary);
    max-width: 34em;
  }
  .footer-links { display: flex; gap: 1.4rem; }
  .footer-links a {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-secondary);
  }
  .footer-links a:hover { color: var(--accent-strong); }
  .footer-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2rem;
    font-size: 0.78rem;
    color: var(--text-tertiary);
  }
</style>
